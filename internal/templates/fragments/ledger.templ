package fragments

import (
	"fmt"
	"github.com/withObsrvr/prism/internal/templates/components"
	"github.com/withObsrvr/prism/internal/templates/pages"
)

// LedgerTxs renders the transactions table for a ledger.
templ LedgerTxs(data pages.LedgerDetailData) {
	<div id="ledger-txs" class="anim d1 mb-10">
		<div class="flex items-center justify-between mb-3">
			@components.SectionHeader(fmt.Sprintf("Transactions (%s)", data.TxCount))
			<div class="flex items-center gap-1">
				<button class="rounded-lg border border-gray-900 dark:border-gray-100 bg-gray-900 dark:bg-gray-100 px-2.5 py-1.5 text-xs font-semibold text-white dark:text-gray-900">All</button>
				<button class="rounded-lg border border-border-default bg-surface-card px-2.5 py-1.5 text-xs font-medium text-violet-600 hover:bg-violet-50 dark:hover:bg-violet-950/30">Soroban</button>
				<button class="rounded-lg border border-border-default bg-surface-card px-2.5 py-1.5 text-xs font-medium text-text-body hover:bg-surface-subtle">Classic</button>
				<button class="rounded-lg border border-border-default bg-surface-card px-2.5 py-1.5 text-xs font-medium text-red-500 hover:bg-red-50 dark:hover:bg-red-950/30">Failed</button>
			</div>
		</div>
		<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden overflow-x-auto">
			<div class="flex items-center px-5 py-2.5 text-2xs font-semibold uppercase tracking-wider text-text-muted border-b border-border-default bg-surface-page">
				<div class="hidden md:block w-8">#</div>
				<div class="w-16">Status</div>
				<div class="w-[140px]">Hash</div>
				<div class="flex-1">Human-Readable Summary</div>
				<div class="hidden md:block w-14 text-right">Ops</div>
				<div class="hidden md:block w-20 text-right">Fee</div>
			</div>
			for i, tx := range data.Transactions {
				<div class={ "tx-row flex items-center px-5 py-3", templ.KV("bg-red-50/30 dark:bg-red-950/20", tx.IsFailed), templ.KV("bg-surface-subtle", i%2 == 1 && !tx.IsFailed) }>
					<div class="hidden md:block w-8"><span class="text-2xs font-mono text-text-muted">{ tx.Index }</span></div>
					<div class="w-16">
						if tx.IsFailed {
							<span class="rounded bg-red-50 dark:bg-red-950/30 px-1.5 py-0.5 text-2xs font-bold text-red-600 dark:text-red-400">Failed</span>
						} else {
							<span class="rounded bg-emerald-50 dark:bg-emerald-950/30 px-1.5 py-0.5 text-2xs font-bold text-emerald-700 dark:text-emerald-400">OK</span>
						}
					</div>
					<div class="w-[140px]">
						<div class="flex flex-col">
							<a href={ templ.SafeURL("/tx/" + tx.Hash) } class="font-mono text-xs text-text-primary hover:text-violet-600">{ tx.ShortHash }</a>
							<div class="mt-0.5">
								@components.TypeBadge(tx.OpType, ledgerTxBadgeColor(tx.Family))
							</div>
						</div>
					</div>
					<div class="flex-1 text-xs text-text-strong leading-relaxed pr-4">
						@templ.Raw(tx.Summary)
					</div>
					<div class="hidden md:block w-14 text-right"><span class="font-mono text-xs text-text-strong tabular">{ tx.Ops }</span></div>
					<div class="hidden md:block w-20 text-right"><span class="font-mono text-xs text-text-body tabular">{ tx.Fee }</span></div>
				</div>
			}
			<div class="px-5 py-3 text-center border-t border-border-subtle bg-surface-page">
				<span class="text-xs text-text-body">Showing { fmt.Sprintf("%d", len(data.Transactions)) } of { data.TxCount } transactions · </span>
				<button class="text-xs font-medium text-violet-600 hover:text-violet-700">Load all transactions</button>
			</div>
		</div>
	</div>
}

// LedgerOpsAndFees renders the operation breakdown + fee distribution side by side.
templ LedgerOpsAndFees(data pages.LedgerDetailData) {
	<div id="ledger-ops-fees" class="anim d2 mb-10 grid grid-cols-1 lg:grid-cols-2 gap-6">
		<!-- Op Breakdown -->
		<div>
			@components.SectionHeader("Operation Breakdown")
			<div class="rounded-xl border border-border-default bg-surface-card p-5 shadow-sm">
				if len(data.OpBreakdown) > 0 {
					<div class="flex h-4 w-full overflow-hidden rounded-full mb-4">
						for _, op := range data.OpBreakdown {
							<div class={ "h-full", op.Color } style={ "width:" + op.Width }></div>
						}
					</div>
					<div class="flex flex-wrap gap-x-5 gap-y-1.5 text-xs">
						for _, op := range data.OpBreakdown {
							<div class="flex items-center gap-1.5">
								<span class={ "h-2 w-2 rounded-full", op.Color }></span>
								<span class="text-text-strong font-medium">{ op.Name }</span>
								<span class="font-mono text-text-muted tabular">{ op.Count }</span>
							</div>
						}
					</div>
				}
			</div>
		</div>
		<!-- Fee Distribution -->
		<div>
			@components.SectionHeader("Fee Distribution")
			<div class="rounded-xl border border-border-default bg-surface-card p-4 shadow-sm">
				<div class="space-y-2.5">
					<div class="flex items-center justify-between">
						<div class="flex items-center gap-2">
							<span class="h-2 w-2 rounded-full bg-gray-400"></span>
							<span class="text-xs font-medium text-text-strong">Base Fee</span>
						</div>
						<div>
							<span class="font-mono text-xs font-semibold text-text-primary tabular">{ data.FeeBase }</span>
							<span class="text-2xs text-text-muted ml-0.5">stroops</span>
						</div>
					</div>
					<div class="flex items-center justify-between">
						<div class="flex items-center gap-2">
							<span class="h-2 w-2 rounded-full bg-emerald-500"></span>
							<span class="text-xs font-medium text-text-strong">Median</span>
						</div>
						<div>
							<span class="font-mono text-xs font-semibold text-text-primary tabular">{ data.FeeMedian }</span>
							<span class="text-2xs text-text-muted ml-0.5">stroops</span>
						</div>
					</div>
					<div class="flex items-center justify-between">
						<div class="flex items-center gap-2">
							<span class="h-2 w-2 rounded-full bg-amber-500"></span>
							<span class="text-xs font-medium text-text-strong">P99</span>
						</div>
						<div>
							<span class="font-mono text-xs font-semibold text-text-primary tabular">{ data.FeeP99 }</span>
							<span class="text-2xs text-text-muted ml-0.5">stroops</span>
						</div>
					</div>
				</div>
				<div class="mt-3 pt-2 border-t border-border-subtle flex items-center gap-1.5">
					<span class="h-1.5 w-1.5 rounded-full bg-gray-400"></span>
					<span class="text-2xs text-text-body">Surge: Inactive</span>
					<span class="text-2xs text-text-muted ml-auto">{ data.SurgePct } of max tx set</span>
				</div>
			</div>
		</div>
	</div>
}

// LedgerSoroban renders the Soroban runtime details section.
templ LedgerSoroban(data pages.LedgerDetailData) {
	<div id="ledger-soroban" class="anim d3 mb-10">
		@components.SectionHeader("Soroban Runtime")
		<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden text-sm">
			<div class="detail-row flex items-center px-5 py-2.5 border-b border-border-subtle">
				<span class="w-32 text-text-muted flex-shrink-0">Total CPU</span>
				<span class="font-medium text-violet-700 font-mono tabular ml-4">{ data.TotalCPU }</span>
				<span class="text-text-muted ml-2">·</span>
				<span class="text-text-body ml-2">across { data.SorobanCalls } invocations</span>
			</div>
			<div class="detail-row flex items-center px-5 py-2.5 border-b border-border-subtle">
				<span class="w-32 text-text-muted flex-shrink-0">State Reads</span>
				<span class="font-medium text-violet-700 font-mono tabular ml-4">{ data.StateReads } entries</span>
				<span class="text-text-muted ml-2">·</span>
				<span class="text-text-body ml-2">{ data.StateReadKB }</span>
			</div>
			<div class="detail-row flex items-center px-5 py-2.5 border-b border-border-subtle">
				<span class="w-32 text-text-muted flex-shrink-0">State Writes</span>
				<span class="font-medium text-violet-700 font-mono tabular ml-4">{ data.StateWrites } entries</span>
				<span class="text-text-muted ml-2">·</span>
				<span class="text-text-body ml-2">{ data.StateWriteKB }</span>
			</div>
			<div class="detail-row flex items-center px-5 py-2.5">
				<span class="w-32 text-text-muted flex-shrink-0">Rent Burned</span>
				<span class="font-medium text-violet-700 font-mono tabular ml-4">{ data.RentBurned } XLM</span>
			</div>
		</div>
	</div>
}

// ledgerTxBadgeColor maps an operation family onto one of TypeBadge's colour
// names. TypeBadge is shared with other pages, so the family vocabulary is
// translated here rather than pushed into the component.
func ledgerTxBadgeColor(family string) string {
	switch family {
	case "contract":
		return "violet"
	case "transfer":
		return "blue"
	case "market":
		return "cyan"
	case "controls":
		return "amber"
	case "agent":
		return "red"
	case "revoke":
		return "red"
	default:
		return "gray"
	}
}
