package fragments

import (
	"strings"

	"github.com/withObsrvr/prism/internal/templates/components"
	"github.com/withObsrvr/prism/internal/templates/pages"
)

// TxOverview renders the key-value overview section of a transaction receipt.
templ TxOverview(data pages.TxReceiptData) {
	<div id="tx-overview" class="anim d1 mb-6">
		<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden text-sm">
			<div class="detail-row flex items-center px-5 py-2.5 border-b border-border-subtle">
				<span class="w-32 text-text-muted flex-shrink-0">
					if data.SmartWalletDetected {
						Submitter
					} else {
						Source
					}
				</span>
				<div class="flex items-center gap-1.5 ml-4">
					<a href={ templ.SafeURL("/account/" + data.SourceAddrFull) } class="font-mono text-xs text-emerald-700 hover:text-emerald-800">{ data.SourceAddr }</a>
					@components.CopyButton(data.SourceAddrFull)
				</div>
			</div>
			if data.EffectiveActorAddr != "" && data.EffectiveActorAddr != data.SourceAddrFull {
				<div class="detail-row flex items-center px-5 py-2.5 border-b border-border-subtle">
					<span class="w-32 text-text-muted flex-shrink-0">Effective Actor</span>
					<div class="flex items-center gap-2 ml-4">
						<a href={ templ.SafeURL(data.EffectiveActorHref) } class="font-mono text-xs text-emerald-700 hover:text-emerald-800">{ data.EffectiveActorShort }</a>
						if data.EffectiveActorType != "" {
							<span class="text-text-muted">·</span>
							<span class="text-xs text-text-body">{ data.EffectiveActorType }</span>
						}
					</div>
				</div>
			}
			if data.SmartWalletDetected {
				<div class="detail-row flex items-center px-5 py-2.5 border-b border-border-subtle">
					<span class="w-32 text-text-muted flex-shrink-0">Wallet</span>
					<div class="flex items-center gap-2 ml-4">
						<a href={ templ.SafeURL("/account/" + data.SmartWalletContract + "/smart") } class="font-mono text-xs text-emerald-700 hover:text-emerald-800">{ data.SmartWalletContractShort }</a>
						if data.SmartWalletType != "" {
							<span class="text-text-muted">·</span>
							<span class="text-xs text-text-body">{ data.SmartWalletType }</span>
						}
					</div>
				</div>
			}
			if data.DownstreamContractAddr != "" || data.ContractAddr != "—" {
				<div class="detail-row flex items-center px-5 py-2.5 border-b border-border-subtle">
					<span class="w-32 text-text-muted flex-shrink-0">Target</span>
					<div class="flex items-center gap-2 ml-4">
						if data.DownstreamContractAddr != "" {
							<a href={ templ.SafeURL(data.DownstreamContractHref) } class="font-mono text-xs text-emerald-700 hover:text-emerald-800">{ data.DownstreamContractShort }</a>
						} else {
							<span class="text-text-primary font-medium">{ data.ContractName }</span>
							<a href={ templ.SafeURL("/contracts/" + data.ContractAddrFull) } class="font-mono text-xs text-emerald-700 hover:text-emerald-800">{ data.ContractAddr }</a>
						}
						if data.DownstreamFunctionName != "" || data.ContractFn != "—" {
							<span class="text-text-muted">&middot;</span>
							<span class="font-mono text-xs text-violet-600">
								if data.DownstreamFunctionName != "" {
									{ data.DownstreamFunctionName }()
								} else {
									{ data.ContractFn }
								}
							</span>
						}
					</div>
				</div>
			}
			<div class="detail-row flex items-center px-5 py-2.5 border-b border-border-subtle">
				<span class="w-32 text-text-muted flex-shrink-0">Fee</span>
				if data.FeePaidXLM != "" {
					<span class="font-mono font-medium text-text-primary ml-4">{ data.FeePaidXLM }</span>
					<span class="text-text-muted ml-2">({ data.FeePaid } stroops)</span>
				} else {
					<span class="font-mono font-medium text-text-primary ml-4">{ data.FeePaid } stroops</span>
				}
				if data.MaxFee != "" {
					<span class="text-text-muted ml-2">·</span>
					<span class="text-text-body ml-2">max { data.MaxFee } stroops</span>
				}
				if data.FeeUSD != "—" {
					<span class="text-text-muted ml-2">·</span>
					<span class="text-text-muted ml-2">~{ data.FeeUSD }</span>
				}
			</div>
			if data.SeqNumber != "—" && data.SeqNumber != "" {
				<div class="detail-row flex items-center px-5 py-2.5 border-b border-border-subtle">
					<span class="w-32 text-text-muted flex-shrink-0">Sequence</span>
					<span class="font-mono text-xs text-text-primary ml-4">{ data.SeqNumber }</span>
				</div>
			}
			if data.IsSoroban {
				<div class="detail-row flex items-center px-5 py-2.5 border-b border-border-subtle">
					<span class="w-32 text-text-muted flex-shrink-0">Resources</span>
					<div class="flex items-center gap-3 ml-4 text-xs">
						<span class="text-text-strong">CPU <span class="font-mono font-medium text-violet-700">{ data.SorobanCPU }</span></span>
						<span class="text-text-muted">&middot;</span>
						<span class="text-text-strong">Mem <span class="font-mono font-medium">{ data.SorobanMem }</span></span>
						<span class="text-text-muted">&middot;</span>
						<span class="text-text-strong">Read <span class="font-mono font-medium">{ data.SorobanReads }</span></span>
						<span class="text-text-muted">&middot;</span>
						<span class="text-text-strong">Write <span class="font-mono font-medium">{ data.SorobanWrites }</span></span>
					</div>
				</div>
			}
			if data.EffectiveRate != "—" {
				<div class="detail-row flex items-center px-5 py-2.5">
					<span class="w-32 text-text-muted flex-shrink-0">Swap</span>
					<div class="flex items-center gap-3 ml-4 text-xs">
						<span class="text-text-strong">Rate <span class="font-medium text-text-primary">{ data.EffectiveRate }</span></span>
						<span class="text-text-muted">&middot;</span>
						<span class="text-text-strong">Slippage <span class="font-medium text-text-primary">{ data.Slippage }</span></span>
						<span class="text-text-muted">&middot;</span>
						<span class="text-text-strong">Route <span class="font-medium text-text-primary">{ data.Route }</span></span>
					</div>
				</div>
			}
		</div>
	</div>
}

// TxOperations renders the operations table.
templ TxOperations(ops []pages.TxOperation) {
	<div id="tx-operations" class="anim d2 mb-8">
		<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden">
			<table class="w-full text-left">
				<thead>
					<tr class="text-2xs font-mono text-text-muted uppercase tracking-widest bg-surface-subtle">
						<th class="px-5 py-3 font-medium w-8">#</th>
						<th class="px-4 py-3 font-medium w-40">Type</th>
						<th class="px-4 py-3 font-medium">Summary</th>
						<th class="px-4 py-3 font-medium text-right hidden md:table-cell w-24">Status</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-border-subtle">
					for _, op := range ops {
						<tr class={ templ.KV("bg-violet-50/30 dark:bg-violet-950/20", op.IsPrimary) }>
							<td class="px-5 py-3">
								<span class={ "flex h-6 w-6 items-center justify-center rounded-full text-2xs font-bold", templ.KV("bg-violet-100 dark:bg-violet-900/30 text-violet-700 dark:text-violet-400", op.IsPrimary), templ.KV("bg-surface-subtle text-text-body", !op.IsPrimary) }>{ op.Index }</span>
							</td>
							<td class="px-4 py-3">
								<div class="flex items-center gap-2">
									<span class="text-sm font-medium text-text-primary">{ op.Type }</span>
									if op.IsSoroban {
										@components.TypeBadge("Soroban", "violet")
									}
								</div>
								if op.Contract != "" {
									<div class="flex items-center gap-1.5 mt-0.5 text-xs">
										if op.ContractFull != "" {
											<a href={ templ.SafeURL("/contracts/" + op.ContractFull) } class="font-mono text-emerald-700 hover:text-emerald-800">{ op.Contract }</a>
										} else {
											<span class="font-mono text-text-muted">{ op.Contract }</span>
										}
										if op.Function != "" {
											<span class="text-text-muted">&middot;</span>
											<span class="font-mono text-violet-600">{ op.Function }</span>
										}
									</div>
								}
							</td>
							<td class="px-4 py-3 text-sm text-text-strong">
								@templ.Raw(op.SummaryHTML)
							</td>
							<td class="px-4 py-3 text-right hidden md:table-cell">
								<span class="rounded bg-emerald-50 dark:bg-emerald-950/30 px-1.5 py-0.5 text-2xs font-bold text-emerald-700 dark:text-emerald-400">{ op.Status }</span>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

// TxEvents renders the events table.
templ TxEvents(events []pages.TxEvent) {
	<div id="tx-events" class="anim d2 mb-8">
		<h3 class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-2">Events</h3>
		<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden">
			<table class="w-full text-left">
				<thead>
					<tr class="text-2xs font-mono text-text-muted uppercase tracking-widest bg-surface-subtle">
						<th class="px-5 py-3 font-medium w-8 hidden md:table-cell">#</th>
						<th class="px-4 py-3 font-medium w-20">Type</th>
						<th class="px-4 py-3 font-medium w-[130px] hidden md:table-cell">Contract</th>
						<th class="px-4 py-3 font-medium">Data</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-border-subtle">
					for _, evt := range events {
						<tr>
							<td class="px-5 py-3 hidden md:table-cell">
								<span class="text-2xs font-mono text-text-muted">{ evt.Index }</span>
							</td>
							<td class="px-4 py-3">
								@components.TypeBadge(evt.Type, evt.TypeColor)
							</td>
							<td class="px-4 py-3 hidden md:table-cell">
								if evt.ContractFull != "" {
									<a href={ templ.SafeURL("/contracts/" + evt.ContractFull) } class="font-mono text-xs text-emerald-700 hover:text-emerald-800">{ evt.Contract }</a>
								} else {
									<span class="text-xs text-text-strong">{ evt.Contract }</span>
								}
							</td>
							<td class="px-4 py-3 text-sm">
								@templ.Raw(evt.DataHTML)
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

// TxBalanceChanges renders the net balance changes table.
templ TxBalanceChanges(changes []pages.TxBalanceChange) {
	<div id="tx-balance-changes" class="anim d3 mb-8">
		<h3 class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-2">Net Balance Changes</h3>
		<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden">
			<table class="w-full text-left">
				<thead>
					<tr class="text-2xs font-mono text-text-muted uppercase tracking-widest bg-surface-subtle">
						<th class="px-5 py-3 font-medium">Account</th>
						<th class="px-4 py-3 font-medium text-right">Asset</th>
						<th class="px-4 py-3 font-medium text-right hidden md:table-cell">Type</th>
						<th class="px-4 py-3 font-medium text-right">Change</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-border-subtle">
					for _, bc := range changes {
						<tr class={ templ.KV("opacity-60", bc.IsFee || bc.IsPool) }>
							<td class="px-5 py-2.5">
								if bc.AccountFull != "" {
									<a href={ templ.SafeURL("/account/" + bc.AccountFull) } class="font-mono text-xs text-emerald-700 hover:text-emerald-800">{ bc.Account }</a>
								} else {
									<span class="font-mono text-xs text-text-primary">{ bc.Account }</span>
								}
							</td>
							<td class="px-4 py-2.5 text-right">
								<span class="text-sm font-medium text-text-primary">{ bc.Asset }</span>
							</td>
							<td class="px-4 py-2.5 text-right hidden md:table-cell">
								@components.Badge(bc.AssetType, bc.TypeColor)
							</td>
							<td class="px-4 py-2.5 text-right">
								if bc.IsPositive {
									<span class="font-mono text-sm font-semibold text-emerald-600 tabular">{ bc.Change }</span>
								} else {
									<span class="font-mono text-sm font-semibold text-red-600 tabular">{ bc.Change }</span>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

// TxStateChanges renders the Soroban state changes table.
templ TxEffects(effects []pages.TxEffect) {
	<div id="tx-effects" class="anim d3 mb-8">
		<h3 class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-2">Effects</h3>
		<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden">
			if len(effects) == 0 {
				<div class="px-5 py-8 text-center text-sm text-text-muted">No effects available for this transaction</div>
			} else {
				<table class="w-full text-left">
					<thead>
						<tr class="text-2xs font-mono text-text-muted uppercase tracking-widest bg-surface-subtle">
							<th class="px-5 py-3 font-medium w-8">#</th>
							<th class="px-4 py-3 font-medium w-36">Effect</th>
							<th class="px-4 py-3 font-medium">Detail</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-border-subtle">
						for _, eff := range effects {
							<tr class="group hover:bg-surface-subtle transition-colors">
								<td class="px-5 py-3">
									<span class="font-mono text-xs text-text-muted tabular">{ eff.Index }</span>
								</td>
								<td class="px-4 py-3">
									@components.Badge(eff.TypeDisplay, eff.TypeColor)
								</td>
								<td class="px-4 py-3">
									<span class="text-xs text-text-body">
										@templ.Raw(eff.SummaryHTML)
									</span>
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
	</div>
}

// TxTimeline renders the "What Happened" unified timeline.
templ TxTimeline(items []pages.TxTimelineItem) {
	<div id="tx-timeline" class="anim d2 mb-8">
		<h3 class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-2">What happened</h3>
		<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden">
			if len(items) == 0 {
				<div class="px-5 py-8 text-center text-sm text-text-muted">No timeline data available</div>
			} else {
				<div class="flex flex-col px-5 py-4">
					for _, item := range items {
						<div class="grid grid-cols-[32px_1fr] gap-x-3">
							<!-- Spine: dot + connecting line -->
							<div class="flex flex-col items-center">
								<div class={ "w-2.5 h-2.5 rounded-full mt-1.5 flex-shrink-0", tlDotClass(item.DotColor) }></div>
								if !item.IsLast {
									<div class="w-px flex-1 bg-border-default my-1 min-h-[16px]"></div>
								}
							</div>
							<!-- Content -->
							<div class="pb-5">
								<div class="flex items-center gap-2 flex-wrap mb-1">
									@tlBadge(item.BadgeLabel, item.BadgeColor)
									if item.Contract != "" {
										<span class="font-mono text-2xs bg-surface-subtle border border-border-default rounded px-1.5 py-0.5 text-text-muted">{ item.Contract }</span>
									}
								</div>
								<div class="text-sm text-text-primary leading-relaxed">
									@templ.Raw(item.SummaryHTML)
								</div>
								if item.ContextLine != "" {
									<div class="text-xs text-text-muted mt-0.5">{ item.ContextLine }</div>
								}
							</div>
						</div>
					}
				</div>
			}
		</div>
	</div>
}

templ tlBadge(label string, color string) {
	<span class={ "inline-flex items-center rounded-full px-2 py-0.5 text-2xs font-semibold ring-1", tlBadgeClass(color) }>
		{ label }
	</span>
}

func tlDotClass(color string) string {
	switch color {
	case "blue":
		return "bg-blue-100 dark:bg-blue-900/40 border-2 border-blue-500"
	case "green":
		return "bg-emerald-100 dark:bg-emerald-900/40 border-2 border-emerald-500"
	case "red":
		return "bg-red-100 dark:bg-red-900/40 border-2 border-red-500"
	default:
		return "bg-gray-100 dark:bg-surface-subtle border-2 border-gray-300 dark:border-border-default"
	}
}

func tlBadgeClass(color string) string {
	switch color {
	case "cyan":
		return "bg-cyan-50 dark:bg-cyan-950/30 text-cyan-700 dark:text-cyan-400 ring-cyan-200 dark:ring-cyan-800"
	case "emerald":
		return "bg-emerald-50 dark:bg-emerald-950/30 text-emerald-700 dark:text-emerald-400 ring-emerald-200 dark:ring-emerald-800"
	case "red":
		return "bg-red-50 dark:bg-red-950/30 text-red-700 dark:text-red-400 ring-red-200 dark:ring-red-800"
	case "violet":
		return "bg-violet-50 dark:bg-violet-950/30 text-violet-700 dark:text-violet-400 ring-violet-200 dark:ring-violet-800"
	default:
		return "bg-surface-subtle text-text-muted ring-border-default"
	}
}

templ TxStateChanges(changes []pages.TxStateChange) {
	<div id="tx-state-changes" class="anim d3 mb-8">
		<h3 class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-2">Soroban State Changes</h3>
		<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden">
			<table class="w-full text-left">
				<thead>
					<tr class="text-2xs font-mono text-text-muted uppercase tracking-widest bg-surface-subtle">
						<th class="px-5 py-3 font-medium w-20">Action</th>
						<th class="px-4 py-3 font-medium">Key</th>
						<th class="px-4 py-3 font-medium hidden md:table-cell">Contract</th>
						<th class="px-4 py-3 font-medium">Detail</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-border-subtle">
					for _, sc := range changes {
						<tr>
							<td class="px-5 py-3">
								@components.Badge(sc.Action, "amber")
							</td>
							<td class="px-4 py-3">
								<span class="font-mono text-xs text-text-primary">{ sc.Key }</span>
							</td>
							<td class="px-4 py-3 hidden md:table-cell">
								if strings.HasPrefix(sc.Contract, "C") {
									<a href={ templ.SafeURL("/contracts/" + sc.Contract) } class="font-mono text-xs text-emerald-700 hover:text-emerald-800">{ sc.Contract }</a>
								} else {
									<span class="text-xs text-text-strong">{ sc.Contract }</span>
								}
							</td>
							<td class="px-4 py-3 font-mono text-xs text-text-body">
								@templ.Raw(sc.DetailHTML)
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}
