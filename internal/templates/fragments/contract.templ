package fragments

import (
	"github.com/withObsrvr/prism/internal/templates/components"
	"github.com/withObsrvr/prism/internal/templates/pages"
)

// ContractInfo renders the contract info key-value section.
templ ContractInfo(data pages.ContractDetailData) {
	<div id="contract-info" class="anim d1 mb-8">
		<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden text-sm">
			<div class="detail-row flex items-center px-5 py-2.5 border-b border-border-subtle">
				<span class="w-32 text-text-muted flex-shrink-0">Creator</span>
				if data.CreatorHref != "" && data.Creator != "" {
					<a href={ templ.SafeURL(data.CreatorHref) } class="font-mono text-xs text-emerald-700 hover:text-emerald-800 ml-4">{ data.Creator }</a>
				} else {
					<span class="ml-4 text-text-body">—</span>
				}
			</div>
			<div class="detail-row flex items-center px-5 py-2.5 border-b border-border-subtle">
				<span class="w-32 text-text-muted flex-shrink-0">WASM</span>
				<div class="flex items-center gap-2 ml-4">
					<span class="font-mono text-xs text-text-body">{ data.WASMHash }</span>
					@components.CopyButton(data.WASMHash)
					<span class="text-text-muted">&middot;</span>
					<span class="text-text-body">{ data.WASMSize }</span>
				</div>
			</div>
			<div class="detail-row flex items-center px-5 py-2.5 border-b border-border-subtle">
				<span class="w-32 text-text-muted flex-shrink-0">Storage</span>
				<span class="ml-4">{ data.StorageEntries } entries</span>
				<span class="text-text-muted ml-2">&middot;</span>
				<span class="text-text-body ml-2">{ data.StateSize }</span>
				<span class="text-text-muted ml-2">&middot;</span>
				<span class="text-text-body ml-2">{ data.MonthlyRent }/mo rent</span>
			</div>
			<div class="detail-row flex items-center px-5 py-2.5">
				<span class="w-32 text-text-muted flex-shrink-0">Success Rate</span>
				<span class="font-semibold text-emerald-600 ml-4">{ data.SuccessRate }</span>
			</div>
		</div>
	</div>
}

// ContractFunctions renders the top functions table.
templ ContractFunctions(funcs []pages.ContractFunction) {
	<div id="contract-functions" class="anim d2 mb-8">
		<h3 class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-2">Top Functions</h3>
		if len(funcs) > 0 {
			<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden">
				<table class="w-full text-left">
					<thead>
						<tr class="text-2xs font-mono text-text-muted uppercase tracking-widest bg-surface-subtle">
							<th class="px-5 py-3 font-medium">Function</th>
							<th class="px-4 py-3 font-medium text-right">24h</th>
							<th class="px-4 py-3 font-medium text-right hidden md:table-cell">7d</th>
							<th class="px-4 py-3 font-medium text-right hidden md:table-cell">30d</th>
							<th class="px-4 py-3 font-medium text-right hidden md:table-cell">Success</th>
							<th class="px-4 py-3 font-medium text-right hidden lg:table-cell">Avg CPU</th>
							<th class="px-4 py-3 font-medium text-right hidden lg:table-cell">Last Called</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-border-subtle">
						for _, f := range funcs {
							<tr class="hover:bg-surface-subtle transition-colors">
								<td class="px-5 py-3 align-top">
									<span class="font-mono text-sm font-medium text-violet-600">{ f.Name }()</span>
									if f.Category != "" {
										<div class="mt-1 text-2xs uppercase tracking-wider text-text-muted">{ f.Category }</div>
									}
									if f.Description != "" {
										<div class="mt-1 text-2xs leading-5 text-text-body">{ f.Description }</div>
									}
								</td>
								<td class="px-4 py-3 text-right font-mono text-sm text-text-primary tabular align-top">{ f.Calls24h }</td>
								<td class="px-4 py-3 text-right font-mono text-sm text-text-strong tabular hidden md:table-cell align-top">{ f.Calls7d }</td>
								<td class="px-4 py-3 text-right font-mono text-sm text-text-strong tabular hidden md:table-cell align-top">{ f.Calls30d }</td>
								<td class="px-4 py-3 text-right text-sm text-emerald-600 tabular hidden md:table-cell align-top">{ f.SuccessRate }</td>
								<td class="px-4 py-3 text-right font-mono text-xs text-text-body hidden lg:table-cell align-top">{ f.AvgCPU }</td>
								<td class="px-4 py-3 text-right text-xs text-text-body hidden lg:table-cell align-top">{ f.LastCalled }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		} else {
			<div class="rounded-xl border border-border-default bg-surface-card px-5 py-4 shadow-sm">
				<div class="text-sm font-medium text-text-primary">No function data available.</div>
				<div class="mt-1 text-xs leading-5 text-text-body">Prism did not receive top-function rows for this contract on the selected network.</div>
			</div>
		}
	</div>
}

// ContractInvocations renders the recent invocations table.
templ ContractInvocations(invocations []pages.ContractInvocation) {
	<div id="contract-invocations" class="anim d2 mb-8">
		<h3 class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-2">Recent Invocations</h3>
		if len(invocations) > 0 {
			<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden">
				<table class="w-full text-left">
					<thead>
						<tr class="text-2xs font-mono text-text-muted uppercase tracking-widest bg-surface-subtle">
							<th class="px-5 py-3 font-medium">Tx</th>
							<th class="px-4 py-3 font-medium">Function</th>
							<th class="px-4 py-3 font-medium hidden md:table-cell">Caller</th>
							<th class="px-4 py-3 font-medium text-right">Status</th>
							<th class="px-4 py-3 font-medium text-right">Age</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-border-subtle">
						for _, inv := range invocations {
							<tr class="hover:bg-surface-subtle transition-colors">
								<td class="px-5 py-3 align-top">
									<a href={ templ.SafeURL("/tx/" + inv.TxHash) } class="font-mono text-xs text-emerald-700 hover:text-emerald-800">{ inv.ShortHash }</a>
								</td>
								<td class="px-4 py-3 align-top">
									<span class="font-mono text-xs text-violet-600">{ inv.Function }()</span>
									if inv.Summary != "" {
										<div class="mt-1 text-2xs leading-5 text-text-body">{ inv.Summary }</div>
									}
								</td>
								<td class="px-4 py-3 hidden md:table-cell align-top"><span class="font-mono text-xs text-text-body">{ inv.Caller }</span></td>
								<td class="px-4 py-3 text-right align-top">
									@components.Badge(inv.Status, inv.StatusColor)
								</td>
								<td class="px-4 py-3 text-right text-xs text-text-body align-top">{ inv.Age }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		} else {
			<div class="rounded-xl border border-border-default bg-surface-card px-5 py-4 shadow-sm">
				<div class="text-sm font-medium text-text-primary">No recent invocations available.</div>
				<div class="mt-1 text-xs leading-5 text-text-body">Prism did not receive recent invocation rows for this contract on the selected network.</div>
			</div>
		}
	</div>
}
