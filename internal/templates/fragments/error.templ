package fragments

// FragmentError renders an inline error with a retry button.
// retryURL is the fragment endpoint to retry via hx-get.
templ FragmentError(message string, retryURL string) {
	<div class="flex flex-col items-center justify-center py-8 gap-2">
		<div class="flex items-center gap-2 text-sm text-text-muted">
			<svg class="h-4 w-4 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
			</svg>
			<span>{ message }</span>
		</div>
		if retryURL != "" {
			<button
				hx-get={ retryURL }
				hx-swap="outerHTML"
				hx-target="closest div"
				class="text-xs font-medium text-emerald-600 hover:text-emerald-500 transition-colors"
			>
				Try again
			</button>
		}
	</div>
}
