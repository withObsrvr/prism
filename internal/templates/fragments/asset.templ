package fragments

import (
	"fmt"
	"github.com/withObsrvr/prism/internal/templates/components"
	"github.com/withObsrvr/prism/internal/templates/pages"
)

// AssetTable renders the asset directory table with pagination.
templ AssetTable(data pages.AssetDirectoryData) {
	<div id="asset-table">
		<div class="anim d2 bg-surface-card rounded-xl overflow-hidden shadow-sm border border-border-default">
			<table class="w-full text-left">
				<thead>
					<tr class="text-2xs font-mono text-text-muted uppercase tracking-widest bg-surface-subtle">
						<th class="px-6 py-3.5 font-medium">Asset</th>
						<th class="px-4 py-3.5 font-medium hidden md:table-cell">Type</th>
						<th class="px-4 py-3.5 font-medium hidden lg:table-cell">Issuer</th>
						<th class="px-4 py-3.5 font-medium text-right hidden lg:table-cell">Supply</th>
						<th class="px-4 py-3.5 font-medium text-right hidden md:table-cell">Holders</th>
						<th class="px-4 py-3.5 font-medium text-right">24h Volume</th>
						<th class="px-4 py-3.5 font-medium text-right hidden md:table-cell">Change</th>
						<th class="px-6 py-3.5 w-8"></th>
					</tr>
				</thead>
				<tbody class="divide-y divide-border-subtle">
					for _, a := range data.Assets {
						<tr class="group hover:bg-surface-subtle transition-colors cursor-pointer"
							hx-get={ "/assets/" + a.Code + "/preview" }
							hx-target="#slideout"
							hx-swap="innerHTML">
							<td class="px-6 py-4">
								<div class="flex items-center gap-3">
									<div class={ "flex h-10 w-10 items-center justify-center rounded-full text-white text-sm font-bold flex-shrink-0", a.BgColor }>{ a.Initial }</div>
									<div>
										<div class="flex items-center gap-1.5">
											<span class="font-bold text-text-primary">{ a.Code }</span>
											if a.IsVerified {
												<svg class="h-4 w-4 text-emerald-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
											}
										</div>
										<div class="text-2xs text-text-muted">{ a.Name }</div>
									</div>
								</div>
							</td>
							<td class="px-4 py-4 hidden md:table-cell">
								@components.TypeBadge(a.TypeBadge, a.TypeColor)
							</td>
							<td class="px-4 py-4 hidden lg:table-cell">
								<span class="font-mono text-xs text-text-muted">{ a.Issuer }</span>
							</td>
							<td class="px-4 py-4 text-right hidden lg:table-cell">
								<span class="font-mono text-sm text-text-strong tabular">{ a.Supply }</span>
							</td>
							<td class="px-4 py-4 text-right hidden md:table-cell">
								<span class="font-mono text-sm text-text-strong tabular">{ a.Holders }</span>
							</td>
							<td class="px-4 py-4 text-right">
								<span class="font-mono text-sm font-semibold text-emerald-600 tabular">{ a.Volume }</span>
							</td>
							<td class="px-4 py-4 text-right hidden md:table-cell">
								if a.IsUp {
									<span class="text-xs font-semibold text-emerald-600 tabular">{ a.Change }</span>
								} else {
									<span class="text-xs font-semibold text-red-500 tabular">{ a.Change }</span>
								}
							</td>
							<td class="px-6 py-4 text-right">
								<svg class="h-4 w-4 text-text-muted opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>

		<!-- Pagination -->
		<div class="anim d3 mt-6 flex flex-col md:flex-row justify-between items-center gap-4">
			<div class="text-sm text-text-body">
				Showing <span class="font-semibold text-text-primary">1–{ fmt.Sprintf("%d", len(data.Assets)) }</span> of <span class="font-semibold text-text-primary">{ data.TotalAssets }</span> assets
			</div>
			@components.Pagination(data.CurrentPage, data.TotalPages, "/assets")
		</div>
	</div>
}
