package pagesv2

import (
	"fmt"
	vmv2 "github.com/withObsrvr/prism/internal/templates/v2/viewmodel"
)

templ HomeInsights(data vmv2.HomeInsightsData) {
	<section class={ "ph-home-deferred", "is-" + string(data.Status.State) } id="changes" aria-labelledby="ph-home-changes-title" aria-live="off" hx-get={ data.PollURL } hx-trigger="every 60s" hx-swap="outerHTML">
		@homeEvidenceHeading("changes", "What changed", "Compared with a typical hour")
		@homeEvidenceState(data.Status, data.PollURL, "changes", data.DemoData)
		if len(data.Cards) > 0 {
			<div class={ "ph-insight-list", fmt.Sprintf("has-%d", len(data.Cards)) }>
				for _, card := range data.Cards {
					<article class={ "ph-insight", "is-" + card.Tone }>
						<div class="ph-insight-main">
							<div class="ph-insight-signal"><span class={ "ph-signal-dot", "is-" + card.Tone }></span><span>{ homeInsightToneLabel(card.Tone, card.Generic) }</span></div>
							<h3>{ card.Title }</h3>
							<p class="ph-insight-summary">{ card.Summary }</p>
							if card.Detail != "" {
								<p class="ph-insight-detail">{ card.Detail }</p>
							}
							if card.SubjectHref != "" {
								<div class="ph-evidence-subject">
									<span>Subject</span>
									<a href={ templ.SafeURL(card.SubjectHref) }>{ card.SubjectLabel }</a>
									if card.IdentityDetail != "" {
										<small>{ card.IdentityDetail }</small>
									}
								</div>
							}
						</div>
						<div class="ph-insight-proof">
							if len(card.Metrics) > 0 {
								<dl class="ph-insight-facts">
									for _, metric := range card.Metrics {
										<div><dt>{ metric.Label }</dt><dd>{ metric.Value }</dd></div>
									}
								</dl>
							}
							<div class="ph-insight-actions">
								for _, link := range card.Evidence {
									<a class="ph-evidence-link" href={ templ.SafeURL(link.Href) }>{ link.Label } <span aria-hidden="true">→</span></a>
								}
								if len(card.Caveats) > 0 {
									<details class="ph-insight-coverage">
										<summary>Coverage note</summary>
										<ul>
											for _, caveat := range card.Caveats {
												<li>{ caveat }</li>
											}
										</ul>
									</details>
								}
							</div>
						</div>
					</article>
				}
			</div>
		}
	</section>
}

templ HomeTTL(data vmv2.HomeTTLData) {
	<section class={ "ph-home-deferred", "is-" + string(data.Status.State) } id="archival" aria-labelledby="ph-home-archival-title" aria-live="off" hx-get={ data.PollURL } hx-trigger="every 60s" hx-swap="outerHTML">
		@homeEvidenceHeading("archival", "Contract data expiring soon", "")
		<div class="ph-evidence-status-slot">@homeEvidenceState(data.Status, data.PollURL, "archival", data.DemoData)</div>
		if len(data.Cards) > 0 {
			<div class="ph-evidence-rows">
				<div class="ph-ttl-columns" aria-hidden="true"><span>Contract</span><span>Expires in</span></div>
				for _, card := range data.Cards {
					<a class={ "ph-evidence-row", "is-" + card.Tone } href={ templ.SafeURL(card.Href) } aria-label={ card.Name + ", " + card.RunwayLabel }>
						<div class="ph-evidence-row-primary">
							if card.ShowContractID {
								<h3 title={ card.Name }>{ card.Name }</h3>
								<code title={ card.ContractID }>{ card.ContractLabel }</code>
							} else {
								<h3><code class="ph-primary-id" title={ card.ContractID }>{ card.ContractLabel }</code></h3>
							}
						</div>
						<div class="ph-evidence-row-measure">
							<strong>{ card.RunwayLabel }</strong>
							if card.LiveUntilLedger != "" {
								<span>Until ledger { card.LiveUntilLedger }</span>
							}
						</div>
					</a>
				}
			</div>
		}
	</section>
}

templ HomeLeaders(data vmv2.HomeLeadersData) {
	<section class={ "ph-home-deferred", "is-" + string(data.Status.State) } id="contracts" aria-labelledby="ph-home-contracts-title" aria-live="off" hx-get={ data.PollURL } hx-trigger="every 60s" hx-swap="outerHTML">
		@homeEvidenceHeading("contracts", "Busiest contracts, 24h", "")
		<div class="ph-evidence-status-slot">@homeEvidenceState(data.Status, data.PollURL, "contracts", data.DemoData)</div>
		if len(data.Cards) > 0 {
			<ol class="ph-leader-list">
				<li class="ph-leader-columns" aria-hidden="true"><span></span><span>Contract</span><span>Calls</span><span>Failed</span><span>Callers / top function</span></li>
				for index, card := range data.Cards {
					<li>
						<a class="ph-leader-row" href={ templ.SafeURL(card.Href) } aria-label={ card.Name + ", " + card.CallCount + " calls, " + card.FailureLabel }>
							<span class="ph-leader-rank">{ fmt.Sprintf("%02d", index + 1) }</span>
							<div class="ph-leader-identity">
								if card.ShowContractID {
									<h3 title={ card.Name }>{ card.Name }</h3><code title={ card.ContractID }>{ card.ContractLabel }</code>
								} else {
									<h3><code class="ph-primary-id" title={ card.ContractID }>{ card.ContractLabel }</code></h3>
								}
							</div>
							<div class="ph-leader-measure"><strong>{ card.CallCount }</strong><span>calls</span></div>
							<strong class={ "ph-leader-failure", "is-" + card.FailureTone }>{ card.FailureLabel }</strong>
							<div class="ph-leader-context">
								<span>{ card.CallerCount } { card.CallerUnit }</span>
								if card.TopFunction != "" {
									<span>Top <code>{ card.TopFunction }</code></span>
								}
							</div>
						</a>
					</li>
				}
			</ol>
		}
	</section>
}

templ HomeUtilization(data vmv2.HomeUtilizationData) {
	<section class={ "ph-home-deferred", "is-" + string(data.Status.State) } id="utilization" aria-labelledby="ph-home-utilization-title" aria-live="off" hx-get={ data.PollURL } hx-trigger="every 30s" hx-swap="outerHTML">
		@homeEvidenceHeading("utilization", "Smart contract capacity", "")
		@homeEvidenceState(data.Status, data.PollURL, "utilization", data.DemoData)
		if len(data.Metrics) > 0 {
			<div class="ph-utilization-list">
				for _, metric := range data.Metrics {
					<article class={ "ph-utilization-row", "is-" + metric.State }>
						<div class="ph-utilization-heading"><h3>{ metric.Label }</h3><strong>{ metric.PercentLabel }</strong></div>
						<div class="ph-utilization-meter" role="img" aria-label={ metric.Label + " at " + metric.PercentLabel }><span style={ metric.BarStyle }></span></div>
						<div class="ph-utilization-values"><span>{ metric.UsedLabel }</span><span>{ metric.LimitLabel }</span></div>
					</article>
				}
			</div>
		}
	</section>
}

templ homeEvidenceHeading(id string, title string, scope string) {
	<div class="ph-home-deferred-heading">
		<h2 id={ "ph-home-" + id + "-title" }>{ title }</h2>
		if scope != "" {
			<span>{ scope }</span>
		}
	</div>
}

templ homeEvidenceState(status vmv2.HomeSectionStatus, pollURL string, targetID string, demo bool) {
	if demo {
		<div class="ph-inline-state is-demo"><strong>Demo</strong><span>Synthetic fixture, not network activity.</span></div>
	}
	if len(status.Warnings) > 0 {
		<details class={ "ph-evidence-health", "is-" + string(status.State) }>
			<summary>{ homeEvidenceStateLabel(status.State) }</summary>
			<div role="status">
				for _, warning := range status.Warnings {
					<span>{ warning }</span>
				}
			</div>
		</details>
	} else if status.Message != "" {
		<div class={ "ph-inline-state", "is-" + string(status.State) } role="status">
			if status.State != vmv2.HomeSectionEmpty {
				<strong>{ homeEvidenceStateLabel(status.State) }</strong>
			}
			<span>{ status.Message }</span>
		</div>
	}
	if status.State == vmv2.HomeSectionUnavailable && status.Retryable {
		<button class="ph-inline-retry" type="button" hx-get={ pollURL } hx-target={ "#" + targetID } hx-swap="outerHTML">Retry</button>
	}
}

func homeEvidenceStateLabel(state vmv2.HomeSectionState) string {
	switch state {
	case vmv2.HomeSectionPartial: return "Limited"
	case vmv2.HomeSectionStale: return "Delayed"
	case vmv2.HomeSectionEmpty: return "No changes"
	case vmv2.HomeSectionUnavailable: return "Unavailable"
	default: return "Live evidence"
	}
}

func homeInsightToneLabel(tone string, generic bool) string {
	if generic { return "Measured evidence" }
	switch tone {
	case "critical": return "Failure signal"
	case "signal": return "Deployment signal"
	case "info": return "Activity signal"
	default: return "Measured evidence"
	}
}
