package pagesv2

import (
	"net/url"
	"strings"
	layoutsv2 "github.com/withObsrvr/prism/internal/templates/v2/layouts"
	componentsv2 "github.com/withObsrvr/prism/internal/templates/v2/components"
	vmv2 "github.com/withObsrvr/prism/internal/templates/v2/viewmodel"
)

templ Explore(data vmv2.ExploreData) {
	@layoutsv2.Base("Explore activity: Prism") {
		@componentsv2.MainHeader("explore", data.Header.Network) {
			@ExploreHeartbeat(data.Header, data.Loading)
		}
		@componentsv2.Breadcrumbs([]componentsv2.Crumb{{Label: "Explorer", Href: "/v2/home"}, {Label: "Explore"}})
		@ExploreMain(data)
	}
}

templ ExploreHeartbeat(data vmv2.ExploreHeaderData, loading bool) {
	<div id="px-ex-heartbeat" class="ph-heartbeat" hx-get="/v2/explore/header" hx-trigger={ exploreHeartbeatTrigger(loading) } hx-swap="outerHTML">
		<span class="dot"></span><span>live</span><span class="sep">·</span><span>ledger <b>{ exploreHeartbeatLedger(data, loading) }</b></span><span class="sep">·</span><span>{ exploreHeartbeatAge(data, loading) }</span>
	</div>
}

templ ExploreMain(data vmv2.ExploreData) {
	<main class="px-ex-app" id="main-content"
		if data.Loading {
			hx-get={ data.LiveHref } hx-trigger="load" hx-swap="outerHTML"
		}
	>
		<section class="px-ex-control" aria-labelledby="explore-title">
				<div class="px-ex-summary">
					<div class="px-ex-summary-kicker">Query builder</div>
					<h1 id="explore-title">@templ.Raw(data.Summary.SentenceHTML)</h1>
					<div class="px-ex-summary-meta"><span><b>{ data.Summary.MatchedLabel }</b> matched</span><span>{ data.Summary.WindowLabel }</span><span>{ data.Summary.LedgerRange }</span><span>{ data.Summary.EvidenceLabel }</span>
						if strings.TrimSpace(data.Summary.EventsPerSec) != "" {
							<span>{ data.Summary.EventsPerSec } events/s</span>
						}
						if hasExploreFilters(data.Filters) {
							<a class="px-ex-clear" href="/v2/explore">Clear filters</a>
						}
					</div>
					if hasExploreFilters(data.Filters) {
						<div class="px-ex-chips" aria-label="Active filters">
							@exploreFilterChip("scope", data.Filters.Scope, data.Filters)
							@exploreFilterChip("topic", data.Filters.Topic, data.Filters)
							@exploreFilterChip("fn", data.Filters.Fn, data.Filters)
							@exploreFilterChip("asset", data.Filters.Asset, data.Filters)
							@exploreFilterChip("time", data.Filters.Time, data.Filters)
							@exploreFilterChip("status", data.Filters.Status, data.Filters)
							@exploreFilterChip("q", data.Filters.Q, data.Filters)
						</div>
					}
				</div>
				<form class="px-ex-form" action="/v2/explore" method="GET" data-explore-query-form>
					<label class="px-ex-search"><span>Search events</span><input type="search" name="q" value={ data.Filters.Q } placeholder="Contract, tx hash, topic, protocol, or event text" autocomplete="off"/><button type="submit">Run</button></label>
					<div class="px-ex-filter-grid">
						@exploreSelect("Scope", "scope", data.Filters.Scope, []exploreOption{{"all", "All worlds"}, {"soroban", "Soroban"}, {"classic", "Classic"}})
						@exploreSelect("Topic", "topic", data.Filters.Topic, []exploreOption{{"", "Any topic"}, {"transfer", "Transfer"}, {"swap", "Swap"}, {"mint", "Mint"}, {"burn", "Burn"}, {"approve", "Approve"}, {"deposit", "Deposit"}, {"withdraw", "Withdraw"}, {"custom", "Custom"}})
						<label class="px-ex-field"><span>Function</span><input name="fn" value={ data.Filters.Fn } placeholder="swap, approve, submit"/></label>
						<label class="px-ex-field"><span>Asset</span><input name="asset" value={ data.Filters.Asset } placeholder="USDC, XLM, EURC"/></label>
						@exploreSelect("Time", "time", data.Filters.Time, []exploreOption{{"1h", "Last hour"}, {"24h", "Last 24 hours"}, {"7d", "Last 7 days"}, {"30d", "Last 30 days"}})
						@exploreSelect("Status", "status", data.Filters.Status, []exploreOption{{"", "Any status"}, {"success", "Successful"}, {"failed", "Failed"}})
					</div>
				</form>
			</section>
			<section class="px-ex-presets" aria-label="Explore presets">
				for _, preset := range data.Presets {
					<a class="px-ex-preset" href={ templ.SafeURL(preset.Href) }><strong>{ preset.Name }</strong><span>{ preset.Body }</span></a>
				}
			</section>
			if data.Loading {
				<div class="px-ex-notice" role="status"><strong>Loading live evidence.</strong><span>The query shell is ready while Prism fetches matching activity.</span></div>
			} else if strings.TrimSpace(data.ErrorMessage) != "" {
				<div class="px-ex-notice" role="status"><strong>Live data unavailable.</strong><span>{ data.ErrorMessage }</span></div>
			}
			<section class="px-ex-results" aria-labelledby="results-title">
				<div class="px-ex-results-head"><div><div class="px-ex-summary-kicker">Evidence</div><h2 id="results-title">Recent matching activity</h2></div><div class="px-ex-source"><span class={ "dot", templ.KV("mock", !data.SourceLive) }></span>
					if data.Loading {
						<span>Loading gateway</span>
					} else if data.SourceLive {
						<span>Live gateway</span>
					} else {
						<span>Design fallback</span>
					}
				</div></div>
				if len(data.Rows) == 0 {
					@exploreEmpty(data.Filters)
				} else {
					<div class="px-ex-table" role="table" aria-label="Matching activity"><div class="px-ex-thead" role="row"><span>When</span><span>Meaning</span><span>Protocol</span><span>Evidence</span><span>Status</span></div>
						for _, row := range data.Rows {
							@exploreRow(row)
						}
					</div>
				}
				if data.HasMore {
					<a class="px-ex-more" href={ templ.SafeURL(data.NextHref) }>Load the next page</a>
				}
			</section>
		@exploreQueryScript()
		</main>
}

type exploreOption struct { Value string; Label string }

templ exploreSelect(label string, name string, value string, options []exploreOption) {
	<label class="px-ex-field">
		<span>{ label }</span>
		<select name={ name }>
			for _, option := range options {
				<option value={ option.Value } selected?={ option.Value == value }>{ option.Label }</option>
			}
		</select>
	</label>
}

templ exploreRow(row vmv2.ExploreRow) {
	<a class="px-ex-row" role="row" href={ templ.SafeURL(row.EvidenceHref) }>
		<span class="px-ex-time" role="cell"><b>{ row.When }</b><small>{ row.Age }</small></span>
		<span class="px-ex-meaning" role="cell"><strong>{ row.Headline }</strong><small><span class={ "px-ex-topic", exploreTopicClass(row.Topic) }>{ exploreLabel(row.Topic, "event") }</span> from <code>{ exploreShort(row.From) }</code></small></span>
		<span class="px-ex-protocol" role="cell"><b>{ exploreLabel(row.Protocol, "Unknown") }</b><small>{ exploreLabel(row.Function, exploreLabel(row.Asset, "contract event")) }</small></span>
		<span class="px-ex-evidence" role="cell"><code>{ exploreShort(row.TxHash) }</code><small>Ledger { row.Ledger } · { exploreEventLabel(row.Events) }</small></span>
		<span class={ "px-ex-status", row.StatusTone } role="cell">{ row.Status }</span>
	</a>
}

templ exploreEmpty(filters vmv2.ExploreFilters) {
	<div class="px-ex-empty"><h3>No matching activity yet</h3><p>Relax one filter or broaden the time window. Prism keeps the query sentence intact so you can adjust without starting over.</p><a href="/v2/explore">Show all recent activity</a></div>
}

templ exploreQueryScript() { <script>(function(){var form=document.querySelector('[data-explore-query-form]');if(!form||form.dataset.bound==='true')return;form.dataset.bound='true';function target(){var fd=new FormData(form);var q=new URLSearchParams();function set(k,skip){var v=String(fd.get(k)||'').trim();if(!v||v===skip)return;q.set(k,v);}set('scope','all');set('topic','');set('fn','');set('asset','');set('time','1h');set('status','');set('q','');var s=q.toString();return form.action+(s?'?'+s:'');}form.addEventListener('submit',function(e){e.preventDefault();window.location.assign(target());});form.querySelectorAll('select').forEach(function(el){el.addEventListener('change',function(){window.location.assign(target());});});})();</script> }

templ exploreFilterChip(key string, value string, filters vmv2.ExploreFilters) {
	if shouldShowExploreChip(key, value) {
		<a class="px-ex-chip" href={ templ.SafeURL(exploreRemoveFilterHref(key, filters)) }><span>{ key }</span>{ value }<b>×</b></a>
	}
}

func exploreHeartbeatTrigger(loading bool) string { if loading { return "load, every 5s" }; return "every 5s" }
func exploreHeartbeatLedger(data vmv2.ExploreHeaderData, loading bool) string { if loading { return "syncing" }; return data.LedgerNumber }
func exploreHeartbeatAge(data vmv2.ExploreHeaderData, loading bool) string { if loading { return "latest ledger" }; return data.AgeLabel }
func exploreEventLabel(count string) string { count = strings.TrimSpace(count); if count == "" { return "event" }; if count == "1" { return "1 event" }; return count + " events" }
func hasExploreFilters(f vmv2.ExploreFilters) bool { return strings.TrimSpace(f.Topic) != "" || strings.TrimSpace(f.Fn) != "" || strings.TrimSpace(f.Asset) != "" || strings.TrimSpace(f.Status) != "" || strings.TrimSpace(f.Q) != "" || (f.Scope != "" && f.Scope != "all") || (f.Time != "" && f.Time != "1h") }
func shouldShowExploreChip(key string, value string) bool { value = strings.TrimSpace(value); if value == "" { return false }; return !(key == "scope" && value == "all") && !(key == "time" && value == "1h") }
func exploreRemoveFilterHref(key string, f vmv2.ExploreFilters) string { v := url.Values{}; if f.Scope != "" && f.Scope != "all" && key != "scope" { v.Set("scope", f.Scope) }; if f.Topic != "" && key != "topic" { v.Set("topic", f.Topic) }; if f.Fn != "" && key != "fn" { v.Set("fn", f.Fn) }; if f.Asset != "" && key != "asset" { v.Set("asset", f.Asset) }; if f.Time != "" && f.Time != "1h" && key != "time" { v.Set("time", f.Time) }; if f.Status != "" && key != "status" { v.Set("status", f.Status) }; if f.Q != "" && key != "q" { v.Set("q", f.Q) }; if v.Encode() == "" { return "/v2/explore" }; return "/v2/explore?" + v.Encode() }
func exploreLabel(v string, fallback string) string { if strings.TrimSpace(v) != "" { return v }; return fallback }
func exploreShort(v string) string { v = strings.TrimSpace(v); if len(v) <= 12 { return exploreLabel(v, "unknown") }; return v[:6] + "…" + v[len(v)-4:] }
func exploreTopicClass(v string) string { switch strings.ToLower(v) { case "swap": return "swap"; case "transfer": return "transfer"; case "mint", "burn", "approve": return "token"; default: return "call" } }
