package pagesv2

import (
	"fmt"
	"net/url"
	"strings"

	legacy "github.com/withObsrvr/prism/internal/templates/pages"
	componentsv2 "github.com/withObsrvr/prism/internal/templates/v2/components"
	layoutsv2 "github.com/withObsrvr/prism/internal/templates/v2/layouts"
	ui "github.com/withObsrvr/prism/internal/viewmodel"
)

templ ContractDetail(data legacy.ContractDetailData, network string) {
	@layoutsv2.LedgerBase(data.Name + " — Prism") {
		@componentsv2.DetailHeader(data.Address, network)
		@componentsv2.Breadcrumbs([]componentsv2.Crumb{{Label: "Explorer", Href: "/v2/home"}, {Label: "Contracts", Href: "/contracts"}, {Label: cnShort(data.Address), Mono: true}})
		<div class="px-tx-page"><div class="px-tx-page-inner"><main class="px-tx-main">
			@contractIdentity(data)
			@contractTrustStrip(data)
			if data.BalanceFragmentHref != "" {
				@componentsv2.BalancePortfolioLoader(data.BalanceFragmentHref)
			} else {
				@componentsv2.BalancePortfolio(data.Portfolio)
			}
			@contractActivity(data)
			<section class="px-tx-detail" data-cn-tabs-root><div class="px-tx-detail-inner">
				<div class="px-tx-tabs" role="tablist" aria-label="Contract evidence">
					@contractTab("interface", "Interface", cnFirst(data.FunctionsCount, cnInterfaceCount(data)), true)
					@contractTab("calls", "Recent calls", cnRecentInvocationCount(data), false)
					@contractTab("storage", "Storage", cnStorageSampleCount(data), false)
					@contractTab("artifact", "WASM", "", false)
				</div>
				<div class="px-tx-detail-body">
					<div data-cn-panel="interface">@contractInterfaceLoader(data.Address, network, data.Mock)</div>
					<div data-cn-panel="calls" hidden>@contractCalls(data)</div>
					<div data-cn-panel="storage" hidden>@contractStorage(data, network)</div>
					<div data-cn-panel="artifact" data-cn-src={ cnArtifactFragmentHref(data.Address, network, data.Mock) } hidden>@contractArtifactLoader()</div>
				</div>
			</div></section>
		</main><aside class="px-tx-side">
			@sideCard("Contract") { @sideRow("Address", cnShort(data.Address)) @sideRow("Deployed", cnFirst(data.DeployedAt, "unknown")) @sideRow("Ledger", cnFirst(data.DeployLedger, "unknown")) @sideRow("Creator", cnFirst(data.Creator, "unknown")) @sideRow("Functions", cnFirst(data.FunctionsCount, fmt.Sprintf("%d", len(cnFunctions(data))))) @sideRow("Storage", cnFirst(data.StorageEntries, "unknown")) }
			<div class="px-tx-side-card soft"><h4>Why Prism thinks this</h4><p class="px-tx-side-body">{ cnFirst(data.Context, "Prism combines source metadata, exported functions, recent calls, and storage shape to classify this contract.") }</p></div>
			<div class="px-tx-side-card"><h4>Related links</h4><div class="px-tx-related"><a class="px-tx-related-row" href={ templ.SafeURL("/contracts/" + data.Address) }><span class="px-tx-rel-h mono">Legacy contract</span><span class="px-tx-rel-s">current production page</span></a><a class="px-tx-related-row" href="/events"><span class="px-tx-rel-h mono">Events</span><span class="px-tx-rel-s">stream contract activity</span></a></div></div>
		</aside></div></div>
		@contractTabsScript()
		@contractStorageScript()
	}
}

templ contractTab(id string, label string, count string, active bool) {
	<button class={ "px-tx-tab", templ.KV("active", active) } type="button" role="tab" data-cn-tab={ id } aria-selected={ fmt.Sprintf("%t", active) }>{ label }
		if count != "" {
			<span class="px-tx-tab-c">{ count }</span>
		}
	</button>
}

templ contractIdentity(data legacy.ContractDetailData) {
	<section class="px-tx-section px-cn-id">
		<div class="px-cn-id-grid">
			<div class="px-cn-id-icon"><div class="px-cn-icon-shape"><svg viewBox="0 0 32 32" fill="none"><circle cx="11" cy="11" r="6" stroke="currentColor" stroke-width="1.5"></circle><circle cx="21" cy="21" r="6" stroke="currentColor" stroke-width="1.5"></circle><path d="M15.5 15.5L18 18" stroke="currentColor" stroke-width="1.5"></path></svg></div><div class="px-cn-verified"><span>{ cnSourceLabel(data) }</span></div></div>
			<div class="px-cn-id-meta">
				<div class="px-cn-id-row1"><span class="px-cn-tag protocol">Soroban</span><span class="px-cn-tag kind">Contract</span><span class="px-cn-tag wasm">Wasm</span><span class="px-cn-tag live"><span class="px-cn-pulse"></span>{ cnLiveLabel(data) }</span>
					for _, tag := range data.Tags {
						<span class="px-cn-tag kind">{ tag }</span>
					}
				</div>
				<h1 class="px-cn-h1"><span class="px-cn-h1-name">{ data.Name }</span></h1>
				<p class="px-cn-id-blurb">{ cnFirst(data.Narrative, "Prism recognized this as a deployed Soroban contract. Start with the plain-language summary, then inspect the interface, calls, storage, and Wasm evidence below.") }</p>
				<div class="px-cn-addr"><span class="k">Address</span><code>{ data.Address }</code><button class="px-cn-copy" data-copy={ data.Address } title="Copy contract address"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="2" width="6" height="6" rx="1"></rect><path d="M4 8v1a1 1 0 001 1h5a1 1 0 001-1V4a1 1 0 00-1-1H9"></path></svg></button></div>
				<div class="px-cn-actions"><a class="px-tx-btn primary" href="#interface">Read function</a><a class="px-tx-btn" href="#calls">Recent calls</a><a class="px-tx-btn" href="#storage">Storage</a><button class="px-tx-btn" data-copy={ data.Address }>Copy link</button></div>
			</div>
		</div>
	</section>
}

templ contractTrustStrip(data legacy.ContractDetailData) {
	<section class="px-cn-trust">
		@trustItem("ok", "Source", cnSourceEvidence(data))
		@trustItem("ok", "Age", "Deployed " + cnFirst(data.DeployedAt, "at an unknown time"))
		@trustItem("ok", "Interface", cnFirst(data.FunctionsCount, fmt.Sprintf("%d", len(cnFunctions(data)))) + " exported functions")
		@trustItem("warn", "Upgrade review", "Check admin controls before relying on this contract")
	</section>
}

templ trustItem(tone string, title string, body string) {
	<div class={ "px-cn-trust-item", tone }><span class="px-cn-trust-icon"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg></span><div><div class="k">{ title }</div><div class="v">{ body }</div></div></div>
}

templ contractActivity(data legacy.ContractDetailData) {
	<section class="px-tx-section">
		<div class="px-tx-section-head"><h2>Activity</h2><span class="px-tx-section-sub">Recent calls, state weight, and reliability</span></div>
		<div class="px-cn-stats">
			@contractStat("Invocations", cnFirst(data.TotalInvocations, "unknown"), "observed total", "var(--ph-violet)")
			@contractStat("Average / day", cnFirst(data.AvgInvocations, "unknown"), "7 day window", "var(--ph-teal)")
			@contractStat("Peak / day", cnFirst(data.PeakInvocations, "unknown"), "highest recent day", "var(--ph-amber)")
			@contractStat("Success rate", cnFirst(data.SuccessRate, "unknown"), "recent execution", "var(--ph-green)")
		</div>
	</section>
}

templ contractStat(k string, v string, d string, color string) {
	<div class="px-cn-stat"><span class="k">{ k }</span><span class="v">{ v }</span><span class="d muted">{ d }</span><svg class="px-cn-spark" viewBox="0 0 200 36" preserveAspectRatio="none"><path d="M0,30 L18,22 L36,24 L54,15 L72,18 L90,10 L108,13 L126,8 L144,16 L162,11 L180,6 L200,9 L200,36 L0,36 Z" fill={ color } opacity="0.10"></path><path d="M0,30 L18,22 L36,24 L54,15 L72,18 L90,10 L108,13 L126,8 L144,16 L162,11 L180,6 L200,9" fill="none" stroke={ color } stroke-width="1.4"></path></svg></div>
}

templ contractInterfaceLoader(contractID string, network string, mock bool) {
	<div
		class="px-cn-iface px-cn-artifact-loading"
		aria-busy="true"
		hx-get={ templ.SafeURL(cnInterfaceFragmentHref(contractID, network, mock)) }
		hx-trigger="load"
		hx-swap="outerHTML"
	>
		<span class="px-sr-only">Loading declared contract interface</span>
		<div class="px-cn-artifact-skeleton wide"></div>
		<div class="px-cn-artifact-skeleton"></div>
		<div class="px-cn-artifact-skeleton"></div>
	</div>
}

templ contractArtifactLoader() {
	<div class="px-cn-artifact px-cn-artifact-loading" aria-busy="true">
		<span class="px-sr-only">Loading active contract artifact</span>
		<div class="px-cn-artifact-skeleton wide"></div>
		<div class="px-cn-artifact-skeleton"></div>
		<div class="px-cn-artifact-skeleton"></div>
	</div>
}

// ContractInterfaceFragment renders the API's current declared contract
// specification. Invocation evidence is deliberately shown as a separate fact.
templ ContractInterfaceFragment(model ui.ContractInterface) {
	@contractInterfacePanel(model)
}

templ contractInterfacePanel(model ui.ContractInterface) {
	<div id="interface" class="px-cn-iface">
		if !model.Available {
			<div class="px-cn-empty"><b>Declared interface unavailable</b><p>The rest of this contract page is still available. Refresh to try the interface source again.</p></div>
		}
		if model.Available {
			<header class="px-cn-iface-head">
				<div><span class="eyebrow">Current executable</span><h3>Declared interface</h3><p>Decoded from the active contract specification. Historical calls are supporting evidence, not part of this declaration.</p></div>
				if !strings.EqualFold(strings.TrimSpace(model.DetectedType), "unknown") && strings.TrimSpace(model.DetectedType) != "" {
					<span class="px-cn-iface-kind">{ model.DetectedType }</span>
				}
			</header>
			<div class="px-cn-iface-stats">
				@contractInterfaceStat(fmt.Sprintf("%d", model.FunctionCount), "Functions")
				@contractInterfaceStat(fmt.Sprintf("%d", model.DeclaredTypeCount), "Declared types")
				@contractInterfaceStat(fmt.Sprintf("%d", model.EventCount), "Events")
				@contractInterfaceStat(fmt.Sprintf("%d of %d", model.ObservedCurrentCount, model.FunctionCount), "Observed functions")
			</div>
			if len(model.Functions) > 0 {
				<section class="px-cn-iface-section" aria-labelledby="px-cn-functions-title">
					<div class="px-cn-iface-section-head"><div><h4 id="px-cn-functions-title">Functions</h4><p>Expand an entry to inspect its arguments and return values.</p></div></div>
				<div class="px-cn-iface-list">
					for _, fn := range model.Functions {
						<details class="px-cn-iface-fn">
							<summary><span class="px-cn-iface-chevron" aria-hidden="true"></span><code>{ fn.Signature }</code>
								if fn.Observed {
									<span class="px-cn-iface-observed"><i></i>Observed</span>
								}
							</summary>
							<div class="px-cn-iface-fn-body">
								if strings.TrimSpace(fn.Doc) != "" {
									<p class="px-cn-iface-doc">{ fn.Doc }</p>
								}
								<div class="px-cn-iface-io">
									<div><span class="label">Inputs</span>
										if len(fn.Inputs) == 0 {
											<span class="px-cn-iface-none">No arguments</span>
										} else {
											for _, input := range fn.Inputs {
												<div class="px-cn-iface-value"><code>{ input.Name }</code><span>{ input.Type }</span></div>
											}
										}
									</div>
									<div><span class="label">Returns</span>
										if len(fn.Outputs) == 0 {
											<span class="px-cn-iface-none">No return value</span>
										} else {
											for _, output := range fn.Outputs {
												<div class="px-cn-iface-value"><span>{ output }</span></div>
											}
										}
									</div>
								</div>
							</div>
						</details>
					}
				</div>
			</section>
			} else {
				<div class="px-cn-empty compact"><b>No declared functions</b><p>The active executable did not publish any function specifications.</p></div>
			}
			if len(model.DeclaredTypes) > 0 {
				<section class="px-cn-iface-section" aria-labelledby="px-cn-types-title">
					<div class="px-cn-iface-section-head"><div><h4 id="px-cn-types-title">Declared types</h4><p>Structs, unions, enums, and contract errors referenced by the interface.</p></div></div>
				<div class="px-cn-iface-types">
					for _, declaredType := range model.DeclaredTypes {
						<details class="px-cn-iface-type">
							<summary><span class="px-cn-iface-type-kind">{ declaredType.Kind }</span><code>{ declaredType.Name }</code><span>{ fmt.Sprintf("%d members", len(declaredType.Fields)) }</span><span class="px-cn-iface-chevron" aria-hidden="true"></span></summary>
							<div class="px-cn-iface-type-body">
								if strings.TrimSpace(declaredType.Doc) != "" {
									<p class="px-cn-iface-doc">{ declaredType.Doc }</p>
								}
								for _, field := range declaredType.Fields {
									<div class="px-cn-iface-member"><code>{ field.Name }</code><span>{ cnFirst(field.Type, "unit") }</span>
										if strings.TrimSpace(field.Doc) != "" {
											<small>{ field.Doc }</small>
										}
									</div>
								}
							</div>
						</details>
					}
				</div>
			</section>
			}
			if len(model.Events) > 0 {
				<section class="px-cn-iface-section" aria-labelledby="px-cn-events-title">
					<div class="px-cn-iface-section-head"><div><h4 id="px-cn-events-title">Declared events</h4><p>Event shapes emitted by the active executable.</p></div></div>
				<div class="px-cn-iface-types">
					for _, event := range model.Events {
						<details class="px-cn-iface-type"><summary><span class="px-cn-iface-type-kind">Event</span><code>{ event.Name }</code><span>{ cnFirst(event.DataFormat, "data") }</span><span class="px-cn-iface-chevron" aria-hidden="true"></span></summary><div class="px-cn-iface-type-body">
							if strings.TrimSpace(event.Doc) != "" {
								<p class="px-cn-iface-doc">{ event.Doc }</p>
							}
							for _, param := range event.Params {
								<div class="px-cn-iface-member"><code>{ param.Name }</code><span>{ param.Type }</span><small>{ param.Detail }</small></div>
							}
						</div></details>
					}
				</div>
			</section>
			}
			if len(model.ObservedOnlyFunctions) > 0 {
				<section class="px-cn-iface-evidence"><div><span class="eyebrow">Historical evidence</span><h4>Observed outside the current declaration</h4><p>These names appeared in indexed calls but are not declared by the active executable. They may come from an earlier contract version or undecoded invocation data.</p></div><div class="px-cn-iface-evidence-names">
					for _, name := range model.ObservedOnlyFunctions {
						<code>{ name }</code>
					}
				</div></section>
			}
		}
	</div>
}

templ contractInterfaceStat(value string, label string) {
	<div><strong>{ value }</strong><span>{ label }</span></div>
}

// ContractArtifactFragment renders current executable identity and download
// actions. The generated Rust view is explicitly not presented as source code.
templ ContractArtifactFragment(model ui.ContractArtifact) {
	@contractArtifactPanel(model)
}

templ contractArtifactPanel(model ui.ContractArtifact) {
	<div id="artifact" class="px-cn-artifact">
		if !model.Available {
			<div class="px-cn-empty"><b>Executable artifact unavailable</b><p>The contract details remain usable. Refresh to retry the current executable lookup.</p></div>
		}
		if model.Available {
			<header class="px-cn-artifact-head">
				<div class={ "px-cn-artifact-mark", templ.KV("protocol", model.IsStellarAsset) }>
					if model.IsStellarAsset {
						<span>SAC</span>
					} else {
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l7 4v5c0 4.4-2.8 7.5-7 9-4.2-1.5-7-4.6-7-9V7l7-4z"></path><path d="M8.5 12l2.2 2.2 4.8-5"></path></svg>
					}
				</div>
				<div><span class="eyebrow">Active executable</span><h3>{ model.ProvenanceLabel }</h3>
					if model.IsStellarAsset {
						<p>This built-in Stellar Asset Contract uses the canonical protocol interface and has no standalone WASM file.</p>
					} else {
						<p>The executable hash is resolved for every request, so upgrades are reflected without relying on stale contract metadata.</p>
					}
				</div>
			</header>
			<div class="px-cn-artifact-grid">
				<div class="px-cn-artifact-primary">
					<div class="px-cn-artifact-hash"><span>SHA-256 executable hash</span>
						if strings.TrimSpace(model.WASMHash) != "" {
							<code>{ model.WASMHash }</code>
						} else {
							<strong>Protocol built-in</strong>
						}
					</div>
					<div class="px-cn-artifact-actions">
						if model.HasWASM {
							<a class="px-tx-btn primary" href={ templ.SafeURL(model.DownloadHref) } download>Download verified WASM</a>
						}
						<a class="px-tx-btn" href={ templ.SafeURL(model.RustHref) } target="_blank" rel="noopener">Open generated Rust interface</a>
					</div>
					<div class="px-cn-artifact-note"><b>Interface view, not source code</b><p>The Rust-style file is generated from the declared contract specification embedded in the executable. It is useful for inspection, but it is not the original implementation.</p></div>
				</div>
				<dl class="px-cn-artifact-facts">
					@contractArtifactFact("Executable", cnFirst(model.ExecutableType, "unknown"))
					@contractArtifactFact("Artifact size", cnFirst(model.WASMSize, "not applicable"))
					@contractArtifactFact("Resolved at ledger", model.ResolvedAtLedger)
					@contractArtifactFact("Instance modified", model.InstanceLastModifiedLedger)
					@contractArtifactFact("Code modified", model.CodeLastModifiedLedger)
					@contractArtifactFact("Live until ledger", model.LiveUntilLedger)
				</dl>
			</div>
			<section class="px-cn-artifact-provenance">
				<div class="px-cn-iface-section-head"><div><h4>Provenance</h4><p>Where Prism resolved the executable identity and immutable code bytes.</p></div><span>{ cnFirst(model.ProtocolVersion, "Protocol version unknown") }</span></div>
				<div class="px-cn-artifact-provenance-grid">
					@contractArtifactFact("Executable identity", model.ExecutableSource)
					@contractArtifactFact("Code bytes", model.CodeSource)
					for _, item := range model.Metadata {
						@contractArtifactFact(cnArtifactMetadataLabel(item.Key), item.Value)
					}
				</div>
			</section>
		}
	</div>
}

templ contractArtifactFact(label string, value string) {
	<div><dt>{ label }</dt><dd>{ cnFirst(value, "unknown") }</dd></div>
}

templ contractCalls(data legacy.ContractDetailData) {
	<div id="calls" class="px-cn-panel"><div class="px-cn-calls">
		if len(data.Invocations) > 0 {
			for _, inv := range data.Invocations {
				<a class="px-cn-call" href={ templ.SafeURL("/v2/tx/" + inv.TxHash) }><span class="fn mono">{ cnFirst(inv.Function, "call") }</span><span class="summary">{ cnFirst(inv.Summary, "Contract invocation recorded by Prism.") }</span><span class="caller mono">{ cnFirst(inv.Caller, "unknown") }</span><span class="age">{ inv.Age }</span></a>
			}
		} else {
			<div class="px-cn-empty"><b>No recent invocations</b><p>{ cnRecentCallsEmpty(data) }</p></div>
		}
	</div></div>
}

templ contractStorage(data legacy.ContractDetailData, network string) {
	<div id="storage" class="px-cn-panel">
		if len(data.StorageItems) > 0 {
			<div class="px-cn-stx" data-stx-root>
				<div class="px-cn-stx-strip">
					<span class="stat"><span class="k">Entries</span><b>{ cnFirst(data.StorageStats.TotalEntries, data.StorageEntries) }</b></span>
					if data.StorageStats.MonthlyRentXLM != "" {
						<span class="sep"></span>
						<span class="stat"><span class="k">Monthly rent</span><b>{ data.StorageStats.MonthlyRentXLM } XLM</b><span class="usd">{ data.StorageStats.MonthlyRentUSD }</span></span>
					}
					if data.StorageStats.Healthy != "" {
						<span class="sep"></span>
						<span class="pill healthy"><i></i><b>{ data.StorageStats.Healthy }</b> healthy</span>
						<span class="pill atrisk"><i></i><b>{ data.StorageStats.AtRisk }</b> at risk</span>
						<span class="pill critical"><i></i><b>{ data.StorageStats.Critical }</b> critical</span>
					}
				</div>
				<div class="px-cn-stx-filters">
					<div class="px-cn-stx-chips">
						<button type="button" class="px-cn-stx-chip active" data-stx-filter="all">All entries <span>{ fmt.Sprintf("%d", len(data.StorageItems)) }</span></button>
						<button type="button" class="px-cn-stx-chip" data-stx-filter="healthy">Healthy <span>{ fmt.Sprintf("%d", cnStxCount(data.StorageItems, "healthy")) }</span></button>
						<button type="button" class="px-cn-stx-chip" data-stx-filter="atrisk">At risk <span>{ fmt.Sprintf("%d", cnStxCount(data.StorageItems, "atrisk")) }</span></button>
						<button type="button" class="px-cn-stx-chip" data-stx-filter="critical">Critical <span>{ fmt.Sprintf("%d", cnStxCount(data.StorageItems, "critical")) }</span></button>
					</div>
					<div class="px-cn-stx-search">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
						<input type="text" data-stx-q placeholder="Filter by key or value…" aria-label="Filter storage entries"/>
					</div>
				</div>
				if len(data.StorageTypes) > 0 {
					<div class="px-cn-stx-types">
						for _, t := range data.StorageTypes {
							<div class="px-cn-stx-type">
								<span class="name"><i class={ "sw", cnStxTypeClass(t.Name) }></i>{ t.Name }</span>
								<span class="meta"><span><b>{ t.Entries }</b> entries</span><span class="sep"></span><span>{ t.Size }</span><span class="sep"></span><span>Min TTL { t.MinTTL }</span></span>
							</div>
						}
					</div>
				}
				<div class="px-cn-stx-table">
					<div class="px-cn-stx-head">
						<button type="button" data-stx-sort="key">Key <i data-stx-ind="key"></i></button>
						<span>Type</span>
						<button type="button" class="num" data-stx-sort="size">Size <i data-stx-ind="size"></i></button>
						<button type="button" class="num" data-stx-sort="ttl">TTL <i data-stx-ind="ttl"></i></button>
						<button type="button" class="ctr" data-stx-sort="health">Health <i data-stx-ind="health"></i></button>
					</div>
					<div class="px-cn-stx-body" data-stx-body>
						for _, s := range data.StorageItems {
							@contractStorageEntry(s, data.Address, network)
						}
					</div>
					<div class="px-cn-stx-none" data-stx-none hidden>No entries match this filter</div>
				</div>
				<div class="px-cn-stx-foot">
					<span data-stx-count>{ fmt.Sprintf("%d of %d sampled entries shown", len(data.StorageItems), len(data.StorageItems)) } · { cnFirst(data.StorageStats.TotalEntries, data.StorageEntries) } total</span>
					<span class="src">OBSRVR Lake · silver · live-only view</span>
				</div>
			</div>
		} else {
			<div class="px-cn-storage">
				<div class="px-cn-empty"><b>No storage sample available</b><p>{ cnStorageEmpty(data) }</p></div>
			</div>
		}
	</div>
}

templ contractStorageEntry(s legacy.ContractStorageItem, address string, network string) {
	<div
		class="px-cn-stx-entry"
		data-stx-entry
		data-stx-status={ cnStxStatus(s) }
		data-stx-search={ cnStxHaystack(s) }
		data-stx-key={ s.Key }
		data-stx-size={ fmt.Sprintf("%d", s.SizeBytes) }
		data-stx-ttl={ fmt.Sprintf("%d", s.TTLLedgers) }
		data-stx-health={ fmt.Sprintf("%d", s.HealthPct) }
	>
		<button type="button" class="px-cn-stx-row" data-stx-toggle aria-expanded="false">
			<span class="cell key"><code>{ s.Key }</code><small>{ cnFirst(s.Sub, "Storage entry") }</small></span>
			<span class="cell"><span class={ "px-cn-stx-badge", cnStxTypeClass(s.Type) }><i></i>{ s.Type }</span></span>
			<span class="cell num">{ s.Size }</span>
			<span class="cell ttl"><b>{ cnStxTTLMain(s) }</b><small>{ cnStxLedgers(s.TTLLedgers) }</small></span>
			<span class="cell health">
				if cnStxHasHealth(s) {
					<span class="px-cn-stx-track"><span class={ "px-cn-stx-fill", cnStxStatus(s) } style={ fmt.Sprintf("width:%d%%", s.HealthPct) }></span></span>
					<b class={ cnStxStatus(s) }>{ fmt.Sprintf("%d%%", s.HealthPct) }</b>
				} else {
					<b class="unknown">—</b>
				}
			</span>
		</button>
		<div class="px-cn-stx-detail" hidden>
			<div class="pills">
				<span class={ "px-cn-stx-badge", cnStxTypeClass(s.Type) }><i></i>{ s.Type }</span>
				if cnStxHasHealth(s) {
					<span class={ "px-cn-stx-badge", cnStxStatus(s) }><i></i>{ cnStxStatusLabel(s) }</span>
				}
			</div>
			<div class="px-cn-stx-kv">
				<div><span>TTL remaining</span><b>{ cnStxTTLFull(s) }</b></div>
				<div><span>Value type</span><b>{ cnFirst(s.ValueType, "unknown") }</b></div>
				<div><span>Size</span><b>{ s.Size }</b></div>
			</div>
			<div class="px-cn-stx-field">
				<div class="fh"><span>Key</span><button type="button" class="px-cn-stx-copy" data-stx-copy={ s.Key }>copy</button></div>
				<code>{ s.Key }</code>
			</div>
			<div class="px-cn-stx-field">
				<div class="fh"><span>Value</span><button type="button" class="px-cn-stx-copy" data-stx-copy={ s.Value }>copy</button></div>
				<code>{ cnFirst(s.Value, "not decoded") }</code>
			</div>
			if s.KeyHash != "" {
				<div class="px-cn-stx-field">
					<div class="fh"><span>API endpoint</span><button type="button" class="px-cn-stx-copy" data-stx-copy={ "GET " + cnStxEndpoint(network, address, s.KeyHash) }>copy</button></div>
					<code><b>GET</b> { cnStxEndpoint(network, address, s.KeyHash) }</code>
				</div>
			}
		</div>
	</div>
}

templ contractStorageScript() {
	<script>(function(){if(window.__prismStxBound)return;window.__prismStxBound=true;
	function root(el){return el.closest('[data-stx-root]');}
	function apply(rt){var status=rt.__stxStatus||'all';var q=(rt.__stxQuery||'').toLowerCase();var shown=0;var entries=rt.querySelectorAll('[data-stx-entry]');entries.forEach(function(en){var okS=status==='all'||en.getAttribute('data-stx-status')===status;var okQ=!q||(en.getAttribute('data-stx-search')||'').indexOf(q)!==-1;var on=okS&&okQ;en.hidden=!on;if(on)shown++;});var none=rt.querySelector('[data-stx-none]');if(none)none.hidden=shown>0;var count=rt.querySelector('[data-stx-count]');if(count)count.textContent=shown+' of '+entries.length+' sampled entries shown';}
	function sortBy(rt,col){var defDir=col==='size'?'desc':'asc';if(rt.__stxSortCol===col){rt.__stxSortDir=rt.__stxSortDir==='asc'?'desc':'asc';}else{rt.__stxSortCol=col;rt.__stxSortDir=defDir;}var dir=rt.__stxSortDir==='asc'?1:-1;var body=rt.querySelector('[data-stx-body]');var entries=Array.prototype.slice.call(body.querySelectorAll('[data-stx-entry]'));entries.sort(function(a,b){if(col==='key')return a.getAttribute('data-stx-key').localeCompare(b.getAttribute('data-stx-key'))*dir;var attr=col==='size'?'data-stx-size':(col==='ttl'?'data-stx-ttl':'data-stx-health');return (parseInt(a.getAttribute(attr),10)-parseInt(b.getAttribute(attr),10))*dir;});entries.forEach(function(en){body.appendChild(en);});rt.querySelectorAll('[data-stx-ind]').forEach(function(i){i.textContent=i.getAttribute('data-stx-ind')===col?(dir===1?' ↑':' ↓'):'';});}
	function copyText(text){if(navigator.clipboard&&navigator.clipboard.writeText)return navigator.clipboard.writeText(text);return new Promise(function(resolve,reject){var ta=document.createElement('textarea');ta.value=text;ta.setAttribute('readonly','');ta.style.position='fixed';ta.style.opacity='0';document.body.appendChild(ta);ta.select();try{document.execCommand('copy')?resolve():reject(new Error('copy failed'));}catch(err){reject(err);}finally{document.body.removeChild(ta);}});}
	document.addEventListener('click',function(e){var chip=e.target.closest('[data-stx-filter]');if(chip){var rt=root(chip);if(!rt)return;rt.__stxStatus=chip.getAttribute('data-stx-filter');rt.querySelectorAll('[data-stx-filter]').forEach(function(c){c.classList.toggle('active',c===chip);});apply(rt);return;}
	var srt=e.target.closest('[data-stx-sort]');if(srt){var r=root(srt);if(r)sortBy(r,srt.getAttribute('data-stx-sort'));return;}
	var cp=e.target.closest('[data-stx-copy]');if(cp){var old=cp.textContent;cp.disabled=true;copyText(cp.getAttribute('data-stx-copy')||'').then(function(){cp.textContent='copied';setTimeout(function(){cp.textContent=old;cp.disabled=false;},1400);}).catch(function(){cp.textContent='failed';cp.disabled=false;setTimeout(function(){cp.textContent=old;},1400);});return;}
	var tog=e.target.closest('[data-stx-toggle]');if(tog){var en=tog.closest('[data-stx-entry]');var d=en.querySelector('.px-cn-stx-detail');if(!d)return;var open=!d.hidden;d.hidden=open;en.classList.toggle('open',!open);tog.setAttribute('aria-expanded',open?'false':'true');return;}});
	document.addEventListener('input',function(e){var s=e.target.closest('[data-stx-q]');if(!s)return;var rt=root(s);if(!rt)return;rt.__stxQuery=s.value;apply(rt);});
	})();</script>
}

templ contractTabsScript() { <script>(function(){if(window.__prismContractTabsBound)return;window.__prismContractTabsBound=true;function loadPanel(panel){var src=panel&&panel.getAttribute('data-cn-src');if(!src||panel.getAttribute('data-cn-loaded')==='true')return;panel.setAttribute('data-cn-loaded','true');if(window.htmx&&window.htmx.ajax){window.htmx.ajax('GET',src,{target:panel,swap:'innerHTML'});}else{panel.setAttribute('data-cn-loaded','false');}}function activate(root,name){if(!root)return;root.querySelectorAll('[data-cn-tab]').forEach(function(tab){var on=tab.getAttribute('data-cn-tab')===name;tab.classList.toggle('active',on);tab.setAttribute('aria-selected',on?'true':'false');});root.querySelectorAll('[data-cn-panel]').forEach(function(panel){var on=panel.getAttribute('data-cn-panel')===name;panel.hidden=!on;panel.style.display=on?'':'none';if(on)loadPanel(panel);});}document.addEventListener('click',function(e){var tab=e.target.closest('[data-cn-tab]');if(!tab)return;e.preventDefault();activate(tab.closest('[data-cn-tabs-root]'),tab.getAttribute('data-cn-tab'));});})();</script> }

func cnFirst(v string, fallback string) string { if strings.TrimSpace(v) != "" && strings.TrimSpace(v) != "—" { return v }; return fallback }
func cnInterfaceCount(data legacy.ContractDetailData) string { return fmt.Sprintf("%d", len(cnFunctions(data))) }
func cnRecentInvocationCount(data legacy.ContractDetailData) string { return fmt.Sprintf("%d", len(data.Invocations)) }
func cnRecentCallsEmpty(data legacy.ContractDetailData) string { total := strings.TrimSpace(data.TotalInvocations); if total != "" && total != "—" && total != "0" { return "Prism has observed " + total + " total invocations, but the recent-call feed did not return transaction rows for this network." }; return "Prism has not observed recent calls for this contract on the selected network." }
func cnStorageSampleCount(data legacy.ContractDetailData) string { return fmt.Sprintf("%d", len(data.StorageItems)) }
func cnStxHasHealth(s legacy.ContractStorageItem) bool { return s.HealthPct > 0 || s.TTLLedgers > 0 }
func cnStxStatus(s legacy.ContractStorageItem) string { if !cnStxHasHealth(s) { return "unknown" }; if s.HealthPct >= 40 { return "healthy" }; if s.HealthPct >= 15 { return "atrisk" }; return "critical" }
func cnStxStatusLabel(s legacy.ContractStorageItem) string { switch cnStxStatus(s) { case "healthy": return "healthy"; case "atrisk": return "at risk"; case "critical": return "critical" }; return "unknown" }
func cnStxTypeClass(t string) string { return strings.ToLower(strings.TrimSpace(t)) }
func cnStxCount(items []legacy.ContractStorageItem, status string) int { n := 0; for _, s := range items { if cnStxStatus(s) == status { n++ } }; return n }
func cnStxTTLMain(s legacy.ContractStorageItem) string { if s.TTLDays == 1 { return "1 day" }; if s.TTLDays > 0 { return fmt.Sprintf("%d days", s.TTLDays) }; return cnFirst(s.TTL, "unknown") }
func cnStxLedgers(n int) string { if n >= 1000 { return fmt.Sprintf("%dK ledgers", n/1000) }; if n > 0 { return fmt.Sprintf("%d ledgers", n) }; return "" }
func cnStxTTLFull(s legacy.ContractStorageItem) string { main := cnStxTTLMain(s); if l := cnStxLedgers(s.TTLLedgers); l != "" { return main + " · " + l }; return main }
func cnStxHaystack(s legacy.ContractStorageItem) string { return strings.ToLower(s.Key + " " + s.Sub + " " + s.Value + " " + s.ValueType + " " + s.Type) }
func cnStxEndpoint(network string, address string, keyHash string) string { if strings.TrimSpace(network) == "" { network = "testnet" }; return "/lake/v1/" + network + "/api/v1/silver/contracts/" + address + "/storage?key_hash=" + keyHash }
func cnStorageEmpty(data legacy.ContractDetailData) string { total := strings.TrimSpace(data.StorageEntries); if total != "" && total != "—" && total != "0" { return "Prism has observed " + total + " storage entries in metadata, but the storage sample feed did not return rows for this network." }; return "Storage entries will appear here when the gateway returns data for this network." }
func cnShort(v string) string { if len(v) <= 14 || v == "—" { return cnFirst(v, "unknown") }; return v[:6] + "..." + v[len(v)-4:] }
func cnSourceLabel(data legacy.ContractDetailData) string { if data.IsVerified || data.IsSourceVerified { return "Verified" }; return "Unverified" }
func cnSourceEvidence(data legacy.ContractDetailData) string { if data.IsVerified || data.IsSourceVerified { return "Wasm metadata is available for review" }; return "Source verification has not been confirmed" }
func cnLiveLabel(data legacy.ContractDetailData) string { if cnFirst(data.LastInvoked, "") != "" { return "Live · " + data.LastInvoked }; return "No recent call data" }
func cnFunctions(data legacy.ContractDetailData) []legacy.ContractFunction { if len(data.Functions) > 0 { return data.Functions }; out := make([]legacy.ContractFunction, 0, len(data.ExportedFunctions)); for _, name := range data.ExportedFunctions { out = append(out, legacy.ContractFunction{Name:name, Category:"entrypoint", Description:"Exported function detected in the contract interface.", Calls24h:"—"}) }; return out }
func cnInterfaceFragmentHref(contractID string, network string, mock bool) string { values := url.Values{}; if network != "" { values.Set("network", network) }; if mock { values.Set("mock", "true") }; path := "/fragments/contract/" + url.PathEscape(contractID) + "/interface"; if encoded := values.Encode(); encoded != "" { path += "?" + encoded }; return path }
func cnArtifactFragmentHref(contractID string, network string, mock bool) string { values := url.Values{}; if network != "" { values.Set("network", network) }; if mock { values.Set("mock", "true") }; path := "/fragments/contract/" + url.PathEscape(contractID) + "/artifact"; if encoded := values.Encode(); encoded != "" { path += "?" + encoded }; return path }
func cnArtifactMetadataLabel(key string) string { switch strings.ToLower(strings.TrimSpace(key)) { case "rsver": return "Rust compiler"; case "rssdkver": return "Soroban SDK"; default: return strings.ReplaceAll(strings.TrimSpace(key), "_", " ") } }
