package pagesv2

import (
	"fmt"
	"strings"

	legacy "github.com/withObsrvr/prism/internal/templates/pages"
	componentsv2 "github.com/withObsrvr/prism/internal/templates/v2/components"
	layoutsv2 "github.com/withObsrvr/prism/internal/templates/v2/layouts"
)

templ ContractDetail(data legacy.ContractDetailData, network string) {
	@layoutsv2.LedgerBase(data.Name + " — Prism") {
		@componentsv2.DetailHeader(data.Address, network)
		@componentsv2.Breadcrumbs([]componentsv2.Crumb{{Label: "Explorer", Href: "/v2/home"}, {Label: "Contracts", Href: "/contracts"}, {Label: cnShort(data.Address), Mono: true}})
		<div class="px-tx-page"><div class="px-tx-page-inner"><main class="px-tx-main">
			@contractIdentity(data)
			@contractTrustStrip(data)
			@contractActivity(data)
			<section class="px-tx-detail" data-cn-tabs-root><div class="px-tx-detail-inner">
				<div class="px-tx-tabs" role="tablist" aria-label="Contract evidence">
					@contractTab("interface", "Interface", cnInterfaceCount(data), true)
					@contractTab("calls", "Recent calls", cnRecentInvocationCount(data), false)
					@contractTab("storage", "Storage", cnStorageSampleCount(data), false)
					@contractTab("code", "Code", cnCodeCount(data), false)
				</div>
				<div class="px-tx-detail-body">
					<div data-cn-panel="interface">@contractFunctions(data)</div>
					<div data-cn-panel="calls" hidden>@contractCalls(data)</div>
					<div data-cn-panel="storage" hidden>@contractStorage(data)</div>
					<div data-cn-panel="code" hidden>@contractCode(data)</div>
				</div>
			</div></section>
		</main><aside class="px-tx-side">
			@sideCard("Contract") { @sideRow("Address", cnShort(data.Address)) @sideRow("Deployed", cnFirst(data.DeployedAt, "unknown")) @sideRow("Ledger", cnFirst(data.DeployLedger, "unknown")) @sideRow("Creator", cnFirst(data.Creator, "unknown")) @sideRow("Functions", cnFirst(data.FunctionsCount, fmt.Sprintf("%d", len(cnFunctions(data))))) @sideRow("Storage", cnFirst(data.StorageEntries, "unknown")) }
			@sideCard("Code") { @sideRow("Wasm hash", cnShort(data.WASMHash)) @sideRow("Wasm size", cnFirst(data.WASMSize, "unknown")) @sideRow("Source", cnSourceLabel(data)) }
			<div class="px-tx-side-card soft"><h4>Why Prism thinks this</h4><p class="px-tx-side-body">{ cnFirst(data.Context, "Prism combines source metadata, exported functions, recent calls, and storage shape to classify this contract.") }</p></div>
			<div class="px-tx-side-card"><h4>Related links</h4><div class="px-tx-related"><a class="px-tx-related-row" href={ templ.SafeURL("/contracts/" + data.Address) }><span class="px-tx-rel-h mono">Legacy contract</span><span class="px-tx-rel-s">current production page</span></a><a class="px-tx-related-row" href="/events"><span class="px-tx-rel-h mono">Events</span><span class="px-tx-rel-s">stream contract activity</span></a></div></div>
		</aside></div></div>
		@contractTabsScript()
	}
}

templ contractTab(id string, label string, count string, active bool) {
	<button class={ "px-tx-tab", templ.KV("active", active) } type="button" role="tab" data-cn-tab={ id } aria-selected={ fmt.Sprintf("%t", active) }>{ label } <span class="px-tx-tab-c">{ count }</span></button>
}

templ contractIdentity(data legacy.ContractDetailData) {
	<section class="px-tx-section px-cn-id">
		<div class="px-cn-id-grid">
			<div class="px-cn-id-icon"><div class="px-cn-icon-shape"><svg viewBox="0 0 32 32" fill="none"><circle cx="11" cy="11" r="6" stroke="currentColor" stroke-width="1.5"></circle><circle cx="21" cy="21" r="6" stroke="currentColor" stroke-width="1.5"></circle><path d="M15.5 15.5L18 18" stroke="currentColor" stroke-width="1.5"></path></svg></div><div class="px-cn-verified"><span>{ cnSourceLabel(data) }</span></div></div>
			<div class="px-cn-id-meta">
				<div class="px-cn-id-row1"><span class="px-cn-tag protocol">Soroban</span><span class="px-cn-tag kind">Contract</span><span class="px-cn-tag wasm">Wasm</span><span class="px-cn-tag live"><span class="px-cn-pulse"></span>{ cnLiveLabel(data) }</span>
					for _, tag := range data.Tags {
						<span class="px-cn-tag kind">{ tag }</span>
					}
				</div>
				<h1 class="px-cn-h1"><span class="px-cn-h1-name">{ data.Name }</span></h1>
				<p class="px-cn-id-blurb">{ cnFirst(data.Narrative, "Prism recognized this as a deployed Soroban contract. Start with the plain-language summary, then inspect the interface, calls, storage, and Wasm evidence below.") }</p>
				<div class="px-cn-addr"><span class="k">Address</span><code>{ data.Address }</code><button class="px-cn-copy" data-copy={ data.Address } title="Copy contract address"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="2" width="6" height="6" rx="1"></rect><path d="M4 8v1a1 1 0 001 1h5a1 1 0 001-1V4a1 1 0 00-1-1H9"></path></svg></button></div>
				<div class="px-cn-actions"><a class="px-tx-btn primary" href="#interface">Read function</a><a class="px-tx-btn" href="#calls">Recent calls</a><a class="px-tx-btn" href="#storage">Storage</a><button class="px-tx-btn" data-copy={ data.Address }>Copy link</button></div>
			</div>
		</div>
	</section>
}

templ contractTrustStrip(data legacy.ContractDetailData) {
	<section class="px-cn-trust">
		@trustItem("ok", "Source", cnSourceEvidence(data))
		@trustItem("ok", "Age", "Deployed " + cnFirst(data.DeployedAt, "at an unknown time"))
		@trustItem("ok", "Interface", cnFirst(data.FunctionsCount, fmt.Sprintf("%d", len(cnFunctions(data)))) + " exported functions")
		@trustItem("warn", "Upgrade review", "Check admin controls before relying on this contract")
	</section>
}

templ trustItem(tone string, title string, body string) {
	<div class={ "px-cn-trust-item", tone }><span class="px-cn-trust-icon"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg></span><div><div class="k">{ title }</div><div class="v">{ body }</div></div></div>
}

templ contractActivity(data legacy.ContractDetailData) {
	<section class="px-tx-section">
		<div class="px-tx-section-head"><h2>Activity</h2><span class="px-tx-section-sub">Recent calls, state weight, and reliability</span></div>
		<div class="px-cn-stats">
			@contractStat("Invocations", cnFirst(data.TotalInvocations, "unknown"), "observed total", "var(--ph-violet)")
			@contractStat("Average / day", cnFirst(data.AvgInvocations, "unknown"), "7 day window", "var(--ph-teal)")
			@contractStat("Peak / day", cnFirst(data.PeakInvocations, "unknown"), "highest recent day", "var(--ph-amber)")
			@contractStat("Success rate", cnFirst(data.SuccessRate, "unknown"), "recent execution", "var(--ph-green)")
		</div>
	</section>
}

templ contractStat(k string, v string, d string, color string) {
	<div class="px-cn-stat"><span class="k">{ k }</span><span class="v">{ v }</span><span class="d muted">{ d }</span><svg class="px-cn-spark" viewBox="0 0 200 36" preserveAspectRatio="none"><path d="M0,30 L18,22 L36,24 L54,15 L72,18 L90,10 L108,13 L126,8 L144,16 L162,11 L180,6 L200,9 L200,36 L0,36 Z" fill={ color } opacity="0.10"></path><path d="M0,30 L18,22 L36,24 L54,15 L72,18 L90,10 L108,13 L126,8 L144,16 L162,11 L180,6 L200,9" fill="none" stroke={ color } stroke-width="1.4"></path></svg></div>
}

templ contractFunctions(data legacy.ContractDetailData) {
	<div id="interface" class="px-cn-panel"><div class="px-cn-fns">
		if len(cnFunctions(data)) > 0 {
			<div class="px-cn-fns-head"><span>Function</span><span>Meaning</span><span>Calls</span><span>Risk</span></div>
			for _, fn := range cnFunctions(data) {
				<article class="px-cn-fn"><div><code>{ fn.Name }</code><span>{ cnFirst(fn.Category, "entrypoint") }</span></div><p>{ cnFirst(fn.Description, "Exported function detected in the contract interface.") }</p><b>{ cnFirst(fn.Calls24h, cnFirst(fn.Calls, "—")) }</b><em>normal</em></article>
			}
		} else {
			<div class="px-cn-empty"><b>No interface metadata</b><p>Function metadata was not available from the gateway for this contract.</p></div>
		}
	</div></div>
}

templ contractCalls(data legacy.ContractDetailData) {
	<div id="calls" class="px-cn-panel"><div class="px-cn-calls">
		if len(data.Invocations) > 0 {
			for _, inv := range data.Invocations {
				<a class="px-cn-call" href={ templ.SafeURL("/v2/tx/" + inv.TxHash) }><span class="fn mono">{ cnFirst(inv.Function, "call") }</span><span class="summary">{ cnFirst(inv.Summary, "Contract invocation recorded by Prism.") }</span><span class="caller mono">{ cnFirst(inv.Caller, "unknown") }</span><span class="age">{ inv.Age }</span></a>
			}
		} else {
			<div class="px-cn-empty"><b>No recent invocations</b><p>{ cnRecentCallsEmpty(data) }</p></div>
		}
	</div></div>
}

templ contractStorage(data legacy.ContractDetailData) {
	<div id="storage" class="px-cn-panel"><div class="px-cn-storage">
		if len(data.StorageItems) > 0 {
			for _, s := range data.StorageItems {
				<div class="px-cn-store"><code>{ s.Key }</code><span>{ s.Type }</span><b>{ s.Size }</b><em>{ s.TTL }</em></div>
			}
		} else {
			<div class="px-cn-empty"><b>No storage sample available</b><p>{ cnStorageEmpty(data) }</p></div>
		}
	</div></div>
}

templ contractCode(data legacy.ContractDetailData) {
	<div id="code" class="px-cn-panel"><div class="px-cn-code">
		<div class="px-cn-code-meta"><div><span>Wasm hash</span><code>{ cnFirst(data.WASMHash, "unknown") }</code></div><div><span>Wasm size</span><b>{ cnFirst(data.WASMSize, "unknown") }</b></div><div><span>Source</span><b>{ cnSourceLabel(data) }</b></div></div>
		if strings.TrimSpace(data.CodePreview) != "" {
			<pre><code>{ data.CodePreview }</code></pre>
		} else {
			<div class="px-cn-empty"><b>No code preview available</b><p>Wasm metadata is visible, but Prism does not have a source preview for this contract yet.</p></div>
		}
	</div></div>
}

templ contractTabsScript() { <script>(function(){if(window.__prismContractTabsBound)return;window.__prismContractTabsBound=true;function activate(root,name){if(!root)return;root.querySelectorAll('[data-cn-tab]').forEach(function(tab){var on=tab.getAttribute('data-cn-tab')===name;tab.classList.toggle('active',on);tab.setAttribute('aria-selected',on?'true':'false');});root.querySelectorAll('[data-cn-panel]').forEach(function(panel){var on=panel.getAttribute('data-cn-panel')===name;panel.hidden=!on;panel.style.display=on?'':'none';});}document.addEventListener('click',function(e){var tab=e.target.closest('[data-cn-tab]');if(!tab)return;e.preventDefault();activate(tab.closest('[data-cn-tabs-root]'),tab.getAttribute('data-cn-tab'));});})();</script> }

func cnFirst(v string, fallback string) string { if strings.TrimSpace(v) != "" && strings.TrimSpace(v) != "—" { return v }; return fallback }
func cnInterfaceCount(data legacy.ContractDetailData) string { return fmt.Sprintf("%d", len(cnFunctions(data))) }
func cnRecentInvocationCount(data legacy.ContractDetailData) string { return fmt.Sprintf("%d", len(data.Invocations)) }
func cnRecentCallsEmpty(data legacy.ContractDetailData) string { total := strings.TrimSpace(data.TotalInvocations); if total != "" && total != "—" && total != "0" { return "Prism has observed " + total + " total invocations, but the recent-call feed did not return transaction rows for this network." }; return "Prism has not observed recent calls for this contract on the selected network." }
func cnStorageSampleCount(data legacy.ContractDetailData) string { return fmt.Sprintf("%d", len(data.StorageItems)) }
func cnStorageEmpty(data legacy.ContractDetailData) string { total := strings.TrimSpace(data.StorageEntries); if total != "" && total != "—" && total != "0" { return "Prism has observed " + total + " storage entries in metadata, but the storage sample feed did not return rows for this network." }; return "Storage entries will appear here when the gateway returns data for this network." }
func cnShort(v string) string { if len(v) <= 14 || v == "—" { return cnFirst(v, "unknown") }; return v[:6] + "..." + v[len(v)-4:] }
func cnSourceLabel(data legacy.ContractDetailData) string { if data.IsVerified || data.IsSourceVerified { return "Verified" }; return "Unverified" }
func cnSourceEvidence(data legacy.ContractDetailData) string { if data.IsVerified || data.IsSourceVerified { return "Wasm metadata is available for review" }; return "Source verification has not been confirmed" }
func cnLiveLabel(data legacy.ContractDetailData) string { if cnFirst(data.LastInvoked, "") != "" { return "Live · " + data.LastInvoked }; return "No recent call data" }
func cnCodeCount(data legacy.ContractDetailData) string { if strings.TrimSpace(data.CodePreview) != "" { return "1" }; if strings.TrimSpace(data.WASMHash) != "" && strings.TrimSpace(data.WASMHash) != "—" { return "hash" }; return "0" }
func cnFunctions(data legacy.ContractDetailData) []legacy.ContractFunction { if len(data.Functions) > 0 { return data.Functions }; out := make([]legacy.ContractFunction, 0, len(data.ExportedFunctions)); for _, name := range data.ExportedFunctions { out = append(out, legacy.ContractFunction{Name:name, Category:"entrypoint", Description:"Exported function detected in the contract interface.", Calls24h:"—"}) }; return out }
