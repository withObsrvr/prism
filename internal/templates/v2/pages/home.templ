package pagesv2

import (
	layoutsv2 "github.com/withObsrvr/prism/internal/templates/v2/layouts"
	componentsv2 "github.com/withObsrvr/prism/internal/templates/v2/components"
	vmv2 "github.com/withObsrvr/prism/internal/templates/v2/viewmodel"
)

templ Home(data vmv2.HomeData) {
	@layoutsv2.Base("Prism: understand what is happening on Stellar") {
		@componentsv2.MainHeader("home", data.Header.Network) {
			<div class="ph-heartbeat" aria-label="Latest ledger status">
				<span class="dot is-pending" id="ph-heartbeat-dot"></span>
				<span id="ph-heartbeat-state">Loading ledger data</span>
				<span class="sep" aria-hidden="true">·</span>
				<span>ledger <b id="ph-heartbeat-ledger">{ data.Header.LedgerNumber }</b></span>
				<span class="sep" aria-hidden="true">·</span>
				<span id="ph-heartbeat-age">{ data.Header.AgeLabel }</span>
				<span class="sep" aria-hidden="true">·</span>
				<span><b id="ph-heartbeat-tx">Unavailable</b> tx</span>
			</div>
		}
		if data.MockMode {
			<div class="ph-demo-banner" role="status"><strong>Demo data</strong><span>This page is rendering explicit synthetic fixtures.</span></div>
		}
		<main class="ph-home-page">
			@homeTimelineLoading(data.TimelineURL)
			@homeSearch(data.Prompt)
			@homeDeferredSection("changes", "What changed", "Latest completed hour compared with the prior seven-day hourly median", "The latest-hour comparison is temporarily unavailable.")
			@homeDeferredSection("archival", "Nearing archival", "Persistent and contract-instance storage only", "Contract archival evidence is temporarily unavailable.")
			@homeDeferredSection("contracts", "Most called, 24 hours", "Ranked by call count, not TVL", "Contract ranking evidence is temporarily unavailable.")
			@homeDeferredSection("utilization", "Network utilization", "Instructions, read and write bytes, and transaction size", "Ledger utilization evidence is temporarily unavailable.")
			<section class="ph-home-open" id="why" aria-labelledby="ph-home-open-title">
				<div><span class="ph-home-kicker">Open source</span><h2 id="ph-home-open-title">Inspect the explorer, too.</h2></div>
				<p>Prism keeps interpretations connected to evidence, and its implementation is available for review.</p>
				<a href="https://github.com/withObsrvr/prism">github.com/withObsrvr/prism <span aria-hidden="true">→</span></a>
			</section>
		</main>
		<script>
			(function(){
				document.querySelectorAll('.ph-trychip').forEach(function(button){
					button.addEventListener('click', function(){
						var href = button.getAttribute('data-href');
						if (href) window.location.href = href;
					});
				});
			})();
		</script>
	}
}

templ homeSearch(data vmv2.PromptData) {
	<section class="ph-home-search" aria-labelledby="ph-home-search-title">
		<div class="ph-home-search-copy">
			<span class="ph-home-kicker">Lookup and explore</span>
			<h1 id="ph-home-search-title">Find anything on Stellar</h1>
			<p>Paste a transaction, account, contract, asset, or describe recent activity.</p>
		</div>
		<div class="ph-search-wrap">
			<form class="ph-search" action="/search/submit" method="GET">
				<span class="ph-search-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="5"></circle><path d="M12 12l4 4"></path></svg></span>
				<label class="sr-only" for="ph-search-input">Search Stellar activity and entities</label>
				<input id="ph-search-input" type="search" name="q" placeholder={ data.Placeholder } autocomplete="off" hx-get="/search/suggest" hx-trigger="keyup changed delay:120ms" hx-target="#ph-search-results" hx-swap="innerHTML" hx-on::after-request="document.getElementById('ph-search-results').hidden = !this.value.trim()"/>
				<button class="ph-search-submit" type="submit">Search</button>
			</form>
			<div id="ph-search-results" class="ph-search-results" hidden></div>
			<div class="ph-tryline" aria-label="Example searches">
				<span class="label">Try</span>
				<button type="button" class="ph-trychip" data-href="/v2/explore?asset=USDC&fn=swap&time=24h&topic=swap">USDC swaps today</button>
				<button type="button" class="ph-trychip" data-href="/v2/explore?fn=transfer&status=failed&topic=transfer">Failed transfers last hour</button>
				<button type="button" class="ph-trychip" data-href="/v2/explore?scope=soroban&time=24h">Contract calls today</button>
				<button type="button" class="ph-trychip" data-href="/v2/ask?q=Which%20contracts%20are%20nearing%20archival%3F">Contracts nearing archival</button>
			</div>
		</div>
	</section>
}

templ homeTimelineLoading(url string) {
	<section id="ph-home-timeline" class="ph-spectrum-section" aria-labelledby="ph-spectrum-title" aria-busy="true" aria-live="polite" hx-get={ url } hx-trigger="load" hx-swap="outerHTML">
		<div class="ph-spectrum-head">
			<div><span class="ph-home-kicker">Live ledger signal</span><h2 id="ph-spectrum-title">Reading the latest ledgers</h2></div>
			<span class="ph-spectrum-instruction">Classifying activity from one serving snapshot</span>
		</div>
		<div class="ph-spectrum-skeleton" aria-hidden="true">
			for index := range 32 {
				<span class={ "ph-spectrum-skeleton-column", homeSkeletonClass(index) }></span>
			}
		</div>
		<span class="sr-only">Loading recent ledger activity.</span>
	</section>
}

templ HomeTimeline(data vmv2.HomeTimelineData) {
	<span class={ "dot", homeHeartbeatDotClass(data) } id="ph-heartbeat-dot" hx-swap-oob="true"></span>
	<span id="ph-heartbeat-state" hx-swap-oob="true">{ data.HeaderState }</span>
	<b id="ph-heartbeat-ledger" hx-swap-oob="true">{ data.HeaderLedger }</b>
	<span id="ph-heartbeat-age" hx-swap-oob="true">{ data.HeaderAge }</span>
	<b id="ph-heartbeat-tx" hx-swap-oob="true">{ data.HeaderTxCount }</b>
	<section id="ph-home-timeline" class={ "ph-spectrum-section", "is-" + string(data.Status.State) } aria-labelledby="ph-spectrum-title" aria-live="off" hx-get={ data.PollURL } hx-trigger="every 5s" hx-swap="outerHTML">
		<div class="ph-spectrum-head">
			<div>
				<span class="ph-home-kicker">Live ledger signal</span>
				<h2 id="ph-spectrum-title">
					if data.WindowLabel != "" {
						{ data.WindowLabel }
					} else {
						Recent ledger activity
					}
				</h2>
			</div>
			if data.DetailLabel != "" {
				<span class="ph-spectrum-instruction">{ data.DetailLabel }</span>
			}
		</div>
		if data.DemoData {
			<div class="ph-inline-state is-demo"><strong>Demo fixture</strong><span>The chart below is synthetic and is not a claim about this network.</span></div>
		}
		if data.Status.Message != "" {
			<div class={ "ph-inline-state", "is-" + string(data.Status.State) } role="status">
				<strong>{ homeStateLabel(data.Status.State) }</strong><span>{ data.Status.Message }</span>
			</div>
		}
		if len(data.Columns) > 0 {
			<div class="ph-spectrum-layout">
				<div class="ph-spectrum-chart-wrap">
					<div class="ph-spectrum-chart" style={ data.ColumnGridStyle } role="group" aria-label="Composition of recent ledgers by activity class">
						for _, column := range data.Columns {
							<a class={ "ph-spectrum-column", templ.KV("is-latest", column.Latest) } href={ templ.SafeURL(column.Href) } style={ column.HeightStyle + ";" + column.FailureStyle } aria-label={ column.AccessibleLabel } title={ column.AccessibleLabel }>
								<span class="ph-spectrum-stack" aria-hidden="true">
									for _, segment := range column.Segments {
										<span class={ "ph-spectrum-segment", "is-" + segment.Kind } style={ segment.Style }></span>
									}
								</span>
								<span class="ph-spectrum-failure" aria-hidden="true"></span>
								<span class="ph-spectrum-tooltip" aria-hidden="true">
									<strong>Ledger { column.SequenceLabel }</strong>
									<span>{ column.ClosedAt } · { column.AgeLabel }</span>
									<span>{ column.TransactionCount } tx · { column.IncludedOperations } ops · { column.FailedOperations } failed</span>
									if column.Introducer != "" {
										<span>Introduced by { column.Introducer }</span>
									}
								</span>
							</a>
						}
					</div>
					<div class="ph-spectrum-axis" aria-hidden="true"><span>{ data.StartSequence }</span><span>Failed operations</span><span>{ data.EndSequence }</span></div>
				</div>
				<div class="ph-spectrum-legend" aria-label="Activity legend">
					<span class="ph-spectrum-legend-title">Classified as</span>
					for _, item := range data.Legend {
						<div class="ph-spectrum-legend-row"><span class={ "ph-spectrum-swatch", "is-" + item.Kind }></span><span>{ item.Label }</span><b>{ item.Percentage }</b><span class="sr-only">{ item.Count } operations</span></div>
					}
					<div class="ph-spectrum-legend-row is-failure"><span class="ph-spectrum-swatch is-failure"></span><span>Failed</span><b>{ data.FailurePercent }</b><span class="sr-only">{ data.FailureCount } failed operations</span></div>
					if data.Status.AsOfLedger > 0 {
						<div class="ph-spectrum-provenance"><span>As of ledger</span><b>{ data.AsOfLedgerLabel }</b></div>
					}
				</div>
			</div>
		} else if data.Status.State == vmv2.HomeSectionUnavailable {
			<button class="ph-inline-retry" type="button" hx-get={ data.PollURL } hx-target="#ph-home-timeline" hx-swap="outerHTML">Retry ledger activity</button>
		}
	</section>
}

templ homeDeferredSection(id string, title string, scope string, message string) {
	<section class="ph-home-deferred" id={ id } aria-labelledby={ "ph-home-" + id + "-title" }>
		<div class="ph-home-deferred-heading"><div><span class="ph-home-kicker">Evidence section</span><h2 id={ "ph-home-" + id + "-title" }>{ title }</h2></div><span>{ scope }</span></div>
		<div class="ph-inline-state is-unavailable"><strong>Unavailable</strong><span>{ message }</span></div>
	</section>
}

func homeSkeletonClass(index int) string {
	switch index % 4 {
	case 0: return "is-tall"
	case 1: return "is-medium"
	case 2: return "is-short"
	default: return "is-mid-tall"
	}
}

func homeStateLabel(state vmv2.HomeSectionState) string {
	switch state {
	case vmv2.HomeSectionPartial: return "Partial evidence"
	case vmv2.HomeSectionStale: return "Data delayed"
	case vmv2.HomeSectionEmpty: return "No recent ledgers"
	case vmv2.HomeSectionUnavailable: return "Unavailable"
	default: return "Live evidence"
	}
}

func homeHeartbeatDotClass(data vmv2.HomeTimelineData) string {
	if data.DemoData { return "is-demo" }
	switch data.Status.State {
	case vmv2.HomeSectionReady: return "is-live"
	case vmv2.HomeSectionPartial, vmv2.HomeSectionStale: return "is-delayed"
	default: return "is-unavailable"
	}
}
