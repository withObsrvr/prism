	<section class="v2-home-section">
		<div class="v2-section-head">
			<h2 class="v2-section-title">{ data.Title }</h2>
			<div class="v2-section-copy">{ data.Copy }</div>
		</div>
		<div class="v2-simple-cards">
			for _, card := range data.Cards {
				@componentsv2.LeaderCard(componentsv2.LeaderCardData(card))
			}
		</div>
	</section>
}

templ Utilization(data vmv2.UtilizationSectionData) {
	<section class="v2-home-section">
		<div class="v2-section-head">
			<h2 class="v2-section-title">{ data.Title }</h2>
			<div class="v2-section-copy">{ data.Copy }</div>
		</div>
		<div class="v2-util-grid">
			for _, card := range data.Cards {
				@componentsv2.UtilizationCard(componentsv2.UtilizationCardData(card))
			}
		</div>
	</section>
}
