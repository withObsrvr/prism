package layouts

// Base renders the full HTML document shell.
// Every page template composes this layout.
//
// Usage in a page template:
//
//	@layouts.Base("Ledger 61,472,843 — Prism", "explorer") {
//	    <div>page content here</div>
//	}
templ Base(title string, activeNav string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title }</title>
		<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>

		<!-- FOUC prevention: apply dark class before paint -->
		<script>
			(function(){
				var t = localStorage.getItem('prism_theme') || 'system';
				var dark = t === 'dark' || (t === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
				if (dark) document.documentElement.classList.add('dark');
			})();
		</script>

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
		<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>

		<!-- Tailwind (CDN for dev, compiled CSS for production) -->
		<link rel="stylesheet" href="/static/css/app.css"/>

		<!-- htmx -->
		<script src="/static/js/htmx.min.js"></script>
	</head>
	<body class="bg-surface-page text-text-primary antialiased">

		<!-- Top Nav — 56px sticky -->
		@topNav(activeNav)

		<!-- Page Content -->
		<main>
			{ children... }
		</main>

		<!-- Footer -->
		@footer()

		<!-- Ctrl+K → focus search or navigate to search page -->
		<script>
			document.addEventListener('keydown', function(e) {
				if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
					e.preventDefault();
					var input = document.querySelector('form[action="/search"] input[name="q"]');
					if (input) {
						input.focus();
						input.select();
					} else {
						window.location.href = '/search';
					}
				}
			});
		</script>
		<script>
			function selectNetwork(id, label, dotClass) {
				document.getElementById('network-label').textContent = label;
				var dot = document.getElementById('network-dot');
				dot.className = 'h-2 w-2 rounded-full flex-shrink-0 ' + dotClass;
				document.querySelectorAll('[id^="check-"]').forEach(function(el) { el.classList.add('hidden'); });
				document.getElementById('check-' + id).classList.remove('hidden');
				document.getElementById('network-dropdown').classList.add('hidden');
				// Set cookie and swap main content via htmx
				document.cookie = 'prism_network=' + id + ';path=/;max-age=31536000';
				htmx.ajax('GET', window.location.pathname + window.location.search, {
					target: 'main',
					swap: 'outerHTML',
					select: 'main'
				});
			}
			document.addEventListener('click', function(e) {
				var dropdown = document.getElementById('network-dropdown');
				if (!dropdown.classList.contains('hidden') && !e.target.closest('.relative')) {
					dropdown.classList.add('hidden');
				}
			});
			// Initialize network selector from cookie on page load
			(function() {
				var match = document.cookie.match(/prism_network=(\w+)/);
				var net = match ? match[1] : 'mainnet';
				var labels = {mainnet: 'Mainnet', testnet: 'Testnet', futurenet: 'Futurenet'};
				var dots = {mainnet: 'bg-emerald-500', testnet: 'bg-amber-500', futurenet: 'bg-violet-500'};
				document.getElementById('network-label').textContent = labels[net] || 'Mainnet';
				document.getElementById('network-dot').className = 'h-2 w-2 rounded-full flex-shrink-0 ' + (dots[net] || 'bg-emerald-500');
				document.querySelectorAll('[id^="check-"]').forEach(function(el) { el.classList.add('hidden'); });
				var check = document.getElementById('check-' + net);
				if (check) check.classList.remove('hidden');
			})();
		</script>
		<!-- Theme toggle logic -->
		<script>
			function cycleTheme() {
				var themes = ['system', 'light', 'dark'];
				var current = localStorage.getItem('prism_theme') || 'system';
				var idx = themes.indexOf(current);
				var next = themes[(idx + 1) % 3];
				localStorage.setItem('prism_theme', next);
				applyTheme(next);
				updateThemeIcon(next);
			}
			function applyTheme(t) {
				var dark = t === 'dark' || (t === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
				document.documentElement.classList.toggle('dark', dark);
			}
			function updateThemeIcon(t) {
				document.getElementById('theme-icon-system').classList.toggle('hidden', t !== 'system');
				document.getElementById('theme-icon-light').classList.toggle('hidden', t !== 'light');
				document.getElementById('theme-icon-dark').classList.toggle('hidden', t !== 'dark');
			}
			// Init icon on load
			(function() {
				var t = localStorage.getItem('prism_theme') || 'system';
				updateThemeIcon(t);
				// Listen for OS theme changes when in system mode
				window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
					var current = localStorage.getItem('prism_theme') || 'system';
					if (current === 'system') applyTheme('system');
				});
			})();
		</script>

		<!-- Slide-out panel container (htmx swaps content here) -->
		<div id="slideout-backdrop" class="hidden fixed inset-0 bg-black/8 backdrop-blur-[1px] z-40"
			 hx-on:click="this.classList.add('hidden'); document.getElementById('slideout').innerHTML = '';"></div>
		<div id="slideout" class="fixed right-0 top-0 bottom-0 w-full sm:w-[480px] z-50 empty:hidden"
			 hx-on::after-swap="document.getElementById('slideout-backdrop').classList.remove('hidden')"></div>

	</body>
	</html>
}

templ footer() {
	<footer class="border-t border-border-subtle">
		<div class="mx-auto max-w-[1320px] px-4 md:px-8 py-4 flex items-center justify-between text-2xs text-text-muted">
			<span>Prism by <a href="https://obsrvr.com" class="hover:text-text-body transition-colors">Obsrvr</a></span>
			<span class="flex items-center gap-1"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>Operational</span>
		</div>
	</footer>
}

// topNav renders the sticky navigation bar.
// activeNav should be one of: "explorer", "network", "assets", "contracts", "devtools"
templ topNav(active string) {
	<header class="sticky top-0 z-30 flex h-14 items-center justify-between border-b border-border-default bg-surface-card/95 backdrop-blur-md px-4 md:px-6">
		<div class="flex items-center gap-4 md:gap-8">
			<a href="/" class="flex items-center gap-2">
				<div class="flex h-7 w-7 items-center justify-center rounded-lg bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900">
					<!-- Triangle mark -->
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
						<polygon points="12 2 22 20 2 20"/>
					</svg>
				</div>
				<span class="text-sm font-bold tracking-tight">Prism</span>
			</a>
			<!-- Desktop nav -->
			<nav class="hidden md:flex items-center gap-1 h-14 text-sm font-medium text-text-body">
				@navItem("/", "Explorer", active == "explorer")
				@navItem("/network", "Network", active == "network")
				@navItem("/assets", "Assets", active == "assets")
				@navItem("/contracts", "Contracts", active == "contracts")
				@navItem("/events", "Dev Tools", active == "devtools")
			</nav>
		</div>
		<div class="flex items-center gap-3">
			if active != "explorer" {
				<!-- Search trigger — desktop wide bar -->
				<a href="/search" class="hidden md:flex items-center gap-2.5 rounded-xl border border-border-default bg-surface-card px-4 py-2 text-sm text-text-muted hover:border-text-muted hover:text-text-body hover:shadow-sm transition-all w-80 lg:w-96 ring-1 ring-border-subtle">
					<svg class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
					<span class="flex-1">Search accounts, txns, ledgers…</span>
					<kbd class="rounded border border-border-default bg-surface-subtle px-1.5 py-0.5 text-2xs font-semibold text-text-muted">Ctrl+K</kbd>
				</a>
				<!-- Search trigger — mobile -->
				<a href="/search" class="flex md:hidden items-center justify-center h-9 w-9 rounded-lg border border-border-default bg-surface-card text-text-body hover:bg-surface-subtle transition-colors">
					<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
				</a>
			}
			<!-- Theme toggle -->
			<button onclick="cycleTheme()" class="flex items-center justify-center h-9 w-9 rounded-lg border border-border-default bg-surface-card text-text-body hover:bg-surface-subtle transition-colors cursor-pointer" title="Toggle theme">
				<!-- System icon (monitor) -->
				<svg id="theme-icon-system" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
				<!-- Light icon (sun) -->
				<svg id="theme-icon-light" class="h-4 w-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
				<!-- Dark icon (moon) -->
				<svg id="theme-icon-dark" class="h-4 w-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
			</button>
			<!-- Network selector -->
			<div class="relative">
				<button onclick="document.getElementById('network-dropdown').classList.toggle('hidden')" class="flex items-center gap-1.5 rounded-lg border border-border-default bg-surface-card px-2.5 py-1.5 text-xs font-medium text-text-strong hover:bg-surface-subtle transition-colors cursor-pointer">
					<span id="network-dot" class="h-2 w-2 rounded-full bg-emerald-500"></span>
					<span id="network-label">Mainnet</span>
					<svg class="h-3 w-3 text-text-muted ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
				</button>
				<div id="network-dropdown" class="hidden absolute right-0 top-full mt-2 w-52 rounded-xl border border-border-default bg-surface-card shadow-xl overflow-hidden z-50">
					<div class="px-4 pt-3 pb-1.5">
						<span class="text-2xs font-semibold uppercase tracking-wider text-text-muted">Network</span>
					</div>
					<div class="px-2 pb-2">
						<button onclick="selectNetwork('mainnet', 'Mainnet', 'bg-emerald-500')" class="network-option w-full flex items-center gap-2.5 rounded-lg px-3 py-2 text-left hover:bg-surface-subtle transition-colors" data-network="mainnet">
							<span class="h-2 w-2 rounded-full bg-emerald-500 flex-shrink-0"></span>
							<span class="text-xs font-medium text-text-primary flex-1">Mainnet</span>
							<svg id="check-mainnet" class="h-3.5 w-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
						</button>
						<button onclick="selectNetwork('testnet', 'Testnet', 'bg-amber-500')" class="network-option w-full flex items-center gap-2.5 rounded-lg px-3 py-2 text-left hover:bg-surface-subtle transition-colors" data-network="testnet">
							<span class="h-2 w-2 rounded-full bg-amber-500 flex-shrink-0"></span>
							<span class="text-xs font-medium text-text-strong flex-1">Testnet</span>
							<svg id="check-testnet" class="h-3.5 w-3.5 text-emerald-500 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
						</button>
						<button onclick="selectNetwork('futurenet', 'Futurenet', 'bg-violet-500')" class="network-option w-full flex items-center gap-2.5 rounded-lg px-3 py-2 text-left hover:bg-surface-subtle transition-colors" data-network="futurenet">
							<span class="h-2 w-2 rounded-full bg-violet-500 flex-shrink-0"></span>
							<span class="text-xs font-medium text-text-strong flex-1">Futurenet</span>
							<svg id="check-futurenet" class="h-3.5 w-3.5 text-emerald-500 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
						</button>
					</div>
				</div>
			</div>
			<!-- Mobile hamburger -->
			<button onclick="document.getElementById('mobile-drawer').style.transform='translateX(0)'; document.getElementById('drawer-backdrop').classList.remove('hidden');" class="flex md:hidden items-center justify-center h-9 w-9 rounded-lg text-text-strong hover:bg-surface-subtle transition-colors">
				<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
			</button>
		</div>
	</header>

	<!-- Mobile drawer overlay -->
	<div id="drawer-backdrop" class="hidden fixed inset-0 bg-black/30 z-40" onclick="document.getElementById('mobile-drawer').style.transform='translateX(-100%)'; this.classList.add('hidden');"></div>
	<!-- Mobile drawer -->
	<nav id="mobile-drawer" style="transform: translateX(-100%)" class="fixed top-0 left-0 bottom-0 w-72 bg-surface-card z-50 transition-transform duration-300 ease-in-out shadow-xl overflow-y-auto">
		<div class="flex items-center justify-between px-5 py-4 border-b border-border-default">
			<a href="/" class="flex items-center gap-2">
				<div class="flex h-7 w-7 items-center justify-center rounded-lg bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900">
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 22 20 2 20"/></svg>
				</div>
				<span class="text-sm font-bold tracking-tight">Prism</span>
			</a>
			<button onclick="document.getElementById('mobile-drawer').style.transform='translateX(-100%)'; document.getElementById('drawer-backdrop').classList.add('hidden');" class="h-8 w-8 flex items-center justify-center rounded-lg text-text-body hover:bg-surface-subtle">
				<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
			</button>
		</div>
		<div class="py-2">
			@mobileNavItem("/", "Explorer", active == "explorer")
			@mobileNavItem("/network", "Network", active == "network")
			@mobileNavItem("/assets", "Assets", active == "assets")
			@mobileNavItem("/contracts", "Contracts", active == "contracts")
			@mobileNavItem("/events", "Dev Tools", active == "devtools")
		</div>
	</nav>
}

templ mobileNavItem(href string, label string, isActive bool) {
	if isActive {
		<a href={ templ.SafeURL(href) } onclick="document.getElementById('mobile-drawer').style.transform='translateX(-100%)'; document.getElementById('drawer-backdrop').classList.add('hidden');"
		   class="flex items-center px-5 py-3 text-sm font-semibold text-text-primary bg-surface-subtle border-l-2 border-text-primary">
			{ label }
		</a>
	} else {
		<a href={ templ.SafeURL(href) } onclick="document.getElementById('mobile-drawer').style.transform='translateX(-100%)'; document.getElementById('drawer-backdrop').classList.add('hidden');"
		   class="flex items-center px-5 py-3 text-sm font-medium text-text-body hover:bg-surface-subtle hover:text-text-primary transition-colors border-l-2 border-transparent">
			{ label }
		</a>
	}
}

templ navItem(href string, label string, isActive bool) {
	if isActive {
		<a href={ templ.SafeURL(href) }
		   class="relative flex items-center px-3 h-full text-text-primary
				  after:content-[''] after:absolute after:bottom-[-1px] after:left-0 after:right-0
				  after:h-[2px] after:bg-text-primary">
			{ label }
		</a>
	} else {
		<a href={ templ.SafeURL(href) }
		   class="relative flex items-center px-3 h-full hover:text-text-primary transition-colors
				  after:content-[''] after:absolute after:bottom-[-1px] after:left-0 after:right-0
				  after:h-[2px] after:bg-text-primary after:scale-x-0 hover:after:scale-x-100
				  after:transition-transform after:duration-150 after:ease-out after:origin-left">
			{ label }
		</a>
	}
}
