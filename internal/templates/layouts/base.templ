package layouts

// Base renders the full HTML document shell.
// Every page template composes this layout.
//
// Usage in a page template:
//
//	@layouts.Base("Ledger 61,472,843 — Prism", "explorer") {
//	    <div>page content here</div>
//	}
templ Base(title string, activeNav string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title }</title>
		<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
		<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>

		<!-- Tailwind (CDN for dev, compiled CSS for production) -->
		<link rel="stylesheet" href="/static/css/app.css"/>

		<!-- htmx -->
		<script src="/static/js/htmx.min.js"></script>
	</head>
	<body class="bg-[#FAFAFA] text-[#111] antialiased">

		<!-- Top Nav — 56px sticky -->
		@topNav(activeNav)

		<!-- Page Content -->
		<main>
			{ children... }
		</main>

		<!-- Footer -->
		@footer()

		<!-- Command Palette (Ctrl+K) -->
		<div id="command-palette" style="display:none;" class="fixed inset-0 z-50">
			<div class="absolute inset-0 bg-black/30 backdrop-blur-sm" onclick="closeCommandPalette()"></div>
			<div class="absolute inset-0 flex items-start justify-center pt-6 sm:pt-[12vh] px-4 sm:px-0">
				<div class="w-full max-w-[640px] rounded-2xl border border-gray-200 bg-white shadow-2xl overflow-hidden">

					<!-- Search input -->
					<div class="flex items-center gap-3 border-b border-gray-200 px-5 py-4">
						<svg class="h-5 w-5 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
						<input id="command-palette-input" type="text" placeholder="Search accounts, contracts, assets..." class="font-mono text-base text-gray-900 placeholder-gray-400 flex-1 outline-none bg-transparent"/>
						<span class="text-[10px] text-gray-400 flex-shrink-0">ESC to close</span>
					</div>

					<!-- Results -->
					<div class="max-h-[420px] overflow-y-auto">
						<!-- Contracts group -->
						<div class="px-4 py-2 bg-[#FAFAFA] border-b border-gray-100">
							<span class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">Contracts</span>
						</div>
						<a href="/contract/soroswap-router" class="flex items-center gap-3 px-5 py-3 border-b border-gray-50 cursor-pointer hover:bg-gray-50">
							<div class="flex h-8 w-8 items-center justify-center rounded-lg bg-violet-100 flex-shrink-0">
								<svg class="h-4 w-4 text-violet-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
							</div>
							<div class="flex-1 min-w-0">
								<div class="flex items-center gap-2">
									<span class="text-sm font-semibold text-gray-900">Soroswap Router</span>
									<span class="rounded bg-violet-50 px-1.5 py-0.5 text-[9px] font-bold text-violet-600">DEX</span>
									<span class="rounded bg-emerald-50 px-1.5 py-0.5 text-[9px] font-bold text-emerald-700">Verified</span>
								</div>
								<span class="font-mono text-[11px] text-gray-400">CAXY...Z10P · 248k invocations</span>
							</div>
							<svg class="h-4 w-4 text-gray-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
						</a>
						<a href="/contract/soroswap-factory" class="flex items-center gap-3 px-5 py-3 border-b border-gray-50 cursor-pointer hover:bg-gray-50">
							<div class="flex h-8 w-8 items-center justify-center rounded-lg bg-violet-100 flex-shrink-0">
								<svg class="h-4 w-4 text-violet-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
							</div>
							<div class="flex-1 min-w-0">
								<div class="flex items-center gap-2">
									<span class="text-sm font-semibold text-gray-900">Soroswap Factory</span>
									<span class="rounded bg-violet-50 px-1.5 py-0.5 text-[9px] font-bold text-violet-600">Factory</span>
								</div>
								<span class="font-mono text-[11px] text-gray-400">CFAC...T1RY · 42k invocations</span>
							</div>
							<svg class="h-4 w-4 text-gray-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
						</a>
						<a href="/contract/soroswap-xlm-usdc" class="flex items-center gap-3 px-5 py-3 border-b border-gray-50 cursor-pointer hover:bg-gray-50">
							<div class="flex h-8 w-8 items-center justify-center rounded-lg bg-violet-100 flex-shrink-0">
								<svg class="h-4 w-4 text-violet-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
							</div>
							<div class="flex-1 min-w-0">
								<div class="flex items-center gap-2">
									<span class="text-sm font-semibold text-gray-900">Soroswap XLM/USDC Pair</span>
									<span class="rounded bg-cyan-50 px-1.5 py-0.5 text-[9px] font-bold text-cyan-700">LP Pool</span>
								</div>
								<span class="font-mono text-[11px] text-gray-400">CXLM...LP42 · 184k invocations</span>
							</div>
							<svg class="h-4 w-4 text-gray-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
						</a>

						<!-- Accounts group -->
						<div class="px-4 py-2 bg-[#FAFAFA] border-b border-gray-100 border-t border-gray-100">
							<span class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">Accounts</span>
						</div>
						<a href="/account/GSORO" class="flex items-center gap-3 px-5 py-3 border-b border-gray-50 cursor-pointer hover:bg-gray-50">
							<div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gray-100 flex-shrink-0">
								<svg class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
							</div>
							<div class="flex-1 min-w-0">
								<div class="flex items-center gap-2">
									<span class="text-sm font-semibold text-gray-900">Soroswap Deployer</span>
								</div>
								<span class="font-mono text-[11px] text-gray-400">GSORO...W8PQ · 12,480 XLM</span>
							</div>
							<svg class="h-4 w-4 text-gray-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
						</a>

						<!-- Assets group -->
						<div class="px-4 py-2 bg-[#FAFAFA] border-b border-gray-100 border-t border-gray-100">
							<span class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">Assets</span>
						</div>
						<a href="/assets/SRS" class="flex items-center gap-3 px-5 py-3 cursor-pointer hover:bg-gray-50">
							<div class="flex h-8 w-8 items-center justify-center rounded-lg bg-cyan-100 flex-shrink-0">
								<span class="text-[10px] font-bold text-cyan-700">SRS</span>
							</div>
							<div class="flex-1 min-w-0">
								<div class="flex items-center gap-2">
									<span class="text-sm font-semibold text-gray-900">SoroswapToken (SRS)</span>
									<span class="rounded bg-violet-50 px-1.5 py-0.5 text-[9px] font-bold text-violet-600">SEP-41</span>
								</div>
								<span class="font-mono text-[11px] text-gray-400">CSRS...TK42 · 8,420 holders</span>
							</div>
							<svg class="h-4 w-4 text-gray-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
						</a>
					</div>

					<!-- Quick Actions footer -->
					<div class="border-t border-gray-200 bg-[#FAFAFA] px-5 py-3">
						<div class="flex items-center justify-between">
\t\t\t\t\t\t\t<div class="hidden sm:flex items-center gap-4 text-[10px] text-gray-400">
								<span class="flex items-center gap-1">
									<kbd class="rounded border border-gray-300 bg-white px-1 py-0.5 text-[9px] font-semibold shadow-sm">↑</kbd>
									<kbd class="rounded border border-gray-300 bg-white px-1 py-0.5 text-[9px] font-semibold shadow-sm">↓</kbd>
									navigate
								</span>
								<span class="flex items-center gap-1">
									<kbd class="rounded border border-gray-300 bg-white px-1.5 py-0.5 text-[9px] font-semibold shadow-sm">↵</kbd>
									select
								</span>
								<span class="flex items-center gap-1">
									<kbd class="rounded border border-gray-300 bg-white px-1.5 py-0.5 text-[9px] font-semibold shadow-sm">esc</kbd>
									close
								</span>
							</div>
							<span class="text-[10px] text-gray-400">5 results</span>
						</div>
					</div>

				</div>
			</div>
		</div>
		<script>
			function openCommandPalette() {
				var cp = document.getElementById('command-palette');
				cp.style.display = 'block';
				document.getElementById('command-palette-input').focus();
				document.getElementById('command-palette-input').value = '';
			}
			function closeCommandPalette() {
				document.getElementById('command-palette').style.display = 'none';
			}
			document.addEventListener('keydown', function(e) {
				var cp = document.getElementById('command-palette');
				if (e.ctrlKey && e.key === 'k') {
					e.preventDefault();
					if (cp.style.display === 'none') {
						openCommandPalette();
					} else {
						closeCommandPalette();
					}
				}
				if (e.key === 'Escape' && cp.style.display !== 'none') {
					closeCommandPalette();
				}
			});
		</script>
		<script>
			function selectNetwork(id, label, dotClass) {
				document.getElementById('network-label').textContent = label;
				var dot = document.getElementById('network-dot');
				dot.className = 'h-2 w-2 rounded-full flex-shrink-0 ' + dotClass;
				document.querySelectorAll('[id^="check-"]').forEach(function(el) { el.classList.add('hidden'); });
				document.getElementById('check-' + id).classList.remove('hidden');
				document.getElementById('network-dropdown').classList.add('hidden');
			}
			document.addEventListener('click', function(e) {
				var dropdown = document.getElementById('network-dropdown');
				if (!dropdown.classList.contains('hidden') && !e.target.closest('.relative')) {
					dropdown.classList.add('hidden');
				}
			});
		</script>

		<!-- Slide-out panel container (htmx swaps content here) -->
		<div id="slideout-backdrop" class="hidden fixed inset-0 bg-black/8 backdrop-blur-[1px] z-40"
			 hx-on:click="this.classList.add('hidden'); document.getElementById('slideout').innerHTML = '';"></div>
		<div id="slideout" class="fixed right-0 top-0 bottom-0 w-full sm:w-[480px] z-50 empty:hidden"
			 hx-on::after-swap="document.getElementById('slideout-backdrop').classList.remove('hidden')"></div>

	</body>
	</html>
}

templ footer() {
	<footer class="border-t border-gray-200 bg-white">
		<div class="mx-auto max-w-[1320px] px-4 md:px-8 py-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
			<div class="flex items-center gap-6">
				<div class="flex items-center gap-2">
					<div class="flex h-5 w-5 items-center justify-center rounded bg-[#111] text-white">
						<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 22 20 2 20"></polygon></svg>
					</div>
					<span class="text-[12px] font-semibold text-gray-900">Prism</span>
					<span class="text-[11px] text-gray-400">by Obsrvr</span>
				</div>
				<a href="#" class="text-[11px] text-gray-400 hover:text-gray-900 transition-colors">API Docs</a>
				<a href="#" class="text-[11px] text-gray-400 hover:text-gray-900 transition-colors">GitHub</a>
				<a href="#" class="text-[11px] text-gray-400 hover:text-gray-900 transition-colors">Status</a>
			</div>
			<div class="flex items-center gap-4 text-[11px] text-gray-400">
				<span>Powered by Obsrvr Lake</span>
				<span class="text-gray-300">&bull;</span>
				<span class="flex items-center gap-1"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>All systems operational</span>
			</div>
		</div>
	</footer>
}

// topNav renders the sticky navigation bar.
// activeNav should be one of: "explorer", "network", "assets", "contracts", "devtools"
templ topNav(active string) {
	<header class="sticky top-0 z-30 flex h-14 items-center justify-between border-b border-gray-200 bg-white/95 backdrop-blur-md px-4 md:px-6">
		<div class="flex items-center gap-4 md:gap-8">
			<a href="/" class="flex items-center gap-2">
				<div class="flex h-7 w-7 items-center justify-center rounded-lg bg-[#111] text-white">
					<!-- Triangle mark -->
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
						<polygon points="12 2 22 20 2 20"/>
					</svg>
				</div>
				<span class="text-[15px] font-bold tracking-tight">Prism</span>
			</a>
			<!-- Desktop nav -->
			<nav class="hidden md:flex items-center gap-1 h-14 text-[13px] font-medium text-gray-500">
				@navItem("/", "Explorer", active == "explorer")
				@navItem("/network", "Network", active == "network")
				@navItem("/assets", "Assets", active == "assets")
				@navItem("/contracts", "Contracts", active == "contracts")
				@navItem("/events", "Dev Tools", active == "devtools")
			</nav>
		</div>
		<div class="flex items-center gap-3">
			<!-- Search trigger — desktop wide bar -->
			if active != "explorer" {
				<a href="/search" class="hidden md:flex items-center gap-2.5 rounded-lg border border-gray-200 bg-[#FAFAFA] px-4 py-2 text-[13px] text-gray-500 hover:bg-gray-100 hover:text-gray-900 transition-colors w-64">
					<svg class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
					<span class="flex-1">Search…</span>
					<kbd class="rounded border border-gray-300 bg-white px-1.5 py-0.5 text-[10px] font-semibold text-gray-400">Ctrl+K</kbd>
				</a>
				<!-- Search trigger — mobile icon -->
				<a href="/search" class="flex md:hidden items-center justify-center h-9 w-9 rounded-lg border border-gray-200 bg-[#FAFAFA] text-gray-500 hover:bg-gray-100 transition-colors">
					<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
				</a>
			}
			<!-- Network selector -->
			<div class="relative">
				<button onclick="document.getElementById('network-dropdown').classList.toggle('hidden')" class="flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-2.5 py-1.5 text-[11px] font-medium text-gray-700 hover:bg-gray-50 transition-colors cursor-pointer">
					<span id="network-dot" class="h-2 w-2 rounded-full bg-emerald-500"></span>
					<span id="network-label">Mainnet</span>
					<svg class="h-3 w-3 text-gray-400 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
				</button>
				<div id="network-dropdown" class="hidden absolute right-0 top-full mt-2 w-52 rounded-xl border border-gray-200 bg-white shadow-xl overflow-hidden z-50">
					<div class="px-4 pt-3 pb-1.5">
						<span class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">Network</span>
					</div>
					<div class="px-2 pb-2">
						<button onclick="selectNetwork('mainnet', 'Mainnet', 'bg-emerald-500')" class="network-option w-full flex items-center gap-2.5 rounded-lg px-3 py-2 text-left hover:bg-gray-50 transition-colors" data-network="mainnet">
							<span class="h-2 w-2 rounded-full bg-emerald-500 flex-shrink-0"></span>
							<span class="text-[12px] font-medium text-gray-900 flex-1">Mainnet</span>
							<svg id="check-mainnet" class="h-3.5 w-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
						</button>
						<button onclick="selectNetwork('testnet', 'Testnet', 'bg-amber-500')" class="network-option w-full flex items-center gap-2.5 rounded-lg px-3 py-2 text-left hover:bg-gray-50 transition-colors" data-network="testnet">
							<span class="h-2 w-2 rounded-full bg-amber-500 flex-shrink-0"></span>
							<span class="text-[12px] font-medium text-gray-700 flex-1">Testnet</span>
							<svg id="check-testnet" class="h-3.5 w-3.5 text-emerald-500 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
						</button>
						<button onclick="selectNetwork('futurenet', 'Futurenet', 'bg-violet-500')" class="network-option w-full flex items-center gap-2.5 rounded-lg px-3 py-2 text-left hover:bg-gray-50 transition-colors" data-network="futurenet">
							<span class="h-2 w-2 rounded-full bg-violet-500 flex-shrink-0"></span>
							<span class="text-[12px] font-medium text-gray-700 flex-1">Futurenet</span>
							<svg id="check-futurenet" class="h-3.5 w-3.5 text-emerald-500 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
						</button>
					</div>
				</div>
			</div>
			<!-- Mobile hamburger -->
			<button onclick="document.getElementById('mobile-drawer').style.transform='translateX(0)'; document.getElementById('drawer-backdrop').classList.remove('hidden');" class="flex md:hidden items-center justify-center h-9 w-9 rounded-lg text-gray-700 hover:bg-gray-100 transition-colors">
				<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
			</button>
		</div>
	</header>

	<!-- Mobile drawer overlay -->
	<div id="drawer-backdrop" class="hidden fixed inset-0 bg-black/30 z-40" onclick="document.getElementById('mobile-drawer').style.transform='translateX(-100%)'; this.classList.add('hidden');"></div>
	<!-- Mobile drawer -->
	<nav id="mobile-drawer" style="transform: translateX(-100%)" class="fixed top-0 left-0 bottom-0 w-72 bg-white z-50 transition-transform duration-300 ease-in-out shadow-xl overflow-y-auto">
		<div class="flex items-center justify-between px-5 py-4 border-b border-gray-200">
			<a href="/" class="flex items-center gap-2">
				<div class="flex h-7 w-7 items-center justify-center rounded-lg bg-[#111] text-white">
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 22 20 2 20"/></svg>
				</div>
				<span class="text-[15px] font-bold tracking-tight">Prism</span>
			</a>
			<button onclick="document.getElementById('mobile-drawer').style.transform='translateX(-100%)'; document.getElementById('drawer-backdrop').classList.add('hidden');" class="h-8 w-8 flex items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100">
				<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
			</button>
		</div>
		<div class="py-2">
			@mobileNavItem("/", "Explorer", active == "explorer")
			@mobileNavItem("/network", "Network", active == "network")
			@mobileNavItem("/assets", "Assets", active == "assets")
			@mobileNavItem("/contracts", "Contracts", active == "contracts")
			@mobileNavItem("/events", "Dev Tools", active == "devtools")
		</div>
	</nav>
}

templ mobileNavItem(href string, label string, isActive bool) {
	if isActive {
		<a href={ templ.SafeURL(href) } onclick="document.getElementById('mobile-drawer').style.transform='translateX(-100%)'; document.getElementById('drawer-backdrop').classList.add('hidden');"
		   class="flex items-center px-5 py-3 text-[14px] font-semibold text-gray-900 bg-gray-50 border-l-2 border-[#111]">
			{ label }
		</a>
	} else {
		<a href={ templ.SafeURL(href) } onclick="document.getElementById('mobile-drawer').style.transform='translateX(-100%)'; document.getElementById('drawer-backdrop').classList.add('hidden');"
		   class="flex items-center px-5 py-3 text-[14px] font-medium text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors border-l-2 border-transparent">
			{ label }
		</a>
	}
}

templ navItem(href string, label string, isActive bool) {
	if isActive {
		<a href={ templ.SafeURL(href) }
		   class="relative flex items-center px-3 h-full text-gray-900
				  after:content-[''] after:absolute after:bottom-[-1px] after:left-0 after:right-0
				  after:h-[2px] after:bg-[#111]">
			{ label }
		</a>
	} else {
		<a href={ templ.SafeURL(href) }
		   class="relative flex items-center px-3 h-full hover:text-gray-900 transition-colors
				  after:content-[''] after:absolute after:bottom-[-1px] after:left-0 after:right-0
				  after:h-[2px] after:bg-[#111] after:scale-x-0 hover:after:scale-x-100
				  after:transition-transform after:duration-150 after:ease-out after:origin-left">
			{ label }
		</a>
	}
}
