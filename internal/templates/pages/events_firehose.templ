package pages

import (
	"github.com/withObsrvr/prism/internal/templates/components"
	"github.com/withObsrvr/prism/internal/templates/layouts"
)

type EventsFirehoseData struct {
	MatchedEvents string
	LedgerStart   string
	LedgerEnd     string
	EventsPerSec  string
	Filters       []EventFilter
	Events        []FirehoseEvent
}

type EventFilter struct {
	Label string
	Color string // "violet", "cyan"
}

type FirehoseEvent struct {
	Time         string
	Type         string
	TypeColor    string
	ContractName string
	ContractAddr string
	TopicsHTML   string
	Ledger       string
	TxShort      string
	TxHash       string
	IsNew        bool
	AlertBadge   string
	AlertColor   string
	DetailJSON   string
	DetailMeta   string
}

templ EventsFirehose(data EventsFirehoseData) {
	@layouts.Base("Events Firehose — Prism", "devtools") {
		<main class="mx-auto max-w-[1320px] px-4 md:px-8 py-6">
			<!-- Toolbar -->
			<div class="anim mb-4 sticky top-14 z-20 bg-surface-page -mx-4 px-4 md:-mx-8 md:px-8 py-2">
				<div class="flex items-center justify-between gap-4">
					<div class="flex items-center gap-3 flex-1">
						<div class="relative flex-1 max-w-md">
							<svg class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
							<input type="text" placeholder="Filter by contract, topic, tx hash..." class="h-8 w-full rounded-lg border border-border-default bg-surface-card pl-9 pr-3 font-mono text-xs text-text-primary placeholder-text-muted shadow-sm outline-none"/>
						</div>
						<div class="flex items-center gap-1.5">
							for _, f := range data.Filters {
								<span class={ "flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-medium ring-1", templ.KV("bg-violet-50 text-violet-700 ring-violet-200 dark:bg-violet-950/30 dark:text-violet-400 dark:ring-violet-800", f.Color == "violet"), templ.KV("bg-cyan-50 text-cyan-700 ring-cyan-200 dark:bg-cyan-950/30 dark:text-cyan-400 dark:ring-cyan-800", f.Color == "cyan") }>
									{ f.Label }
									<button class="ml-0.5 text-current opacity-50 hover:opacity-100">&times;</button>
								</span>
							}
							<button class="rounded-lg border border-dashed border-border-default px-2.5 py-1 text-xs font-medium text-text-muted hover:border-border-default hover:text-text-body">+ Add filter</button>
						</div>
					</div>
					<div class="flex items-center gap-3 flex-shrink-0">
						<button class="flex items-center gap-1 rounded-lg border border-border-default bg-surface-card px-2.5 py-1.5 text-xs font-medium text-text-body shadow-sm hover:bg-surface-subtle">
							<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
							Export
						</button>
						<button class="flex items-center gap-1 rounded-lg border border-border-default bg-surface-card px-2.5 py-1.5 text-xs font-medium text-text-body shadow-sm hover:bg-surface-subtle">
							<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
							Save filter
						</button>
						<div class="flex items-center gap-2">
							<div class="flex items-end gap-[2px] h-6">
								for _, h := range []string{"4px","6px","8px","12px","10px","16px","22px","18px","14px","20px","24px","16px","8px","12px","20px","14px"} {
									<div class="w-1 rounded-t-sm bg-emerald-500/60" style={ "height:" + h }></div>
								}
							</div>
							<div class="flex flex-col">
								<span class="text-xs font-semibold text-text-primary tabular">~{ data.EventsPerSec }</span>
								<span class="text-2xs text-text-muted">events/s</span>
							</div>
						</div>
						<div class="h-6 w-px bg-border-default"></div>
						<button class="flex items-center gap-1.5 rounded-lg bg-gray-900 dark:bg-gray-100 px-3 py-1.5 text-xs font-semibold text-white dark:text-gray-900 shadow-sm">
							<span class="relative flex h-2 w-2">
								<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
								<span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
							</span>
							Streaming
						</button>
					</div>
				</div>
			</div>

			<!-- Stats bar -->
			<div class="anim d1 border-b border-border-subtle bg-surface-page rounded-lg px-5 py-2.5 mb-4">
				<div class="flex items-center gap-6 text-2xs font-medium text-text-body">
					<span class="flex items-center gap-1.5">
						<span class="h-1.5 w-1.5 rounded-full bg-gray-900"></span>
						Matched: <span class="font-semibold text-text-primary tabular">{ data.MatchedEvents }</span> events
					</span>
					<span class="text-text-muted">|</span>
					<span>Ledger range: <span class="font-mono text-text-primary">{ data.LedgerStart }</span> → <span class="font-mono text-text-primary">{ data.LedgerEnd }</span></span>
					<span class="ml-auto text-text-muted">Showing latest 100 events</span>
				</div>
			</div>

			<!-- Event table -->
			<div class="anim d2">
				<div class="flex items-center border-b border-border-default py-2.5 text-2xs font-semibold uppercase tracking-wider text-text-muted">
					<div class="w-[72px]">Time</div>
					<div class="w-20">Type</div>
					<div class="hidden md:block w-[140px]">Contract</div>
					<div class="flex-1 min-w-[200px]">Topics &amp; Data</div>
					<div class="hidden md:block w-24 text-right">Ledger</div>
					<div class="hidden md:block w-16 text-right pr-1">Tx</div>
				</div>

				for _, ev := range data.Events {
					<details class="group">
						<summary class={ "flex items-center border-b border-border-subtle py-2.5 cursor-pointer list-none hover:bg-surface-subtle", templ.KV("bg-emerald-50/30 dark:bg-transparent", ev.IsNew) }>
							<div class="w-[72px]">
								<span class="font-mono text-xs text-text-body tabular">{ ev.Time }</span>
							</div>
							<div class="w-20">
								@eventTypeBadge(ev.Type, ev.TypeColor)
							</div>
							<div class="hidden md:block w-[140px]">
								<div class="flex flex-col">
									<span class="text-xs font-medium text-text-primary truncate">{ ev.ContractName }</span>
									<span class="font-mono text-2xs text-text-muted truncate">{ ev.ContractAddr }</span>
								</div>
							</div>
							<div class="flex-1 min-w-[200px]">
								<div class="flex items-center gap-1.5">
									@templ.Raw(ev.TopicsHTML)
									if ev.AlertBadge != "" {
										<span class={ "rounded px-1 py-0.5 text-2xs font-bold uppercase", templ.KV("bg-red-100 text-red-700 dark:bg-red-950/30 dark:text-red-400", ev.AlertColor == "red"), templ.KV("bg-amber-100 text-amber-700 dark:bg-amber-950/30 dark:text-amber-400", ev.AlertColor == "amber") }>{ ev.AlertBadge }</span>
									}
								</div>
							</div>
							<div class="hidden md:block w-24 text-right">
								<span class="font-mono text-xs text-text-strong tabular">{ ev.Ledger }</span>
							</div>
							<div class="hidden md:block w-16 text-right pr-1">
								<a href={ templ.SafeURL("/tx/" + ev.TxHash) } class="font-mono text-2xs text-text-muted hover:text-text-primary">{ ev.TxShort }</a>
							</div>
						</summary>
						if ev.DetailJSON != "" {
							<div class="border-b border-border-subtle bg-surface-page px-5 py-4">
								<div class="grid grid-cols-2 gap-4">
									<div>
										<div class="flex items-center justify-between mb-2">
											<span class="text-2xs font-semibold uppercase tracking-wider text-text-muted">Raw Event Data</span>
											@components.CopyButton(ev.DetailJSON)
										</div>
										<pre class="rounded-lg bg-[#1E1E2E] p-3 text-2xs font-mono text-gray-300 overflow-x-auto leading-relaxed">{ ev.DetailJSON }</pre>
									</div>
									<div>
										<span class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-2 block">Context</span>
										<div class="text-xs text-text-body leading-relaxed">{ ev.DetailMeta }</div>
									</div>
								</div>
							</div>
						}
					</details>
				}

				<!-- Load older events -->
				<div class="border-t border-border-default py-4 text-center">
					<button class="rounded-lg border border-border-default bg-surface-card px-4 py-2 text-xs font-medium text-text-body shadow-sm hover:bg-surface-subtle">Load older events</button>
				</div>
			</div>
		</main>
	}
}

templ eventTypeBadge(label, color string) {
	<span class={ "inline-flex items-center rounded px-1.5 py-0.5 text-2xs font-bold",
		templ.KV("bg-cyan-50 text-cyan-700 dark:bg-cyan-950/30 dark:text-cyan-400", color == "transfer"),
		templ.KV("bg-violet-50 text-violet-700 dark:bg-violet-950/30 dark:text-violet-400", color == "contract"),
		templ.KV("bg-emerald-50 text-emerald-700 dark:bg-emerald-950/30 dark:text-emerald-400", color == "mint"),
		templ.KV("bg-amber-50 text-amber-700 dark:bg-amber-950/30 dark:text-amber-400", color == "system"),
		templ.KV("bg-blue-50 text-blue-700 dark:bg-blue-950/30 dark:text-blue-400", color == "approve"),
		templ.KV("bg-red-50 text-red-700 dark:bg-red-950/30 dark:text-red-400", color == "burn"),
		templ.KV("bg-surface-subtle text-text-strong", color == "admin"),
	}>{ label }</span>
}
