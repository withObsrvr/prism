package pages

import (
	"fmt"
	"github.com/withObsrvr/prism/internal/templates/components"
	"github.com/withObsrvr/prism/internal/templates/layouts"
)

type AccountData struct {
	Address      string
	ShortAddress string
	TotalValue   string
	TotalCents   string
	XLMBalance   string
	Trustlines   string
	ActiveOffers string
	Subentries   string
	CreatedAt    string
	HomeDomain   string
	IsFunded     bool
	IsSmartWallet bool
	SignerCount  string
	Balances     []AccountBalance
	Activities   []AccountActivity
	Contracts    []AccountContract
	Offers       []AccountOffer
	Signers      []AccountSigner
	Thresholds   []AccountThreshold
}

type AccountBalance struct {
	Code     string
	Name     string
	Issuer   string
	BgColor  string
	Type     string
	TypeColor string
	Balance  string
	ValueUSD string
	Extra    string
}

type AccountActivity struct {
	IconBg    string
	IconColor string
	IconSVG   string
	Summary   string
	Badge     string
	BadgeColor string
	TxHash    string
	ShortHash string
	Time      string
	DateGroup string
}

type AccountContract struct {
	Name     string
	Badge    string
	BadgeColor string
	Address  string
	TopFn    string
	Calls    string
	Fees     string
	LastCall string
}

type AccountOffer struct {
	Side    string
	SideColor string
	Pair    string
	Price   string
	PriceUnit string
	Amount  string
	OfferID string
}

type AccountSigner struct {
	Address string
	Type    string
	IsSelf  bool
	Weight  string
}

type AccountThreshold struct {
	Label   string
	Value   string
	Pct     string
	Color   string
}

templ AccountPortfolio(data AccountData) {
	@layouts.Base("Account " + data.ShortAddress + " — Prism", "explorer") {
		<main class="mx-auto max-w-[1320px] px-8 py-6">
			<div class="anim mb-8">
				@components.BackNav("Back to Search", "/")
				<!-- Account identity -->
				<div class="flex items-center justify-between mb-4">
					<div class="flex items-center gap-3">
						<div class="flex h-12 w-12 items-center justify-center rounded-full bg-gradient-to-br from-violet-100 to-cyan-100 ring-2 ring-white shadow-sm">
							<svg class="h-6 w-6 text-violet-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
						</div>
						<div>
							<div class="flex items-center gap-2">
								<span class="font-mono text-lg font-semibold text-gray-900">{ data.ShortAddress }</span>
								@components.CopyButton(data.Address)
							</div>
							<div class="flex items-center gap-2 mt-1">
								if data.IsFunded {
									@components.Badge("Funded", "emerald")
								}
								if data.IsSmartWallet {
									@components.Badge("Smart Wallet", "violet")
								}
								<span class="rounded-full bg-gray-100 px-2.5 py-0.5 ring-1 ring-gray-200 text-[10px] font-semibold text-gray-600">Signer on { data.SignerCount } accounts</span>
								<span class="text-[10px] text-gray-400">Created { data.CreatedAt }</span>
							</div>
						</div>
					</div>
					<div class="flex items-center gap-2">
						@components.ActionButtons([]components.ActionButton{
							{Label: "Stellar.expert", Href: "https://stellar.expert/explorer/public/account/" + data.Address, Icon: "external"},
							{Label: "Share", Href: "#", Icon: "share"},
						})
					</div>
				</div>
				if data.HomeDomain != "" {
					<div class="flex items-center gap-1.5 mb-4 text-xs text-gray-500">
						<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>
						<span class="font-medium text-gray-700">{ data.HomeDomain }</span>
					</div>
				}
				<!-- Balance hero -->
				<div class="rounded-xl border border-gray-200 bg-gradient-to-b from-[#FAFAFA] to-white p-6 shadow-sm">
					<div class="flex items-end justify-between">
						<div>
							<div class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 mb-1">Total Estimated Value</div>
							<div class="flex items-baseline">
								<span class="text-[40px] font-semibold leading-none text-gray-900 tabular">{ data.TotalValue }</span>
								<span class="text-xl font-medium text-gray-400 ml-1">{ data.TotalCents }</span>
							</div>
						</div>
						<div class="flex items-center gap-6 text-sm">
							<div class="text-right">
								<div class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">XLM Balance</div>
								<div class="font-mono font-semibold text-gray-900 tabular">{ data.XLMBalance }</div>
							</div>
							<div class="text-right">
								<div class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">Trustlines</div>
								<div class="font-semibold text-gray-900">{ data.Trustlines }</div>
							</div>
							<div class="text-right">
								<div class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">Active Offers</div>
								<div class="font-semibold text-gray-900">{ data.ActiveOffers }</div>
							</div>
							<div class="text-right">
								<div class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">Subentries</div>
								<div class="font-semibold text-gray-900">{ data.Subentries }</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Tabs -->
			<div class="anim d1">
				@components.TabBar([]components.Tab{
					{ID: "portfolio", Label: "Portfolio"},
					{ID: "activity", Label: "Activity"},
					{ID: "soroban", Label: "Soroban"},
					{ID: "signers", Label: "Signers & Thresholds"},
					{ID: "data", Label: "Data Entries (2)"},
				}, "portfolio")
			</div>

			<!-- Balances -->
			<div class="anim d2 mb-10">
				@components.SectionHeader("Balances")
				<div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden">
					<div class="flex items-center px-5 py-2 text-[10px] font-semibold uppercase tracking-wider text-gray-400 border-b border-gray-200 bg-[#FAFAFA]">
						<div class="w-[200px]">Asset</div>
						<div class="w-28">Type</div>
						<div class="flex-1 text-right">Balance</div>
						<div class="w-32 text-right">Value (USD)</div>
					</div>
					for i, b := range data.Balances {
						<div class={ "detail-row flex items-center px-5 py-3.5", templ.KV("border-b border-gray-50", i < len(data.Balances)-1) }>
							<div class="w-[200px]">
								<div class="flex items-center gap-2.5">
									<div class={ "flex h-8 w-8 items-center justify-center rounded-full text-white text-[10px] font-bold shadow-sm", b.BgColor }>{ b.Code }</div>
									<div>
										<div class="text-sm font-semibold text-gray-900">{ b.Code }</div>
										<div class="text-[10px] text-gray-400">{ b.Name }</div>
									</div>
								</div>
							</div>
							<div class="w-28">
								@components.Badge(b.Type, b.TypeColor)
							</div>
							<div class="flex-1 text-right">
								<div class="font-mono text-sm font-medium text-gray-900 tabular">{ b.Balance }</div>
								if b.Extra != "" {
									<div class="text-[10px] text-gray-400">{ b.Extra }</div>
								}
							</div>
							<div class="w-32 text-right text-sm font-semibold text-gray-900 tabular">{ b.ValueUSD }</div>
						</div>
					}
				</div>
			</div>

			<!-- Recent Activity -->
			<div class="anim d3 mb-10">
				<div class="flex items-center justify-between mb-3">
					@components.SectionHeader("Recent Activity")
					<a href="#" class="text-xs font-medium text-gray-500 hover:text-gray-900">View all activity →</a>
				</div>
				<div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden">
					for i, act := range data.Activities {
						if i == 0 || act.DateGroup != data.Activities[i-1].DateGroup {
							<div class="px-5 py-1.5 bg-[#FAFAFA] border-b border-gray-100">
								<span class="text-[10px] font-semibold text-gray-400">{ act.DateGroup }</span>
							</div>
						}
						<div class="detail-row flex items-center justify-between px-5 py-3 border-b border-gray-50">
							<div class="flex items-center gap-3">
								<div class={ "flex h-7 w-7 items-center justify-center rounded-full", act.IconBg }>
									@templ.Raw(act.IconSVG)
								</div>
								<div>
									<p class="text-sm text-gray-700">
										@templ.Raw(act.Summary)
									</p>
									<div class="flex items-center gap-2 mt-0.5">
										@ledgerTxBadge(act.Badge, act.BadgeColor)
										<a href={ templ.SafeURL("/tx/" + act.TxHash) } class="font-mono text-[10px] text-gray-400 hover:text-violet-600">{ act.ShortHash }</a>
									</div>
								</div>
							</div>
							<span class="text-[10px] text-gray-400 flex-shrink-0">{ act.Time }</span>
						</div>
					}
				</div>
			</div>

			<!-- Contract Interactions -->
			<div class="anim d4 mb-10">
				<div class="flex items-center justify-between mb-3">
					@components.SectionHeader("Contract Interactions")
					<a href="#" class="text-xs font-medium text-gray-500 hover:text-gray-900">View Soroban tab →</a>
				</div>
				<div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden">
					<div class="flex items-center px-5 py-2 text-[10px] font-semibold uppercase tracking-wider text-gray-400 border-b border-gray-200 bg-[#FAFAFA]">
						<div class="flex-1">Contract</div>
						<div class="w-28">Top Function</div>
						<div class="w-20 text-right">Calls</div>
						<div class="w-24 text-right">Total Fees</div>
						<div class="w-28 text-right">Last Called</div>
					</div>
					for i, c := range data.Contracts {
						<div class={ "detail-row flex items-center px-5 py-3", templ.KV("border-b border-gray-50", i < len(data.Contracts)-1) }>
							<div class="flex-1">
								<div class="flex items-center gap-2">
									<a href="#" class="text-sm font-medium text-gray-900 hover:text-violet-600">{ c.Name }</a>
									@components.Badge(c.Badge, c.BadgeColor)
								</div>
								<span class="font-mono text-[10px] text-gray-400">{ c.Address }</span>
							</div>
							<div class="w-28"><span class="font-mono text-xs text-violet-600">{ c.TopFn }</span></div>
							<div class="w-20 text-right"><span class="font-mono text-sm font-semibold text-gray-900 tabular">{ c.Calls }</span></div>
							<div class="w-24 text-right"><span class="font-mono text-xs text-gray-700 tabular">{ c.Fees }</span></div>
							<div class="w-28 text-right"><span class="text-xs text-gray-500">{ c.LastCall }</span></div>
						</div>
					}
				</div>
			</div>

			<!-- Active Offers -->
			if len(data.Offers) > 0 {
				<div class="anim d5 mb-10">
					@components.SectionHeader(fmt.Sprintf("Active Offers (%d)", len(data.Offers)))
					<div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden">
						<div class="flex items-center px-5 py-2 text-[10px] font-semibold uppercase tracking-wider text-gray-400 border-b border-gray-200 bg-[#FAFAFA]">
							<div class="w-16">Side</div>
							<div class="w-32">Pair</div>
							<div class="flex-1">Price</div>
							<div class="w-32 text-right">Amount</div>
							<div class="w-24 text-right">Offer ID</div>
						</div>
						for i, o := range data.Offers {
							<div class={ "detail-row flex items-center px-5 py-3", templ.KV("border-b border-gray-50", i < len(data.Offers)-1) }>
								<div class="w-16">
									@components.Badge(o.Side, o.SideColor)
								</div>
								<div class="w-32"><span class="text-sm text-gray-900">{ o.Pair }</span></div>
								<div class="flex-1"><span class="font-mono text-sm text-gray-900">{ o.Price }</span> <span class="text-xs text-gray-400">{ o.PriceUnit }</span></div>
								<div class="w-32 text-right font-mono text-sm text-gray-900 tabular">{ o.Amount }</div>
								<div class="w-24 text-right"><span class="font-mono text-xs text-gray-500">{ o.OfferID }</span></div>
							</div>
						}
					</div>
				</div>
			}

			<!-- Signers & Thresholds -->
			<div class="anim d6 mb-10">
				<div class="flex items-center justify-between mb-3">
					@components.SectionHeader("Signers & Thresholds")
					<a href="#" class="text-xs font-medium text-gray-500 hover:text-gray-900">View full details →</a>
				</div>
				<div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
					<div class="grid grid-cols-2 gap-6">
						<div>
							<div class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 mb-3">Thresholds</div>
							<div class="space-y-3">
								for _, t := range data.Thresholds {
									<div>
										<div class="flex items-center justify-between mb-1">
											<span class="text-xs text-gray-600">{ t.Label }</span>
											<span class="font-mono text-xs font-medium text-gray-900">{ t.Value }</span>
										</div>
										@components.ProgressBar(1, 1, t.Color)
									</div>
								}
							</div>
						</div>
						<div>
							<div class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 mb-3">Signers ({ fmt.Sprintf("%d", len(data.Signers)) })</div>
							<div class="space-y-2">
								for _, s := range data.Signers {
									<div class="flex items-center justify-between rounded-lg bg-[#FAFAFA] px-3 py-2">
										<div class="flex items-center gap-2">
											<span class="font-mono text-xs text-gray-900">{ s.Address }</span>
											@components.Badge(s.Type, "gray")
											if s.IsSelf {
												@components.Badge("Self", "violet")
											}
										</div>
										<span class="font-mono text-xs font-semibold text-gray-900">Weight: { s.Weight }</span>
									</div>
								}
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Context -->
			<div class="anim d7 mb-10">
				@components.SectionHeader("Context")
				<div class="flex items-center gap-3 flex-wrap">
					<a href="/events" class="flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3 py-2 shadow-sm hover:bg-gray-50">
						<svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
						<span class="text-xs font-medium text-gray-700">Firehose: This account's events</span>
					</a>
					<a href={ templ.SafeURL("/account/" + data.Address + "/smart") } class="flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3 py-2 shadow-sm hover:bg-gray-50">
						<svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
						<span class="text-xs font-medium text-gray-700">Smart Account Dashboard</span>
					</a>
					<a href="/devtools/rent" class="flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3 py-2 shadow-sm hover:bg-gray-50">
						<svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
						<span class="text-xs font-medium text-gray-700">State & Rent</span>
					</a>
					<a href={ templ.SafeURL("https://stellar.expert/explorer/public/account/" + data.Address) } class="flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3 py-2 shadow-sm hover:bg-gray-50">
						<svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
						<span class="text-xs font-medium text-gray-700">Stellar.expert</span>
					</a>
				</div>
			</div>
		</main>
	}
}
