package pages

import (
	"github.com/withObsrvr/prism/internal/templates/layouts"
)

// AssetDirectoryV2 renders the alternate bento-style asset explorer.
// Reuses AssetDirectoryData and AssetRow from asset_directory.templ.
templ AssetDirectoryV2(data AssetDirectoryData) {
	@layouts.Base("Assets Explorer — Prism", "assets") {
		<main class="mx-auto max-w-[1320px] px-4 md:px-8 py-6">

			<!-- Header -->
			<div class="anim mt-4 mb-6">
				<h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Assets</h1>
				<div class="text-2xs text-text-muted uppercase tracking-wider mb-1">24h Network Volume</div>
				<div class="text-4xl font-bold text-text-primary tabular mb-3">{ data.NetworkVolume }</div>
				<div class="flex items-center gap-5 text-sm text-text-body">
					<span><span class="font-semibold text-text-primary tabular">{ data.TotalAssets }</span> assets</span>
					<span class="text-text-muted">&middot;</span>
					<span>{ data.ClassicCount } Classic + { data.SEP41Count } SEP-41</span>
					<span class="text-text-muted">&middot;</span>
					<span>Trustlines <span class="font-semibold text-text-primary tabular">{ data.Trustlines }</span></span>
				</div>
			</div>

			<!-- Tabs -->
			<div class="anim d1 flex gap-6 border-b border-border-default text-sm font-medium text-text-muted mb-4">
				<button class="border-b-2 border-text-primary pb-3 text-text-primary font-semibold">All</button>
				<button class="pb-3.5 hover:text-text-primary transition-colors">Classic</button>
				<button class="pb-3.5 hover:text-text-primary transition-colors">Soroban (SEP-41)</button>
			</div>

			<!-- Search + Sort -->
			<div class="anim d1 flex flex-col md:flex-row gap-3 mb-4">
				<div class="relative flex-1">
					<svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
					<input
						type="text"
						placeholder="Filter by name, code, or issuer…"
						class="w-full pl-10 pr-4 py-2.5 bg-surface-card rounded-lg text-sm outline-none border border-border-default placeholder-text-muted focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500"
					/>
				</div>
				<div class="flex items-center gap-2 border border-border-default bg-surface-card px-4 py-2.5 rounded-lg flex-shrink-0">
					<span class="text-sm text-text-muted">Sort:</span>
					<span class="text-sm font-semibold text-text-primary">24h Volume</span>
					<svg class="h-4 w-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
				</div>
			</div>

			<!-- Asset Table: loaded via htmx fragment -->
			<div hx-get="/fragments/assets/table" hx-trigger="load" hx-swap="outerHTML">
				@assetTableSkeleton(8)
			</div>

		</main>
	}
}

templ assetTableSkeleton(n int) {
	<div class="bg-surface-card rounded-xl overflow-hidden shadow-sm border border-border-default">
		for i := 0; i < n; i++ {
			<div class={ "flex items-center gap-4 px-6 py-4", templ.KV("bg-surface-subtle", i%2 == 1) }>
				<div class="h-10 w-10 rounded-full bg-surface-subtle animate-pulse flex-shrink-0"></div>
				<div class="flex-1 space-y-1.5">
					<div class="h-3.5 w-16 rounded bg-surface-subtle animate-pulse"></div>
					<div class="h-3 w-24 rounded bg-surface-subtle animate-pulse"></div>
				</div>
				<div class="h-3.5 w-20 rounded bg-surface-subtle animate-pulse"></div>
				<div class="h-3.5 w-16 rounded bg-surface-subtle animate-pulse"></div>
			</div>
		}
	</div>
}

