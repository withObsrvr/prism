package pages

import (
	"github.com/withObsrvr/prism/internal/templates/components"
	"github.com/withObsrvr/prism/internal/templates/layouts"
)

type TxReceiptData struct {
	Hash          string
	ShortHash     string
	Status        string // "success" or "failed"
	IsSoroban     bool
	HasClassicOps bool
	// Summary
	SummaryHTML   string
	Timestamp     string
	Ledger        string
	OpsCount      string
	EventsCount   string
	// Flow diagram
	SourceAddr    string
	SourceAmount  string
	ContractName  string
	ContractAddr  string
	ContractFn    string
	DestAddr      string
	DestAmount    string
	// Swap details
	EffectiveRate string
	Slippage      string
	Route         string
	// Details
	FeePaid       string
	MaxFee        string
	FeeUSD        string
	SorobanCPU    string
	SorobanMem    string
	SorobanReads  string
	SorobanWrites string
	SeqNumber     string
	// Operations
	Operations    []TxOperation
	// Events
	Events        []TxEvent
	// Balance Changes
	BalanceChanges []TxBalanceChange
	// State Changes
	StateChanges  []TxStateChange
}

type TxOperation struct {
	Index       string
	Type        string
	IsSoroban   bool
	IsPrimary   bool
	Status      string
	SummaryHTML string
	Contract    string
	Function    string
	DetailHTML  string
}

type TxEvent struct {
	Index    string
	Type     string
	TypeColor string
	Contract string
	DataHTML string
}

type TxBalanceChange struct {
	Account   string
	Asset     string
	AssetType string
	TypeColor string
	Change    string
	IsPositive bool
	IsFee     bool
	IsPool    bool
}

type TxStateChange struct {
	Action   string // "Modified", "Created", "Deleted"
	Key      string
	Contract string
	DetailHTML string
}

templ TransactionReceipt(data TxReceiptData) {
	@layouts.Base("Transaction " + data.ShortHash + " — Prism", "explorer") {
		<main class="mx-auto max-w-[1320px] px-4 md:px-8 py-6">
			<div class="anim mb-6">
				@components.BackNav("Back to Activity", "/")
				<div class="flex items-center justify-between">
					<div class="flex items-center gap-3">
						if data.Status == "success" {
							<div class="flex items-center gap-1.5 rounded-full bg-emerald-50 dark:bg-emerald-950/30 px-3 py-1 ring-1 ring-emerald-200 dark:ring-emerald-800">
								<svg class="h-3.5 w-3.5 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
								<span class="text-xs font-semibold text-emerald-700 dark:text-emerald-400">Success</span>
							</div>
						} else {
							<div class="flex items-center gap-1.5 rounded-full bg-red-50 dark:bg-red-950/30 px-3 py-1 ring-1 ring-red-200 dark:ring-red-800">
								<svg class="h-3.5 w-3.5 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path></svg>
								<span class="text-xs font-semibold text-red-600 dark:text-red-400">Failed</span>
							</div>
						}
						if data.IsSoroban {
							@components.Badge("Soroban", "violet")
						}
						if data.HasClassicOps {
							@components.Badge("+ Classic Ops", "gray")
						}
					</div>
					<div class="flex items-center gap-2">
						<a href="#" class="flex items-center gap-1 rounded-lg border border-border-default bg-surface-card px-2.5 py-1.5 text-xs font-medium text-text-body shadow-sm hover:bg-surface-subtle">
							<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
							Stellar.expert
						</a>
						<button class="flex items-center gap-1 rounded-lg border border-border-default bg-surface-card px-2.5 py-1.5 text-xs font-medium text-text-body shadow-sm hover:bg-surface-subtle">
							<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
							Share
						</button>
					</div>
				</div>
			</div>

			<!-- Human-Readable Summary -->
			<div class="anim d1 mb-8 rounded-xl border border-border-default bg-gradient-to-b from-surface-page to-surface-card p-6 shadow-sm">
				<div class="mb-5">
					<p class="text-lg text-text-primary leading-relaxed">
						@templ.Raw(data.SummaryHTML)
					</p>
					<p class="mt-1 text-sm text-text-body">{ data.Timestamp } &middot; Ledger { data.Ledger } &middot; { data.OpsCount } operations &middot; { data.EventsCount } events</p>
				</div>
				<!-- Flow Diagram -->
				<div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-0 py-2 overflow-x-auto">
					<div class="flex items-center gap-2.5 rounded-xl border border-border-default bg-surface-card px-4 py-3 shadow-sm min-w-[170px]">
						<div class="flex h-9 w-9 items-center justify-center rounded-full bg-surface-subtle">
							<svg class="h-5 w-5 text-text-body" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
						</div>
						<div class="flex flex-col">
							<span class="text-xs font-semibold text-text-primary">Source</span>
							<span class="font-mono text-xs text-text-body">{ data.SourceAddr }</span>
							<span class="font-mono text-xs font-semibold text-red-600 mt-0.5">{ data.SourceAmount }</span>
						</div>
					</div>
					<div class="flex flex-col items-center flex-1 px-1">
						<div class="flow-line w-full"></div>
						<span class="mt-1 rounded bg-surface-subtle px-1.5 py-0.5 text-2xs font-bold text-text-body">approve</span>
					</div>
					<div class="flex items-center gap-2.5 rounded-xl border-2 border-violet-200 dark:border-violet-800/60 bg-violet-50/40 dark:bg-violet-950/20 px-4 py-3 shadow-sm min-w-[170px]">
						<div class="flex h-9 w-9 items-center justify-center rounded-full bg-violet-100 dark:bg-violet-900/30">
							<svg class="h-5 w-5 text-violet-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
						</div>
						<div class="flex flex-col">
							<span class="text-xs font-semibold text-text-primary">{ data.ContractName }</span>
							<span class="font-mono text-xs text-text-body">{ data.ContractAddr }</span>
							<span class="text-2xs text-violet-600 font-medium mt-0.5">fn: { data.ContractFn }</span>
						</div>
					</div>
					<div class="flex flex-col items-center flex-1 px-1">
						<div class="flow-line w-full"></div>
						<span class="mt-1 rounded bg-surface-subtle px-1.5 py-0.5 text-2xs font-bold text-text-body">transfer</span>
					</div>
					<div class="flex items-center gap-2.5 rounded-xl border border-border-default bg-surface-card px-4 py-3 shadow-sm min-w-[170px]">
						<div class="flex h-9 w-9 items-center justify-center rounded-full bg-surface-subtle">
							<svg class="h-5 w-5 text-text-body" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
						</div>
						<div class="flex flex-col">
							<span class="text-xs font-semibold text-text-primary">Destination</span>
							<span class="font-mono text-xs text-text-body">{ data.DestAddr }</span>
							<span class="font-mono text-xs font-semibold text-emerald-600 mt-0.5">{ data.DestAmount }</span>
						</div>
					</div>
				</div>
				<div class="mt-4 flex items-center gap-4 text-xs text-text-body">
					<span>Effective rate: <span class="font-semibold text-text-primary">{ data.EffectiveRate }</span></span>
					<span class="text-text-muted">|</span>
					<span>Slippage: <span class="font-semibold text-text-primary">{ data.Slippage }</span></span>
					<span class="text-text-muted">|</span>
					<span>Route: <span class="font-semibold text-text-primary">{ data.Route }</span></span>
				</div>
			</div>

			<!-- Tabs -->
			<div class="anim d2">
				@components.TabBar([]components.Tab{
					{ID: "overview", Label: "Overview"},
					{ID: "operations", Label: "Operations (" + data.OpsCount + ")"},
					{ID: "events", Label: "Events (" + data.EventsCount + ")"},
					{ID: "xdr", Label: "Raw XDR"},
				}, "overview")
			</div>

			<!-- Transaction Details -->
			<div class="anim d3 mb-10">
				@components.SectionHeader("Transaction Details")
				<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden overflow-x-auto">
					@components.DetailRow("Transaction Hash") {
						<div class="flex items-center gap-1.5">
							<span class="font-mono text-sm text-text-primary">{ data.Hash }</span>
							@components.CopyButton(data.Hash)
						</div>
					}
					@components.DetailRow("Ledger") {
						<a href={ templ.SafeURL("/ledger/" + data.Ledger) } class="font-mono text-sm font-medium text-text-primary hover:text-violet-600 tabular">{ data.Ledger }</a>
					}
					@components.DetailRow("Timestamp") {
						<span class="text-sm text-text-primary">{ data.Timestamp }</span>
					}
					@components.DetailRow("Source Account") {
						<div class="flex items-center gap-1.5">
							<a href={ templ.SafeURL("/account/" + data.SourceAddr) } class="font-mono text-sm text-text-primary hover:text-violet-600">{ data.SourceAddr }</a>
							@components.CopyButton(data.SourceAddr)
						</div>
					}
					@components.DetailRow("Fee Paid") {
						<div class="flex items-baseline gap-2">
							<span class="text-sm font-medium text-text-primary">{ data.FeePaid } stroops</span>
							<span class="text-xs text-text-muted">~{ data.FeeUSD }</span>
						</div>
					}
					if data.IsSoroban {
						@components.DetailRow("Soroban Resources") {
							<div class="flex items-center gap-3 text-xs text-text-body">
								<span class="rounded bg-surface-subtle px-2 py-0.5 font-mono">CPU: { data.SorobanCPU }</span>
								<span class="rounded bg-surface-subtle px-2 py-0.5 font-mono">Mem: { data.SorobanMem }</span>
								<span class="rounded bg-surface-subtle px-2 py-0.5 font-mono">Read: { data.SorobanReads }</span>
								<span class="rounded bg-surface-subtle px-2 py-0.5 font-mono">Write: { data.SorobanWrites }</span>
							</div>
						}
					}
					@components.DetailRowLast("Sequence Number") {
						<span class="font-mono text-sm text-text-primary tabular">{ data.SeqNumber }</span>
					}
				</div>
			</div>

			<!-- Operations -->
			<div class="anim d4 mb-10">
				<div class="flex items-center justify-between mb-3">
					@components.SectionHeader("Operations")
					<span class="text-2xs text-text-muted">{ data.OpsCount } operations in this transaction</span>
				</div>
				<div class="space-y-3">
					for _, op := range data.Operations {
						<div class={ "rounded-xl bg-surface-card p-4 shadow-sm", templ.KV("border-2 border-violet-200", op.IsPrimary), templ.KV("border border-border-default", !op.IsPrimary) }>
							<div class="flex items-center justify-between mb-3">
								<div class="flex items-center gap-2">
									<span class={ "flex h-6 w-6 items-center justify-center rounded-full text-2xs font-bold", templ.KV("bg-violet-100 dark:bg-violet-900/30 text-violet-700 dark:text-violet-400", op.IsPrimary), templ.KV("bg-surface-subtle text-text-body", !op.IsPrimary) }>{ op.Index }</span>
									<span class="text-sm font-semibold text-text-primary">{ op.Type }</span>
									if op.IsSoroban {
										@components.Badge("Soroban", "violet")
									} else {
										@components.Badge("Classic", "gray")
									}
									if op.IsPrimary {
										@components.Badge("Primary", "amber")
									}
								</div>
								<span class="rounded bg-emerald-50 dark:bg-emerald-950/30 px-1.5 py-0.5 text-2xs font-bold text-emerald-700 dark:text-emerald-400">{ op.Status }</span>
							</div>
							<div class="rounded-lg bg-surface-page px-4 py-3 mb-3">
								<p class="text-sm text-text-strong">
									@templ.Raw(op.SummaryHTML)
								</p>
							</div>
							<div class="flex items-center gap-4 text-xs text-text-body">
								if op.Contract != "" {
									<span>Contract: <span class="font-mono text-text-strong">{ op.Contract }</span></span>
									<span class="text-text-muted">|</span>
								}
								if op.Function != "" {
									<span>Function: <span class="font-mono font-semibold text-violet-600">{ op.Function }</span></span>
								}
							</div>
						</div>
					}
				</div>
			</div>

			<!-- Events -->
			<div class="anim d5 mb-10">
				<div class="flex items-center justify-between mb-3">
					@components.SectionHeader("Contract Events (CAP-67)")
					<span class="text-2xs text-text-muted">{ data.EventsCount } events emitted</span>
				</div>
				<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden overflow-x-auto">
					<div class="flex items-center px-4 py-2 text-2xs font-semibold uppercase tracking-wider text-text-muted border-b border-border-subtle bg-surface-page">
						<div class="hidden md:block w-8">#</div>
						<div class="w-20">Type</div>
						<div class="w-[130px]">Contract</div>
						<div class="flex-1">Decoded Data</div>
					</div>
					for _, evt := range data.Events {
						<div class="detail-row flex items-center px-4 py-3 border-b border-border-subtle cursor-pointer">
							<div class="hidden md:block w-8"><span class="text-2xs font-mono text-text-muted">{ evt.Index }</span></div>
							<div class="w-20">
								@components.TypeBadge(evt.Type, evt.TypeColor)
							</div>
							<div class="w-[130px]"><span class="text-xs text-text-strong">{ evt.Contract }</span></div>
							<div class="flex-1">
								@templ.Raw(evt.DataHTML)
							</div>
						</div>
					}
				</div>
			</div>

			<!-- Net Balance Changes -->
			<div class="anim d6 mb-10">
				@components.SectionHeader("Net Balance Changes")
				<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden overflow-x-auto">

					<div class="flex items-center px-5 py-2 text-2xs font-semibold uppercase tracking-wider text-text-muted border-b border-border-subtle bg-surface-page">
						<div class="flex-1">Account</div>
						<div class="w-28 text-right">Asset</div>
						<div class="hidden md:block w-28 text-right">Type</div>
						<div class="w-40 text-right">Change</div>
					</div>
					for _, bc := range data.BalanceChanges {
						<div class={ "detail-row flex items-center px-5 py-3 border-b border-border-subtle", templ.KV("opacity-60", bc.IsFee || bc.IsPool) }>
							<div class="flex-1"><span class="font-mono text-xs text-text-primary">{ bc.Account }</span></div>
							<div class="w-28 text-right"><span class="text-sm font-medium text-text-primary">{ bc.Asset }</span></div>
							<div class="hidden md:block w-28 text-right">
								@components.Badge(bc.AssetType, bc.TypeColor)
							</div>
							<div class="w-40 text-right">
								if bc.IsPositive {
									<span class="font-mono text-sm font-semibold text-emerald-600 tabular">{ bc.Change }</span>
								} else {
									<span class="font-mono text-sm font-semibold text-red-600 tabular">{ bc.Change }</span>
								}
							</div>
						</div>
					}

				</div>
			</div>

			<!-- Soroban State Changes -->
			if len(data.StateChanges) > 0 {
				<div class="anim d7 mb-10">
					@components.SectionHeader("Soroban State Changes")
					<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden overflow-x-auto">
						for _, sc := range data.StateChanges {
							<div class="detail-row flex items-start px-5 py-3.5 border-b border-border-subtle">
								<div class="w-20 flex-shrink-0">
									@components.Badge(sc.Action, "amber")
								</div>
								<div class="flex-1">
									<div class="flex items-center gap-2 mb-1">
										<span class="font-mono text-xs text-text-primary">{ sc.Key }</span>
										<span class="text-2xs text-text-muted">on</span>
										<span class="text-xs text-text-strong">{ sc.Contract }</span>
									</div>
									<div class="font-mono text-xs text-text-body">
										@templ.Raw(sc.DetailHTML)
									</div>
								</div>
							</div>
						}
					</div>
				</div>
			}

			<!-- Context Links -->
			<div class="anim d8 mb-10">
				@components.SectionHeader("Context")
				<div class="flex items-center gap-3 flex-wrap">
					<a href={ templ.SafeURL("/contracts/" + data.ContractAddr) } class="flex items-center gap-1.5 rounded-lg border border-border-default bg-surface-card px-3 py-2 shadow-sm hover:bg-surface-subtle">
						<svg class="h-4 w-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
						<span class="text-xs font-medium text-text-strong">View Contract</span>
						<span class="font-mono text-2xs text-text-muted">{ data.ContractAddr }</span>
					</a>
					<a href={ templ.SafeURL("/account/" + data.SourceAddr) } class="flex items-center gap-1.5 rounded-lg border border-border-default bg-surface-card px-3 py-2 shadow-sm hover:bg-surface-subtle">
						<svg class="h-4 w-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
						<span class="text-xs font-medium text-text-strong">View Account</span>
						<span class="font-mono text-2xs text-text-muted">{ data.SourceAddr }</span>
					</a>
					<a href={ templ.SafeURL("/ledger/" + data.Ledger) } class="flex items-center gap-1.5 rounded-lg border border-border-default bg-surface-card px-3 py-2 shadow-sm hover:bg-surface-subtle">
						<svg class="h-4 w-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
						<span class="text-xs font-medium text-text-strong">View Ledger</span>
						<span class="font-mono text-2xs text-text-muted">{ data.Ledger }</span>
					</a>
					<a href="/events" class="flex items-center gap-1.5 rounded-lg border border-border-default bg-surface-card px-3 py-2 shadow-sm hover:bg-surface-subtle">
						<svg class="h-4 w-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
						<span class="text-xs font-medium text-text-strong">Firehose: Soroswap swaps</span>
					</a>
				</div>
			</div>
		</main>
	}
}
