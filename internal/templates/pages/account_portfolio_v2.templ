package pages

import (
	"github.com/withObsrvr/prism/internal/templates/components"
	"github.com/withObsrvr/prism/internal/templates/layouts"
)

// AccountPortfolioV2 renders the streamlined account detail page.
templ AccountPortfolioV2(data AccountData) {
	@layouts.Base("Account " + data.ShortAddress + " — Prism", "explorer") {
		<main class="mx-auto max-w-[1320px] px-4 md:px-8 py-6">

			<!-- Header: address hero + inline stats -->
			<div class="anim mt-4 mb-5">
				@components.BackNav("Back to Explorer", "/")
				<div class="flex items-center gap-3 mb-1">
					<span class="font-mono text-lg font-semibold text-text-body">{ data.ShortAddress }</span>
					@components.CopyButton(data.Address)
					if data.IsFunded {
						@components.Badge("Funded", "emerald")
					}
					if data.IsSmartWallet {
						@components.Badge("Smart Wallet", "violet")
					}
				</div>
				<!-- Hero number: total value -->
				<div class="flex items-baseline mb-3">
					<span class="text-4xl font-bold text-text-primary tabular">{ data.TotalValue }</span>
					<span class="text-2xl font-medium text-text-muted ml-0.5">{ data.TotalCents }</span>
				</div>
				<div class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-text-body">
					<span>XLM <span class="font-mono font-semibold text-text-primary tabular">{ data.XLMBalance }</span></span>
					<span class="text-text-muted">&middot;</span>
					<span>Trustlines <span class="font-semibold text-text-primary">{ data.Trustlines }</span></span>
					<span class="text-text-muted">&middot;</span>
					<span>Signers <span class="font-semibold text-text-primary">{ data.SignerCount }</span></span>
					if data.HomeDomain != "" {
						<span class="text-text-muted">&middot;</span>
						<span class="font-medium text-emerald-700">{ data.HomeDomain }</span>
					}
					if data.CreatedAt != "" {
						<span class="text-text-muted">&middot;</span>
						<span>Created { data.CreatedAt }</span>
					}
				</div>
			</div>

			<!-- Tabs -->
			<div class="anim d1 flex gap-6 border-b border-border-default text-sm font-medium text-text-muted mb-6">
				<button class="border-b-2 border-text-primary pb-3 text-text-primary font-semibold">Portfolio</button>
				<button class="pb-3.5 hover:text-text-primary transition-colors">Activity</button>
				<button class="pb-3.5 hover:text-text-primary transition-colors">Soroban</button>
				<button class="pb-3.5 hover:text-text-primary transition-colors">Signers</button>
			</div>

			<!-- Balances: loaded via htmx fragment -->
			<div hx-get={ "/fragments/account/" + data.Address + "/balances" } hx-trigger="load" hx-swap="outerHTML">
				@accountTableSkeleton(4)
			</div>

			<!-- Activity + Contracts + Offers: loaded via htmx fragment -->
			<div hx-get={ "/fragments/account/" + data.Address + "/activity" } hx-trigger="load" hx-swap="outerHTML">
				@accountTableSkeleton(5)
			</div>

			<!-- Signers & Thresholds: loaded via htmx fragment -->
			<div hx-get={ "/fragments/account/" + data.Address + "/signers" } hx-trigger="load" hx-swap="outerHTML">
				<div class="mb-8 grid grid-cols-1 lg:grid-cols-2 gap-6">
					for i := 0; i < 2; i++ {
						<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden">
							for j := 0; j < 3; j++ {
								<div class="flex items-center justify-between px-5 py-2.5 border-b border-border-subtle">
									<div class="h-3.5 w-24 rounded bg-surface-subtle animate-pulse"></div>
									<div class="h-3.5 w-16 rounded bg-surface-subtle animate-pulse"></div>
								</div>
							}
						</div>
					}
				</div>
			</div>

		</main>
	}
}

templ accountTableSkeleton(n int) {
	<div class="mb-8">
		<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden">
			for i := 0; i < n; i++ {
				<div class={ "flex items-center gap-4 px-5 py-3", templ.KV("bg-surface-subtle", i%2 == 1) }>
					<div class="h-8 w-8 rounded-full bg-surface-subtle animate-pulse flex-shrink-0"></div>
					<div class="flex-1 space-y-1.5">
						<div class="h-3.5 w-24 rounded bg-surface-subtle animate-pulse"></div>
						<div class="h-3 w-16 rounded bg-surface-subtle animate-pulse"></div>
					</div>
					<div class="h-3.5 w-20 rounded bg-surface-subtle animate-pulse"></div>
					<div class="h-3.5 w-16 rounded bg-surface-subtle animate-pulse"></div>
				</div>
			}
		</div>
	</div>
}
