package pages

import (
	"fmt"
	"github.com/withObsrvr/prism/internal/templates/components"
	"github.com/withObsrvr/prism/internal/templates/layouts"
)

type AssetDirectoryData struct {
	TotalAssets   string
	ClassicCount  string
	SEP41Count    string
	NetworkVolume string
	VolumeChange  string
	Trustlines    string
	DEXLiquidity  string
	ActiveFilter  string
	Assets        []AssetRow
	CurrentPage   int
	TotalPages    int
}

type AssetRow struct {
	Rank       int
	Code       string
	Slug       string
	Name       string
	Issuer     string
	BgColor    string
	Initial    string
	Price      string
	Change     string
	IsUp       bool
	IsVerified bool
	MarketCap  string
	Volume     string
	Supply     string
	Holders    string
	TypeBadge  string
	TypeColor  string
}

templ AssetDirectory(data AssetDirectoryData) {
	@layouts.Base("Assets — Prism", "assets") {
		<main class="mx-auto max-w-[1320px] px-4 md:px-8 py-6">
			<!-- Header -->
			<div class="anim mb-6">
				<div class="flex items-center justify-between">
					<div class="flex items-center gap-3">
						<div>
						<h1 class="text-2xl font-bold text-text-primary">Asset Directory</h1>
						<p class="text-xs text-text-body mt-0.5">Browse all classic and SEP-41 assets on Stellar</p>
					</div>
						<div class="flex items-center gap-1 rounded-full bg-emerald-50 dark:bg-emerald-950/30 px-2 py-0.5 ring-1 ring-emerald-200/60 dark:ring-emerald-800/60">
							<span class="h-1.5 w-1.5 rounded-full bg-emerald-500 pulse-dot"></span>
							<span class="text-2xs font-medium text-emerald-700 dark:text-emerald-400">Live</span>
						</div>
					</div>
					<div class="text-right text-xs text-text-body">
						<span class="font-semibold text-text-primary tabular">{ data.TotalAssets }</span> total assets
						<span class="text-text-muted mx-1">&middot;</span>
						{ data.ClassicCount } Classic + { data.SEP41Count } SEP-41
					</div>
				</div>
			</div>

			<!-- Stats -->
			<div class="anim d1 mb-6 grid grid-cols-2 md:grid-cols-4 gap-3">
				<div class="rounded-xl border border-border-default bg-surface-card px-4 py-3 shadow-sm">
					<div class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-1">24h Network Volume</div>
					<div class="text-lg font-semibold text-text-primary tabular">{ data.NetworkVolume }</div>
					<div class="text-2xs text-emerald-600 font-medium mt-0.5">{ data.VolumeChange }</div>
				</div>
				<div class="rounded-xl border border-border-default bg-surface-card px-4 py-3 shadow-sm">
					<div class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-1">Active Trustlines</div>
					<div class="text-lg font-semibold text-text-primary tabular">{ data.Trustlines }</div>
				</div>
				<div class="rounded-xl border border-border-default bg-surface-card px-4 py-3 shadow-sm">
					<div class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-1">DEX Liquidity</div>
					<div class="text-lg font-semibold text-text-primary tabular">{ data.DEXLiquidity }</div>
				</div>
				<div class="rounded-xl border border-border-default bg-surface-card px-4 py-3 shadow-sm">
					<div class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-1">Total Assets</div>
					<div class="text-lg font-semibold text-text-primary tabular">{ data.TotalAssets }</div>
				</div>
			</div>

			<!-- Filter controls -->
			<div class="anim d2 mb-6 flex items-center gap-3">
				<div class="flex items-center gap-1">
					<span class="text-2xs font-semibold uppercase tracking-wider text-text-muted mr-1">Asset Type</span>
					<button class="rounded-lg border border-gray-900 dark:border-gray-100 bg-gray-900 dark:bg-gray-100 px-2.5 py-1.5 text-xs font-semibold text-white dark:text-gray-900 shadow-sm">All</button>
					<button class="rounded-lg border border-border-default bg-surface-card px-2.5 py-1.5 text-xs font-medium text-text-body shadow-sm hover:bg-surface-subtle">Classic</button>
					<button class="rounded-lg border border-border-default bg-surface-card px-2.5 py-1.5 text-xs font-medium text-violet-600 shadow-sm hover:bg-violet-50 dark:hover:bg-violet-950/30">SEP-41</button>
					<button class="rounded-lg border border-border-default bg-surface-card px-2.5 py-1.5 text-xs font-medium text-amber-600 shadow-sm hover:bg-amber-50 dark:hover:bg-amber-950/30">LP Tokens</button>
				</div>
				<div class="flex items-center gap-2">
					<span class="text-2xs font-semibold uppercase tracking-wider text-text-muted">Filters</span>
					<select class="rounded-lg border border-border-default bg-surface-card px-2.5 py-1.5 text-xs font-medium text-text-body shadow-sm outline-none">
						<option>All Categories</option>
						<option>Stablecoins</option>
						<option>DeFi</option>
						<option>Meme</option>
						<option>Wrapped</option>
					</select>
					<button class="rounded-lg border border-border-default bg-surface-card px-2.5 py-1.5 text-xs font-medium text-text-body shadow-sm hover:bg-surface-subtle flex items-center gap-1">
						<svg class="h-3 w-3 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
						Verified only
					</button>
				</div>
				<div class="flex-1"></div>
				<div class="flex items-center gap-2 rounded-lg border border-border-default bg-surface-card px-3 py-1.5 shadow-sm">
					<svg class="h-3.5 w-3.5 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
					<input type="text" placeholder="Search assets..." class="text-xs text-text-primary placeholder-text-muted outline-none bg-transparent w-40"/>
				</div>
			</div>

			<!-- Asset table -->
			<div class="anim d3 mb-6">
				<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden overflow-x-auto">
					<div class="flex items-center px-5 py-2.5 text-2xs font-semibold uppercase tracking-wider text-text-muted border-b border-border-default bg-surface-page">
						<div class="hidden md:block w-10">#</div>
						<div class="w-[180px]">Asset</div>
						<div class="w-24 text-right">Price</div>
						<div class="w-20 text-right">24h</div>
						<div class="hidden md:block w-28 text-right">Market Cap</div>
						<div class="hidden md:block w-24 text-right">Volume</div>
						<div class="hidden md:block w-28 text-right">Supply</div>
						<div class="hidden md:block w-20 text-right">Holders</div>
						<div class="hidden md:block w-16 text-right">Type</div>
					</div>
					for _, a := range data.Assets {
						<a href={ templ.SafeURL(assetRowHref(a)) } class="detail-row flex items-center px-5 py-3 border-b border-border-subtle cursor-pointer hover:bg-surface-subtle">
							<div class="hidden md:block w-10"><span class="text-xs font-semibold text-text-muted tabular">{ fmt.Sprintf("%d", a.Rank) }</span></div>
							<div class="w-[180px]">
								<div class="flex items-center gap-2.5">
									<div class={ "flex h-7 w-7 items-center justify-center rounded-full text-white text-2xs font-bold", a.BgColor }>{ a.Initial }</div>
									<div>
										<div class="flex items-center gap-1">
											<span class="text-sm font-semibold text-text-primary">{ a.Code }</span>
											if a.IsVerified {
												<svg class="h-3.5 w-3.5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
											}
										</div>
										<div class="text-2xs text-text-muted">{ a.Name }</div>
									</div>
								</div>
							</div>
							<div class="w-24 text-right font-mono text-sm text-text-primary tabular">{ a.Price }</div>
							<div class="w-20 text-right">
								if a.IsUp {
									<span class="text-xs font-semibold text-emerald-600 tabular">{ a.Change }</span>
								} else {
									<span class="text-xs font-semibold text-red-500 tabular">{ a.Change }</span>
								}
							</div>
							<div class="hidden md:block w-28 text-right text-xs text-text-strong tabular">{ a.MarketCap }</div>
							<div class="hidden md:block w-24 text-right text-xs text-text-strong tabular">{ a.Volume }</div>
							<div class="hidden md:block w-28 text-right font-mono text-xs text-text-body tabular">{ a.Supply }</div>
							<div class="hidden md:block w-20 text-right text-xs text-text-body tabular">{ a.Holders }</div>
							<div class="hidden md:block w-16 text-right">
								@components.Badge(a.TypeBadge, a.TypeColor)
							</div>
						</a>
					}
				</div>
			</div>

			<!-- Pagination -->
			@components.Pagination(data.CurrentPage, data.TotalPages, "/assets")
		</main>
	}
}

func assetRowHref(a AssetRow) string {
	if a.Slug != "" {
		return "/assets/" + a.Slug
	}
	if a.Code != "" {
		return "/assets/" + a.Code
	}
	return "/assets"
}
