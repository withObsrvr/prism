package pages

import (
	"github.com/withObsrvr/prism/internal/templates/components"
	"github.com/withObsrvr/prism/internal/templates/layouts"
)

type SearchData struct {
	Query         string
	DetectedType  string // "account", "contract", "transaction", "ledger", "asset", ""
	DetectedLabel string
	DetectedDesc  string
	DetectedHref  string
	Results       []SearchResultGroup
	RecentSearches []string
}

type SearchResultGroup struct {
	Category string // "Contracts", "Accounts", "Assets"
	Items    []SearchResultItem
}

type SearchResultItem struct {
	Name     string
	Badge    string
	BadgeColor string
	Subtitle string
	IconBg   string
	IconHTML string
	Href     string
}

type SearchTip struct {
	Pattern string
	Desc    string
}

templ Search(data SearchData) {
	@layouts.Base("Search: " + data.Query + " — Prism", "explorer") {
		<main class="mx-auto max-w-[1320px] px-4 md:px-8 py-6">
			<!-- Search bar -->
			<form action="/search" method="GET" class="anim mb-8">
				<div class="search-ring flex items-center gap-3 rounded-xl border border-border-default bg-surface-card px-5 py-3.5 shadow-sm">
					<svg class="h-5 w-5 text-text-muted flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
					<input
						type="text"
						name="q"
						value={ data.Query }
						autofocus
						placeholder="Search by address, tx hash, contract, asset, or ledger…"
						class="font-mono text-base text-text-primary placeholder-text-muted flex-1 outline-none bg-transparent"
						autocomplete="off"
					/>
					if data.Query != "" {
						<a href="/search" class="rounded-lg border border-border-default bg-surface-page px-2.5 py-1 text-xs font-medium text-text-body hover:bg-surface-subtle">Clear</a>
					}
				</div>
			</form>

			<!-- Type Detection Banner -->
			if data.DetectedType != "" {
				<div class="anim d1 mb-8 flex items-center gap-3 rounded-xl border border-violet-200 dark:border-violet-800 bg-violet-50/30 dark:bg-violet-950/20 px-5 py-4">
					<div class="flex h-10 w-10 items-center justify-center rounded-full bg-violet-100 dark:bg-violet-900/30 flex-shrink-0">
						<svg class="h-5 w-5 text-violet-600 dark:text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
					</div>
					<div class="flex-1">
						<div class="flex items-center gap-2">
							<span class="text-sm font-semibold text-text-primary">{ data.DetectedLabel }</span>
							@components.Badge(data.DetectedType + " detected", "violet")
						</div>
						<p class="text-xs text-text-body mt-0.5">{ data.DetectedDesc }</p>
					</div>
					<a href={ templ.SafeURL(data.DetectedHref) } class="flex items-center gap-1 rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-violet-700">
						View { data.DetectedType }
						<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
					</a>
				</div>
			}

			<!-- Disambiguation -->
			<div class="anim d2 mb-10">
				@components.SectionHeader("Also search as")
				<div class="grid grid-cols-1 md:grid-cols-3 gap-3">
					<a href={ templ.SafeURL("/search?q=" + data.Query + "&type=tx") } class="flex items-center gap-3 rounded-xl border border-border-default bg-surface-card px-4 py-3 shadow-sm hover:bg-surface-subtle group">
						<div class="flex h-8 w-8 items-center justify-center rounded-lg bg-surface-subtle flex-shrink-0 group-hover:bg-surface-subtle">
							<svg class="h-4 w-4 text-text-body" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
						</div>
						<div>
							<div class="text-xs font-semibold text-text-primary">Transaction Hash</div>
							<div class="text-2xs text-text-muted">Search as tx hash</div>
						</div>
					</a>
					<a href={ templ.SafeURL("/search?q=" + data.Query + "&type=contract") } class="flex items-center gap-3 rounded-xl border border-border-default bg-surface-card px-4 py-3 shadow-sm hover:bg-surface-subtle group">
						<div class="flex h-8 w-8 items-center justify-center rounded-lg bg-surface-subtle flex-shrink-0 group-hover:bg-surface-subtle">
							<svg class="h-4 w-4 text-text-body" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
						</div>
						<div>
							<div class="text-xs font-semibold text-text-primary">Contract Address</div>
							<div class="text-2xs text-text-muted">Search as contract</div>
						</div>
					</a>
					<a href={ templ.SafeURL("/search?q=" + data.Query + "&type=asset") } class="flex items-center gap-3 rounded-xl border border-border-default bg-surface-card px-4 py-3 shadow-sm hover:bg-surface-subtle group">
						<div class="flex h-8 w-8 items-center justify-center rounded-lg bg-surface-subtle flex-shrink-0 group-hover:bg-surface-subtle">
							<svg class="h-4 w-4 text-text-body" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"></path></svg>
						</div>
						<div>
							<div class="text-xs font-semibold text-text-primary">Asset Code</div>
							<div class="text-2xs text-text-muted">Search assets by code</div>
						</div>
					</a>
				</div>
			</div>

			<!-- Recent Searches -->
			if len(data.RecentSearches) > 0 {
				<div class="anim d3 mb-10">
					@components.SectionHeader("Recent Searches")
					<div class="flex items-center gap-2 flex-wrap">
						for _, s := range data.RecentSearches {
							<a href={ templ.SafeURL("/search?q=" + s) } class="flex items-center gap-1.5 rounded-lg border border-border-default bg-surface-card px-3 py-2 shadow-sm hover:bg-surface-subtle">
								<svg class="h-3.5 w-3.5 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
								<span class="font-mono text-xs text-text-strong">{ s }</span>
							</a>
						}
					</div>
				</div>
			}

			<!-- Empty State -->
			if data.Query != "" && len(data.Results) == 0 && data.DetectedType == "" {
				<div class="anim d3 mb-10">
					@components.EmptyState("search", "No results found", "Try a different search term, or check the search tips below for supported formats.", "", "")
				</div>
			}

			<!-- Search Results -->
			if len(data.Results) > 0 {
				<div class="anim d3 mb-10">
					for _, group := range data.Results {
						<div class="mb-6">
							@components.SectionHeader(group.Category)
							<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden">
								for i, item := range group.Items {
									<a href={ templ.SafeURL(item.Href) } class={ "detail-row flex items-center gap-3 px-5 py-3 hover:bg-surface-subtle", templ.KV("border-b border-border-subtle", i < len(group.Items)-1) }>
										<div class={ "flex h-8 w-8 items-center justify-center rounded-lg flex-shrink-0", item.IconBg }>
											@templ.Raw(item.IconHTML)
										</div>
										<div class="flex-1">
											<div class="flex items-center gap-2">
												<span class="text-sm font-medium text-text-primary">{ item.Name }</span>
												if item.Badge != "" {
													@components.Badge(item.Badge, item.BadgeColor)
												}
											</div>
											if item.Subtitle != "" {
												<span class="text-2xs text-text-muted">{ item.Subtitle }</span>
											}
										</div>
										<svg class="h-4 w-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
									</a>
								}
							</div>
						</div>
					}
				</div>
			}

			<!-- Search Tips -->
			<div class="anim d4 mb-10">
				@components.SectionHeader("Search Tips")
				<div class="rounded-xl border border-border-default bg-surface-card p-5 shadow-sm">
					<div class="grid grid-cols-2 gap-4 text-xs text-text-body">
						<div class="flex items-start gap-2">
							<span class="font-mono text-violet-600 font-semibold flex-shrink-0">G...</span>
							<span>Account address — opens Account Portfolio</span>
						</div>
						<div class="flex items-start gap-2">
							<span class="font-mono text-violet-600 font-semibold flex-shrink-0">C...</span>
							<span>Contract address — opens Contract Detail</span>
						</div>
						<div class="flex items-start gap-2">
							<span class="font-mono text-violet-600 font-semibold flex-shrink-0">64 hex</span>
							<span>Transaction hash — opens Transaction Receipt</span>
						</div>
						<div class="flex items-start gap-2">
							<span class="font-mono text-violet-600 font-semibold flex-shrink-0">12345</span>
							<span>Ledger sequence — opens Ledger Detail</span>
						</div>
						<div class="flex items-start gap-2">
							<span class="font-mono text-violet-600 font-semibold flex-shrink-0">USDC</span>
							<span>Asset code — opens Asset Directory entry</span>
						</div>
						<div class="flex items-start gap-2">
							<span class="font-mono text-violet-600 font-semibold flex-shrink-0">name</span>
							<span>Free text — fuzzy search across all entities</span>
						</div>
					</div>
				</div>
			</div>
		</main>
	}
}
