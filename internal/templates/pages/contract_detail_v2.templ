package pages

import (
	"fmt"
	"github.com/withObsrvr/prism/internal/templates/components"
	"github.com/withObsrvr/prism/internal/templates/layouts"
)

templ ContractDetailV2(data ContractDetailData) {
	@layouts.Base(data.Name + " — Prism", "contracts") {
		<main class="mx-auto max-w-[1320px] px-4 md:px-8 py-6">

			<!-- Header -->
			<div class="anim mt-4 mb-5">
				@components.BackNav("Back to Contracts", "/contracts")
				<div class="flex items-center gap-3 mb-2">
					<span class="text-2xl font-bold text-text-primary">{ data.Name }</span>
					if data.IsVerified {
						<svg class="h-5 w-5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
					}
					for _, tag := range data.Tags {
						@components.Badge(tag, "violet")
					}
				</div>
				<div class="flex items-center gap-1.5 mb-3">
					<span class="font-mono text-xs text-text-muted">{ data.Address }</span>
					@components.CopyButton(data.Address)
				</div>
				<div class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-text-body">
					<span>Invocations <span class="font-semibold text-text-primary tabular">{ data.TotalInvocations }</span></span>
					<span class="text-text-muted">&middot;</span>
					<span>Last called <span class="font-semibold text-text-primary">{ data.LastInvoked }</span></span>
					<span class="text-text-muted">&middot;</span>
					<span>Deployed <span class="font-semibold text-text-primary">{ data.DeployedAt }</span></span>
					<span class="text-text-muted">&middot;</span>
					<span>Functions <span class="font-semibold text-text-primary">{ data.FunctionsCount }</span></span>
					<span class="text-text-muted">&middot;</span>
					<span>State <span class="font-semibold text-text-primary">{ data.StateSize }</span></span>
				</div>
			</div>

			<!-- Tabs -->
			<div class="anim d1 flex gap-6 border-b border-border-default text-sm font-medium text-text-muted mb-6">
				<button class="border-b-2 border-text-primary pb-3 text-text-primary font-semibold">Overview</button>
				<button class="pb-3.5 hover:text-text-primary transition-colors">Invocations</button>
				<button class="pb-3.5 hover:text-text-primary transition-colors">Storage</button>
				<button class="pb-3.5 hover:text-text-primary transition-colors">Code</button>
			</div>

			<!-- Contract Info: loaded via htmx fragment -->
			<div hx-get={ "/fragments/contract/" + data.Address + "/info" } hx-trigger="load" hx-swap="outerHTML">
				@contractDetailSkeleton(4)
			</div>

			<!-- Functions: loaded via htmx fragment -->
			<div hx-get={ "/fragments/contract/" + data.Address + "/functions" } hx-trigger="load" hx-swap="outerHTML">
				@contractTableSkeleton(5)
			</div>

			<!-- Recent Invocations: loaded via htmx fragment -->
			<div hx-get={ "/fragments/contract/" + data.Address + "/invocations" } hx-trigger="load" hx-swap="outerHTML">
				@contractTableSkeleton(5)
			</div>

			<!-- Storage -->
			if len(data.StorageItems) > 0 {
				<div class="anim d3 mb-8">
					<h3 class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-2">Storage Entries ({ fmt.Sprintf("%s", data.StorageEntries) })</h3>
					<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden">
						<table class="w-full text-left">
							<thead>
								<tr class="text-2xs font-mono text-text-muted uppercase tracking-widest bg-surface-subtle">
									<th class="px-5 py-3 font-medium">Key</th>
									<th class="px-4 py-3 font-medium">Type</th>
									<th class="px-4 py-3 font-medium text-right">Size</th>
									<th class="px-4 py-3 font-medium text-right">TTL</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-border-subtle">
								for _, s := range data.StorageItems {
									<tr>
										<td class="px-5 py-3"><span class="font-mono text-xs text-text-primary">{ s.Key }</span></td>
										<td class="px-4 py-3">
											@components.TypeBadge(s.Type, s.TypeColor)
										</td>
										<td class="px-4 py-3 text-right text-xs text-text-strong">{ s.Size }</td>
										<td class="px-4 py-3 text-right text-xs text-text-strong">{ s.TTL }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}

		</main>
	}
}

templ contractDetailSkeleton(n int) {
	<div class="mb-8">
		<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden">
			for i := 0; i < n; i++ {
				<div class="flex items-center px-5 py-2.5 border-b border-border-subtle">
					<div class="h-3.5 w-24 rounded bg-surface-subtle animate-pulse"></div>
					<div class="h-3.5 w-48 rounded bg-surface-subtle animate-pulse ml-4"></div>
				</div>
			}
		</div>
	</div>
}

templ contractTableSkeleton(n int) {
	<div class="mb-8">
		<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden">
			for i := 0; i < n; i++ {
				<div class={ "flex items-center gap-4 px-5 py-3", templ.KV("bg-surface-subtle", i%2 == 1) }>
					<div class="flex-1 space-y-1.5">
						<div class="h-3.5 w-32 rounded bg-surface-subtle animate-pulse"></div>
						<div class="h-3 w-24 rounded bg-surface-subtle animate-pulse"></div>
					</div>
					<div class="h-3.5 w-14 rounded bg-surface-subtle animate-pulse"></div>
					<div class="h-3.5 w-14 rounded bg-surface-subtle animate-pulse"></div>
				</div>
			}
		</div>
	</div>
}
