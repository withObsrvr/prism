package pages

import (
	"fmt"
	"github.com/withObsrvr/prism/internal/templates/components"
	"github.com/withObsrvr/prism/internal/templates/layouts"
	ui "github.com/withObsrvr/prism/internal/viewmodel"
)

type ContractDetailData struct {
	Name           string
	Address        string
	IsVerified     bool
	Tags           []string
	DeployedAt     string
	DeployLedger   string
	TotalInvocations string
	StorageEntries string
	StateSize      string
	MonthlyRent    string
	LastInvoked    string
	Functions      []ContractFunction
	Invocations    []ContractInvocation
	StorageItems   []ContractStorageItem
	StorageStats   ContractStorageStats
	StorageTypes   []ContractStorageTypeAgg
	CodePreview    string
	WASMHash       string
	// Phase 1A additions
	Creator         string
	CreatorHref     string
	WASMSize        string
	FunctionsCount  string
	IsSourceVerified bool
	ActivityPoints  []float64
	AvgInvocations  string
	PeakInvocations string
	SuccessRate     string
	ExportedFunctions []string
	Narrative       string
	Context         string
	FunctionSummary string
	StorageSummary  string
	Signals         []ContractHumanSignal
	Evidence        []ContractHumanEvidence
	Portfolio       ui.BalancePortfolio
	BalanceFragmentHref string
}

type ContractFunction struct {
	Name        string
	Description string
	Category    string
	Calls       string
	Pct         string
	AvgCPU      string
	LastCalled  string
	Calls24h    string
	Calls7d     string
	Calls30d    string
	SuccessRate string
}

type ContractInvocation struct {
	TxHash      string
	ShortHash   string
	Function    string
	Caller      string
	Status      string
	StatusColor string
	Summary     string
	CPUUsed     string
	Age         string
}

type ContractStorageItem struct {
	Key      string
	Type     string // "Instance", "Persistent", "Temporary"
	TypeColor string
	Size     string
	TTL      string
	// Storage explorer enrichment (v2 State & rent panel)
	Sub        string // plain-language description of the key
	ValueType  string // e.g. "Address", "i128", "Map"
	Value      string // decoded value preview
	KeyHash    string // hash used by the lake storage endpoint
	SizeBytes  int
	TTLDays    int
	TTLLedgers int
	HealthPct  int    // % of max TTL remaining
}

type ContractStorageStats struct {
	TotalEntries   string
	MonthlyRentXLM string
	MonthlyRentUSD string
	Healthy        string
	AtRisk         string
	Critical       string
}

type ContractStorageTypeAgg struct {
	Name    string // "Instance", "Persistent", "Temporary"
	Entries string
	Size    string
	MinTTL  string
}

type ContractHumanSignal struct {
	Title    string
	Severity string
	Summary  string
}

type ContractHumanEvidence struct {
	Label string
	Value string
}

templ ContractDetail(data ContractDetailData) {
	@layouts.Base(data.Name + " — Prism", "contracts") {
		<main class="mx-auto max-w-[1320px] px-4 md:px-8 py-6">
			<!-- Header -->
			<div class="anim mb-6">
				@components.BackNav("Back to Contracts", "/contracts")
				<div class="flex items-center justify-between">
					<div class="flex items-center gap-3">
						<div class="flex h-12 w-12 items-center justify-center rounded-xl bg-violet-100 dark:bg-violet-900/30 shadow-sm">
							<svg class="h-6 w-6 text-violet-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
						</div>
						<div>
							<div class="flex items-center gap-2">
								<span class="text-xl font-bold text-text-primary">{ data.Name }</span>
								if data.IsVerified {
									@components.Badge("Verified", "emerald")
								}
								for _, tag := range data.Tags {
									@components.Badge(tag, "violet")
								}
							</div>
							<div class="flex items-center gap-2 mt-1">
								<span class="font-mono text-xs text-text-body">{ data.Address }</span>
								@components.CopyButton(data.Address)
								<span class="text-2xs text-text-muted">Deployed { data.DeployedAt } · Ledger { data.DeployLedger }</span>
							</div>
						</div>
					</div>
					@components.ActionButtons([]components.ActionButton{
						{Label: "Stellar.expert", Href: "#", Icon: "external"},
						{Label: "Share", Href: "#", Icon: "share"},
					})
				</div>
			</div>
			if data.BalanceFragmentHref != "" {
				@BalancePortfolioLoader(data.BalanceFragmentHref)
			} else {
				@BalancePortfolio(data.Portfolio)
			}

			<!-- Quick Stats -->
			<div class="anim d1 mb-8 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
				<div class="rounded-xl border border-border-default bg-surface-card px-4 py-3 shadow-sm">
					<div class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-1">Total Invocations</div>
					<div class="text-lg font-semibold text-text-primary tabular">{ data.TotalInvocations }</div>
				</div>
				<div class="rounded-xl border border-border-default bg-surface-card px-4 py-3 shadow-sm">
					<div class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-1">Storage Entries</div>
					<div class="text-lg font-semibold text-text-primary tabular">{ data.StorageEntries }</div>
				</div>
				<div class="rounded-xl border border-border-default bg-surface-card px-4 py-3 shadow-sm">
					<div class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-1">State Size</div>
					<div class="text-lg font-semibold text-text-primary tabular">{ data.StateSize }</div>
				</div>
				<div class="rounded-xl border border-border-default bg-surface-card px-4 py-3 shadow-sm">
					<div class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-1">Monthly Rent</div>
					<div class="text-lg font-semibold text-text-primary tabular">{ data.MonthlyRent }</div>
				</div>
				<div class="rounded-xl border border-border-default bg-surface-card px-4 py-3 shadow-sm">
					<div class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-1">Last Invoked</div>
					<div class="text-lg font-semibold text-text-primary">{ data.LastInvoked }</div>
				</div>
			</div>

			<!-- Activity Chart + Contract Info Sidebar -->
			<div class="anim d2 mb-8 grid grid-cols-1 md:grid-cols-3 gap-6">
				<!-- Activity sparkline chart -->
				<div class="md:col-span-2 rounded-xl border border-border-default bg-surface-card p-5 shadow-sm">
					<div class="flex items-center justify-between mb-4">
						<span class="text-xs font-semibold uppercase tracking-wider text-text-muted">Invocation Activity (30d)</span>
						<div class="flex items-center gap-3 text-2xs">
							<span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-violet-500"></span>Invocations</span>
						</div>
					</div>
					<div class="h-32">
						@components.MiniSparkline(data.ActivityPoints, 600, 128, "violet")
					</div>
					<div class="flex justify-between mt-2 text-2xs text-text-muted">
						<span>30d ago</span><span>20d</span><span>10d</span><span>Now</span>
					</div>
					<div class="flex items-center gap-6 mt-4 pt-4 border-t border-border-subtle">
						<div><span class="text-2xs text-text-muted">Avg/day</span><div class="text-sm font-semibold text-text-primary tabular">{ data.AvgInvocations }</div></div>
						<div><span class="text-2xs text-text-muted">Peak</span><div class="text-sm font-semibold text-text-primary tabular">{ data.PeakInvocations }</div></div>
						<div><span class="text-2xs text-text-muted">Success Rate</span><div class="text-sm font-semibold text-emerald-600 tabular">{ data.SuccessRate }</div></div>
					</div>
				</div>
				<!-- Contract Info sidebar -->
				<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden overflow-x-auto">
					<div class="px-5 py-3 bg-surface-page border-b border-border-subtle">
						<span class="text-2xs font-semibold uppercase tracking-wider text-text-muted">Contract Info</span>
					</div>
					@components.DetailRow("Creator") {
						<a href={ templ.SafeURL(data.CreatorHref) } class="font-mono text-xs text-emerald-700 hover:underline">{ data.Creator }</a>
					}
					@components.DetailRow("Deployed") {
						<span class="text-xs text-text-primary">Ledger { data.DeployLedger }</span>
					}
					@components.DetailRow("WASM Hash") {
						<div class="flex items-center gap-1">
							<span class="font-mono text-2xs text-text-strong truncate max-w-[140px]">{ data.WASMHash }</span>
							@components.CopyButton(data.WASMHash)
						</div>
					}
					@components.DetailRow("WASM Size") {
						<span class="text-xs text-text-primary">{ data.WASMSize }</span>
					}
					@components.DetailRow("Functions") {
						<span class="text-xs text-text-primary">{ data.FunctionsCount }</span>
					}
					@components.DetailRowLast("Source") {
						if data.IsSourceVerified {
							@components.Badge("Verified", "emerald")
						} else {
							@components.Badge("Unverified", "gray")
						}
					}
				</div>
			</div>

			<!-- Tabs -->
			<div class="anim d3">
				@components.TabBar([]components.Tab{
					{ID: "overview", Label: "Overview"},
					{ID: "invocations", Label: "Invocations"},
					{ID: "events", Label: "Events (CAP-67)"},
					{ID: "storage", Label: "Storage"},
					{ID: "code", Label: "Code"},
				}, "overview")
			</div>

			<!-- Exported Functions -->
			if len(data.ExportedFunctions) > 0 {
				<div class="anim d4 mb-6">
					<div class="flex items-center gap-2 flex-wrap">
						for _, fn := range data.ExportedFunctions {
							@components.Badge(fn, "violet")
						}
					</div>
				</div>
			}

			<!-- Top Functions -->
			<div class="anim d4 mb-10">
				@components.SectionHeader("Top Functions")
				<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden overflow-x-auto">
					<div class="flex items-center px-5 py-2 text-2xs font-semibold uppercase tracking-wider text-text-muted border-b border-border-default bg-surface-page">
						<div class="w-[180px]">Function</div>
						<div class="w-20 text-right">24h</div>
						<div class="hidden md:block w-20 text-right">7d</div>
						<div class="hidden md:block w-20 text-right">30d</div>
						<div class="hidden md:block w-24 text-right">Success</div>
						<div class="hidden md:block w-28 text-right">Avg CPU</div>
						<div class="hidden md:block flex-1 text-right">Last Called</div>
					</div>
					for i, fn := range data.Functions {
						<div class={ "detail-row flex items-center px-5 py-3", templ.KV("border-b border-border-subtle", i < len(data.Functions)-1) }>
							<div class="w-[180px]"><span class="font-mono text-sm font-medium text-violet-600">{ fn.Name }</span></div>
							<div class="w-20 text-right"><span class="font-mono text-xs text-text-primary tabular">{ fn.Calls24h }</span></div>
							<div class="hidden md:block w-20 text-right"><span class="font-mono text-xs text-text-strong tabular">{ fn.Calls7d }</span></div>
							<div class="hidden md:block w-20 text-right"><span class="font-mono text-xs text-text-body tabular">{ fn.Calls30d }</span></div>
							<div class="hidden md:block w-24 text-right"><span class="text-xs font-medium text-emerald-600 tabular">{ fn.SuccessRate }</span></div>
							<div class="hidden md:block w-28 text-right"><span class="font-mono text-xs text-text-body tabular">{ fn.AvgCPU }</span></div>
							<div class="hidden md:block flex-1 text-right"><span class="text-xs text-text-body">{ fn.LastCalled }</span></div>
						</div>
					}
				</div>
			</div>

			<!-- Recent Invocations -->
			<div class="anim d5 mb-10">
				<div class="flex items-center justify-between mb-3">
					@components.SectionHeader("Recent Invocations")
					<a href="/events" class="text-xs font-medium text-violet-600 hover:text-violet-700">View all invocations →</a>
				</div>
				<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden overflow-x-auto">
					for i, inv := range data.Invocations {
						<div class={ "detail-row flex items-center px-5 py-3", templ.KV("border-b border-border-subtle", i < len(data.Invocations)-1) }>
							<div class="flex items-center gap-2 w-5">
								if inv.StatusColor == "emerald" || inv.StatusColor == "" {
									<span class="h-2 w-2 rounded-full bg-emerald-500"></span>
								} else if inv.StatusColor == "red" {
									<span class="h-2 w-2 rounded-full bg-red-500"></span>
								} else {
									<span class="h-2 w-2 rounded-full bg-amber-500"></span>
								}
							</div>
							<div class="flex-1">
								<div class="flex items-center gap-2">
									<a href={ templ.SafeURL("/tx/" + inv.TxHash) } class="font-mono text-xs text-text-primary hover:text-violet-600">{ inv.ShortHash }</a>
									<span class="font-mono text-xs text-violet-600">{ inv.Function }</span>
									@components.Badge(inv.Status, "emerald")
								</div>
								if inv.Summary != "" {
									<span class="text-2xs text-text-body mt-0.5">{ inv.Summary }</span>
								}
								<span class="font-mono text-2xs text-text-muted mt-0.5">by { inv.Caller }</span>
							</div>
							<div class="flex items-center gap-4">
								if inv.CPUUsed != "" {
									<span class="font-mono text-2xs text-text-muted tabular">{ inv.CPUUsed }</span>
								}
								<span class="text-2xs text-text-muted">{ inv.Age }</span>
							</div>
						</div>
					}
				</div>
			</div>

			<!-- Storage Preview -->
			<div class="anim d6 mb-10">
				<div class="flex items-center justify-between mb-3">
					@components.SectionHeader("Storage Entries")
					<a href="/state" class="text-xs font-medium text-violet-600 hover:text-violet-700">View all entries →</a>
				</div>
				<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden overflow-x-auto">
					<div class="flex items-center px-5 py-2 text-2xs font-semibold uppercase tracking-wider text-text-muted border-b border-border-default bg-surface-page">
						<div class="flex-1">Key</div>
						<div class="w-28">Type</div>
						<div class="hidden md:block w-20 text-right">Size</div>
						<div class="w-28 text-right">TTL</div>
					</div>
					for i, s := range data.StorageItems {
						<div class={ "detail-row flex items-center px-5 py-3", templ.KV("border-b border-border-subtle", i < len(data.StorageItems)-1) }>
							<div class="flex-1"><span class="font-mono text-xs text-text-primary">{ s.Key }</span></div>
							<div class="w-28">
								@components.Badge(s.Type, s.TypeColor)
							</div>
							<div class="hidden md:block w-20 text-right"><span class="text-xs text-text-body tabular">{ s.Size }</span></div>
							<div class="w-28 text-right"><span class="text-xs text-text-body tabular">{ s.TTL }</span></div>
						</div>
					}
				</div>
			</div>

			<!-- Code Preview -->
			<div class="anim d7 mb-10">
				@components.SectionHeader("Code & WASM")
				<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden overflow-x-auto">
					<div class="flex items-center justify-between px-5 py-3 border-b border-border-subtle bg-surface-page">
						<span class="text-xs text-text-body">WASM Hash: <span class="font-mono text-text-strong">{ data.WASMHash }</span></span>
						@components.Badge("Rust", "amber")
					</div>
					<pre class="p-5 text-xs font-mono text-gray-300 overflow-x-auto bg-[#1E1E2E] leading-relaxed">{ data.CodePreview }</pre>
				</div>
			</div>

			<!-- Context -->
			<div class="anim d8 mb-10">
				@components.SectionHeader("Context")
				<div class="flex items-center gap-3 flex-wrap">
					<a href={ templ.SafeURL(data.CreatorHref) } class="flex items-center gap-1.5 rounded-lg border border-border-default bg-surface-card px-3 py-2 shadow-sm hover:bg-surface-subtle">
						<svg class="h-4 w-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
						<span class="text-xs font-medium text-text-strong">Creator Account</span>
						<span class="font-mono text-2xs text-text-muted">{ data.Creator }</span>
					</a>
					<a href="#" class="flex items-center gap-1.5 rounded-lg border border-border-default bg-surface-card px-3 py-2 shadow-sm hover:bg-surface-subtle">
						<svg class="h-4 w-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
						<span class="text-xs font-medium text-text-strong">Stellar.expert</span>
					</a>
					<a href="/events" class="flex items-center gap-1.5 rounded-lg border border-border-default bg-surface-card px-3 py-2 shadow-sm hover:bg-surface-subtle">
						<svg class="h-4 w-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
						<span class="text-xs font-medium text-text-strong">Firehose: { data.Name } events</span>
					</a>
					<a href="/state" class="flex items-center gap-1.5 rounded-lg border border-border-default bg-surface-card px-3 py-2 shadow-sm hover:bg-surface-subtle">
						<svg class="h-4 w-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
						<span class="text-xs font-medium text-text-strong">State &amp; Rent Tracker</span>
					</a>
				</div>
			</div>
		</main>
	}
}

// ContractList stub — just reuse ContractDetail page pattern but simplified.
type ContractListData struct {
	Contracts []ContractListItem
}

type ContractListItem struct {
	Rank        int
	Name        string
	Address     string
	Href        string
	Tag         string
	TagColor    string
	Invocations string
	Change      string
	IsPositive  bool
}

templ ContractList(data ContractListData) {
	@layouts.Base("Contracts — Prism", "contracts") {
		<main class="mx-auto max-w-[1320px] px-4 md:px-8 py-6">
			<div class="anim mb-6">
				<h1 class="text-2xl font-bold text-text-primary">Smart Contracts</h1>
				<p class="text-sm text-text-body mt-1">Browse deployed Soroban smart contracts on Stellar</p>
			</div>
			<div class="anim d1 rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden overflow-x-auto">
				<div class="flex items-center px-5 py-2.5 text-2xs font-semibold uppercase tracking-wider text-text-muted border-b border-border-default bg-surface-page">
					<div class="hidden md:block w-10">#</div>
					<div class="flex-1">Contract</div>
					<div class="w-28 text-right">7d Invocations</div>
					<div class="hidden md:block w-20 text-right">Change</div>
				</div>
				for _, c := range data.Contracts {
					<a href={ templ.SafeURL(c.Href) } class="detail-row flex items-center px-5 py-3 border-b border-border-subtle hover:bg-surface-subtle">
						<div class="hidden md:block w-10"><span class="text-xs font-semibold text-text-muted tabular">{ fmt.Sprintf("%d", c.Rank) }</span></div>
						<div class="flex-1">
							<div class="flex items-center gap-2">
								<span class="text-sm font-semibold text-text-primary">{ c.Name }</span>
								@components.Badge(c.Tag, c.TagColor)
							</div>
							<span class="font-mono text-2xs text-text-muted">{ c.Address }</span>
						</div>
						<div class="w-28 text-right"><span class="font-mono text-sm font-semibold text-text-primary tabular">{ c.Invocations }</span></div>
						<div class="hidden md:block w-20 text-right">
							if c.IsPositive {
								<span class="text-xs font-semibold text-emerald-600 tabular">{ c.Change }</span>
							} else {
								<span class="text-xs font-semibold text-red-500 tabular">{ c.Change }</span>
							}
						</div>
					</a>
				}
			</div>
		</main>
	}
}
