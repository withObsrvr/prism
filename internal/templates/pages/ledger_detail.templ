package pages

import (
	"fmt"
	"github.com/withObsrvr/prism/internal/templates/components"
	"github.com/withObsrvr/prism/internal/templates/layouts"
)

type LedgerDetailData struct {
	Sequence     string
	PrevSequence string
	NextSequence string
	ClosedAt     string
	CloseTime    string
	Hash         string
	PrevHash     string
	Protocol     string
	BaseFee      string
	MaxTxSetSize string
	TotalCoins   string
	TxCount      string
	TxSuccess    string
	TxFailed     string
	OpCount      string
	OpsPerTx     string
	SorobanCalls string
	SorobanPct   string
	TotalFees    string
	FeesUSD      string
	EventsEmitted string
	// Soroban runtime
	TotalCPU     string
	StateReads   string
	StateReadKB  string
	StateWrites  string
	StateWriteKB string
	RentBurned   string
	// Op breakdown
	OpBreakdown  []OpBreakdownItem
	// Transactions
	Transactions []LedgerTx
	// Fee distribution
	FeeBase      string
	FeeMedian    string
	FeeP99       string
	SurgeActive  bool
	SurgePct     string
}

type OpBreakdownItem struct {
	Name    string
	Count   string
	Pct     string
	Width   string
	Color   string
}

type LedgerTx struct {
	Index   string
	Status  string // "ok" or "failed"
	Hash    string
	ShortHash string
	OpType  string
	OpColor string // "violet", "cyan", "emerald", "gray"
	Summary string
	Ops     string
	Fee     string
	IsFailed bool
}

templ LedgerDetail(data LedgerDetailData) {
	@layouts.Base(fmt.Sprintf("Ledger %s — Prism", data.Sequence), "explorer") {
		<main class="mx-auto max-w-[1320px] px-8 py-6">
			<div class="anim mb-6">
				@components.BackNav("Back to Explorer", "/")
				<div class="flex items-center justify-between">
					<div class="flex items-center gap-4">
						<h1 class="font-mono text-3xl font-bold text-gray-900 tabular">{ data.Sequence }</h1>
						<div class="flex items-center gap-1">
							<a href={ templ.SafeURL("/ledger/" + data.PrevSequence) } class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white shadow-sm hover:bg-gray-50" title="Previous ledger">
								<svg class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
							</a>
							<a href={ templ.SafeURL("/ledger/" + data.NextSequence) } class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white shadow-sm hover:bg-gray-50" title="Next ledger">
								<svg class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
							</a>
						</div>
					</div>
					<div class="flex items-center gap-2">
						@components.Badge("Closed", "emerald")
						@components.Badge("Protocol v"+data.Protocol, "violet")
					</div>
				</div>
			</div>

			<!-- Stats Row -->
			<div class="anim d1 mb-8 grid grid-cols-6 gap-3">
				<div class="rounded-xl border border-gray-200 bg-white px-4 py-3 shadow-sm">
					<div class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 mb-1">Close Time</div>
					<div class="text-lg font-semibold text-gray-900 tabular">{ data.CloseTime }</div>
					<div class="flex items-center gap-1 mt-0.5">
						<span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
						<span class="text-[10px] text-gray-500">Within target</span>
					</div>
				</div>
				<div class="rounded-xl border border-gray-200 bg-white px-4 py-3 shadow-sm">
					<div class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 mb-1">Transactions</div>
					<div class="text-lg font-semibold text-gray-900 tabular">{ data.TxCount }</div>
					<div class="text-[10px] text-gray-500 mt-0.5">{ data.TxSuccess } successful, { data.TxFailed } failed</div>
				</div>
				<div class="rounded-xl border border-gray-200 bg-white px-4 py-3 shadow-sm">
					<div class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 mb-1">Operations</div>
					<div class="text-lg font-semibold text-gray-900 tabular">{ data.OpCount }</div>
					<div class="text-[10px] text-gray-500 mt-0.5">~{ data.OpsPerTx } ops/tx avg</div>
				</div>
				<div class="rounded-xl border border-gray-200 bg-white px-4 py-3 shadow-sm">
					<div class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 mb-1">Soroban Calls</div>
					<div class="flex items-baseline gap-1">
						<div class="text-lg font-semibold text-violet-700 tabular">{ data.SorobanCalls }</div>
						<div class="text-[10px] text-violet-500 font-medium">{ data.SorobanPct }</div>
					</div>
					<div class="text-[10px] text-gray-500 mt-0.5">of total transactions</div>
				</div>
				<div class="rounded-xl border border-gray-200 bg-white px-4 py-3 shadow-sm">
					<div class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 mb-1">Total Fees</div>
					<div class="text-lg font-semibold text-gray-900 tabular">{ data.TotalFees }</div>
					<div class="text-[10px] text-gray-500 mt-0.5">XLM (~{ data.FeesUSD })</div>
				</div>
				<div class="rounded-xl border border-gray-200 bg-white px-4 py-3 shadow-sm">
					<div class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 mb-1">Events Emitted</div>
					<div class="text-lg font-semibold text-gray-900 tabular">{ data.EventsEmitted }</div>
					<div class="text-[10px] text-gray-500 mt-0.5">CAP-67 contract events</div>
				</div>
			</div>

			<!-- Ledger Details -->
			<div class="anim d2 mb-10">
				@components.SectionHeader("Ledger Details")
				<div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden">
					@components.DetailRow("Sequence") {
						<span class="font-mono text-sm font-medium text-gray-900 tabular">{ data.Sequence }</span>
					}
					@components.DetailRow("Closed At") {
						<span class="text-sm text-gray-900">{ data.ClosedAt }</span>
					}
					@components.DetailRow("Hash") {
						<span class="font-mono text-sm text-gray-900">{ data.Hash }</span>
					}
					@components.DetailRow("Previous Ledger Hash") {
						<a href={ templ.SafeURL("/ledger/" + data.PrevSequence) } class="font-mono text-sm text-gray-900 hover:text-violet-600">{ data.PrevHash }</a>
					}
					@components.DetailRow("Protocol Version") {
						<div class="flex items-center gap-2">
							<span class="text-sm font-medium text-gray-900">{ data.Protocol }</span>
							@components.Badge("Latest", "emerald")
						</div>
					}
					@components.DetailRow("Base Fee") {
						<div class="flex items-baseline gap-2">
							<span class="text-sm font-medium text-gray-900">{ data.BaseFee } stroops</span>
							<span class="text-xs text-gray-400">0.00001 XLM</span>
						</div>
					}
					@components.DetailRow("Max Tx Set Size") {
						<span class="text-sm text-gray-900 tabular">{ data.MaxTxSetSize }</span>
					}
					@components.DetailRowLast("Total Coins") {
						<span class="font-mono text-sm text-gray-900 tabular">{ data.TotalCoins }</span>
					}
				</div>
			</div>

			<!-- Soroban Runtime -->
			<div class="anim d3 mb-10">
				@components.SectionHeader("Soroban Runtime (this ledger)")
				<div class="grid grid-cols-4 gap-3">
					<div class="rounded-xl border border-violet-200 bg-violet-50/30 px-4 py-3">
						<div class="text-[10px] font-semibold uppercase tracking-wider text-violet-500 mb-1">Total CPU</div>
						<div class="text-lg font-semibold text-violet-900 tabular font-mono">{ data.TotalCPU }</div>
						<div class="text-[10px] text-violet-600">instructions across { data.SorobanCalls } invocations</div>
					</div>
					<div class="rounded-xl border border-violet-200 bg-violet-50/30 px-4 py-3">
						<div class="text-[10px] font-semibold uppercase tracking-wider text-violet-500 mb-1">State Reads</div>
						<div class="text-lg font-semibold text-violet-900 tabular font-mono">{ data.StateReads }</div>
						<div class="text-[10px] text-violet-600">entries / { data.StateReadKB } total</div>
					</div>
					<div class="rounded-xl border border-violet-200 bg-violet-50/30 px-4 py-3">
						<div class="text-[10px] font-semibold uppercase tracking-wider text-violet-500 mb-1">State Writes</div>
						<div class="text-lg font-semibold text-violet-900 tabular font-mono">{ data.StateWrites }</div>
						<div class="text-[10px] text-violet-600">entries / { data.StateWriteKB } total</div>
					</div>
					<div class="rounded-xl border border-violet-200 bg-violet-50/30 px-4 py-3">
						<div class="text-[10px] font-semibold uppercase tracking-wider text-violet-500 mb-1">Rent Burned</div>
						<div class="text-lg font-semibold text-violet-900 tabular font-mono">{ data.RentBurned }</div>
						<div class="text-[10px] text-violet-600">XLM in this ledger</div>
					</div>
				</div>
			</div>

			<!-- Operation Type Breakdown -->
			<div class="anim d4 mb-10">
				@components.SectionHeader("Operation Type Breakdown")
				<div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
					<div class="flex h-6 w-full overflow-hidden rounded-full mb-4">
						for _, op := range data.OpBreakdown {
							<div class={ "h-full", op.Color } style={ "width:" + op.Width }></div>
						}
					</div>
					<div class="flex flex-wrap gap-x-6 gap-y-2 text-xs">
						for _, op := range data.OpBreakdown {
							<div class="flex items-center gap-2">
								<span class={ "h-2.5 w-2.5 rounded-full", op.Color }></span>
								<span class="text-gray-700 font-medium">{ op.Name }</span>
								<span class="font-mono text-gray-500 tabular">{ op.Count } ({ op.Pct })</span>
							</div>
						}
					</div>
				</div>
			</div>

			<!-- Transactions -->
			<div class="anim d5 mb-10">
				<div class="flex items-center justify-between mb-3">
					@components.SectionHeader(fmt.Sprintf("Transactions (%s)", data.TxCount))
					<div></div>
				</div>
				<div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden">
					<div class="flex items-center px-5 py-2.5 text-[10px] font-semibold uppercase tracking-wider text-gray-400 border-b border-gray-200 bg-[#FAFAFA]">
						<div class="w-8">#</div>
						<div class="w-16">Status</div>
						<div class="w-[140px]">Hash</div>
						<div class="flex-1">Human-Readable Summary</div>
						<div class="w-14 text-right">Ops</div>
						<div class="w-20 text-right">Fee</div>
					</div>
					for _, tx := range data.Transactions {
						<div class={ "tx-row flex items-center px-5 py-3 border-b border-gray-50", templ.KV("bg-red-50/30", tx.IsFailed) }>
							<div class="w-8"><span class="text-[10px] font-mono text-gray-400">{ tx.Index }</span></div>
							<div class="w-16">
								if tx.IsFailed {
									<span class="rounded bg-red-50 px-1.5 py-0.5 text-[10px] font-bold text-red-600">Failed</span>
								} else {
									<span class="rounded bg-emerald-50 px-1.5 py-0.5 text-[10px] font-bold text-emerald-700">OK</span>
								}
							</div>
							<div class="w-[140px]">
								<div class="flex flex-col">
									<a href={ templ.SafeURL("/tx/" + tx.Hash) } class="font-mono text-xs text-gray-900 hover:text-violet-600">{ tx.ShortHash }</a>
									<div class="mt-0.5">
										@ledgerTxBadge(tx.OpType, tx.OpColor)
									</div>
								</div>
							</div>
							<div class="flex-1 text-xs text-gray-700 leading-relaxed pr-4">
								@templ.Raw(tx.Summary)
							</div>
							<div class="w-14 text-right"><span class="font-mono text-xs text-gray-700 tabular">{ tx.Ops }</span></div>
							<div class="w-20 text-right"><span class="font-mono text-xs text-gray-500 tabular">{ tx.Fee }</span></div>
						</div>
					}
					<div class="px-5 py-3 text-center border-t border-gray-100 bg-[#FAFAFA]">
						<span class="text-xs text-gray-500">Showing { fmt.Sprintf("%d", len(data.Transactions)) } of { data.TxCount } transactions</span>
					</div>
				</div>
			</div>

			<!-- Fee Distribution -->
			<div class="anim d6 mb-10">
				@components.SectionHeader("Fee Distribution")
				<div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
					<div class="grid grid-cols-4 gap-6">
						<div>
							<div class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 mb-1">Base Fee</div>
							<div class="font-mono text-sm font-medium text-gray-900">{ data.FeeBase } stroops</div>
							<div class="text-[10px] text-gray-400">0.00001 XLM</div>
						</div>
						<div>
							<div class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 mb-1">Median Fee</div>
							<div class="font-mono text-sm font-medium text-gray-900">{ data.FeeMedian } stroops</div>
							<div class="text-[10px] text-gray-400">Classic payments</div>
						</div>
						<div>
							<div class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 mb-1">P99 Fee</div>
							<div class="font-mono text-sm font-medium text-gray-900">{ data.FeeP99 } stroops</div>
							<div class="text-[10px] text-gray-400">Soroban invocations</div>
						</div>
						<div>
							<div class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 mb-1">Surge Pricing</div>
							<div class="flex items-center gap-1.5">
								<span class="h-2 w-2 rounded-full bg-gray-400"></span>
								<span class="text-sm font-medium text-gray-900">Inactive</span>
							</div>
							<div class="text-[10px] text-gray-400">{ data.SurgePct } of max tx set used</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Context Links -->
			<div class="anim d7 mb-10">
				@components.SectionHeader("Context")
				<div class="flex items-center gap-3 flex-wrap">
					<a href={ templ.SafeURL("/ledger/" + data.PrevSequence) } class="flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3 py-2 shadow-sm hover:bg-gray-50">
						<svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
						<span class="text-xs font-medium text-gray-700">Previous Ledger</span>
						<span class="font-mono text-[10px] text-gray-400 tabular">{ data.PrevSequence }</span>
					</a>
					<a href={ templ.SafeURL("/ledger/" + data.NextSequence) } class="flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3 py-2 shadow-sm hover:bg-gray-50">
						<span class="text-xs font-medium text-gray-700">Next Ledger</span>
						<span class="font-mono text-[10px] text-gray-400 tabular">{ data.NextSequence }</span>
						<svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
					</a>
					<a href="/network" class="flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3 py-2 shadow-sm hover:bg-gray-50">
						<svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
						<span class="text-xs font-medium text-gray-700">Network Health Dashboard</span>
					</a>
				</div>
			</div>
		</main>
	}
}

templ ledgerTxBadge(opType string, color string) {
	switch color {
		case "violet":
			<span class="rounded px-1.5 py-0.5 text-[10px] font-bold text-violet-600 bg-violet-50">{ opType }</span>
		case "cyan":
			<span class="rounded px-1.5 py-0.5 text-[10px] font-bold text-cyan-700 bg-cyan-50">{ opType }</span>
		case "emerald":
			<span class="rounded px-1.5 py-0.5 text-[10px] font-bold text-emerald-700 bg-emerald-50">{ opType }</span>
		default:
			<span class="rounded px-1.5 py-0.5 text-[10px] font-bold text-gray-600 bg-gray-100">{ opType }</span>
	}
}
