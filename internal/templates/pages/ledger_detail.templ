package pages

import (
	"fmt"
	"github.com/withObsrvr/prism/internal/templates/components"
	"github.com/withObsrvr/prism/internal/templates/layouts"
)

type LedgerDetailData struct {
	Sequence     string
	PrevSequence string
	NextSequence string
	ClosedAt     string
	CloseTime    string
	Hash         string
	PrevHash     string
	Protocol     string
	BaseFee      string
	MaxTxSetSize string
	TotalCoins   string
	TxCount      string
	TxSuccess    string
	TxFailed     string
	OpCount      string
	OpsPerTx     string
	SorobanCalls string
	SorobanPct   string
	TotalFees    string
	FeesUSD      string
	EventsEmitted string
	// Soroban runtime
	TotalCPU     string
	StateReads   string
	StateReadKB  string
	StateWrites  string
	StateWriteKB string
	RentBurned   string
	// Op breakdown
	OpBreakdown  []OpBreakdownItem
	// Transactions
	Transactions []LedgerTx
	// Fee distribution
	FeeBase      string
	FeeMedian    string
	FeeP99       string
	SurgeActive  bool
	SurgePct     string
}

type OpBreakdownItem struct {
	Name    string
	Count   string
	Pct     string
	Width   string
	Color   string
}

type LedgerTx struct {
	Index   string
	Status  string // "ok" or "failed"
	Hash    string
	ShortHash string
	OpType  string
	OpColor string // "violet", "cyan", "emerald", "gray"
	Summary string
	Ops     string
	Fee     string
	IsFailed bool
}

templ LedgerDetail(data LedgerDetailData) {
	@layouts.Base(fmt.Sprintf("Ledger %s — Prism", data.Sequence), "explorer") {
		<main class="mx-auto max-w-[1320px] px-4 md:px-8 py-6">

			<!-- Ledger Header: Ramp hero + Etherscan key-value scannability -->
			<div class="anim mb-8">
				@components.BackNav("Back to Explorer", "/")

				<!-- Hero line: sequence + nav + status -->
				<div class="flex items-center gap-4 mb-5">
					<h1 class="font-mono text-3xl font-bold text-gray-900 tabular">{ data.Sequence }</h1>
					<div class="flex items-center gap-1">
						<a href={ templ.SafeURL("/ledger/" + data.PrevSequence) } class="flex h-7 w-7 items-center justify-center rounded-lg border border-gray-200 hover:bg-gray-50" title="Previous ledger">
							<svg class="h-3.5 w-3.5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
						</a>
						<a href={ templ.SafeURL("/ledger/" + data.NextSequence) } class="flex h-7 w-7 items-center justify-center rounded-lg border border-gray-200 hover:bg-gray-50" title="Next ledger">
							<svg class="h-3.5 w-3.5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
						</a>
					</div>
					<div class="flex items-center gap-2">
						@components.Badge("Closed", "emerald")
						@components.Badge("Protocol v"+data.Protocol, "violet")
					</div>
				</div>

				<!-- Key-value overview -->
				<div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden text-sm">
					<div class="detail-row flex items-center px-5 py-2.5 border-b border-gray-100">
						<span class="w-32 text-gray-400 flex-shrink-0">Timestamp</span>
						<span class="text-gray-900 ml-4">{ data.ClosedAt }</span>
						<span class="text-gray-400 ml-2">·</span>
						<span class="text-gray-400 ml-2">{ data.CloseTime } close</span>
					</div>
					<div class="detail-row flex items-center px-5 py-2.5 border-b border-gray-100">
						<span class="w-32 text-gray-400 flex-shrink-0">Transactions</span>
						<span class="font-medium text-gray-900 tabular ml-4">{ data.TxCount }</span>
						if data.TxFailed != "0" {
							<span class="text-gray-400 ml-2">·</span>
							<span class="text-gray-500 ml-2">{ data.TxSuccess } ok,</span>
							<span class="text-red-500 ml-1">{ data.TxFailed } failed</span>
						}
					</div>
					<div class="detail-row flex items-center px-5 py-2.5 border-b border-gray-100">
						<span class="w-32 text-gray-400 flex-shrink-0">Operations</span>
						<span class="font-medium text-gray-900 tabular ml-4">{ data.OpCount }</span>
						<span class="text-gray-400 ml-2">·</span>
						<span class="text-gray-500 ml-2">~{ data.OpsPerTx } per tx</span>
					</div>
					<div class="detail-row flex items-center px-5 py-2.5 border-b border-gray-100">
						<span class="w-32 text-gray-400 flex-shrink-0">Soroban</span>
						<span class="font-medium text-violet-700 tabular ml-4">{ data.SorobanCalls } calls</span>
						<span class="text-violet-400 ml-2">·</span>
						<span class="text-violet-500 ml-2">{ data.SorobanPct } of ops</span>
						<span class="text-gray-400 ml-2">·</span>
						<span class="text-gray-500 ml-2">{ data.EventsEmitted } events</span>
					</div>
					<div class="detail-row flex items-center px-5 py-2.5">
						<span class="w-32 text-gray-400 flex-shrink-0">Fees</span>
						<span class="font-medium text-gray-900 tabular ml-4">{ data.TotalFees } stroops</span>
						if data.FeesUSD != "—" {
							<span class="text-gray-400 ml-2">·</span>
							<span class="text-gray-500 ml-2">~{ data.FeesUSD }</span>
						}
					</div>
				</div>
			</div>

			<!-- Transactions — primary content, now right below the header -->
			<div class="anim d1 mb-10">
				<div class="flex items-center justify-between mb-3">
					@components.SectionHeader(fmt.Sprintf("Transactions (%s)", data.TxCount))
					<div class="flex items-center gap-1">
						<button class="rounded-lg border border-gray-900 bg-gray-900 px-2.5 py-1.5 text-xs font-semibold text-white">All</button>
						<button class="rounded-lg border border-gray-200 bg-white px-2.5 py-1.5 text-xs font-medium text-violet-600 hover:bg-violet-50">Soroban</button>
						<button class="rounded-lg border border-gray-200 bg-white px-2.5 py-1.5 text-xs font-medium text-gray-600 hover:bg-gray-50">Classic</button>
						<button class="rounded-lg border border-gray-200 bg-white px-2.5 py-1.5 text-xs font-medium text-red-500 hover:bg-red-50">Failed</button>
					</div>
				</div>
				<div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden overflow-x-auto">
					<div class="flex items-center px-5 py-2.5 text-2xs font-semibold uppercase tracking-wider text-gray-400 border-b border-gray-200 bg-[#FAFAFA]">
						<div class="hidden md:block w-8">#</div>
						<div class="w-16">Status</div>
						<div class="w-[140px]">Hash</div>
						<div class="flex-1">Human-Readable Summary</div>
						<div class="hidden md:block w-14 text-right">Ops</div>
						<div class="hidden md:block w-20 text-right">Fee</div>
					</div>
					for i, tx := range data.Transactions {
						<div class={ "tx-row flex items-center px-5 py-3", templ.KV("bg-red-50/30", tx.IsFailed), templ.KV("bg-gray-50/30", i%2 == 1 && !tx.IsFailed) }>
							<div class="hidden md:block w-8"><span class="text-2xs font-mono text-gray-400">{ tx.Index }</span></div>
							<div class="w-16">
								if tx.IsFailed {
									<span class="rounded bg-red-50 px-1.5 py-0.5 text-2xs font-bold text-red-600">Failed</span>
								} else {
									<span class="rounded bg-emerald-50 px-1.5 py-0.5 text-2xs font-bold text-emerald-700">OK</span>
								}
							</div>
							<div class="w-[140px]">
								<div class="flex flex-col">
									<a href={ templ.SafeURL("/tx/" + tx.Hash) } class="font-mono text-xs text-gray-900 hover:text-violet-600">{ tx.ShortHash }</a>
									<div class="mt-0.5">
										@components.TypeBadge(tx.OpType, tx.OpColor)
									</div>
								</div>
							</div>
							<div class="flex-1 text-xs text-gray-700 leading-relaxed pr-4">
								@templ.Raw(tx.Summary)
							</div>
							<div class="hidden md:block w-14 text-right"><span class="font-mono text-xs text-gray-700 tabular">{ tx.Ops }</span></div>
							<div class="hidden md:block w-20 text-right"><span class="font-mono text-xs text-gray-500 tabular">{ tx.Fee }</span></div>
						</div>
					}
					<div class="px-5 py-3 text-center border-t border-gray-100 bg-[#FAFAFA]">
						<span class="text-xs text-gray-500">Showing { fmt.Sprintf("%d", len(data.Transactions)) } of { data.TxCount } transactions · </span>
						<button class="text-xs font-medium text-violet-600 hover:text-violet-700">Load all transactions</button>
					</div>
				</div>
			</div>

			<!-- Secondary: Operation Breakdown + Fees side by side -->
			<div class="anim d2 mb-10 grid grid-cols-1 lg:grid-cols-2 gap-6">
				<!-- Op Breakdown -->
				<div>
					@components.SectionHeader("Operation Breakdown")
					<div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
						if len(data.OpBreakdown) > 0 {
							<div class="flex h-4 w-full overflow-hidden rounded-full mb-4">
								for _, op := range data.OpBreakdown {
									<div class={ "h-full", op.Color } style={ "width:" + op.Width }></div>
								}
							</div>
							<div class="flex flex-wrap gap-x-5 gap-y-1.5 text-xs">
								for _, op := range data.OpBreakdown {
									<div class="flex items-center gap-1.5">
										<span class={ "h-2 w-2 rounded-full", op.Color }></span>
										<span class="text-gray-700 font-medium">{ op.Name }</span>
										<span class="font-mono text-gray-400 tabular">{ op.Count }</span>
									</div>
								}
							</div>
						}
					</div>
				</div>
				<!-- Fee Distribution -->
				<div>
					@components.SectionHeader("Fee Distribution")
					<div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
						<div class="space-y-2.5">
							<div class="flex items-center justify-between">
								<div class="flex items-center gap-2">
									<span class="h-2 w-2 rounded-full bg-gray-400"></span>
									<span class="text-xs font-medium text-gray-700">Base Fee</span>
								</div>
								<div>
									<span class="font-mono text-xs font-semibold text-gray-900 tabular">{ data.FeeBase }</span>
									<span class="text-2xs text-gray-400 ml-0.5">stroops</span>
								</div>
							</div>
							<div class="flex items-center justify-between">
								<div class="flex items-center gap-2">
									<span class="h-2 w-2 rounded-full bg-emerald-500"></span>
									<span class="text-xs font-medium text-gray-700">Median</span>
								</div>
								<div>
									<span class="font-mono text-xs font-semibold text-gray-900 tabular">{ data.FeeMedian }</span>
									<span class="text-2xs text-gray-400 ml-0.5">stroops</span>
								</div>
							</div>
							<div class="flex items-center justify-between">
								<div class="flex items-center gap-2">
									<span class="h-2 w-2 rounded-full bg-amber-500"></span>
									<span class="text-xs font-medium text-gray-700">P99</span>
								</div>
								<div>
									<span class="font-mono text-xs font-semibold text-gray-900 tabular">{ data.FeeP99 }</span>
									<span class="text-2xs text-gray-400 ml-0.5">stroops</span>
								</div>
							</div>
						</div>
						<div class="mt-3 pt-2 border-t border-gray-100 flex items-center gap-1.5">
							<span class="h-1.5 w-1.5 rounded-full bg-gray-400"></span>
							<span class="text-2xs text-gray-500">Surge: Inactive</span>
							<span class="text-2xs text-gray-400 ml-auto">{ data.SurgePct } of max tx set</span>
						</div>
					</div>
				</div>
			</div>

			<!-- Soroban Runtime -->
			<div class="anim d3 mb-10">
				@components.SectionHeader("Soroban Runtime")
				<div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden text-sm">
					<div class="detail-row flex items-center px-5 py-2.5 border-b border-gray-100">
						<span class="w-32 text-gray-400 flex-shrink-0">Total CPU</span>
						<span class="font-medium text-violet-700 font-mono tabular ml-4">{ data.TotalCPU }</span>
						<span class="text-gray-400 ml-2">·</span>
						<span class="text-gray-500 ml-2">across { data.SorobanCalls } invocations</span>
					</div>
					<div class="detail-row flex items-center px-5 py-2.5 border-b border-gray-100">
						<span class="w-32 text-gray-400 flex-shrink-0">State Reads</span>
						<span class="font-medium text-violet-700 font-mono tabular ml-4">{ data.StateReads } entries</span>
						<span class="text-gray-400 ml-2">·</span>
						<span class="text-gray-500 ml-2">{ data.StateReadKB }</span>
					</div>
					<div class="detail-row flex items-center px-5 py-2.5 border-b border-gray-100">
						<span class="w-32 text-gray-400 flex-shrink-0">State Writes</span>
						<span class="font-medium text-violet-700 font-mono tabular ml-4">{ data.StateWrites } entries</span>
						<span class="text-gray-400 ml-2">·</span>
						<span class="text-gray-500 ml-2">{ data.StateWriteKB }</span>
					</div>
					<div class="detail-row flex items-center px-5 py-2.5">
						<span class="w-32 text-gray-400 flex-shrink-0">Rent Burned</span>
						<span class="font-medium text-violet-700 font-mono tabular ml-4">{ data.RentBurned } XLM</span>
					</div>
				</div>
			</div>

			<!-- Ledger Details — collapsible technical info -->
			<div class="anim d4 mb-10">
				<details>
					<summary class="cursor-pointer mb-3 flex items-center gap-2">
						<h3 class="text-xs font-semibold uppercase tracking-wider text-gray-400">Ledger Details</h3>
						<svg class="h-3.5 w-3.5 text-gray-400 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
					</summary>
					<div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden overflow-x-auto">
						@components.DetailRow("Hash") {
							<div class="flex items-center gap-1.5">
								<span class="font-mono text-sm text-gray-900">{ data.Hash }</span>
								@components.CopyButton(data.Hash)
							</div>
						}
						@components.DetailRow("Previous Hash") {
							<a href={ templ.SafeURL("/ledger/" + data.PrevSequence) } class="font-mono text-sm text-gray-900 hover:text-violet-600">{ data.PrevHash }</a>
						}
						@components.DetailRow("Base Fee") {
							<span class="text-sm text-gray-900">{ data.BaseFee } stroops</span>
						}
						@components.DetailRow("Max Tx Set Size") {
							<span class="text-sm text-gray-900 tabular">{ data.MaxTxSetSize }</span>
						}
						@components.DetailRowLast("Total Coins") {
							<span class="font-mono text-sm text-gray-900 tabular">{ data.TotalCoins }</span>
						}
					</div>
				</details>
			</div>

			<!-- Context Links -->
			<div class="anim d5 mb-10">
				<div class="flex items-center gap-3 flex-wrap">
					<a href={ templ.SafeURL("/ledger/" + data.PrevSequence) } class="flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3 py-2 shadow-sm hover:bg-gray-50">
						<svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
						<span class="text-xs font-medium text-gray-700">Previous Ledger</span>
						<span class="font-mono text-2xs text-gray-400 tabular">{ data.PrevSequence }</span>
					</a>
					<a href={ templ.SafeURL("/ledger/" + data.NextSequence) } class="flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3 py-2 shadow-sm hover:bg-gray-50">
						<span class="text-xs font-medium text-gray-700">Next Ledger</span>
						<span class="font-mono text-2xs text-gray-400 tabular">{ data.NextSequence }</span>
						<svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
					</a>
					<a href="/events" class="flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3 py-2 shadow-sm hover:bg-gray-50">
						<svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
						<span class="text-xs font-medium text-gray-700">Events</span>
					</a>
					<a href="/network" class="flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3 py-2 shadow-sm hover:bg-gray-50">
						<svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
						<span class="text-xs font-medium text-gray-700">Network Health</span>
					</a>
				</div>
			</div>
		</main>
	}
}

