package pages

import (
	"fmt"
	"github.com/withObsrvr/prism/internal/templates/components"
	"github.com/withObsrvr/prism/internal/templates/layouts"
)

type LedgerDetailData struct {
	// Demo marks fixtures. See TxReceiptData.Demo.
	Demo bool
	Sequence        string
	SequenceRaw     string // Unformatted sequence for URLs
	PrevSequence    string
	PrevSequenceRaw string // Unformatted for URLs
	NextSequence    string
	NextSequenceRaw string // Unformatted for URLs
	ClosedAt     string
	CloseTime    string
	Hash         string
	PrevHash     string
	Protocol     string
	BaseFee      string
	MaxTxSetSize string
	TotalCoins   string
	TxCount      string
	TxSuccess    string
	TxFailed     string
	OpCount      string
	OpsPerTx     string
	SorobanCalls string
	SorobanPct   string
	TotalFees    string
	FeesUSD      string
	EventsEmitted string
	// Soroban runtime
	TotalCPU     string
	StateReads   string
	StateReadKB  string
	StateWrites  string
	StateWriteKB string
	RentBurned   string
	// Op breakdown
	OpBreakdown  []OpBreakdownItem
	// OpsClassified is how many operations actually went into OpBreakdown. The
	// operations fetch is capped, so on busy ledgers this is a sample of
	// OpCount rather than all of it, and the bar must say so.
	OpsClassified string
	// Transactions
	Transactions []LedgerTx
	// Fee distribution
	FeeBase      string
	FeeMedian    string
	FeeP99       string
	SurgeActive  bool
	SurgePct     string
	// V2 presentation enrichments
	Narrative       string
	SubNarrative    string
	ActivityTag     string
	SpotlightCards  []LedgerSpotlightCard
	ChangedAccounts []LedgerChangedAccount
}

type OpBreakdownItem struct {
	Name   string
	Count  string
	Pct    string
	Width  string
	Color  string // Tailwind class, still used by the v1 ledger fragment
	Family string // semantic family slug from gateway.OperationFamily
	Tier   int    // 1-3: rank within the family by count, drives the shade ramp
}

type LedgerTx struct {
	Index     string
	Status    string // "ok" or "failed"
	Hash      string
	ShortHash string
	Kind      string // "classic", "soroban", or "failed" — the only classification source
	OpType    string
	Family    string // semantic family slug from gateway.OperationFamily; drives colour only
	Summary   string
	Ops       string
	Fee       string
	IsFailed  bool
}

type LedgerSpotlightCard struct {
	Kicker string
	Value  string
	Body   string
	Tone   string
}

type LedgerChangedAccount struct {
	Name    string
	Address string
	Touched string
	Deltas  []string
}

templ LedgerDetail(data LedgerDetailData) {
	@layouts.Base(fmt.Sprintf("Ledger %s — Prism", data.Sequence), "explorer") {
		<main class="mx-auto max-w-[1320px] px-4 md:px-8 py-6">

			<!-- Ledger Header: Ramp hero + Etherscan key-value scannability -->
			<div class="anim mb-8">
				@components.BackNav("Back to Explorer", "/")

				<!-- Hero line: sequence + nav + status -->
				<div class="flex items-center gap-4 mb-5">
					<h1 class="font-mono text-3xl font-bold text-text-primary tabular">{ data.Sequence }</h1>
					<div class="flex items-center gap-1">
						<a href={ templ.SafeURL("/ledger/" + data.PrevSequenceRaw) } class="flex h-7 w-7 items-center justify-center rounded-lg border border-border-default hover:bg-surface-subtle" title="Previous ledger">
							<svg class="h-3.5 w-3.5 text-text-body" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
						</a>
						<a href={ templ.SafeURL("/ledger/" + data.NextSequenceRaw) } class="flex h-7 w-7 items-center justify-center rounded-lg border border-border-default hover:bg-surface-subtle" title="Next ledger">
							<svg class="h-3.5 w-3.5 text-text-body" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
						</a>
					</div>
					<div class="flex items-center gap-2">
						@components.Badge("Closed", "emerald")
						@components.Badge("Protocol v"+data.Protocol, "violet")
					</div>
				</div>

				<!-- Key-value overview -->
				<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden text-sm">
					<div class="detail-row flex items-center px-5 py-2.5 border-b border-border-subtle">
						<span class="w-32 text-text-muted flex-shrink-0">Timestamp</span>
						<span class="text-text-primary ml-4">{ data.ClosedAt }</span>
						<span class="text-text-muted ml-2">·</span>
						<span class="text-text-muted ml-2">{ data.CloseTime } close</span>
					</div>
					<div class="detail-row flex items-center px-5 py-2.5 border-b border-border-subtle">
						<span class="w-32 text-text-muted flex-shrink-0">Transactions</span>
						<span class="font-medium text-text-primary tabular ml-4">{ data.TxCount }</span>
						if data.TxFailed != "0" {
							<span class="text-text-muted ml-2">·</span>
							<span class="text-text-body ml-2">{ data.TxSuccess } ok,</span>
							<span class="text-red-500 ml-1">{ data.TxFailed } failed</span>
						}
					</div>
					<div class="detail-row flex items-center px-5 py-2.5 border-b border-border-subtle">
						<span class="w-32 text-text-muted flex-shrink-0">Operations</span>
						<span class="font-medium text-text-primary tabular ml-4">{ data.OpCount }</span>
						<span class="text-text-muted ml-2">·</span>
						<span class="text-text-body ml-2">~{ data.OpsPerTx } per tx</span>
					</div>
					<div class="detail-row flex items-center px-5 py-2.5 border-b border-border-subtle">
						<span class="w-32 text-text-muted flex-shrink-0">Soroban</span>
						<span class="font-medium text-violet-700 tabular ml-4">{ data.SorobanCalls } calls</span>
						<span class="text-violet-400 ml-2">·</span>
						<span class="text-violet-500 ml-2">{ data.SorobanPct } of ops</span>
						<span class="text-text-muted ml-2">·</span>
						<span class="text-text-body ml-2">{ data.EventsEmitted } events</span>
					</div>
					<div class="detail-row flex items-center px-5 py-2.5">
						<span class="w-32 text-text-muted flex-shrink-0">Fees</span>
						<span class="font-medium text-text-primary tabular ml-4">{ data.TotalFees } stroops</span>
						if data.FeesUSD != "—" {
							<span class="text-text-muted ml-2">·</span>
							<span class="text-text-body ml-2">~{ data.FeesUSD }</span>
						}
					</div>
				</div>
			</div>

			<!-- Transactions: loaded via htmx fragment -->
			<div hx-get={ "/fragments/ledger/" + data.SequenceRaw + "/txs" } hx-trigger="load" hx-swap="outerHTML">
				@ledgerTableSkeleton(5)
			</div>

			<!-- Operation Breakdown + Fees: loaded via htmx fragment -->
			<div hx-get={ "/fragments/ledger/" + data.SequenceRaw + "/ops-fees" } hx-trigger="load" hx-swap="outerHTML">
				<div class="mb-10 grid grid-cols-1 lg:grid-cols-2 gap-6">
					<div class="rounded-xl border border-border-default bg-surface-card p-5 shadow-sm">
						<div class="h-4 w-full rounded-full bg-surface-subtle animate-pulse mb-4"></div>
						<div class="flex flex-wrap gap-3">
							for i := 0; i < 4; i++ {
								<div class="h-3 w-20 rounded bg-surface-subtle animate-pulse"></div>
							}
						</div>
					</div>
					<div class="rounded-xl border border-border-default bg-surface-card p-4 shadow-sm space-y-3">
						for i := 0; i < 3; i++ {
							<div class="flex items-center justify-between">
								<div class="h-3 w-16 rounded bg-surface-subtle animate-pulse"></div>
								<div class="h-3 w-20 rounded bg-surface-subtle animate-pulse"></div>
							</div>
						}
					</div>
				</div>
			</div>

			<!-- Soroban Runtime: loaded via htmx fragment -->
			<div hx-get={ "/fragments/ledger/" + data.SequenceRaw + "/soroban" } hx-trigger="load" hx-swap="outerHTML">
				@ledgerDetailSkeleton(4)
			</div>

			<!-- Ledger Details — collapsible technical info -->
			<div class="anim d4 mb-10">
				<details>
					<summary class="cursor-pointer mb-3 flex items-center gap-2">
						<h3 class="text-xs font-semibold uppercase tracking-wider text-text-muted">Ledger Details</h3>
						<svg class="h-3.5 w-3.5 text-text-muted transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
					</summary>
					<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden overflow-x-auto">
						@components.DetailRow("Hash") {
							<div class="flex items-center gap-1.5">
								<span class="font-mono text-sm text-text-primary">{ data.Hash }</span>
								@components.CopyButton(data.Hash)
							</div>
						}
						@components.DetailRow("Previous Hash") {
							<a href={ templ.SafeURL("/ledger/" + data.PrevSequenceRaw) } class="font-mono text-sm text-text-primary hover:text-violet-600">{ data.PrevHash }</a>
						}
						@components.DetailRow("Base Fee") {
							<span class="text-sm text-text-primary">{ data.BaseFee } stroops</span>
						}
						@components.DetailRow("Max Tx Set Size") {
							<span class="text-sm text-text-primary tabular">{ data.MaxTxSetSize }</span>
						}
						@components.DetailRowLast("Total Coins") {
							<span class="font-mono text-sm text-text-primary tabular">{ data.TotalCoins }</span>
						}
					</div>
				</details>
			</div>

			<!-- Context Links -->
			<div class="anim d5 mb-10">
				<div class="flex items-center gap-3 flex-wrap">
					<a href={ templ.SafeURL("/ledger/" + data.PrevSequenceRaw) } class="flex items-center gap-1.5 rounded-lg border border-border-default bg-surface-card px-3 py-2 shadow-sm hover:bg-surface-subtle">
						<svg class="h-4 w-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
						<span class="text-xs font-medium text-text-strong">Previous Ledger</span>
						<span class="font-mono text-2xs text-text-muted tabular">{ data.PrevSequence }</span>
					</a>
					<a href={ templ.SafeURL("/ledger/" + data.NextSequenceRaw) } class="flex items-center gap-1.5 rounded-lg border border-border-default bg-surface-card px-3 py-2 shadow-sm hover:bg-surface-subtle">
						<span class="text-xs font-medium text-text-strong">Next Ledger</span>
						<span class="font-mono text-2xs text-text-muted tabular">{ data.NextSequence }</span>
						<svg class="h-4 w-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
					</a>
					<a href="/events" class="flex items-center gap-1.5 rounded-lg border border-border-default bg-surface-card px-3 py-2 shadow-sm hover:bg-surface-subtle">
						<svg class="h-4 w-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
						<span class="text-xs font-medium text-text-strong">Events</span>
					</a>
					<a href="/network" class="flex items-center gap-1.5 rounded-lg border border-border-default bg-surface-card px-3 py-2 shadow-sm hover:bg-surface-subtle">
						<svg class="h-4 w-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
						<span class="text-xs font-medium text-text-strong">Network Health</span>
					</a>
				</div>
			</div>
		</main>
	}
}

// ── Skeleton placeholders for htmx fragment loading ──

templ ledgerTableSkeleton(n int) {
	<div class="mb-10">
		<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden">
			for i := 0; i < n; i++ {
				<div class={ "flex items-center px-5 py-3", templ.KV("bg-surface-subtle", i%2 == 1) }>
					<div class="hidden md:block w-8"><div class="h-3 w-4 rounded bg-surface-subtle animate-pulse"></div></div>
					<div class="w-16"><div class="h-5 w-10 rounded bg-surface-subtle animate-pulse"></div></div>
					<div class="w-[140px] space-y-1">
						<div class="h-3.5 w-20 rounded bg-surface-subtle animate-pulse"></div>
						<div class="h-3 w-14 rounded bg-surface-subtle animate-pulse"></div>
					</div>
					<div class="flex-1"><div class="h-3 w-48 rounded bg-surface-subtle animate-pulse"></div></div>
					<div class="hidden md:block w-14 text-right"><div class="h-3 w-6 rounded bg-surface-subtle animate-pulse ml-auto"></div></div>
					<div class="hidden md:block w-20 text-right"><div class="h-3 w-12 rounded bg-surface-subtle animate-pulse ml-auto"></div></div>
				</div>
			}
		</div>
	</div>
}

templ ledgerDetailSkeleton(n int) {
	<div class="mb-10">
		<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden">
			for i := 0; i < n; i++ {
				<div class="flex items-center px-5 py-2.5 border-b border-border-subtle">
					<div class="h-3.5 w-24 rounded bg-surface-subtle animate-pulse"></div>
					<div class="h-3.5 w-40 rounded bg-surface-subtle animate-pulse ml-4"></div>
				</div>
			}
		</div>
	</div>
}
