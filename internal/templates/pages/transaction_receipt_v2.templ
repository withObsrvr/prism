package pages

import (
	"fmt"
	"github.com/withObsrvr/prism/internal/templates/components"
	"github.com/withObsrvr/prism/internal/templates/layouts"
)

func effectsCount(effects []TxEffect) string {
	return fmt.Sprintf("%d", len(effects))
}

// TransactionReceiptV2 renders the Ramp-inspired transaction detail page.
templ TransactionReceiptV2(data TxReceiptData) {
	@layouts.Base("Transaction " + data.ShortHash + " — Prism", "explorer") {
		<main class="mx-auto max-w-[1320px] px-4 md:px-8 py-6">

			<!-- Header: status + hash + badges -->
			<div class="anim mt-4 mb-5">
				@components.BackNav("Back to Explorer", "/")
				<div class="flex items-center gap-3 mb-2">
					if data.Status == "success" {
						<div class="flex items-center gap-1.5 rounded-full bg-emerald-50 dark:bg-emerald-950/30 px-3 py-1 ring-1 ring-emerald-200 dark:ring-emerald-800">
							<svg class="h-3.5 w-3.5 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
							<span class="text-xs font-semibold text-emerald-700 dark:text-emerald-400">Success</span>
						</div>
					} else {
						<div class="flex items-center gap-1.5 rounded-full bg-red-50 dark:bg-red-950/30 px-3 py-1 ring-1 ring-red-200 dark:ring-red-800">
							<svg class="h-3.5 w-3.5 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path></svg>
							<span class="text-xs font-semibold text-red-600 dark:text-red-400">Failed</span>
						</div>
					}
					if data.IsSoroban {
						@components.Badge("Soroban", "violet")
					}
					if data.HasClassicOps {
						@components.Badge("Classic", "gray")
					}
				</div>
				<!-- Summary as the hero text -->
				<p class="text-lg text-text-primary leading-relaxed mb-2">
					@templ.Raw(data.SummaryHTML)
				</p>
				<!-- Hash + inline meta -->
				<div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-text-body">
					<div class="flex items-center gap-1.5">
						<span class="font-mono text-xs text-text-muted">{ data.ShortHash }</span>
						@components.CopyButton(data.Hash)
					</div>
					<span class="text-text-muted">&middot;</span>
					if data.TimestampRelative != "" {
					<span title={ data.Timestamp }><span class="font-medium text-text-primary">{ data.TimestampRelative }</span> <span class="text-text-muted">({ data.Timestamp })</span></span>
				} else {
					<span>{ data.Timestamp }</span>
				}
					<span class="text-text-muted">&middot;</span>
					<span>Ledger <a href={ templ.SafeURL("/ledger/" + data.LedgerRaw) } class="font-mono text-emerald-700 hover:text-emerald-800">{ data.Ledger }</a></span>
					<span class="text-text-muted">&middot;</span>
					<span>{ data.OpsCount } ops</span>
					<span class="text-text-muted">&middot;</span>
					<span>{ data.EventsCount } events</span>
				</div>
			</div>

			@TxHumanizedSection(data)

			<!-- Key-value overview: loaded via htmx fragment -->
			<div hx-get={ "/fragments/tx/" + data.Hash + "/overview" } hx-trigger="load" hx-swap="outerHTML">
				@txDetailSkeleton(4)
			</div>

			<!-- Tabs -->
			<div class="anim d1 flex gap-6 border-b border-border-default text-sm font-medium text-text-muted mb-6">
				<button class="border-b-2 border-text-primary pb-3 text-text-primary font-semibold">Operations ({ data.OpsCount })</button>
				<button class="pb-3.5 hover:text-text-primary transition-colors">Events ({ data.EventsCount })</button>
				if len(data.Effects) > 0 {
					<button class="pb-3.5 hover:text-text-primary transition-colors">Effects ({ effectsCount(data.Effects) })</button>
				}
				<button class="pb-3.5 hover:text-text-primary transition-colors">Balance Changes</button>
				if len(data.StateChanges) > 0 {
					<button class="pb-3.5 hover:text-text-primary transition-colors">State Changes</button>
				}
			</div>

			<!-- Operations: loaded via htmx fragment -->
			<div hx-get={ "/fragments/tx/" + data.Hash + "/operations" } hx-trigger="load" hx-swap="outerHTML">
				@txTableSkeleton(4)
			</div>

			<!-- Events: loaded via htmx fragment -->
			<div hx-get={ "/fragments/tx/" + data.Hash + "/events" } hx-trigger="load" hx-swap="outerHTML">
				@txTableSkeleton(4)
			</div>

			<!-- Effects -->
			if len(data.Effects) > 0 {
				<div hx-get={ "/fragments/tx/" + data.Hash + "/effects" } hx-trigger="load" hx-swap="outerHTML">
					@txTableSkeleton(3)
				</div>
			}

			<!-- Balance Changes: loaded via htmx fragment -->
			<div hx-get={ "/fragments/tx/" + data.Hash + "/balance-changes" } hx-trigger="load" hx-swap="outerHTML">
				@txTableSkeleton(3)
			</div>

			<!-- State Changes: loaded via htmx fragment -->
			if len(data.StateChanges) > 0 {
				<div hx-get={ "/fragments/tx/" + data.Hash + "/state-changes" } hx-trigger="load" hx-swap="outerHTML">
					@txTableSkeleton(3)
				</div>
			}

			<!-- Context links -->
			<div class="anim d4 mb-10">
				<div class="flex items-center gap-3 flex-wrap">
					if data.ContractAddrFull != "" && data.ContractAddrFull != "—" {
						<a href={ templ.SafeURL("/contracts/" + data.ContractAddrFull) } class="flex items-center gap-1.5 rounded-lg border border-border-default bg-surface-card px-3 py-2 shadow-sm hover:bg-surface-subtle">
						<svg class="h-4 w-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
						<span class="text-xs font-medium text-text-strong">Contract</span>
						</a>
					}
					<a href={ templ.SafeURL("/account/" + data.SourceAddrFull) } class="flex items-center gap-1.5 rounded-lg border border-border-default bg-surface-card px-3 py-2 shadow-sm hover:bg-surface-subtle">
						<svg class="h-4 w-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
						<span class="text-xs font-medium text-text-strong">
							if data.SmartWalletDetected {
								Submitter
							} else {
								Account
							}
						</span>
					</a>
					if data.SmartWalletDetected {
						<a href={ templ.SafeURL("/account/" + data.SmartWalletContract + "/smart") } class="flex items-center gap-1.5 rounded-lg border border-border-default bg-surface-card px-3 py-2 shadow-sm hover:bg-surface-subtle">
							<svg class="h-4 w-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0-1.657 1.343-3 3-3m-6 0a3 3 0 116 0m-9 8a9 9 0 1118 0H3z"></path></svg>
							<span class="text-xs font-medium text-text-strong">Wallet</span>
						</a>
					}
					<a href={ templ.SafeURL("/ledger/" + data.LedgerRaw) } class="flex items-center gap-1.5 rounded-lg border border-border-default bg-surface-card px-3 py-2 shadow-sm hover:bg-surface-subtle">
						<svg class="h-4 w-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
						<span class="text-xs font-medium text-text-strong">Ledger { data.Ledger }</span>
					</a>
				</div>
			</div>
		</main>
	}
}

// ── Skeleton placeholders for htmx fragment loading ──

templ txDetailSkeleton(n int) {
	<div class="anim d1 mb-6">
		<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden">
			for i := 0; i < n; i++ {
				<div class="flex items-center px-5 py-2.5 border-b border-border-subtle">
					<div class="h-3.5 w-24 rounded bg-surface-subtle animate-pulse"></div>
					<div class="h-3.5 w-48 rounded bg-surface-subtle animate-pulse ml-4"></div>
				</div>
			}
		</div>
	</div>
}

templ txTableSkeleton(n int) {
	<div class="mb-8">
		<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden">
			for i := 0; i < n; i++ {
				<div class={ "flex items-center gap-4 px-5 py-3", templ.KV("bg-surface-subtle", i%2 == 1) }>
					<div class="h-6 w-6 rounded-full bg-surface-subtle animate-pulse flex-shrink-0"></div>
					<div class="flex-1 space-y-1.5">
						<div class="h-3.5 w-32 rounded bg-surface-subtle animate-pulse"></div>
						<div class="h-3 w-48 rounded bg-surface-subtle animate-pulse"></div>
					</div>
					<div class="h-3.5 w-16 rounded bg-surface-subtle animate-pulse"></div>
				</div>
			}
		</div>
	</div>
}
