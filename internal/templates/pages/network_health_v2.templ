package pages

import (
	"github.com/withObsrvr/prism/internal/templates/layouts"
)

// NetworkHealthV2 renders the Token Terminal + Ramp hybrid network page.
// Reuses NetworkHealthData from network_health.templ.
templ NetworkHealthV2(data NetworkHealthData) {
	@layouts.Base("Network — Prism", "network") {
		<main class="mx-auto max-w-[1320px] px-4 md:px-8 py-6">

			<!-- Header -->
			<div class="anim mt-4 mb-3">
				<div class="flex items-center gap-3 mb-1">
					<h1 class="text-2xl font-bold tracking-tight text-text-primary">Network</h1>
					<div class="flex items-center gap-1.5 rounded-full bg-emerald-50 dark:bg-emerald-950/30 px-3 py-1 ring-1 ring-emerald-200 dark:ring-emerald-800">
						<span class="h-2 w-2 rounded-full bg-emerald-500 pulse-dot"></span>
						<span class="text-xs font-semibold text-emerald-700 dark:text-emerald-400">{ data.Status }</span>
					</div>
				</div>
				<div class="text-2xs text-text-muted uppercase tracking-wider mb-1">Latest Ledger</div>
				<div class="font-mono text-4xl font-bold text-text-primary tabular mb-3">{ data.LatestLedger }</div>
				<div class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-text-body">
					<span>Close <span class="font-semibold text-text-primary tabular">{ data.AvgCloseTime }</span></span>
					<span class="text-text-muted">&middot;</span>
					<span>TPS <span class="font-semibold text-text-primary tabular">{ data.CurrentTPS }</span></span>
					<span class="text-text-muted">&middot;</span>
					<span>24h txns <span class="font-semibold text-text-primary tabular">{ data.Tx24h }</span></span>
					<span class="text-text-muted">&middot;</span>
					<span>Protocol <span class="font-semibold text-text-primary">v{ data.ProtocolVer }</span></span>
				</div>
			</div>

			<!-- Tabs -->
			<div class="anim d1 flex gap-6 border-b border-border-default text-sm font-medium text-text-muted mb-6">
				<button class="border-b-2 border-text-primary pb-3 text-text-primary font-semibold">Overview</button>
				<button class="pb-3.5 hover:text-text-primary transition-colors">Validators</button>
				<button class="pb-3.5 hover:text-text-primary transition-colors">Ledgers</button>
				<button class="pb-3.5 hover:text-text-primary transition-colors">Soroban</button>
			</div>

			<!-- Stats grid (chart + consensus/fees/soroban/protocol): loaded via htmx fragment -->
			<div hx-get="/fragments/network/stats-grid" hx-trigger="load" hx-swap="outerHTML">
				@networkStatsSkeleton()
			</div>

			<!-- Validators: loaded via htmx fragment -->
			<div hx-get="/fragments/network/validators" hx-trigger="load" hx-swap="outerHTML">
				@networkTableSkeleton(5)
			</div>

			<!-- Recent Ledgers: loaded via htmx fragment -->
			<div hx-get="/fragments/network/recent-ledgers" hx-trigger="load" hx-swap="outerHTML">
				@networkTableSkeleton(6)
			</div>

		</main>
	}
}

templ networkStatsSkeleton() {
	<div>
		<div class="mb-8 rounded-xl border border-border-default bg-surface-card p-5 shadow-sm">
			<div class="h-40 rounded bg-surface-subtle animate-pulse"></div>
		</div>
		<div class="mb-8 grid grid-cols-1 lg:grid-cols-2 gap-6">
			for i := 0; i < 2; i++ {
				<div class="space-y-6">
					for j := 0; j < 2; j++ {
						<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden">
							for k := 0; k < 5; k++ {
								<div class="flex items-center justify-between px-5 py-2.5 border-b border-border-subtle">
									<div class="h-3.5 w-24 rounded bg-surface-subtle animate-pulse"></div>
									<div class="h-3.5 w-16 rounded bg-surface-subtle animate-pulse"></div>
								</div>
							}
						</div>
					}
				</div>
			}
		</div>
	</div>
}

templ networkTableSkeleton(n int) {
	<div class="mb-8">
		<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden">
			for i := 0; i < n; i++ {
				<div class={ "flex items-center gap-4 px-5 py-3", templ.KV("bg-surface-subtle", i%2 == 1) }>
					<div class="h-2 w-2 rounded-full bg-surface-subtle animate-pulse flex-shrink-0"></div>
					<div class="flex-1 space-y-1.5">
						<div class="h-3.5 w-32 rounded bg-surface-subtle animate-pulse"></div>
						<div class="h-3 w-20 rounded bg-surface-subtle animate-pulse"></div>
					</div>
					<div class="h-3.5 w-14 rounded bg-surface-subtle animate-pulse"></div>
					<div class="h-3.5 w-14 rounded bg-surface-subtle animate-pulse"></div>
				</div>
			}
		</div>
	</div>
}
