package pages

import (
	"github.com/withObsrvr/prism/internal/templates/components"
	"github.com/withObsrvr/prism/internal/templates/layouts"
)

type NetworkHealthData struct {
	Status        string // "Operational", "Degraded"
	StatusColor   string
	LatestLedger  string
	LedgerAge     string
	AvgCloseTime  string
	CurrentTPS    string
	PeakTPS       string
	Tx24h         string
	TxChange      string
	Ops24h        string
	OpsPerTx      string
	FailureRate    string
	LedgerCapacity string // e.g. "42%"
	CapacityStatus string // e.g. "Plenty of room"
	// Fee market
	FeeBase       string
	FeeMedian     string
	FeeP99        string
	DailyFees     string
	SurgePricing  string
	// Soroban
	SorobanInvocations string
	ActiveContracts string
	TotalState    string
	RentBurned    string
	AvgCPU        string
	// Protocol
	ProtocolVer   string
	ProtocolSubtitle string
	CoreVersion   string
	NextUpgrade   string
	HorizonVer    string
	SorobanRPCVer string
	// Consensus
	Agreement      string
	ConsensusHalted string
	ValidatorCount string
	QuorumSets    string
	AvgLatency    string
	Validators    []ValidatorRow
	RecentLedgers []NetworkLedger
}

type ValidatorRow struct {
	Name       string
	Org        string
	Address    string
	Uptime     string
	LastVote   string
	Status     string
	StatusColor string
	Version    string
	Quorum     string
	Latency    string
}

type NetworkLedger struct {
	Sequence    string
	Age         string
	TxCount     string
	OpsCount    string
	SorobanCalls string
	SorobanPct  string
	Fees        string
	CloseTime   string
	IsLatest    bool
	IsSlow      bool
}

templ NetworkHealth(data NetworkHealthData) {
	@layouts.Base("Network Health — Prism", "network") {
		<main class="mx-auto max-w-[1320px] px-4 md:px-8 py-6">
			<!-- Status Banner -->
			<div class="anim mb-6 flex items-center justify-between">
				<div class="flex items-center gap-3">
					<div>
						<h1 class="text-2xl font-bold text-text-primary">Network Health</h1>
						<p class="text-xs text-text-body mt-0.5">Protocol v{ data.ProtocolVer } · { data.ProtocolSubtitle }</p>
					</div>
					<div class="flex items-center gap-1.5 rounded-full bg-emerald-50 dark:bg-emerald-950/30 px-3 py-1 ring-1 ring-emerald-200 dark:ring-emerald-800">
						<span class="h-2 w-2 rounded-full bg-emerald-500 pulse-dot"></span>
						<span class="text-xs font-semibold text-emerald-700 dark:text-emerald-400">{ data.Status }</span>
					</div>
				</div>
				<div class="flex items-center gap-4">
					<div class="flex items-center gap-1.5 text-2xs text-text-muted">
						<span class="h-1.5 w-1.5 rounded-full bg-emerald-500 pulse-dot"></span>
						<span>Auto-refresh: 5s</span>
					</div>
					<div class="flex items-center gap-2">
						<button class="rounded-lg border border-gray-900 dark:border-gray-100 bg-gray-900 dark:bg-gray-100 px-2.5 py-1.5 text-xs font-semibold text-white dark:text-gray-900">Live</button>
						<button class="rounded-lg border border-border-default bg-surface-card px-2.5 py-1.5 text-xs font-medium text-text-body">1h</button>
						<button class="rounded-lg border border-border-default bg-surface-card px-2.5 py-1.5 text-xs font-medium text-text-body">24h</button>
						<button class="rounded-lg border border-border-default bg-surface-card px-2.5 py-1.5 text-xs font-medium text-text-body">7d</button>
					</div>
				</div>
			</div>

			<!-- Primary Metrics -->
			<div class="anim d1 mb-8 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
				@components.StatCard("Latest Ledger", data.LatestLedger, "normal", -1)
				@components.StatCard("Avg Close Time", data.AvgCloseTime, "normal", -1)
				@components.StatCard("Current TPS", data.CurrentTPS, "normal", -1)
				@components.StatCard("24h Transactions", data.Tx24h, "normal", -1)
				@components.StatCard("24h Operations", data.Ops24h, "normal", -1)
				@components.StatCard("Ledger Capacity", data.LedgerCapacity, "normal", -1)
			</div>

			<!-- Chart + Consensus -->
			<div class="anim d2 mb-8 grid grid-cols-1 md:grid-cols-3 gap-6">
				<!-- Throughput chart -->
				<div class="col-span-2 rounded-xl border border-border-default border-t-2 border-t-emerald-500 bg-surface-card p-5 shadow-sm">
					<div class="flex items-center justify-between mb-4">
						<span class="text-xs font-semibold uppercase tracking-wider text-text-muted">Transaction Throughput (24h)</span>
						<div class="flex items-center gap-3 text-2xs">
							<span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-gray-900"></span>Total</span>
							<span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-violet-500"></span>Soroban</span>
							<span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-text-muted"></span>Classic</span>
						</div>
					</div>
					<!-- SVG area chart -->
					<div class="h-40">
						<svg class="h-full w-full" viewBox="0 0 400 160" preserveAspectRatio="none">
							<!-- Total (dark) -->
							<path d="M0,120 C20,110 40,100 60,95 C80,90 100,80 120,70 C140,65 160,55 180,50 C200,45 220,40 240,35 C260,38 280,42 300,30 C320,25 340,20 360,15 C380,18 400,12 400,12 L400,160 L0,160 Z" fill="rgba(17,24,39,0.08)"></path>
							<path d="M0,120 C20,110 40,100 60,95 C80,90 100,80 120,70 C140,65 160,55 180,50 C200,45 220,40 240,35 C260,38 280,42 300,30 C320,25 340,20 360,15 C380,18 400,12 400,12" fill="none" stroke="#111827" stroke-width="2"></path>
							<!-- Soroban (violet) -->
							<path d="M0,145 C20,140 40,135 60,130 C80,128 100,120 120,115 C140,110 160,100 180,95 C200,90 220,85 240,80 C260,82 280,78 300,70 C320,65 340,60 360,55 C380,58 400,52 400,52 L400,160 L0,160 Z" fill="rgba(139,92,246,0.08)"></path>
							<path d="M0,145 C20,140 40,135 60,130 C80,128 100,120 120,115 C140,110 160,100 180,95 C200,90 220,85 240,80 C260,82 280,78 300,70 C320,65 340,60 360,55 C380,58 400,52 400,52" fill="none" stroke="#8B5CF6" stroke-width="1.5"></path>
						</svg>
					</div>
					<div class="flex justify-between mt-2 text-2xs text-text-muted">
						<span>24h ago</span><span>18h</span><span>12h</span><span>6h</span><span>Now</span>
					</div>
				</div>

				<!-- Consensus -->
				<div class="rounded-xl border border-border-default bg-surface-card p-5 shadow-sm">
					<div class="text-xs font-semibold uppercase tracking-wider text-text-muted mb-0.5">Consensus</div>
					<div class="text-2xs text-text-muted mb-4">Stellar Consensus Protocol (SCP)</div>
					<!-- Ring visualization -->
					<div class="flex justify-center mb-4">
						<div class="relative h-24 w-24">
							<svg class="h-24 w-24" viewBox="0 0 100 100">
								<circle cx="50" cy="50" r="40" fill="none" stroke="#E5E7EB" stroke-width="8"></circle>
								<circle cx="50" cy="50" r="40" fill="none" stroke="#10B981" stroke-width="8" stroke-dasharray="244" stroke-dashoffset="7" transform="rotate(-90 50 50)"></circle>
							</svg>
							<div class="absolute inset-0 flex items-center justify-center">
								<span class="text-xl font-bold text-text-primary">{ data.Agreement }</span>
							</div>
						</div>
					</div>
					<div class="grid grid-cols-2 gap-3 text-center">
						<div>
							<div class="text-2xs text-text-muted">Validators</div>
							<div class="text-sm font-semibold text-text-primary">{ data.ValidatorCount }</div>
						</div>
						<div>
							<div class="text-2xs text-text-muted">Quorum Sets</div>
							<div class="text-sm font-semibold text-text-primary">{ data.QuorumSets }</div>
						</div>
						<div>
							<div class="text-2xs text-text-muted">Avg Latency</div>
							<div class="text-sm font-semibold text-text-primary">{ data.AvgLatency }</div>
						</div>
						<div>
							<div class="text-2xs text-text-muted">Halted</div>
							<div class="text-sm font-semibold text-emerald-600">{ data.ConsensusHalted }</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Fee Market + Soroban + Protocol -->
			<div class="anim d3 mb-8 grid grid-cols-1 md:grid-cols-3 gap-6">
				<div class="rounded-xl border border-border-default bg-surface-card p-5 shadow-sm">
					<div class="text-xs font-semibold uppercase tracking-wider text-text-muted mb-3">Fee Market</div>
					<div class="space-y-3">
						<div class="flex justify-between"><span class="text-xs text-text-body">Base</span><span class="font-mono text-xs font-medium text-text-primary">{ data.FeeBase } stroops</span></div>
						<div class="flex justify-between"><span class="text-xs text-text-body">Median</span><span class="font-mono text-xs font-medium text-text-primary">{ data.FeeMedian } stroops</span></div>
						<div class="flex justify-between"><span class="text-xs text-text-body">p99</span><span class="font-mono text-xs font-medium text-amber-600">{ data.FeeP99 } stroops</span></div>
						<div class="flex justify-between"><span class="text-xs text-text-body">Daily Fees</span><span class="text-xs font-medium text-text-primary">{ data.DailyFees }</span></div>
						<div class="flex justify-between"><span class="text-xs text-text-body">Surge Pricing</span><span class="text-xs font-medium text-text-primary">{ data.SurgePricing }</span></div>
					</div>
				</div>
				<div class="rounded-xl border border-violet-200 dark:border-violet-800 border-t-2 border-t-violet-500 bg-violet-50/20 dark:bg-violet-950/20 p-5 shadow-sm">
					<div class="text-xs font-semibold uppercase tracking-wider text-violet-500 mb-3">Soroban Metrics</div>
					<div class="space-y-3">
						<div class="flex justify-between"><span class="text-xs text-violet-600">Invocations (24h)</span><span class="font-mono text-xs font-medium text-violet-900">{ data.SorobanInvocations }</span></div>
						<div class="flex justify-between"><span class="text-xs text-violet-600">Active Contracts</span><span class="font-mono text-xs font-medium text-violet-900">{ data.ActiveContracts }</span></div>
						<div class="flex justify-between"><span class="text-xs text-violet-600">Total State</span><span class="font-mono text-xs font-medium text-violet-900">{ data.TotalState }</span></div>
						<div class="flex justify-between"><span class="text-xs text-violet-600">Rent Burned (24h)</span><span class="font-mono text-xs font-medium text-violet-900">{ data.RentBurned }</span></div>
						<div class="flex justify-between"><span class="text-xs text-violet-600">Avg CPU/Invocation</span><span class="font-mono text-xs font-medium text-violet-900">{ data.AvgCPU }</span></div>
					</div>
				</div>
				<div class="rounded-xl border border-border-default bg-surface-card p-5 shadow-sm">
					<div class="text-xs font-semibold uppercase tracking-wider text-text-muted mb-3">Protocol Info</div>
					<div class="space-y-3">
						<div class="flex justify-between items-center"><span class="text-xs text-text-body">Protocol Version</span><div class="flex items-center gap-1"><span class="font-mono text-xs font-medium text-text-primary">v{ data.ProtocolVer }</span>@components.Badge("Latest", "emerald")</div></div>
						<div class="flex justify-between"><span class="text-xs text-text-body">Horizon</span><span class="font-mono text-xs font-medium text-text-primary">{ data.HorizonVer }</span></div>
						<div class="flex justify-between"><span class="text-xs text-text-body">Core Version</span><span class="font-mono text-xs font-medium text-text-primary">{ data.CoreVersion }</span></div>
						<div class="flex justify-between"><span class="text-xs text-text-body">Soroban RPC</span><span class="font-mono text-xs font-medium text-text-primary">{ data.SorobanRPCVer }</span></div>
						<div class="flex justify-between"><span class="text-xs text-text-body">Next Upgrade</span><span class="text-xs font-medium text-text-body">{ data.NextUpgrade }</span></div>
					</div>
				</div>
			</div>

			<!-- Validators Table -->
			<div class="anim d4 mb-8">
				@components.SectionHeader("Validators")
				<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden overflow-x-auto">
					<div class="flex items-center px-5 py-2.5 text-2xs font-semibold uppercase tracking-wider text-text-muted border-b border-border-default bg-surface-page">
						<div class="flex-1">Validator</div>
						<div class="hidden md:block w-28">Organization</div>
						<div class="w-20 text-right">Uptime</div>
						<div class="hidden md:block w-20 text-right">Version</div>
						<div class="hidden md:block w-20 text-right">Latency</div>
						<div class="w-20 text-right">Status</div>
					</div>
					for i, v := range data.Validators {
						<a href={ templ.SafeURL("/network/validators/" + v.Address) } class={ "detail-row flex items-center px-5 py-3 hover:bg-surface-subtle cursor-pointer", templ.KV("bg-surface-subtle", i%2 == 1) }>
							<div class="flex-1">
								<div class="flex items-center gap-1.5">
									<span class={ "h-2 w-2 rounded-full", "bg-" + v.StatusColor + "-500" }></span>
									<span class="text-sm font-medium text-text-primary">{ v.Name }</span>
								</div>
								<span class="font-mono text-2xs text-text-muted ml-3.5">{ v.Address }</span>
							</div>
							<div class="hidden md:block w-28"><span class="text-xs text-text-strong">{ v.Org }</span></div>
							<div class="w-20 text-right"><span class="text-xs text-text-strong tabular">{ v.Uptime }</span></div>
							<div class="hidden md:block w-20 text-right"><span class="font-mono text-2xs text-text-body">{ v.Version }</span></div>
							<div class="hidden md:block w-20 text-right"><span class="text-xs text-text-body tabular">{ v.Latency }</span></div>
							<div class="w-20 text-right">
								@components.Badge(v.Status, v.StatusColor)
							</div>
						</a>
					}
				</div>
				<div class="mt-3 text-center">
					<a href="/network/validators" class="text-xs font-medium text-text-body hover:text-text-primary">View all { data.ValidatorCount } validators →</a>
				</div>
			</div>

			<!-- Recent Ledgers -->
			<div class="anim d5 mb-10">
				@components.SectionHeader("Recent Ledgers")
				<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden overflow-x-auto">
					<div class="flex items-center px-5 py-2.5 text-2xs font-semibold uppercase tracking-wider text-text-muted border-b border-border-default bg-surface-page">
						<div class="w-28">Ledger</div>
						<div class="w-20">Age</div>
						<div class="w-16 text-right">Txs</div>
						<div class="hidden md:block w-16 text-right">Ops</div>
						<div class="hidden md:block w-24 text-right">Soroban</div>
						<div class="hidden md:block w-24 text-right">Fees</div>
						<div class="hidden md:block flex-1 text-right">Close Time</div>
					</div>
					for i, l := range data.RecentLedgers {
						<div class={ "tx-row flex items-center px-5 py-2.5", templ.KV("bg-surface-subtle", i%2 == 1 && !l.IsSlow), templ.KV("glow", l.IsLatest), templ.KV("bg-amber-50/40 dark:bg-amber-950/20", l.IsSlow) }>
							<div class="w-28">
								<div class="flex items-center gap-1.5">
									<a href={ templ.SafeURL("/ledger/" + l.Sequence) } class="font-mono text-xs font-semibold text-emerald-700 hover:text-emerald-800 tabular">{ l.Sequence }</a>
									if l.IsLatest {
										<span class="h-1.5 w-1.5 rounded-full bg-emerald-500 pulse-dot"></span>
									}
								</div>
							</div>
							<div class="w-20"><span class="text-2xs text-text-muted">{ l.Age }</span></div>
							<div class="w-16 text-right"><span class="text-xs text-text-primary tabular">{ l.TxCount }</span></div>
							<div class="hidden md:block w-16 text-right"><span class="text-xs text-text-strong tabular">{ l.OpsCount }</span></div>
							<div class="w-24 text-right">
								<span class="text-xs text-violet-600 tabular">{ l.SorobanCalls }</span>
								if l.SorobanPct != "" {
									<span class="ml-1 rounded bg-violet-50 dark:bg-violet-950/30 px-1 py-0.5 text-2xs font-medium text-violet-600 dark:text-violet-400">{ l.SorobanPct }</span>
								}
							</div>
							<div class="hidden md:block w-24 text-right"><span class="font-mono text-2xs text-text-body tabular">{ l.Fees }</span></div>
							<div class="flex-1 text-right">
								<span class={ "text-2xs tabular", templ.KV("text-amber-600 font-medium", l.IsSlow), templ.KV("text-text-muted", !l.IsSlow) }>{ l.CloseTime }</span>
							</div>
						</div>
					}
				</div>
			</div>
		</main>
	}
}
