package pages

import (
	"github.com/withObsrvr/prism/internal/templates/components"
	"github.com/withObsrvr/prism/internal/templates/layouts"
)

type RentTrackerData struct {
	ContractName   string
	ContractAddr   string
	CurrentLedger  string
	// TTL Health cards
	TotalEntries   string
	EstMonthlyRent string
	RentUSD        string
	HealthyCount   string
	AtRiskCount    string
	CriticalCount  string
	// Storage breakdown
	InstanceEntries   string
	InstanceSize      string
	InstanceMinTTL    string
	PersistentEntries string
	PersistentSize    string
	PersistentMinTTL  string
	TemporaryEntries  string
	TemporarySize     string
	TemporaryMinTTL   string
	// Bump cost
	BumpCost       string
	BumpCostUSD    string
	// Entries
	StorageEntries []RentStorageEntry
}

type RentStorageEntry struct {
	Type       string
	TypeColor  string
	Key        string
	KeyDesc    string
	Size       string
	TTLDays    string
	TTLLedgers string
	HealthPct  string
	HealthColor string // "emerald", "amber", "red"
	RentPerMonth string
}

templ RentTracker(data RentTrackerData) {
	@layouts.Base("State & Rent Tracker — Prism", "devtools") {
		<main class="mx-auto max-w-[1320px] px-8 py-6">
			<!-- Header -->
			<div class="anim mb-8">
				<span class="text-[11px] font-semibold uppercase tracking-wider text-gray-400">State &amp; Rent Tracker</span>
				<div class="mt-2 flex items-center justify-between">
					<div class="flex items-center gap-4">
						<div class="flex items-center gap-3 rounded-xl border border-gray-200 bg-white px-4 py-2.5 shadow-sm">
							<div class="flex flex-col">
								<span class="text-sm font-semibold text-gray-900">{ data.ContractName }</span>
								<span class="font-mono text-[11px] text-gray-400">{ data.ContractAddr }</span>
							</div>
							<svg class="h-4 w-4 text-gray-400 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
						</div>
						<div class="flex items-center gap-1.5">
							<span class="text-[10px] font-semibold text-gray-400 mr-1">Recent:</span>
							<button class="rounded-lg border border-gray-200 bg-white px-2.5 py-1 text-[11px] font-medium text-gray-600 shadow-sm">Blend Pool</button>
							<button class="rounded-lg border border-gray-200 bg-white px-2.5 py-1 text-[11px] font-medium text-gray-600 shadow-sm">USDC Token</button>
						</div>
					</div>
					<div class="flex items-center gap-2">
						<div class="flex items-center gap-1.5 rounded-full border border-gray-200 bg-white px-3 py-1 shadow-sm">
							<span class="relative flex h-2 w-2">
								<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
								<span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
							</span>
							<span class="text-[11px] font-medium text-gray-600">Auto-refresh: 30s</span>
						</div>
						<span class="text-[10px] text-gray-400">Ledger #{ data.CurrentLedger }</span>
					</div>
				</div>
			</div>

			<!-- TTL Health Overview -->
			<div class="anim d1 mb-8 grid grid-cols-5 gap-4">
				<div class="flex flex-col rounded-xl border border-gray-100 bg-[#FAFAFA] p-4 shadow-sm">
					<span class="mb-0.5 text-[10px] font-semibold uppercase tracking-wider text-gray-400">Total Entries</span>
					<span class="text-xl font-semibold text-gray-900 tabular">{ data.TotalEntries }</span>
					<span class="mt-0.5 text-[10px] text-gray-400">Across all storage types</span>
				</div>
				<div class="flex flex-col rounded-xl border border-gray-100 bg-[#FAFAFA] p-4 shadow-sm">
					<span class="mb-0.5 text-[10px] font-semibold uppercase tracking-wider text-gray-400">Est. Monthly Rent</span>
					<div class="flex items-baseline">
						<span class="text-xl font-semibold text-gray-900 tabular">{ data.EstMonthlyRent }</span>
						<span class="ml-1 text-sm font-medium text-gray-400">XLM</span>
					</div>
					<span class="mt-0.5 text-[10px] text-gray-400">~{ data.RentUSD }</span>
				</div>
				<div class="flex flex-col rounded-xl border border-emerald-100 bg-emerald-50/30 p-4 shadow-sm">
					<span class="mb-0.5 text-[10px] font-semibold uppercase tracking-wider text-emerald-600">Healthy</span>
					<span class="text-xl font-semibold text-emerald-700 tabular">{ data.HealthyCount }</span>
					<span class="mt-0.5 text-[10px] text-emerald-600/70">TTL &gt; 30 days</span>
				</div>
				<div class="flex flex-col rounded-xl border border-amber-100 bg-amber-50/30 p-4 shadow-sm">
					<span class="mb-0.5 text-[10px] font-semibold uppercase tracking-wider text-amber-600">At Risk</span>
					<span class="text-xl font-semibold text-amber-700 tabular">{ data.AtRiskCount }</span>
					<span class="mt-0.5 text-[10px] text-amber-600/70">TTL 7–30 days</span>
				</div>
				<div class="flex flex-col rounded-xl border border-red-100 bg-red-50/30 p-4 shadow-sm">
					<span class="mb-0.5 text-[10px] font-semibold uppercase tracking-wider text-red-600">Critical</span>
					<span class="text-xl font-semibold text-red-700 tabular">{ data.CriticalCount }</span>
					<span class="mt-0.5 text-[10px] text-red-600/70">TTL &lt; 7 days</span>
				</div>
			</div>

			<!-- Storage Breakdown + Extend Rent -->
			<div class="anim d2 mb-10 grid grid-cols-3 gap-6">
				<div class="col-span-2 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
					<h3 class="mb-1 text-sm font-semibold text-gray-900">Storage Breakdown</h3>
					<p class="text-xs text-gray-500 mb-5">Data entries by Soroban storage type</p>
					<!-- Stacked bar -->
					<div class="mb-4">
						<div class="flex h-3 w-full overflow-hidden rounded-full bg-gray-100">
							<div class="bg-indigo-500 rounded-l-full" style="width: 2%"></div>
							<div class="bg-cyan-500" style="width: 68%"></div>
							<div class="bg-amber-500 rounded-r-full" style="width: 30%"></div>
						</div>
						<div class="mt-2 flex items-center gap-4 text-[10px] font-medium text-gray-500">
							<span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-indigo-500"></span> Instance ({ data.InstanceEntries })</span>
							<span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-cyan-500"></span> Persistent ({ data.PersistentEntries })</span>
							<span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-amber-500"></span> Temporary ({ data.TemporaryEntries })</span>
						</div>
					</div>
					<div class="space-y-3 border-t border-gray-100 pt-4">
						@storageTypeRow("Instance", "Contract config, admin state", data.InstanceEntries, data.InstanceSize, data.InstanceMinTTL, "emerald")
						@storageTypeRow("Persistent", "User balances, LP positions", data.PersistentEntries, data.PersistentSize, data.PersistentMinTTL, "red")
						@storageTypeRow("Temporary", "Swap routes, caches", data.TemporaryEntries, data.TemporarySize, data.TemporaryMinTTL, "amber")
					</div>
				</div>

				<!-- Extend Rent Panel -->
				<div class="rounded-xl border border-gray-200 bg-white shadow-sm h-fit">
					<div class="border-b border-gray-200 px-5 py-4">
						<h3 class="text-sm font-semibold text-gray-900">Extend Rent</h3>
						<p class="text-xs text-gray-500 mt-0.5">Bump TTL for at-risk entries</p>
					</div>
					<div class="p-5">
						<div class="mb-4">
							<label class="mb-1.5 block text-[10px] font-semibold uppercase tracking-wider text-gray-400">Scope</label>
							<div class="flex w-full items-center justify-between border-b border-gray-300 py-2 text-sm font-medium text-gray-900">
								<span>All critical entries ({ data.CriticalCount })</span>
								<svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
							</div>
						</div>
						<div class="mb-4">
							<label class="mb-1.5 block text-[10px] font-semibold uppercase tracking-wider text-gray-400">Extend By</label>
							<div class="flex gap-2">
								<button class="flex-1 rounded-lg border border-gray-200 bg-white px-2 py-2 text-xs font-medium text-gray-600">30d</button>
								<button class="flex-1 rounded-lg bg-gray-900 px-2 py-2 text-xs font-semibold text-white shadow-sm">90d</button>
								<button class="flex-1 rounded-lg border border-gray-200 bg-white px-2 py-2 text-xs font-medium text-gray-600">180d</button>
								<button class="flex-1 rounded-lg border border-gray-200 bg-white px-2 py-2 text-xs font-medium text-gray-600">1yr</button>
							</div>
						</div>
						<div class="mb-5 rounded-lg bg-[#FAFAFA] p-3 ring-1 ring-gray-100">
							<div class="flex items-center justify-between mb-2">
								<span class="text-xs text-gray-500">Estimated Cost</span>
								<div class="flex items-baseline">
									<span class="text-lg font-semibold text-gray-900 tabular">{ data.BumpCost }</span>
									<span class="ml-1 text-xs font-medium text-gray-400">XLM</span>
								</div>
							</div>
							<div class="flex items-center justify-between">
								<span class="text-xs text-gray-500">USD Equivalent</span>
								<span class="text-sm font-medium text-gray-600 tabular">~{ data.BumpCostUSD }</span>
							</div>
						</div>
						<button class="flex w-full items-center justify-center gap-2 rounded-lg bg-gray-900 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-gray-800">
							Connect Wallet to Execute
						</button>
					</div>
				</div>
			</div>

			<!-- Entry-level table -->
			<div class="anim d3 mb-6">
				<div class="flex items-center justify-between mb-4">
					<div class="flex items-center gap-2">
						<h3 class="text-sm font-semibold text-gray-900">Storage Entries</h3>
						<span class="rounded-full bg-gray-100 px-2 py-0.5 text-[10px] font-bold text-gray-600">{ data.TotalEntries }</span>
					</div>
					<div class="flex gap-1.5">
						<button class="rounded-lg bg-gray-900 px-3 py-1.5 text-[11px] font-semibold text-white shadow-sm">All</button>
						<button class="rounded-lg border border-red-200 bg-red-50 px-3 py-1.5 text-[11px] font-semibold text-red-700">Critical</button>
						<button class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-1.5 text-[11px] font-semibold text-amber-700">At Risk</button>
					</div>
				</div>

				<div class="flex items-center border-b border-gray-200 pb-2.5 text-[10px] font-semibold uppercase tracking-wider text-gray-400">
					<div class="w-24">Type</div>
					<div class="flex-1 min-w-[180px]">Key</div>
					<div class="w-20 text-right">Size</div>
					<div class="w-32 text-right">TTL Remaining</div>
					<div class="w-[160px] text-center px-3">Health</div>
					<div class="w-24 text-right">Rent/mo</div>
					<div class="w-20 text-right pr-1">Action</div>
				</div>

				for _, e := range data.StorageEntries {
					<div class="flex items-center border-b border-gray-100 py-3.5">
						<div class="w-24">
							@components.Badge(e.Type, e.TypeColor)
						</div>
						<div class="flex-1 min-w-[180px]">
							<div class="flex flex-col">
								<span class="font-mono text-xs text-gray-900 truncate max-w-[260px]">{ e.Key }</span>
								<span class="text-[10px] text-gray-400">{ e.KeyDesc }</span>
							</div>
						</div>
						<div class="w-20 text-right">
							<span class="text-xs font-medium text-gray-700 tabular">{ e.Size }</span>
						</div>
						<div class="w-32 text-right">
							<div class="flex items-center justify-end gap-1.5">
								<span class={ "text-xs font-semibold tabular", templ.KV("text-red-600", e.HealthColor == "red"), templ.KV("text-amber-600", e.HealthColor == "amber"), templ.KV("text-emerald-600", e.HealthColor == "emerald") }>{ e.TTLDays }</span>
								<span class="font-mono text-[9px] text-gray-400">~{ e.TTLLedgers } ledgers</span>
							</div>
						</div>
						<div class="w-[160px] px-3">
							<div class="h-1.5 w-full rounded-full bg-gray-100">
								<div class={ "h-1.5 rounded-full", templ.KV("bg-red-500", e.HealthColor == "red"), templ.KV("bg-amber-500", e.HealthColor == "amber"), templ.KV("bg-emerald-500", e.HealthColor == "emerald") } style={ "width:" + e.HealthPct }></div>
							</div>
						</div>
						<div class="w-24 text-right">
							<span class="text-xs font-medium text-gray-700 tabular">{ e.RentPerMonth }</span>
						</div>
						<div class="w-20 flex justify-end pr-1">
							if e.HealthColor == "red" {
								<button class="rounded-md bg-red-600 px-2.5 py-1 text-[10px] font-bold text-white shadow-sm">Bump</button>
							} else if e.HealthColor == "amber" {
								<button class="rounded-md bg-amber-500 px-2.5 py-1 text-[10px] font-bold text-white shadow-sm">Bump</button>
							} else {
								<button class="rounded-md border border-gray-200 bg-white px-2.5 py-1 text-[10px] font-medium text-gray-500">Extend</button>
							}
						</div>
					</div>
				}
			</div>
		</main>
	}
}

templ storageTypeRow(name, desc, entries, size, minTTL, ttlColor string) {
	<div class="flex items-center justify-between py-2 border-t border-gray-50">
		<div class="flex items-center gap-3">
			<div class="flex flex-col">
				<span class="text-sm font-semibold text-gray-900">{ name }</span>
				<span class="text-[10px] text-gray-500">{ desc }</span>
			</div>
		</div>
		<div class="flex items-center gap-6">
			<div class="text-right">
				<div class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">Entries</div>
				<span class="text-sm font-semibold text-gray-900 tabular">{ entries }</span>
			</div>
			<div class="text-right">
				<div class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">Size</div>
				<span class="text-sm font-medium text-gray-700 tabular">{ size }</span>
			</div>
			<div class="text-right">
				<div class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">Min TTL</div>
				<div class="flex items-center gap-1.5">
					<span class={ "h-2 w-2 rounded-full", "bg-" + ttlColor + "-500" }></span>
					<span class={ "text-sm font-semibold tabular", templ.KV("text-red-600", ttlColor == "red"), templ.KV("text-amber-600", ttlColor == "amber"), templ.KV("text-emerald-600", ttlColor == "emerald"), templ.KV("text-gray-900", ttlColor != "red" && ttlColor != "amber" && ttlColor != "emerald") }>{ minTTL }</span>
				</div>
			</div>
		</div>
	</div>
}
