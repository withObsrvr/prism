package pages

import (
	"github.com/withObsrvr/prism/internal/templates/layouts"
)

// EventsFirehoseV2 renders the streamlined events page.
// Reuses EventsFirehoseData and FirehoseEvent from events_firehose.templ.
templ EventsFirehoseV2(data EventsFirehoseData) {
	@layouts.Base("Events — Prism", "devtools") {
		<main class="mx-auto max-w-[1320px] px-4 md:px-8 py-6">

			<!-- Header -->
			<div class="anim mt-4 mb-3">
				<div class="flex items-center gap-3 mb-1">
					<h1 class="text-2xl font-bold tracking-tight text-text-primary">Events</h1>
					<button class="flex items-center gap-1.5 rounded-full bg-gray-900 dark:bg-gray-100 px-3 py-1 text-xs font-semibold text-white dark:text-gray-900">
						<span class="relative flex h-2 w-2">
							<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
							<span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
						</span>
						Streaming
					</button>
				</div>
				<div class="text-2xs text-text-muted uppercase tracking-wider mb-1">Matched Events</div>
				<div class="text-4xl font-bold text-text-primary tabular mb-3">{ data.MatchedEvents }</div>
				<div class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-text-body">
					<span>Ledgers <span class="font-mono text-text-primary">{ data.LedgerStart }</span> → <span class="font-mono text-text-primary">{ data.LedgerEnd }</span></span>
					<span class="text-text-muted">&middot;</span>
					<span>~<span class="font-semibold text-text-primary tabular">{ data.EventsPerSec }</span> events/s</span>
				</div>
			</div>

			<!-- Tabs -->
			<div class="anim d1 flex gap-6 border-b border-border-default text-sm font-medium text-text-muted mb-4">
				<button class="border-b-2 border-text-primary pb-3 text-text-primary font-semibold">All Events</button>
				<button class="pb-3.5 hover:text-text-primary transition-colors">Transfers</button>
				<button class="pb-3.5 hover:text-text-primary transition-colors">Swaps</button>
				<button class="pb-3.5 hover:text-text-primary transition-colors">Mints / Burns</button>
				<button class="pb-3.5 hover:text-text-primary transition-colors">Contract Calls</button>
			</div>

			<!-- Filter bar -->
			<div class="anim d1 flex flex-col md:flex-row gap-3 mb-4">
				<div class="relative flex-1">
					<svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
					<input
						type="text"
						placeholder="Filter by contract, topic, or tx hash…"
						class="w-full pl-10 pr-4 py-2.5 bg-surface-card rounded-lg text-sm font-mono outline-none border border-border-default placeholder-text-muted focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500"
					/>
				</div>
				<!-- Active filters -->
				<div class="flex items-center gap-2 flex-shrink-0">
					for _, f := range data.Filters {
						<span class={ "flex items-center gap-1.5 rounded-lg px-2.5 py-2 text-xs font-medium ring-1", templ.KV("bg-violet-50 text-violet-700 ring-violet-200 dark:bg-violet-950/30 dark:text-violet-400 dark:ring-violet-800", f.Color == "violet"), templ.KV("bg-cyan-50 text-cyan-700 ring-cyan-200 dark:bg-cyan-950/30 dark:text-cyan-400 dark:ring-cyan-800", f.Color == "cyan") }>
							{ f.Label }
							<button class="text-current opacity-50 hover:opacity-100">&times;</button>
						</span>
					}
					<button class="rounded-lg border border-dashed border-border-default px-2.5 py-2 text-xs font-medium text-text-muted hover:border-border-default hover:text-text-body">+ Filter</button>
				</div>
			</div>

			<!-- Events table: loaded via htmx fragment -->
			<div hx-get="/fragments/events/stream" hx-trigger="load" hx-swap="outerHTML">
				@eventsTableSkeleton(8)
			</div>

		</main>
	}
}

templ eventsTableSkeleton(n int) {
	<div class="bg-surface-card rounded-xl overflow-hidden shadow-sm border border-border-default">
		for i := 0; i < n; i++ {
			<div class={ "flex items-center gap-4 px-5 py-3", templ.KV("bg-surface-subtle", i%2 == 1) }>
				<div class="h-3 w-12 rounded bg-surface-subtle animate-pulse flex-shrink-0"></div>
				<div class="h-5 w-16 rounded bg-surface-subtle animate-pulse flex-shrink-0"></div>
				<div class="flex-1 space-y-1.5">
					<div class="h-3.5 w-40 rounded bg-surface-subtle animate-pulse"></div>
					<div class="h-3 w-28 rounded bg-surface-subtle animate-pulse"></div>
				</div>
				<div class="h-3 w-16 rounded bg-surface-subtle animate-pulse"></div>
			</div>
		}
	</div>
}
