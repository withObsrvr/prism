package pages

import (
	"github.com/withObsrvr/prism/internal/templates/components"
	"github.com/withObsrvr/prism/internal/templates/layouts"
)

// EventsFirehoseV2 renders the streamlined events page.
// Reuses EventsFirehoseData and FirehoseEvent from events_firehose.templ.
templ EventsFirehoseV2(data EventsFirehoseData) {
	@layouts.Base("Events — Prism", "devtools") {
		<main class="mx-auto max-w-[1320px] px-4 md:px-8 py-6">

			<!-- Header -->
			<div class="anim mt-4 mb-3">
				<div class="flex items-center gap-3 mb-1">
					<h1 class="text-2xl font-bold tracking-tight text-gray-900">Events</h1>
					<button class="flex items-center gap-1.5 rounded-full bg-gray-900 px-3 py-1 text-xs font-semibold text-white">
						<span class="relative flex h-2 w-2">
							<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
							<span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
						</span>
						Streaming
					</button>
				</div>
				<div class="text-2xs text-gray-400 uppercase tracking-wider mb-1">Matched Events</div>
				<div class="text-4xl font-bold text-gray-900 tabular mb-3">{ data.MatchedEvents }</div>
				<div class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-gray-500">
					<span>Ledgers <span class="font-mono text-gray-900">{ data.LedgerStart }</span> → <span class="font-mono text-gray-900">{ data.LedgerEnd }</span></span>
					<span class="text-gray-300">&middot;</span>
					<span>~<span class="font-semibold text-gray-900 tabular">{ data.EventsPerSec }</span> events/s</span>
				</div>
			</div>

			<!-- Tabs -->
			<div class="anim d1 flex gap-6 border-b border-gray-200 text-sm font-medium text-gray-400 mb-4">
				<button class="border-b-2 border-gray-900 pb-3 text-gray-900 font-semibold">All Events</button>
				<button class="pb-3.5 hover:text-gray-900 transition-colors">Transfers</button>
				<button class="pb-3.5 hover:text-gray-900 transition-colors">Swaps</button>
				<button class="pb-3.5 hover:text-gray-900 transition-colors">Mints / Burns</button>
				<button class="pb-3.5 hover:text-gray-900 transition-colors">Contract Calls</button>
			</div>

			<!-- Filter bar -->
			<div class="anim d1 flex flex-col md:flex-row gap-3 mb-4">
				<div class="relative flex-1">
					<svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
					<input
						type="text"
						placeholder="Filter by contract, topic, or tx hash…"
						class="w-full pl-10 pr-4 py-2.5 bg-white rounded-lg text-sm font-mono outline-none border border-gray-200 placeholder-gray-400 focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500"
					/>
				</div>
				<!-- Active filters -->
				<div class="flex items-center gap-2 flex-shrink-0">
					for _, f := range data.Filters {
						<span class={ "flex items-center gap-1.5 rounded-lg px-2.5 py-2 text-xs font-medium ring-1", templ.KV("bg-violet-50 text-violet-700 ring-violet-200", f.Color == "violet"), templ.KV("bg-cyan-50 text-cyan-700 ring-cyan-200", f.Color == "cyan") }>
							{ f.Label }
							<button class="text-current opacity-50 hover:opacity-100">&times;</button>
						</span>
					}
					<button class="rounded-lg border border-dashed border-gray-300 px-2.5 py-2 text-xs font-medium text-gray-400 hover:border-gray-400 hover:text-gray-600">+ Filter</button>
				</div>
			</div>

			<!-- Events table -->
			<div class="anim d2 bg-white rounded-xl overflow-hidden shadow-sm border border-gray-200">
				<table class="w-full text-left">
					<thead>
						<tr class="text-2xs font-mono text-gray-400 uppercase tracking-widest bg-gray-50/80">
							<th class="px-5 py-3 font-medium w-[72px]">Time</th>
							<th class="px-4 py-3 font-medium w-20">Type</th>
							<th class="px-4 py-3 font-medium hidden md:table-cell w-[140px]">Contract</th>
							<th class="px-4 py-3 font-medium">Topics &amp; Data</th>
							<th class="px-4 py-3 font-medium text-right hidden md:table-cell w-24">Ledger</th>
							<th class="px-4 py-3 font-medium text-right hidden md:table-cell w-16">Tx</th>
							<th class="px-5 py-3 w-8"></th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-100">
						for _, ev := range data.Events {
							<tr class={ "group hover:bg-gray-50/50 transition-colors", templ.KV("bg-emerald-50/30", ev.IsNew) }
								onclick="var d=this.nextElementSibling;d.classList.toggle('hidden')">
								<td class="px-5 py-3">
									<span class="font-mono text-xs text-gray-500 tabular">{ ev.Time }</span>
								</td>
								<td class="px-4 py-3">
									@components.TypeBadge(ev.Type, eventColor(ev.TypeColor))
								</td>
								<td class="px-4 py-3 hidden md:table-cell">
									<div class="text-xs font-medium text-gray-900 truncate max-w-[130px]">{ ev.ContractName }</div>
									<div class="font-mono text-2xs text-gray-400 truncate max-w-[130px]">{ ev.ContractAddr }</div>
								</td>
								<td class="px-4 py-3">
									<div class="flex items-center gap-1.5">
										@templ.Raw(ev.TopicsHTML)
										if ev.AlertBadge != "" {
											<span class={ "rounded px-1 py-0.5 text-2xs font-bold uppercase", templ.KV("bg-red-100 text-red-700", ev.AlertColor == "red"), templ.KV("bg-amber-100 text-amber-700", ev.AlertColor == "amber") }>{ ev.AlertBadge }</span>
										}
									</div>
								</td>
								<td class="px-4 py-3 text-right hidden md:table-cell">
									<span class="font-mono text-xs text-gray-700 tabular">{ ev.Ledger }</span>
								</td>
								<td class="px-4 py-3 text-right hidden md:table-cell">
									<a href={ templ.SafeURL("/tx/" + ev.TxHash) } class="font-mono text-2xs text-gray-400 hover:text-gray-900" onclick="event.stopPropagation()">{ ev.TxShort }</a>
								</td>
								<td class="px-5 py-3 text-right">
									<svg class="h-4 w-4 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
								</td>
							</tr>
							<!-- Expandable detail row -->
							if ev.DetailJSON != "" {
								<tr class="hidden">
									<td colspan="7" class="bg-gray-50/80 px-5 py-4 border-b border-gray-100">
										<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
											<div>
												<div class="flex items-center justify-between mb-2">
													<span class="text-2xs font-semibold uppercase tracking-wider text-gray-400">Raw Event Data</span>
													@components.CopyButton(ev.DetailJSON)
												</div>
												<pre class="rounded-lg bg-[#1E1E2E] p-3 text-2xs font-mono text-gray-300 overflow-x-auto leading-relaxed">{ ev.DetailJSON }</pre>
											</div>
											<div>
												<span class="text-2xs font-semibold uppercase tracking-wider text-gray-400 mb-2 block">Context</span>
												<div class="text-xs text-gray-600 leading-relaxed">{ ev.DetailMeta }</div>
											</div>
										</div>
									</td>
								</tr>
							}
						}
					</tbody>
				</table>

				<!-- Load more -->
				<div class="border-t border-gray-100 py-3.5 text-center bg-gray-50/50">
					<button class="text-xs font-medium text-gray-500 hover:text-gray-900 transition-colors">Load older events</button>
				</div>
			</div>

		</main>
	}
}

// eventColor maps the firehose TypeColor strings to shared TypeBadge colors.
func eventColor(tc string) string {
	switch tc {
	case "transfer":
		return "cyan"
	case "contract":
		return "violet"
	case "mint":
		return "emerald"
	case "approve":
		return "blue"
	case "burn":
		return "red"
	case "system":
		return "amber"
	default:
		return "gray"
	}
}
