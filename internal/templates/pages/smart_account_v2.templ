package pages

import (
	"fmt"
	"github.com/withObsrvr/prism/internal/templates/components"
	"github.com/withObsrvr/prism/internal/templates/layouts"
)

templ SmartAccountV2(data SmartAccountData) {
	@layouts.Base(data.Name + " — Prism", "explorer") {
		<main class="mx-auto max-w-[1320px] px-4 md:px-8 py-6">

			<!-- Header -->
			<div class="anim mt-4 mb-5">
				@components.BackNav("Back to Explorer", "/")
				if data.Degraded {
					<div class="mb-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-900/50 dark:bg-amber-950/20 dark:text-amber-200">
						This contract shows smart-wallet behavior, but the indexer has not fully classified or decoded it yet.
					</div>
				}
				if data.PartialData {
					<div class="mb-4 rounded-xl border border-border-default bg-surface-subtle px-4 py-3 text-sm text-text-body">
						Some wallet details are partial; Prism is filling gaps from other account and contract endpoints where possible.
					</div>
				}
				<div class="flex items-center gap-3 mb-1 flex-wrap">
					<span class="text-2xl font-bold text-text-primary">{ data.Name }</span>
					@components.Badge(data.BadgeLabel, "violet")
					if data.ClassificationSource != "" {
						@components.MetaBadge(data.ClassificationSource)
					}
					if data.Confidence != "" {
						@components.MetaBadge(data.Confidence)
					}
				</div>
				<div class="flex items-center gap-1.5 mb-2">
					<span class="font-mono text-xs text-text-muted">{ data.ContractID }</span>
					@components.CopyButton(data.ContractID)
				</div>
				<!-- Hero balance summary -->
				<div class="text-2xs text-text-muted uppercase tracking-wider mb-1">{ data.Portfolio.HeroLabel() }</div>
				<div class="flex items-baseline mb-3">
					<span class="text-4xl font-bold text-text-primary tabular">{ data.Portfolio.HeroValue() }</span>
					if data.Portfolio.HeroUnit() != "" {
						<span class="text-2xl font-medium text-text-muted ml-0.5">{ data.Portfolio.HeroUnit() }</span>
					}
				</div>
				<div class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-text-body">
					<span>Signers <span class="font-semibold text-text-primary">{ fmt.Sprintf("%d", len(data.Signers)) }</span></span>
					<span class="text-text-muted">&middot;</span>
					<span>Approval <span class="font-semibold text-text-primary">{ data.MinSigners }</span></span>
					<span class="text-text-muted">&middot;</span>
					<span>TTL <span class="font-semibold text-text-primary">{ data.Health.TTLRemaining }</span></span>
				</div>
				if data.ApprovalSummary != "" {
					<div class="mt-2 text-sm text-text-body max-w-3xl">{ data.ApprovalSummary }</div>
				}
				if len(data.Evidence) > 0 {
					<div class="mt-3 flex flex-wrap gap-2">
						for _, evidence := range data.Evidence {
							<span class="rounded-lg bg-surface-subtle px-3 py-1.5 text-xs text-text-body">{ evidence }</span>
						}
					</div>
				}
			</div>

			@balancePortfolio(data.Portfolio)

			<!-- Tabs -->
			<div class="anim d1 flex gap-6 border-b border-border-default text-sm font-medium text-text-muted mb-6 overflow-x-auto flex-nowrap whitespace-nowrap" data-smart-tabs>
				<button type="button" data-smart-tab="overview" class="border-b-2 border-text-primary pb-3 text-text-primary font-semibold">{ data.OverviewTabLabel }</button>
				<button type="button" data-smart-tab="security" class="pb-3.5 hover:text-text-primary transition-colors">{ data.SecurityTabLabel }</button>
				<button type="button" data-smart-tab="activity" class="pb-3.5 hover:text-text-primary transition-colors">{ data.ActivityTabLabel }</button>
			</div>

			<!-- Signers -->
			<div class="anim d1 mb-8" data-smart-section="overview security">
				<div class="flex items-center justify-between mb-2 gap-3">
					<h3 class="text-2xs font-semibold uppercase tracking-wider text-text-muted">Signers</h3>
					if data.SignerSourceLabel != "" {
						<span class="text-2xs text-text-muted">{ data.SignerSourceLabel }</span>
					}
				</div>
				<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden">
					if len(data.Signers) > 0 {
						<table class="w-full text-left">
							<thead>
								<tr class="text-2xs font-mono text-text-muted uppercase tracking-widest bg-surface-subtle">
									<th class="px-5 py-3 font-medium">Signer</th>
									<th class="px-4 py-3 font-medium">Role</th>
									<th class="px-4 py-3 font-medium hidden md:table-cell">Key Type</th>
									<th class="px-4 py-3 font-medium text-right">Weight</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-border-subtle">
								for _, s := range data.Signers {
									<tr>
										<td class="px-5 py-3">
											<div class="text-sm font-medium text-text-primary">{ s.Name }</div>
											<a href={ templ.SafeURL(s.AddressHref) } class="font-mono text-2xs text-emerald-700 hover:text-emerald-800 dark:text-emerald-400 dark:hover:text-emerald-300">{ s.Address }</a>
										</td>
										<td class="px-4 py-3">
											@components.Badge(s.Role, s.RoleColor)
										</td>
										<td class="px-4 py-3 hidden md:table-cell text-xs text-text-body">{ s.KeyType }</td>
										<td class="px-4 py-3 text-right font-mono text-sm font-semibold text-text-primary">{ s.Weight }</td>
									</tr>
								}
							</tbody>
						</table>
					} else {
						<div class="px-5 py-4 text-sm text-text-body">Signer set has not been decoded from indexed state yet.</div>
					}
				</div>
			</div>

			<!-- Behavior Summary -->
			if len(data.ActiveWindows) > 0 || len(data.CommonFunctions) > 0 || len(data.CommonProtocols) > 0 {
				<div class="anim d2 mb-8" data-smart-section="overview">
					<h3 class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-2">Behavior Summary</h3>
					<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden text-sm">
						if len(data.ActiveWindows) > 0 {
							<div class="px-5 py-3 border-b border-border-subtle">
								<div class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-2">Active Windows</div>
								<div class="flex flex-wrap gap-2">
									for _, window := range data.ActiveWindows {
										<span class="rounded-lg bg-surface-subtle px-3 py-1.5 text-xs text-text-body">{ window }</span>
									}
								</div>
							</div>
						}
						if len(data.CommonFunctions) > 0 {
							<div class="px-5 py-3 border-b border-border-subtle">
								<div class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-2">Common Functions</div>
								<div class="flex flex-wrap gap-2">
									for _, fn := range data.CommonFunctions {
										<span class="rounded-lg bg-surface-subtle px-3 py-1.5 text-xs">
											<span class="font-medium text-text-primary">{ fn.Name }</span>
											<span class="text-text-muted ml-1">{ fn.Count }</span>
										</span>
									}
								</div>
							</div>
						}
						if len(data.CommonProtocols) > 0 {
							<div class="px-5 py-3">
								<div class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-2">Common Protocols</div>
								<div class="flex flex-wrap gap-2">
									for _, p := range data.CommonProtocols {
										<span class="rounded-lg bg-surface-subtle px-3 py-1.5 text-xs">
											<span class="font-medium text-text-primary">{ p.Name }</span>
											<span class="text-text-muted ml-1">{ p.Count }</span>
										</span>
									}
								</div>
							</div>
						}
					</div>
				</div>
			}

			<!-- Policies -->
			<div class="anim d2 mb-8" data-smart-section="security">
				<div class="flex items-center justify-between mb-2 gap-3">
					<h3 class="text-2xs font-semibold uppercase tracking-wider text-text-muted">Authorization Policies</h3>
					if data.PolicyStateLabel != "" {
						<span class="text-2xs text-text-muted">{ data.PolicyStateLabel }</span>
					}
				</div>
				if len(data.Policies) > 0 {
					<div class="space-y-3">
						for _, p := range data.Policies {
							<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden text-sm">
								<div class="flex items-center justify-between px-5 py-3 border-b border-border-subtle">
									<div>
										<span class="font-medium text-text-primary">{ p.Name }</span>
										<span class="text-text-muted ml-2">{ p.Description }</span>
									</div>
									if p.IsActive {
										@components.Badge("Active", "emerald")
									}
								</div>
								if p.Limit != "" {
									<div class="px-5 py-3">
										<div class="flex items-center justify-between text-xs mb-1.5">
											<span class="text-text-muted">{ p.Spent } / { p.Limit } used</span>
											<span class="text-text-muted">Resets in { p.ResetsIn }</span>
										</div>
										<div class="h-1.5 rounded-full bg-surface-subtle">
											<div class="h-1.5 rounded-full bg-emerald-500" style={ "width:" + p.SpentPct }></div>
										</div>
									</div>
								}
								if len(p.Contracts) > 0 {
									<div class="px-5 py-3 border-t border-border-subtle">
										<div class="flex flex-wrap gap-2">
											for _, c := range p.Contracts {
												<span class="rounded-lg bg-surface-subtle px-3 py-1.5 text-xs">
													<span class="font-medium text-text-primary">{ c.Name }</span>
													<span class="text-text-muted ml-1">{ c.Methods }</span>
												</span>
											}
										</div>
									</div>
								}
							</div>
						}
					</div>
				} else {
					<div class="rounded-xl border border-border-default bg-surface-card px-5 py-4 text-sm text-text-body shadow-sm">
						No decoded policy objects are available for this wallet yet.
					</div>
				}
			</div>

			<!-- Session Keys -->
			if len(data.SessionKeys) > 0 {
				<div class="anim d2 mb-8" data-smart-section="security">
					<h3 class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-2">Session Keys</h3>
					<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden">
						<table class="w-full text-left">
							<thead>
								<tr class="text-2xs font-mono text-text-muted uppercase tracking-widest bg-surface-subtle">
									<th class="px-5 py-3 font-medium">Session</th>
									<th class="px-4 py-3 font-medium hidden md:table-cell">Scope</th>
									<th class="px-4 py-3 font-medium text-right">Spend Limit</th>
									<th class="px-4 py-3 font-medium text-right">Expires</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-border-subtle">
								for _, sk := range data.SessionKeys {
									<tr>
										<td class="px-5 py-3">
											<div class="text-sm font-medium text-text-primary">{ sk.Name }</div>
											<div class="font-mono text-2xs text-text-muted">{ sk.Key }</div>
										</td>
										<td class="px-4 py-3 hidden md:table-cell text-xs text-text-body">{ sk.Scope }</td>
										<td class="px-4 py-3 text-right">
											<span class="font-mono text-sm text-text-primary tabular">{ sk.Used }/{ sk.SpendLimit }</span>
										</td>
										<td class="px-4 py-3 text-right text-xs text-text-body">{ sk.Expires }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}

			<!-- Approval Model + Contract Health + Security Log -->
			<div class="anim d3 grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
				<div data-smart-section="overview security">
					<h3 class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-2">Approval Model</h3>
					<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden text-sm">
						<div class="detail-row px-5 py-3 border-b border-border-subtle">
							<div class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-1">Summary</div>
							<div class="text-text-primary">{ data.ApprovalSummary }</div>
						</div>
						<div class="detail-row flex items-center justify-between px-5 py-2.5 border-b border-border-subtle">
							<span class="text-text-muted">Signers Observed</span>
							<span class="font-medium text-text-primary">{ fmt.Sprintf("%d", len(data.Signers)) }</span>
						</div>
						<div class="detail-row flex items-center justify-between px-5 py-2.5 border-b border-border-subtle">
							<span class="text-text-muted">Required</span>
							<span class="font-medium text-text-primary">{ data.MinSigners }</span>
						</div>
						<div class="detail-row flex items-center justify-between px-5 py-2.5 border-b border-border-subtle">
							<span class="text-text-muted">Required Weight</span>
							<span class="font-medium text-text-primary">{ data.RequiredWeight }</span>
						</div>
						<div class="detail-row flex items-center justify-between px-5 py-2.5">
							<span class="text-text-muted">Total Weight</span>
							<span class="font-medium text-text-primary">{ data.TotalWeight }</span>
						</div>
					</div>
				</div>
				<div data-smart-section="overview security">
					<h3 class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-2">Contract Health</h3>
					<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden text-sm">
						<div class="detail-row flex items-center justify-between px-5 py-2.5 border-b border-border-subtle">
							<span class="text-text-muted">Rent Status</span>
							<span class="font-medium text-emerald-600">{ data.Health.RentStatus }</span>
						</div>
						<div class="detail-row flex items-center justify-between px-5 py-2.5 border-b border-border-subtle">
							<span class="text-text-muted">TTL Remaining</span>
							<span class="font-medium text-text-primary">{ data.Health.TTLRemaining }</span>
						</div>
						<div class="detail-row flex items-center justify-between px-5 py-2.5 border-b border-border-subtle">
							<span class="text-text-muted">WASM Hash</span>
							<span class="font-mono text-xs text-text-body">{ data.Health.WASMHash }</span>
						</div>
						<div class="detail-row flex items-center justify-between px-5 py-2.5 border-b border-border-subtle">
							<span class="text-text-muted">Implementation</span>
							<span class="text-text-primary">{ data.Health.OZVersion }</span>
						</div>
						<div class="detail-row flex items-center justify-between px-5 py-2.5 border-b border-border-subtle">
							<span class="text-text-muted">Deployer</span>
							<a href={ templ.SafeURL(data.Health.DeployerHref) } class="font-mono text-xs text-emerald-700 hover:text-emerald-800 dark:text-emerald-400 dark:hover:text-emerald-300">{ data.Health.Deployer }</a>
						</div>
						<div class="detail-row flex items-center justify-between px-5 py-2.5 border-b border-border-subtle">
							<span class="text-text-muted">State Size</span>
							<span class="text-text-strong">{ data.Health.StateSize }</span>
						</div>
						<div class="detail-row flex items-center justify-between px-5 py-2.5">
							<span class="text-text-muted">Deployed</span>
							<span class="text-text-strong">{ data.Health.Deployed }</span>
						</div>
					</div>
				</div>
				<div data-smart-section="security">
					<h3 class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-2">Security Log</h3>
					<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden text-sm">
						for _, ev := range data.SecurityLog {
							<div class="detail-row px-5 py-3 border-b border-border-subtle">
								<div class="flex items-center gap-3 mb-1.5">
									<div class={ "flex h-6 w-6 items-center justify-center rounded-full", ev.IconBg }>
										if ev.IconSVG == "check" {
											<svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
										}
										if ev.IconSVG == "plus" {
											<svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m6-6H6"></path></svg>
										}
										if ev.IconSVG == "x" {
											<svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
										}
										if ev.IconSVG == "key" {
											<svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg>
										}
										if ev.IconSVG == "arrow-up-right" {
											<svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H8m9 0v9"></path></svg>
										}
										if ev.IconSVG == "swap" {
											<svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
										}
									</div>
									<span class="text-xs text-text-muted w-12 flex-shrink-0">{ ev.Time }</span>
									<span class="text-text-strong flex-1">{ ev.Action }</span>
									@components.Badge(ev.Status, ev.StatusColor)
								</div>
								<div class="pl-[3.75rem] text-xs text-text-body">
									{ ev.Detail }
									if ev.CounterpartyLabel != "" {
										<span class="mx-1 text-text-muted">·</span>
										<a href={ templ.SafeURL(ev.CounterpartyHref) } class="font-mono text-emerald-700 hover:text-emerald-800 dark:text-emerald-400 dark:hover:text-emerald-300">{ ev.CounterpartyLabel }</a>
									}
									if ev.RelatedLabel != "" {
										<span class="mx-1 text-text-muted">·</span>
										<a href={ templ.SafeURL(ev.RelatedHref) } class="font-mono text-emerald-700 hover:text-emerald-800 dark:text-emerald-400 dark:hover:text-emerald-300">{ ev.RelatedLabel }</a>
									}
									if ev.TxHash != "" {
										<span class="mx-1 text-text-muted">·</span>
										<a href={ templ.SafeURL("/tx/" + ev.TxHash) } class="font-mono text-emerald-700 hover:text-emerald-800 dark:text-emerald-400 dark:hover:text-emerald-300">{ ev.ShortHash }</a>
									}
								</div>
							</div>
						}
					</div>
				</div>
			</div>

			<div class="anim d3 mb-8" data-smart-section="activity">
				<div class="flex items-center justify-between mb-2 gap-3 flex-wrap">
					<h3 class="text-2xs font-semibold uppercase tracking-wider text-text-muted">Wallet Activity</h3>
					<div class="flex items-center gap-3 flex-wrap">
						if data.ActivitySourceLabel != "" {
							<span class="text-2xs text-text-muted">{ data.ActivitySourceLabel }</span>
						}
						if data.ActivityWindowLabel != "" {
							<span class="text-2xs text-text-muted">{ data.ActivityWindowLabel }</span>
						}
					</div>
				</div>
				<div class="rounded-xl border border-border-default bg-surface-card shadow-sm overflow-hidden text-sm">
					if len(data.ActivityLog) > 0 {
						for _, ev := range data.ActivityLog {
							<div class="detail-row px-5 py-3 border-b border-border-subtle">
								<div class="flex items-center gap-3 mb-1.5">
									<div class={ "flex h-6 w-6 items-center justify-center rounded-full", ev.IconBg }>
										if ev.IconSVG == "check" {
											<svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
										}
										if ev.IconSVG == "plus" {
											<svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m6-6H6"></path></svg>
										}
										if ev.IconSVG == "x" {
											<svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
										}
										if ev.IconSVG == "key" {
											<svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg>
										}
										if ev.IconSVG == "arrow-up-right" {
											<svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H8m9 0v9"></path></svg>
										}
										if ev.IconSVG == "swap" {
											<svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
										}
									</div>
									<span class="text-xs text-text-muted w-12 flex-shrink-0">{ ev.Time }</span>
									<span class="text-text-strong flex-1">{ ev.Action }</span>
									@components.Badge(ev.Status, ev.StatusColor)
								</div>
								<div class="pl-[3.75rem] text-xs text-text-body">
									{ ev.Detail }
									if ev.CounterpartyLabel != "" {
										<span class="mx-1 text-text-muted">·</span>
										<a href={ templ.SafeURL(ev.CounterpartyHref) } class="font-mono text-emerald-700 hover:text-emerald-800 dark:text-emerald-400 dark:hover:text-emerald-300">{ ev.CounterpartyLabel }</a>
									}
									if ev.RelatedLabel != "" {
										<span class="mx-1 text-text-muted">·</span>
										<a href={ templ.SafeURL(ev.RelatedHref) } class="font-mono text-emerald-700 hover:text-emerald-800 dark:text-emerald-400 dark:hover:text-emerald-300">{ ev.RelatedLabel }</a>
									}
									if ev.TxHash != "" {
										<span class="mx-1 text-text-muted">·</span>
										<a href={ templ.SafeURL("/tx/" + ev.TxHash) } class="font-mono text-emerald-700 hover:text-emerald-800 dark:text-emerald-400 dark:hover:text-emerald-300">{ ev.ShortHash }</a>
									}
								</div>
							</div>
						}
					} else {
						<div class="px-5 py-4 text-sm text-text-body">No recent transfers involving this wallet were observed in the selected history window.</div>
					}
				</div>
			</div>

			<script>
				(() => {
					const tabRoot = document.querySelector('[data-smart-tabs]');
					if (!tabRoot) return;
					const buttons = Array.from(tabRoot.querySelectorAll('[data-smart-tab]'));
					const sections = Array.from(document.querySelectorAll('[data-smart-section]'));

					function setTab(tab) {
						buttons.forEach((btn) => {
							const isActive = btn.dataset.smartTab === tab;
							btn.classList.toggle('border-b-2', isActive);
							btn.classList.toggle('border-text-primary', isActive);
							btn.classList.toggle('pb-3', isActive);
							btn.classList.toggle('text-text-primary', isActive);
							btn.classList.toggle('font-semibold', isActive);
							btn.classList.toggle('pb-3.5', !isActive);
						});
						sections.forEach((section) => {
							const tabs = (section.dataset.smartSection || '').split(/\s+/).filter(Boolean);
							section.classList.toggle('hidden', tabs.length > 0 && !tabs.includes(tab));
						});
						window.history.replaceState(null, '', '#' + tab);
					}

					buttons.forEach((btn) => btn.addEventListener('click', () => setTab(btn.dataset.smartTab || 'overview')));
					const initial = (window.location.hash || '#overview').replace('#', '');
					setTab(['overview', 'security', 'activity'].includes(initial) ? initial : 'overview');
				})();
			</script>
		</main>
	}
}
