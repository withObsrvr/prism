package pages

import "github.com/withObsrvr/prism/internal/templates/layouts"
import "github.com/withObsrvr/prism/internal/templates/components"

// HomeData holds everything the home page needs to render.
type HomeData struct {
	LatestLedger uint64
	TPS          float64
	TxCount24H   uint64
}

// Home renders the search-first landing page.
templ Home(data HomeData) {
	@layouts.Base("Prism — Soroban-first Block Explorer", "explorer") {

		<!-- Search hero -->
		<div class="mx-auto max-w-[640px] pt-16 pb-12 text-center">
			<h1 class="text-2xl font-bold tracking-tight text-gray-900 mb-2">
				Explore Stellar
			</h1>
			<p class="text-[13px] text-gray-500 mb-8">
				Search by address, transaction hash, contract ID, asset code, or ledger number
			</p>

			<!-- Search input with htmx live results -->
			<div class="search-ring flex items-center gap-3 rounded-2xl border border-gray-200 bg-white px-5 py-4 shadow-lg shadow-gray-200/50">
				<svg class="h-5 w-5 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
				</svg>
				<input
					type="text"
					name="q"
					placeholder="Search…"
					class="flex-1 text-[15px] text-gray-900 placeholder-gray-400 outline-none bg-transparent"
					autocomplete="off"
					hx-get="/partials/search-results"
					hx-trigger="keyup changed delay:300ms"
					hx-target="#search-live-results"
				/>
				<kbd class="rounded-lg border border-gray-200 bg-gray-50 px-2.5 py-1 text-[11px] font-semibold text-gray-400">⌘K</kbd>
			</div>

			<!-- Live search results drop here -->
			<div id="search-live-results" class="mt-2 text-left"></div>

			<!-- Type hints -->
			<div class="flex items-center justify-center gap-2 mt-4 text-[11px] text-gray-400">
				<span class="rounded-full border border-gray-200 px-2.5 py-0.5 font-medium">G… → Account</span>
				<span class="rounded-full border border-gray-200 px-2.5 py-0.5 font-medium">C… → Contract</span>
				<span class="rounded-full border border-gray-200 px-2.5 py-0.5 font-medium">hex → Transaction</span>
				<span class="rounded-full border border-gray-200 px-2.5 py-0.5 font-medium"># → Ledger</span>
			</div>
		</div>

		<!-- Network pulse -->
		@components.NetworkPulse(data.LatestLedger, data.TPS)

		<!-- Live transaction feed (polls every 3s) -->
		<div class="mt-8">
			<div class="flex items-center gap-2 mb-3">
				<span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
				<span class="text-[12px] font-semibold text-gray-700">Live Transactions</span>
			</div>
			<div
				hx-get="/partials/live-feed"
				hx-trigger="every 3s"
				hx-swap="innerHTML"
			>
				<!-- Initial content rendered server-side, then htmx replaces -->
				<div class="text-[12px] text-gray-400">Connecting to network…</div>
			</div>
		</div>
	}
}
