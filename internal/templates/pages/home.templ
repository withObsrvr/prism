package pages

import (
	"fmt"
	"github.com/withObsrvr/prism/internal/templates/components"
	"github.com/withObsrvr/prism/internal/templates/layouts"
)

// HomeData holds everything the home page needs to render.
type HomeData struct {
	Network       string
	LatestLedger  string
	LedgerAge     string
	TxCount24H    string
	TxChange      string
	TPSAvg        string
	TPSPeak       string
	SorobanCalls  string
	SorobanChange string
	Validators    int
	// Fee Guide
	FeeEconomy    string // base fee in stroops
	FeeStandard   string // median fee in stroops
	FeePriority   string // p99 fee in stroops
	SurgeActive   bool
	SurgeContext  string // e.g. "Network is uncongested"
	Transactions  []HomeTx
	Ledgers       []HomeLedger
	Contracts     []HomeContract
	Assets        []HomeAsset
}

type HomeTx struct {
	Hash     string
	ShortHash string
	Type     string // "contract_call", "payment", "account_merge"
	TypeLabel string
	Summary  string
	From     string
	To       string
	Ops      string
	Fee      string
	Age      string
}

type HomeLedger struct {
	Sequence string
	Age      string
	TxCount  string
	OpCount  string
	IsLatest bool
}

type HomeContract struct {
	Rank        int
	Name        string
	Tag         string
	TagColor    string // "violet", "cyan", "emerald"
	Address     string
	Invocations string
	Change      string
	IsPositive  bool
}

type HomeAsset struct {
	Code       string
	Issuer     string
	Initial    string
	BgColor    string
	Volume     string
	Change     string
	IsPositive bool
}

// Home renders the search-first landing page.
templ Home(data HomeData) {
	@layouts.Base("Prism — Soroban-first Block Explorer", "explorer") {

		<!-- Mock Design Modal -->
		<dialog id="mock-banner" class="fixed inset-0 z-50 m-auto h-fit w-full max-w-md rounded-xl border border-border-default bg-surface-card p-0 shadow-xl backdrop:bg-gray-900/40 backdrop:backdrop-blur-sm">
			<div class="p-6">
				<div class="mb-4 flex items-center gap-2.5">
					<div class="flex h-9 w-9 items-center justify-center rounded-lg bg-amber-50 dark:bg-amber-950/30 ring-1 ring-amber-200 dark:ring-amber-800">
						<svg class="h-5 w-5 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
					</div>
					<div>
						<h2 class="text-sm font-semibold text-text-primary">Design Preview</h2>
						<p class="text-xs text-text-muted">Prism Block Explorer</p>
					</div>
				</div>
				<p class="mb-1 text-sm leading-relaxed text-text-body">
					This is a <span class="font-semibold text-text-primary">mock design</span> of the Prism block explorer. All data shown is placeholder content for testing the UI layout and visual design.
				</p>
				<p class="mb-5 text-xs text-text-muted">
					No live blockchain data is being displayed.
				</p>
				<button onclick="localStorage.setItem('prism_mock_dismissed','1');document.getElementById('mock-banner').close()" class="w-full rounded-lg bg-gray-900 dark:bg-gray-100 px-4 py-2 text-sm font-semibold text-white dark:text-gray-900 shadow-sm hover:bg-gray-800 transition-colors">
					Got it, explore the design
				</button>
			</div>
		</dialog>
		<script>
			if (!localStorage.getItem('prism_mock_dismissed')) {
				document.getElementById('mock-banner').showModal();
			}
		</script>

		<!-- Hero Section -->
		<section class="relative overflow-hidden bg-surface-card border-b border-border-subtle">
			<!-- Subtle grid texture -->
			<div class="absolute inset-0 opacity-[.025] dark:invert" style="background-image:url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2240%22 height=%2240%22><line x1=%2220%22 y1=%220%22 x2=%2220%22 y2=%2240%22 stroke=%22%23111%22 stroke-width=%220.5%22/><line x1=%220%22 y1=%2220%22 x2=%2240%22 y2=%2220%22 stroke=%22%23111%22 stroke-width=%220.5%22/></svg>')"></div>

			<div class="relative mx-auto max-w-[1320px] px-4 md:px-8 pt-8 md:pt-12 pb-10 md:pb-12">

				<!-- Search Bar -->
				<form action="/search" method="GET" class="anim mx-auto max-w-[680px] mb-8">
					<div class="search-ring flex items-center gap-3 rounded-2xl border border-border-default bg-surface-card px-5 py-4 shadow-lg shadow-sm">
						<svg class="h-5 w-5 text-text-muted flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
						</svg>
						<input
							type="text"
							name="q"
							placeholder="Search by address, tx hash, contract, asset, or ledger…"
							class="flex-1 text-sm text-text-primary placeholder-text-muted outline-none bg-transparent"
							autocomplete="off"
							hx-get="/partials/search-results"
							hx-trigger="keyup changed delay:300ms"
							hx-target="#search-live-results"
						/>
						<kbd class="rounded-lg border border-border-default bg-surface-subtle px-2.5 py-1 text-xs font-semibold text-text-muted">Ctrl+K</kbd>
					</div>

					<!-- Live search results -->
					<div id="search-live-results" class="mt-2 text-left"></div>

					<!-- Smart hints -->
					<div class="flex flex-wrap items-center justify-center gap-2 mt-3">
						<span class="text-2xs text-text-muted mr-1">Try:</span>
						<a href="#" class="hint-pill rounded-full bg-surface-subtle px-2.5 py-1 text-xs font-medium text-text-body">G… → Account</a>
						<a href="#" class="hint-pill rounded-full bg-surface-subtle px-2.5 py-1 text-xs font-medium text-text-body">C… → Contract</a>
						<a href="#" class="hint-pill rounded-full bg-surface-subtle px-2.5 py-1 text-xs font-medium text-text-body">64-char hex → Transaction</a>
						<a href="#" class="hint-pill rounded-full bg-surface-subtle px-2.5 py-1 text-xs font-medium text-text-body">USDC → Asset</a>
						<a href="#" class="hint-pill rounded-full bg-surface-subtle px-2.5 py-1 text-xs font-medium text-text-body">{ data.LatestLedger } → Ledger</a>
					</div>
				</form>

				<!-- Network Pulse (5 metrics) -->
				<div class="anim d1 mx-auto max-w-[820px] grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-px rounded-xl bg-border-default overflow-hidden ring-1 ring-border-default">
					<div class="bg-surface-card px-4 py-3 text-center border-t-2 border-emerald-500" hx-get="/partials/latest-ledger" hx-trigger="every 2.5s" hx-swap="innerHTML">
						<div class="text-2xs font-semibold uppercase tracking-wider text-text-muted">Latest Ledger</div>
						<div class="text-lg font-bold text-text-primary tabular font-mono mt-0.5">{ data.LatestLedger }</div>
						<div class="flex items-center justify-center gap-1 mt-0.5">
							<span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
							<span class="text-2xs text-emerald-600 font-medium">{ data.LedgerAge }</span>
						</div>
					</div>
					<div class="bg-surface-card px-4 py-3 text-center">
						<div class="text-2xs font-semibold uppercase tracking-wider text-text-muted">Transactions (24h)</div>
						<div class="text-lg font-bold text-text-primary tabular mt-0.5">{ data.TxCount24H }</div>
						<div class="text-2xs text-emerald-600 font-medium mt-0.5">{ data.TxChange }</div>
					</div>
					<div class="bg-surface-card px-4 py-3 text-center">
						<div class="text-2xs font-semibold uppercase tracking-wider text-text-muted">TPS (avg)</div>
						<div class="text-lg font-bold text-text-primary tabular mt-0.5">{ data.TPSAvg }</div>
						<div class="text-2xs text-text-body mt-0.5">peak: { data.TPSPeak }</div>
					</div>
					<div class="bg-surface-card px-4 py-3 text-center">
						<div class="text-2xs font-semibold uppercase tracking-wider text-text-muted">Soroban Calls (24h)</div>
						<div class="text-lg font-bold text-text-primary tabular mt-0.5">{ data.SorobanCalls }</div>
						<div class="text-2xs text-emerald-600 font-medium mt-0.5">{ data.SorobanChange }</div>
					</div>
					<div class="bg-surface-card px-4 py-3 text-center">
						<div class="text-2xs font-semibold uppercase tracking-wider text-text-muted">Validators</div>
						<div class="text-lg font-bold text-text-primary tabular mt-0.5">{ fmt.Sprintf("%d", data.Validators) }</div>
						<div class="flex items-center justify-center gap-1 mt-0.5">
							<span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
							<span class="text-2xs text-emerald-600 font-medium">All healthy</span>
						</div>
					</div>
				</div>

			</div>
		</section>

		<!-- Main Content: Transactions + Ledgers -->
		<section class="mx-auto max-w-[1320px] px-4 md:px-8 py-8">
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

				<!-- Latest Transactions (2 cols) -->
				<div class="lg:col-span-2">
					<div class="flex items-center justify-between mb-4">
						<div class="flex items-center gap-2.5">
							<h2 class="text-sm font-semibold text-text-primary">Latest Transactions</h2>
							<div class="flex items-center gap-1 rounded-full bg-emerald-50 dark:bg-emerald-950/30 px-2 py-0.5 ring-1 ring-emerald-200/60 dark:ring-emerald-800/60">
								<span class="h-1.5 w-1.5 rounded-full bg-emerald-500 pulse-dot"></span>
								<span class="text-2xs font-medium text-emerald-700 dark:text-emerald-400">Live</span>
							</div>
						</div>
						<a href="#" class="text-xs font-medium text-text-body hover:text-text-primary transition-colors">View all →</a>
					</div>

					<div class="rounded-xl border border-border-default bg-surface-card overflow-hidden">
						for i, tx := range data.Transactions {
							<a href={ templ.SafeURL("/tx/" + tx.Hash) } class={ "tx-row flex items-center gap-4 px-5 py-3 hover:bg-surface-subtle cursor-pointer transition-colors", templ.KV("bg-surface-subtle", i%2 == 1) }>
								<!-- Summary + Hash -->
								<div class="flex-1 min-w-0">
									<div class="flex items-center gap-2 mb-0.5">
										<span class="text-xs text-text-strong truncate">{ tx.Summary }</span>
										@components.Badge(tx.TypeLabel, txTypeColor(tx.Type))
									</div>
									<div class="flex items-center gap-2 text-2xs">
										<span class="font-mono text-emerald-700 font-medium">{ tx.ShortHash }</span>
										<span class="text-text-muted">&middot;</span>
										<span class="text-text-muted">{ tx.Age }</span>
									</div>
								</div>
								<!-- Meta -->
								<div class="hidden md:flex items-center gap-3 flex-shrink-0 text-2xs text-text-muted tabular">
									<span class="w-10 text-right">{ tx.Ops }</span>
									<span class="font-mono w-16 text-right">{ tx.Fee }</span>
								</div>
								<!-- Arrow -->
								<svg class="h-3.5 w-3.5 text-text-muted flex-shrink-0 hidden md:block" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
							</a>
						}
					</div>
				</div>

				<!-- Latest Ledgers (1 col) -->
				<div>
					<div class="flex items-center justify-between mb-4">
						<h2 class="text-sm font-semibold text-text-primary">Latest Ledgers</h2>
						<a href="#" class="text-xs font-medium text-text-body hover:text-text-primary transition-colors">View all →</a>
					</div>
					<div class="rounded-xl border border-border-default bg-surface-card overflow-hidden">
						for i, ledger := range data.Ledgers {
							<a href={ templ.SafeURL("/ledger/" + ledger.Sequence) } class={ "tx-row flex items-center justify-between px-4 py-2.5 hover:bg-surface-subtle transition-colors", templ.KV("bg-surface-subtle", i%2 == 1), templ.KV("glow", ledger.IsLatest) }>
								<div>
									<div class="flex items-center gap-2">
										<span class="font-mono text-xs font-semibold text-emerald-700 tabular">{ ledger.Sequence }</span>
										if ledger.IsLatest {
											<span class="h-1.5 w-1.5 rounded-full bg-emerald-500 pulse-dot"></span>
										}
									</div>
									<div class="text-2xs text-text-muted mt-0.5">{ ledger.Age }</div>
								</div>
								<div class="text-right">
									<div class="text-xs text-text-primary tabular">{ ledger.TxCount }</div>
									<div class="text-2xs text-text-muted tabular">{ ledger.OpCount }</div>
								</div>
							</a>
						}
					</div>
				</div>

			</div>
		</section>

		<!-- Curated Sections: Contracts (2 cols) + Sidebar (1 col) -->
		<section class="mx-auto max-w-[1320px] px-4 md:px-8 pb-8">
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

				<!-- Trending Contracts — wide -->
				<div class="anim d3 lg:col-span-2">
					<div class="flex items-center justify-between mb-3">
						<h2 class="text-sm font-semibold text-text-primary">Trending Contracts</h2>
						<a href="/contracts" class="text-xs font-medium text-text-body hover:text-text-primary transition-colors">View all →</a>
					</div>
					<div class="rounded-xl border border-border-default bg-surface-card overflow-hidden">
						<!-- Header -->
						<div class="hidden md:flex items-center gap-3 px-4 py-2 bg-surface-subtle border-b border-border-subtle text-2xs font-semibold uppercase tracking-wider text-text-muted">
							<span class="w-7 flex-shrink-0 text-center">#</span>
							<span class="flex-1">Contract</span>
							<span class="w-24 text-right">Invocations</span>
							<span class="w-16 text-right">Change</span>
						</div>
						for i, c := range data.Contracts {
							<a href="/contracts" class={ "flex items-center gap-3 px-4 py-2.5 hover:bg-surface-subtle transition-colors", templ.KV("bg-surface-subtle", i%2 == 1) }>
								<span class="flex h-7 w-7 items-center justify-center rounded-lg bg-surface-subtle text-xs font-bold text-text-body flex-shrink-0 tabular">{ fmt.Sprintf("%d", c.Rank) }</span>
								<div class="flex-1 min-w-0">
									<div class="flex items-center gap-1.5">
										<span class="text-xs font-semibold text-text-primary truncate">{ c.Name }</span>
										@components.Badge(c.Tag, c.TagColor)
									</div>
									<span class="font-mono text-2xs text-text-muted">{ c.Address }</span>
								</div>
								<div class="w-24 text-right flex-shrink-0">
									<div class="text-xs font-semibold text-text-primary tabular">{ c.Invocations }</div>
								</div>
								<div class="w-16 text-right flex-shrink-0">
									if c.IsPositive {
										<span class="text-2xs text-emerald-600 font-medium tabular">{ c.Change }</span>
									} else {
										<span class="text-2xs text-red-500 font-medium tabular">{ c.Change }</span>
									}
								</div>
								<svg class="h-3.5 w-3.5 text-text-muted flex-shrink-0 hidden md:block" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
							</a>
						}
					</div>
				</div>

				<!-- Sidebar: Assets + Network -->
				<div class="flex flex-col gap-6">

					<!-- Top Assets -->
					<div class="anim d4">
						<div class="flex items-center justify-between mb-3">
							<h2 class="text-sm font-semibold text-text-primary">Top Assets</h2>
							<a href="/assets" class="text-xs font-medium text-text-body hover:text-text-primary transition-colors">View all →</a>
						</div>
						<div class="rounded-xl border border-border-default bg-surface-card overflow-hidden">
							for i, a := range data.Assets {
								<a href="/assets" class={ "flex items-center gap-3 px-4 py-2.5 hover:bg-surface-subtle transition-colors", templ.KV("bg-surface-subtle", i%2 == 1) }>
									<div class={ "flex h-7 w-7 items-center justify-center rounded-full text-white text-2xs font-bold flex-shrink-0", a.BgColor }>{ a.Initial }</div>
									<div class="flex-1 min-w-0">
										<span class="text-xs font-semibold text-text-primary">{ a.Code }</span>
										<span class="text-2xs text-text-muted ml-1">{ a.Issuer }</span>
									</div>
									<div class="text-right flex-shrink-0">
										<div class="text-xs font-semibold text-text-primary tabular">{ a.Volume }</div>
										if a.IsPositive {
											<div class="text-2xs text-emerald-600 font-medium tabular">{ a.Change }</div>
										} else {
											<div class="text-2xs text-red-500 font-medium tabular">{ a.Change }</div>
										}
									</div>
								</a>
							}
						</div>
					</div>

					<!-- Fee Guide -->
					<div class="anim d5">
						<div class="flex items-center justify-between mb-3">
							<h2 class="text-sm font-semibold text-text-primary">Fee Guide</h2>
						</div>
						<div class="rounded-xl border border-border-default bg-surface-card p-4">
							<div class="space-y-2.5">
								<div class="flex items-center justify-between">
									<div class="flex items-center gap-2">
										<span class="h-2 w-2 rounded-full bg-text-muted"></span>
										<span class="text-xs font-medium text-text-strong">Economy</span>
									</div>
									<div>
										<span class="font-mono text-xs font-semibold text-text-primary tabular">{ data.FeeEconomy }</span>
										<span class="text-2xs text-text-muted ml-0.5">stroops</span>
									</div>
								</div>
								<div class="flex items-center justify-between">
									<div class="flex items-center gap-2">
										<span class="h-2 w-2 rounded-full bg-emerald-500"></span>
										<span class="text-xs font-medium text-text-strong">Standard</span>
									</div>
									<div>
										<span class="font-mono text-xs font-semibold text-text-primary tabular">{ data.FeeStandard }</span>
										<span class="text-2xs text-text-muted ml-0.5">stroops</span>
									</div>
								</div>
								<div class="flex items-center justify-between">
									<div class="flex items-center gap-2">
										<span class="h-2 w-2 rounded-full bg-amber-500"></span>
										<span class="text-xs font-medium text-text-strong">Priority</span>
									</div>
									<div>
										<span class="font-mono text-xs font-semibold text-amber-600 tabular">{ data.FeePriority }</span>
										<span class="text-2xs text-text-muted ml-0.5">stroops</span>
									</div>
								</div>
							</div>
							<div class="mt-3 pt-2 border-t border-border-subtle flex items-center gap-1.5">
								if data.SurgeActive {
									<span class="h-1.5 w-1.5 rounded-full bg-amber-500 pulse-dot"></span>
									<span class="text-2xs font-medium text-amber-600">Surge: Active</span>
								} else {
									<span class="h-1.5 w-1.5 rounded-full bg-text-muted"></span>
									<span class="text-2xs text-text-body">Surge: Inactive</span>
								}
							</div>
						</div>
					</div>

				</div>

			</div>
		</section>

		<!-- Quick Access Cards -->
		<section class="mx-auto max-w-[1320px] px-4 md:px-8 pb-12">
			<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
				@quickAccessCard("/account/CDLZQ8M4/smart", "bg-emerald-100 dark:bg-emerald-900/30", "text-emerald-600", "Smart Accounts", "OZ v0.5.0 wallets", shieldIcon())
				@quickAccessCard("/events", "bg-violet-100 dark:bg-violet-900/30", "text-violet-600", "Events Firehose", "Real-time streaming", boltIcon())
				@quickAccessCard("/state", "bg-cyan-100 dark:bg-cyan-900/30", "text-cyan-600", "State & Rent", "TTL monitoring", clockIcon())
				@quickAccessCard("/nft", "bg-amber-100 dark:bg-amber-900/30", "text-amber-600", "NFT Gallery", "Stellar NFTs", imageIcon())
				@quickAccessCard("/network", "bg-surface-subtle", "text-text-body", "Validators", "Network health", chartIcon())
			</div>
		</section>
	}
}

// txTypeColor maps transaction types to badge color names.
func txTypeColor(txType string) string {
	switch txType {
	case "contract_call":
		return "violet"
	case "payment":
		return "emerald"
	case "account_merge":
		return "amber"
	default:
		return "gray"
	}
}

// Quick access card
templ quickAccessCard(href string, bgColor string, textColor string, title string, subtitle string, icon templ.Component) {
	<a href={ templ.SafeURL(href) } class="card-hover flex items-center gap-3 rounded-xl border border-border-default bg-surface-card px-4 py-3.5">
		<div class={ "flex h-9 w-9 items-center justify-center rounded-lg flex-shrink-0", bgColor }>
			<div class={ textColor }>
				@icon
			</div>
		</div>
		<div>
			<div class="text-xs font-semibold text-text-primary">{ title }</div>
			<div class="text-2xs text-text-muted">{ subtitle }</div>
		</div>
	</a>
}

// SVG icon components
templ shieldIcon() {
	<svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
}

templ boltIcon() {
	<svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
}

templ clockIcon() {
