package pages

import (
	"fmt"
	"github.com/withObsrvr/prism/internal/templates/components"
	"github.com/withObsrvr/prism/internal/templates/layouts"
)

type ValidatorDetailData struct {
	Name           string
	NodeType       string
	NodeID         string
	ShortNodeID    string
	StatusBadge    string
	Badges         []string
	// Stats
	NodeIndex      string
	IndexWidth     string
	Validating24H  string
	Val24HWidth    string
	Validating30D  string
	Val30DWidth    string
	CrawlerReject  string
	CrawlerWidth   string
	TrustsCount    string
	TrustsOrgs     string
	TrustedByCount string
	ExtLag         string
	// Node details
	Host           string
	IP             string
	ISP            string
	Domain         string
	Organization   string
	Country        string
	Version        string
	Overlay        string
	LedgerVer      string
	HistoryURL     string
	Discovered     string
	// Org
	OrgName        string
	OrgNodes       []OrgNode
	OrgUptime      string
	OrgValidators  string
	// Quorum
	QuorumThreshold string
	QuorumSets     []QuorumSet
	// Trusts
	Trusts         []TrustRow
	// Updates
	Updates        []NodeUpdate
}

type OrgNode struct {
	Name      string
	ShortID   string
	Uptime    string
	IsViewing bool
}

type QuorumSet struct {
	Name      string
	Threshold string
	IsSelf    bool
	Nodes     []QuorumNode
}

type QuorumNode struct {
	Name   string
	IsSelf bool
	Status string // "up", "down"
}

type TrustRow struct {
	Name        string
	Badge       string // "" or "Warning"
	BadgeColor  string
	Index       string
	TrustWeight string
	TrustPct    string
	Valid24H    string
	Color24H    string // "gray-900", "amber-600"
	Valid30D    string
	Color30D    string
	Version     string
	Country     string
	ISP         string
}

type NodeUpdate struct {
	IconBg    string // "bg-cyan-100", "bg-violet-100", "bg-amber-100"
	IconColor string // "text-cyan-600", etc.
	IconSVG   string // "refresh", "bolt", "location"
	Date      string
	Detail    string
}

templ ValidatorDetail(data ValidatorDetailData) {
	@layouts.Base(data.Name + " — Prism", "network") {
		<main class="mx-auto max-w-[1320px] px-4 md:px-8 py-6">
			<!-- Breadcrumb -->
			<div class="anim">
				@components.Breadcrumb([]components.BreadcrumbItem{
					{Label: "Network", Href: "/network"},
					{Label: data.Organization, Href: "/network"},
					{Label: data.Name, Href: ""},
				})
			</div>

			<!-- Validator identity -->
			<div class="anim d1 flex items-center justify-between mb-7">
				<div class="flex items-center gap-4">
					<div class="relative">
						<div class="flex h-[52px] w-[52px] items-center justify-center rounded-2xl bg-gradient-to-br from-emerald-100 to-cyan-50 dark:from-emerald-900/30 dark:to-cyan-950/20 ring-1 ring-border-default shadow-sm">
							<svg class="h-6 w-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
						</div>
						<div class="absolute -bottom-0.5 -right-0.5 h-3.5 w-3.5 rounded-full bg-emerald-500 ring-2 ring-surface-card pulse-dot"></div>
					</div>
					<div>
						<div class="flex items-center gap-2.5">
							<span class="text-xl font-bold text-text-primary">{ data.Name }</span>
							<span class="text-sm text-text-muted">{ data.NodeType }</span>
						</div>
						<div class="flex items-center gap-1.5 mt-0.5">
							<span class="font-mono text-xs text-text-body">{ data.NodeID }</span>
							@components.CopyButton(data.NodeID)
						</div>
						<div class="flex items-center gap-1.5 mt-2">
							@components.Badge(data.StatusBadge, "emerald")
							for _, b := range data.Badges {
								@components.Badge(b, "gray")
							}
						</div>
					</div>
				</div>
				<div class="flex items-center gap-2">
					@components.ActionButtons([]components.ActionButton{
						{Label: "View Account", Href: "/account/" + data.ShortNodeID, Icon: "account"},
						{Label: "Radar", Href: "#", Icon: "external"},
					})
				</div>
			</div>

			<!-- Stats -->
			<div class="anim d2 mb-7 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
				<div class="rounded-xl border border-border-default bg-surface-card px-4 py-3">
					<div class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-1">Node Index</div>
					<div class="text-2xl font-bold text-text-primary tabular">{ data.NodeIndex }</div>
					<div class="mt-1.5 h-1 rounded-full bg-surface-subtle"><div class="h-1 rounded-full bg-emerald-500" style={ "width:" + data.IndexWidth }></div></div>
				</div>
				<div class="rounded-xl border border-border-default bg-surface-card px-4 py-3">
					<div class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-1">24H Validating</div>
					<div class="text-2xl font-bold text-emerald-600 tabular">{ data.Validating24H }</div>
					<div class="mt-1.5 h-1 rounded-full bg-surface-subtle"><div class="h-1 rounded-full bg-emerald-500" style={ "width:" + data.Val24HWidth }></div></div>
				</div>
				<div class="rounded-xl border border-border-default bg-surface-card px-4 py-3">
					<div class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-1">30D Validating</div>
					<div class="text-2xl font-bold text-emerald-600 tabular">{ data.Validating30D }</div>
					<div class="mt-1.5 h-1 rounded-full bg-surface-subtle"><div class="h-1 rounded-full bg-emerald-500" style={ "width:" + data.Val30DWidth }></div></div>
				</div>
				<div class="rounded-xl border border-amber-200/60 dark:border-amber-800/60 bg-amber-50/20 dark:bg-amber-950/20 px-4 py-3">
					<div class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-1">30D Crawler Rejected</div>
					<div class="text-2xl font-bold text-amber-600 tabular">{ data.CrawlerReject }</div>
					<div class="mt-1.5 h-1 rounded-full bg-surface-subtle"><div class="h-1 rounded-full bg-amber-400" style={ "width:" + data.CrawlerWidth }></div></div>
				</div>
				<div class="rounded-xl border border-border-default bg-surface-card px-4 py-3">
					<div class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-1">Trusts</div>
					<div class="text-xl font-bold text-text-primary tabular">{ data.TrustsCount } <span class="text-sm font-normal text-text-muted">nodes</span></div>
					<div class="text-2xs text-text-body mt-0.5">across { data.TrustsOrgs } organizations</div>
				</div>
				<div class="rounded-xl border border-border-default bg-surface-card px-4 py-3">
					<div class="text-2xs font-semibold uppercase tracking-wider text-text-muted mb-1">Trusted By</div>
					<div class="text-xl font-bold text-text-primary tabular">{ data.TrustedByCount } <span class="text-sm font-normal text-text-muted">nodes</span></div>
					<div class="text-2xs text-text-body mt-0.5">Externalize lag: { data.ExtLag }</div>
				</div>
			</div>

			<!-- Tabs -->
			<div class="anim d2">
				@components.TabBar([]components.Tab{
					{ID: "overview", Label: "Overview"},
					{ID: "quorum", Label: "Quorum Set"},
					{ID: "trusts", Label: "Trusts (" + data.TrustsCount + ")"},
					{ID: "trusted-by", Label: "Trusted By (" + data.TrustedByCount + ")"},
					{ID: "updates", Label: "Updates"},
				}, "overview")
			</div>

			<!-- 30D Charts -->
			<div class="anim d3 mb-7 grid grid-cols-1 md:grid-cols-3 gap-4">
				@validatorChart("Validating", "emerald")
				@validatorChart("History Archive", "emerald")
				@validatorChartAmber("Crawler Rejected")
			</div>

			<!-- Node Details + Org -->
			<div class="anim d4 mb-7 grid grid-cols-2 md:grid-cols-4 gap-4">
				<div class="col-span-3 rounded-xl border border-border-default bg-surface-card overflow-hidden">
					<div class="px-5 py-2.5 bg-surface-subtle border-b border-border-subtle flex items-center justify-between">
						<span class="text-2xs font-semibold uppercase tracking-wider text-text-muted">Node Details</span>
						<span class="text-2xs text-text-muted">Discovered { data.Discovered }</span>
					</div>
					<div class="grid grid-cols-3">
						<div class="border-r border-border-subtle">
							@components.DetailRow("Public Key") {
								<span class="font-mono text-xs text-text-primary">{ data.ShortNodeID }</span>
							}
							@components.DetailRow("Host") {
								<span class="font-mono text-xs text-text-primary">{ data.Host }</span>
							}
							@components.DetailRow("IP Address") {
								<span class="font-mono text-xs text-text-primary">{ data.IP }</span>
							}
							@components.DetailRowLast("ISP") {
								<span class="text-xs text-text-primary">{ data.ISP }</span>
							}
						</div>
						<div class="border-r border-border-subtle">
							@components.DetailRow("Domain") {
								<a href="#" class="text-xs font-medium text-emerald-700 hover:text-emerald-800">{ data.Domain }</a>
							}
							@components.DetailRow("Organization") {
								<a href="#" class="text-xs font-medium text-emerald-700 hover:text-emerald-800">{ data.Organization }</a>
							}
							@components.DetailRow("Country") {
								<span class="text-xs text-text-primary">{ data.Country }</span>
							}
							@components.DetailRowLast("Version") {
								<span class="text-xs text-text-primary">{ data.Version }</span>
							}
						</div>
						<div>
							@components.DetailRow("Overlay") {
								<span class="text-xs text-text-primary tabular">{ data.Overlay }</span>
							}
							@components.DetailRow("Ledger Ver.") {
								<span class="text-xs text-text-primary tabular">{ data.LedgerVer }</span>
							}
							@components.DetailRow("Ext. Lag") {
								<span class="text-xs font-medium text-emerald-600">{ data.ExtLag }</span>
							}
							@components.DetailRowLast("History") {
								<span class="font-mono text-2xs text-emerald-700 truncate max-w-[180px]">{ data.HistoryURL }</span>
							}
						</div>
					</div>
				</div>

				<!-- Org card -->
				<div class="rounded-xl border border-border-default bg-surface-card overflow-hidden">
					<div class="px-4 py-2.5 bg-surface-subtle border-b border-border-subtle"><span class="text-2xs font-semibold uppercase tracking-wider text-text-muted">{ data.OrgName } Organization</span></div>
					for _, n := range data.OrgNodes {
						<div class={ "px-4 py-2.5 border-b border-border-subtle", templ.KV("bg-emerald-50/20 dark:bg-emerald-950/20", n.IsViewing) }>
							<div class="flex items-center gap-2 mb-0.5">
								<span class="h-2 w-2 rounded-full bg-emerald-500"></span>
								<span class="text-sm font-semibold text-text-primary">{ n.Name }</span>
								if n.IsViewing {
									<span class="rounded bg-emerald-100 dark:bg-emerald-900/30 px-1 py-0.5 text-2xs font-bold text-emerald-700 dark:text-emerald-400">VIEWING</span>
								}
							</div>
							<div class="font-mono text-2xs text-text-muted ml-4">{ n.ShortID } · <span class="text-emerald-600 font-medium">{ n.Uptime }</span></div>
						</div>
					}
					<div class="px-4 py-2.5 bg-surface-subtle grid grid-cols-2 gap-2 text-center">
						<div><div class="text-2xs text-text-muted">Org Uptime</div><div class="text-sm font-bold text-emerald-600">{ data.OrgUptime }</div></div>
						<div><div class="text-2xs text-text-muted">Validators</div><div class="text-sm font-bold text-text-primary">{ data.OrgValidators }</div></div>
					</div>
				</div>
			</div>

			<!-- Quorum Set -->
			<div class="anim d5 mb-7">
				<div class="flex items-center justify-between mb-3">
					<h3 class="text-sm font-semibold text-text-primary">Quorum Set</h3>
					@components.Badge(data.QuorumThreshold, "amber")
				</div>
				<div class="rounded-xl border border-border-default bg-surface-card p-5">
					<div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-7 gap-3">
						for _, qs := range data.QuorumSets {
							<div class={ "rounded-lg border p-3", templ.KV("border-emerald-200 dark:border-emerald-800 bg-emerald-50/30 dark:bg-emerald-950/20", qs.IsSelf), templ.KV("border-border-default bg-surface-card", !qs.IsSelf) }>
								<div class="flex items-center mb-2"><span class={ "text-2xs font-bold uppercase tracking-wider", templ.KV("text-emerald-700", qs.IsSelf), templ.KV("text-text-strong", !qs.IsSelf) }>{ qs.Name }</span></div>
								<div class="rounded bg-surface-subtle px-1.5 py-0.5 text-2xs font-bold text-text-body mb-2 inline-block">{ qs.Threshold }</div>
								<div class="flex flex-col gap-1.5">
									for _, n := range qs.Nodes {
										<div class="flex items-center gap-1.5">
											<span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
											<span class="font-mono text-2xs text-text-body">{ n.Name }</span>
											if n.IsSelf {
												<span class="ml-auto text-2xs text-emerald-600 dark:text-emerald-400 font-bold bg-emerald-50 dark:bg-emerald-950/30 px-1 rounded">YOU</span>
											}
										</div>
									}
								</div>
							</div>
						}
					</div>
				</div>
				<div class="mt-4 flex items-center gap-3 rounded-lg border border-emerald-200/60 dark:border-emerald-800/60 bg-emerald-50/30 dark:bg-emerald-950/20 px-4 py-2">
					<svg class="h-4 w-4 text-emerald-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
					<span class="text-xs text-text-body">Failure safety: <span class="font-semibold text-text-primary">2 organizations</span> can fail &bull; Liveness tolerates <span class="font-semibold text-text-primary">2 organization failures</span></span>
				</div>
			</div>

			<!-- Trusts Table -->
			<div class="anim d6 mb-7">
				<div class="flex items-center justify-between mb-3">
					<h3 class="text-sm font-semibold text-text-primary">Trusts <span class="ml-1 rounded bg-surface-subtle px-1.5 py-0.5 text-2xs font-bold text-text-body">{ data.TrustsCount }</span></h3>
					<div class="flex items-center gap-2 rounded-lg border border-border-default bg-surface-card px-2.5 py-1.5">
						<svg class="h-3.5 w-3.5 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
						<span class="text-xs text-text-muted">Filter...</span>
					</div>
				</div>
				<div class="rounded-xl border border-border-default bg-surface-card overflow-hidden">
					<table class="w-full">
						<thead>
							<tr class="bg-surface-subtle text-2xs font-semibold uppercase tracking-wider text-text-muted">
								<th class="text-left px-4 py-2.5 w-[22%]">Quorumset Validator</th>
								<th class="hidden md:table-cell text-center px-3 py-2.5">Index</th>
								<th class="hidden md:table-cell text-left px-3 py-2.5">Trust</th>
								<th class="text-right px-3 py-2.5">24H</th>
								<th class="text-right px-3 py-2.5">30D</th>
								<th class="hidden md:table-cell text-left px-3 py-2.5">Version</th>
								<th class="hidden md:table-cell text-left px-3 py-2.5">Country</th>
								<th class="hidden md:table-cell text-left px-3 py-2.5">ISP</th>
							</tr>
						</thead>
						<tbody class="text-xs">
							for _, t := range data.Trusts {
								<tr class="border-t border-border-subtle detail-row cursor-pointer"
									hx-get={ "/network/validators/" + t.Name + "/preview" }
									hx-target="#slideout"
									hx-swap="innerHTML">
									<td class="px-4 py-2.5">
										<div class="flex items-center gap-2">
											<span class="h-2 w-2 rounded-full bg-emerald-500 flex-shrink-0"></span>
											<span class="font-medium text-emerald-700">{ t.Name }</span>
											if t.Badge != "" {
												<span class={ "ml-1.5 rounded px-1 py-0.5 text-2xs font-bold", templ.KV("bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400", t.BadgeColor == "amber") }>{ t.Badge }</span>
											}
										</div>
									</td>
									<td class="hidden md:table-cell px-3 py-2.5 text-center tabular text-text-primary">{ t.Index }</td>
									<td class="hidden md:table-cell px-3 py-2.5">
										<div class="flex items-center gap-1.5">
											<div class="w-12 h-1.5 rounded-full bg-surface-subtle overflow-hidden">
												<div class="h-1.5 rounded-full bg-emerald-500" style={ "width:" + t.TrustPct }></div>
											</div>
											<span class="tabular text-text-body">{ t.TrustWeight }</span>
										</div>
									</td>
									<td class={ "px-3 py-2.5 text-right tabular", "text-" + t.Color24H }>{ t.Valid24H }</td>
									<td class={ "px-3 py-2.5 text-right tabular font-medium", "text-" + t.Color30D }>{ t.Valid30D }</td>
									<td class="hidden md:table-cell px-3 py-2.5 font-mono text-2xs text-text-body">{ t.Version }</td>
									<td class="hidden md:table-cell px-3 py-2.5 text-text-body">{ t.Country }</td>
									<td class="hidden md:table-cell px-3 py-2.5 text-text-body">{ t.ISP }</td>
								</tr>
							}
						</tbody>
					</table>
					<div class="px-4 py-2.5 bg-surface-subtle border-t border-border-subtle flex items-center justify-between">
						<span class="text-2xs text-text-muted">Showing { fmt.Sprintf("%d", len(data.Trusts)) } of { data.TrustsCount } &bull; Click a row to preview</span>
						<div class="flex items-center gap-1">
							<button class="rounded bg-gray-900 dark:bg-gray-100 px-2.5 py-1 text-2xs font-bold text-white dark:text-gray-900">1</button>
							<button class="rounded bg-surface-subtle px-2.5 py-1 text-2xs font-medium text-text-body hover:bg-surface-subtle">2</button>
							<button class="rounded bg-surface-subtle px-2.5 py-1 text-2xs font-medium text-text-body hover:bg-surface-subtle">3</button>
							<button class="rounded bg-surface-subtle px-2.5 py-1 text-2xs font-medium text-text-body hover:bg-surface-subtle">&rsaquo;</button>
						</div>
					</div>
				</div>
			</div>

			<!-- Latest Node Updates -->
			<div class="anim d7 mb-10">
				<h3 class="text-sm font-semibold text-text-primary mb-3">Latest Node Updates</h3>
				<div class="rounded-xl border border-border-default bg-surface-card overflow-hidden">
					for i, u := range data.Updates {
						<div class={ "detail-row flex items-start gap-3 px-5 py-3", templ.KV("border-b border-border-subtle", i < len(data.Updates)-1) }>
							<div class={ "flex h-6 w-6 items-center justify-center rounded-full mt-0.5 flex-shrink-0", u.IconBg }>
								if u.IconSVG == "refresh" {
									<svg class={ "h-3 w-3", u.IconColor } fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
								}
								if u.IconSVG == "bolt" {
									<svg class={ "h-3 w-3", u.IconColor } fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
								}
								if u.IconSVG == "location" {
									<svg class={ "h-3 w-3", u.IconColor } fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
								}
							</div>
							<div class="flex-1">
								<div class="text-2xs text-text-muted mb-0.5">{ u.Date }</div>
								<div class="text-xs text-text-strong">{ u.Detail }</div>
							</div>
						</div>
					}
				</div>
			</div>
		</main>
	}
}

templ validatorChart(title, color string) {
	<div class="rounded-xl border border-border-default bg-surface-card p-4">
		<div class="flex items-center justify-between mb-3">
			<span class="text-xs font-semibold text-text-primary">{ title }</span>
			<div class="flex gap-1">
				<button class="rounded bg-gray-900 dark:bg-gray-100 px-2 py-0.5 text-2xs font-bold text-white dark:text-gray-900">30D</button>
				<button class="rounded bg-surface-subtle px-2 py-0.5 text-2xs font-medium text-text-body">24H</button>
				<button class="rounded bg-surface-subtle px-2 py-0.5 text-2xs font-medium text-text-body">1H</button>
			</div>
		</div>
		<div class="flex items-end gap-[3px] h-20">
			for _, h := range []string{"100%","100%","100%","100%","100%","100%","100%","100%","100%","100%","100%","100%","100%","100%","100%","100%","100%","100%","85%","100%","100%","100%","100%","100%","100%","100%","100%","100%","100%","100%"} {
				<div class={ "flex-1 rounded-t-sm", templ.KV("bg-emerald-500", h == "100%"), templ.KV("bg-amber-400", h != "100%") } style={ "height:" + h }></div>
			}
		</div>
		<div class="flex justify-between mt-2 text-2xs text-text-muted"><span>Feb 1</span><span>Feb 15</span><span>Mar 2</span></div>
	</div>
}

templ validatorChartAmber(title string) {
	<div class="rounded-xl border border-amber-200/60 dark:border-amber-800/60 bg-amber-50/10 dark:bg-amber-950/20 p-4">
		<div class="flex items-center justify-between mb-3">
			<span class="text-xs font-semibold text-text-primary">{ title }</span>
			<div class="flex gap-1">
				<button class="rounded bg-gray-900 dark:bg-gray-100 px-2 py-0.5 text-2xs font-bold text-white dark:text-gray-900">30D</button>
				<button class="rounded bg-surface-subtle px-2 py-0.5 text-2xs font-medium text-text-body">24H</button>
				<button class="rounded bg-surface-subtle px-2 py-0.5 text-2xs font-medium text-text-body">1H</button>
			</div>
		</div>
		<div class="flex items-end gap-[3px] h-20">
			for _, h := range []string{"65%","44%","73%","50%","79%","79%","33%","44%","32%","50%","55%","47%","34%","43%","66%","75%","50%","43%","71%","61%","55%","71%","59%","39%","46%","38%","45%","77%","65%","64%"} {
				<div class="flex-1 rounded-t-sm bg-red-400" style={ "height:" + h }></div>
			}
		</div>
		<div class="flex justify-between mt-2 text-2xs text-text-muted"><span>Feb 1</span><span>Feb 15</span><span>Mar 2</span></div>
	</div>
}
