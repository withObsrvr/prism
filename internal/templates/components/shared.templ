package components

import (
	"fmt"
	"strings"
)

// NetworkPulse shows the latest ledger and TPS in the home page.
templ NetworkPulse(latestLedger uint64, tps float64) {
	<div class="flex items-center justify-center gap-8 text-xs text-gray-500">
		<div class="flex items-center gap-2">
			<span class="text-gray-400">Latest Ledger</span>
			<a href={ templ.SafeURL(fmt.Sprintf("/ledger/%d", latestLedger)) }
			   class="mono text-emerald-700 font-medium tabular">
				{ fmt.Sprintf("%d", latestLedger) }
			</a>
		</div>
		<div class="h-3 w-px bg-gray-200"></div>
		<div class="flex items-center gap-2">
			<span class="text-gray-400">TPS</span>
			<span class="mono font-medium tabular">{ fmt.Sprintf("%.1f", tps) }</span>
		</div>
	</div>
}

// StatCard renders a single metric card used in 6-column grids.
//
// status: "normal", "warning", "critical" — controls border/bg color.
templ StatCard(label string, value string, status string, progress float64) {
	<div class={ statCardClasses(status) }>
		<div class="text-2xs font-semibold uppercase tracking-wider text-gray-400 mb-1">
			{ label }
		</div>
		<div class={ "text-2xl font-bold tabular", statValueColor(status) }>
			{ value }
		</div>
		if progress >= 0 {
			<div class="mt-1.5 h-1 rounded-full bg-gray-100">
				<div class={ "h-1 rounded-full", statBarColor(status) }
					 style={ fmt.Sprintf("width:%.1f%%", progress) }></div>
			</div>
		}
	</div>
}

// TruncatedAddress renders a blockchain address with copy button.
templ TruncatedAddress(full string, href string) {
	<span class="inline-flex items-center gap-1">
		<a href={ templ.SafeURL(href) }
		   class="mono text-xs text-emerald-700 font-medium hover:underline">
			{ truncate(full) }
		</a>
		<button onclick={ copyToClipboard(full) }
				class="text-gray-300 hover:text-gray-600 transition-colors"
				title="Copy full address">
			<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
					  d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
			</svg>
		</button>
	</span>
}

// Helper functions (these compile into the generated Go code).

func truncate(addr string) string {
	if len(addr) <= 12 {
		return addr
	}
	return addr[:6] + "…" + addr[len(addr)-4:]
}

func copyToClipboard(text string) templ.ComponentScript {
	return templ.ComponentScript{
		Name: "copyAddr",
		Function: fmt.Sprintf(`function copyAddr(){
			var btn=event.currentTarget;
			navigator.clipboard.writeText("%s");
			var svg=btn.querySelector("svg");
			var orig=svg.innerHTML;
			svg.innerHTML='<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>';
			svg.classList.add("text-emerald-500");
			svg.classList.remove("text-gray-300");
			setTimeout(function(){svg.innerHTML=orig;svg.classList.remove("text-emerald-500");svg.classList.add("text-gray-300");},1500);
		}`, text),
	}
}

func statCardClasses(status string) string {
	base := "rounded-xl px-4 py-3 "
	switch status {
	case "warning":
		return base + "border border-amber-200/60 bg-amber-50/20"
	case "critical":
		return base + "border border-red-200/60 bg-red-50/20"
	default:
		return base + "border border-gray-200 bg-white"
	}
}

func statValueColor(status string) string {
	switch status {
	case "warning":
		return "text-amber-600"
	case "critical":
		return "text-red-600"
	default:
		return "text-gray-900"
	}
}

func statBarColor(status string) string {
	switch status {
	case "warning":
		return "bg-amber-400"
	case "critical":
		return "bg-red-500"
	default:
		return "bg-emerald-500"
	}
}

// Badge renders a colored pill label.
// color: "emerald", "violet", "amber", "red", "cyan", "gray", "blue"
templ Badge(label string, color string) {
	<span class={ badgeClasses(color) }>{ label }</span>
}

func badgeClasses(color string) string {
	base := "rounded-full px-2 py-0.5 text-2xs font-semibold ring-1 "
	switch color {
	case "emerald":
		return base + "text-emerald-700 bg-emerald-50 ring-emerald-200"
	case "violet":
		return base + "text-violet-700 bg-violet-50 ring-violet-200"
	case "amber":
		return base + "text-amber-700 bg-amber-50 ring-amber-200"
	case "red":
		return base + "text-red-600 bg-red-50 ring-red-200"
	case "cyan":
		return base + "text-cyan-700 bg-cyan-50 ring-cyan-200"
	case "blue":
		return base + "text-blue-700 bg-blue-50 ring-blue-200"
	default:
		return base + "text-gray-600 bg-gray-100 ring-gray-200"
	}
}

// TypeBadge renders a smaller inline badge for operation/entity types.
// Use Badge for status labels (Validating, Success, Failed).
// Use TypeBadge for type labels inside table rows (Contract Call, Payment, DEX).
// color: "emerald", "violet", "amber", "red", "cyan", "blue", "gray"
templ TypeBadge(label string, color string) {
	<span class={ typeBadgeClasses(color) }>{ label }</span>
}

func typeBadgeClasses(color string) string {
	base := "rounded px-1.5 py-0.5 text-2xs font-bold ring-1 "
	switch color {
	case "emerald":
		return base + "text-emerald-600 bg-emerald-50 ring-emerald-200/60"
	case "violet":
		return base + "text-violet-600 bg-violet-50 ring-violet-200/60"
	case "amber":
		return base + "text-amber-600 bg-amber-50 ring-amber-200/60"
	case "red":
		return base + "text-red-600 bg-red-50 ring-red-200/60"
	case "cyan":
		return base + "text-cyan-600 bg-cyan-50 ring-cyan-200/60"
	case "blue":
		return base + "text-blue-600 bg-blue-50 ring-blue-200/60"
	default:
		return base + "text-gray-500 bg-gray-100 ring-gray-200"
	}
}

// MetaBadge renders a neutral metadata badge (Tier 1, Archive Publisher, SEP-41).
templ MetaBadge(label string) {
	<span class="rounded px-1.5 py-0.5 text-2xs font-semibold text-gray-600 bg-gray-100 ring-1 ring-gray-200">{ label }</span>
}

// Tab represents a single tab in a TabBar.
type Tab struct {
	ID    string
	Label string
}

// TabBar renders a horizontal tab strip with an underline active state.
templ TabBar(tabs []Tab, activeID string) {
	<div class="mb-8 flex gap-6 border-b border-gray-200 text-sm font-medium text-gray-400 overflow-x-auto flex-nowrap whitespace-nowrap">
		for _, tab := range tabs {
			if tab.ID == activeID {
				<button class="border-b-2 border-gray-900 pb-3 text-gray-900">{ tab.Label }</button>
			} else {
				<button class="pb-3.5 cursor-pointer hover:text-gray-900">{ tab.Label }</button>
			}
		}
	</div>
}

// DetailRow renders a key-value row with hover effect.
templ DetailRow(label string) {
	<div class="detail-row flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 sm:gap-4 px-5 py-3 border-b border-gray-100">
		<span class="text-sm text-gray-500 flex-shrink-0">{ label }</span>
		<div class="min-w-0 break-all sm:break-normal sm:text-right">
			{ children... }
		</div>
	</div>
}

// DetailRowLast renders a key-value row without bottom border.
templ DetailRowLast(label string) {
	<div class="detail-row flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 sm:gap-4 px-5 py-3">
		<span class="text-sm text-gray-500 flex-shrink-0">{ label }</span>
		<div class="min-w-0 break-all sm:break-normal sm:text-right">
			{ children... }
		</div>
	</div>
}

// BackNav renders a back arrow + label link.
templ BackNav(label string, href string) {
	<a href={ templ.SafeURL(href) } class="group mb-5 flex items-center gap-1.5 text-sm font-medium text-gray-400 hover:text-gray-900">
		<svg class="h-4 w-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
		{ label }
	</a>
}

// BreadcrumbItem represents a single breadcrumb entry.
type BreadcrumbItem struct {
	Label string
	Href  string
}

// Breadcrumb renders a trail with separator arrows.
templ Breadcrumb(items []BreadcrumbItem) {
	<nav class="flex items-center gap-1.5 text-sm mb-5">
		for i, item := range items {
			if i > 0 {
				<svg class="h-3.5 w-3.5 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
			}
			if i == len(items)-1 {
				<span class="font-medium text-gray-900">{ item.Label }</span>
			} else {
				<a href={ templ.SafeURL(item.Href) } class="text-gray-400 hover:text-gray-900">{ item.Label }</a>
			}
		}
	</nav>
}

// Pagination renders prev/next + windowed page numbers with ellipsis.
// Shows: 1 ... (current-1) [current] (current+1) ... total
templ Pagination(current int, total int, baseURL string) {
	<div class="flex items-center justify-center gap-1.5 mt-6">
		if current > 1 {
			<a href={ templ.SafeURL(fmt.Sprintf("%s?page=%d", baseURL, current-1)) } class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white shadow-sm hover:bg-gray-50">
				<svg class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
			</a>
		}
		for _, p := range paginationPages(current, total) {
			if p == -1 {
				<span class="flex h-8 w-8 items-center justify-center text-xs text-gray-400">…</span>
			} else if p == current {
				<span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gray-900 text-white text-xs font-semibold tabular">{ fmt.Sprintf("%d", p) }</span>
			} else {
				<a href={ templ.SafeURL(fmt.Sprintf("%s?page=%d", baseURL, p)) } class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white text-xs font-medium text-gray-600 shadow-sm hover:bg-gray-50 tabular">{ fmt.Sprintf("%d", p) }</a>
			}
		}
		if current < total {
			<a href={ templ.SafeURL(fmt.Sprintf("%s?page=%d", baseURL, current+1)) } class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white shadow-sm hover:bg-gray-50">
				<svg class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
			</a>
		}
	</div>
}

// paginationPages returns the page numbers to display with -1 as ellipsis.
// For total <= 7: all pages. Otherwise: 1 ... window ... total.
func paginationPages(current, total int) []int {
	if total <= 7 {
		pages := make([]int, total)
		for i := range pages {
			pages[i] = i + 1
		}
		return pages
	}

	var pages []int
	// Always show first page
	pages = append(pages, 1)

	// Left ellipsis
	if current > 3 {
		pages = append(pages, -1)
	}

	// Window around current
	for i := current - 1; i <= current+1; i++ {
		if i > 1 && i < total {
			pages = append(pages, i)
		}
	}

	// Right ellipsis
	if current < total-2 {
		pages = append(pages, -1)
	}

	// Always show last page
	pages = append(pages, total)

	return pages
}

// ProgressBar renders a horizontal progress bar.
templ ProgressBar(value float64, max float64, color string) {
	<div class="h-1.5 w-full rounded-full bg-gray-100">
		<div class={ "h-1.5 rounded-full", progressBarColor(color) } style={ fmt.Sprintf("width:%.1f%%", (value/max)*100) }></div>
	</div>
}

func progressBarColor(color string) string {
	switch color {
	case "emerald":
		return "bg-emerald-500"
	case "violet":
		return "bg-violet-500"
	case "amber":
		return "bg-amber-500"
	case "red":
		return "bg-red-500"
	case "cyan":
		return "bg-cyan-500"
	default:
		return "bg-gray-500"
	}
}

// ActionButton describes a single action button for page headers.
type ActionButton struct {
	Label string
	Href  string
	Icon  string // "external", "share", "star", "account"
}

// CopyButton renders a clipboard icon that copies text on click.
templ CopyButton(text string) {
	<button onclick={ copyToClipboard(text) }
			class="text-gray-300 hover:text-gray-600 transition-colors"
			title="Copy to clipboard">
		<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
				  d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
		</svg>
	</button>
}

// ActionButtons renders a row of border buttons with icons.
templ ActionButtons(buttons []ActionButton) {
	<div class="flex items-center gap-2">
		for _, btn := range buttons {
			<a href={ templ.SafeURL(btn.Href) } class="flex items-center gap-1 rounded-lg border border-gray-200 bg-white px-2.5 py-1.5 text-xs font-medium text-gray-600 shadow-sm hover:bg-gray-50">
				if btn.Icon == "external" {
					<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
				}
				if btn.Icon == "share" {
					<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
				}
				if btn.Icon == "star" {
					<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>
				}
				if btn.Icon == "account" {
					<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
				}
				{ btn.Label }
			</a>
		}
	</div>
}

// MiniSparkline renders a small inline SVG area chart.
templ MiniSparkline(points []float64, width, height int, color string) {
	<svg width={ fmt.Sprintf("%d", width) } height={ fmt.Sprintf("%d", height) } viewBox={ fmt.Sprintf("0 0 %d %d", width, height) } class="inline-block">
		<path d={ sparklinePath(points, width, height) } fill={ sparklineFill(color) } stroke={ sparklineStroke(color) } stroke-width="1.5"/>
	</svg>
}

func sparklinePath(points []float64, w, h int) string {
	if len(points) == 0 {
		return ""
	}
	maxVal := points[0]
	for _, p := range points {
		if p > maxVal {
			maxVal = p
		}
	}
	if maxVal == 0 {
		maxVal = 1
	}
	step := float64(w) / float64(len(points)-1)
	var sb strings.Builder
	sb.WriteString(fmt.Sprintf("M0,%d ", h))
	for i, p := range points {
		x := float64(i) * step
		y := float64(h) - (p/maxVal)*float64(h)*0.9 - float64(h)*0.05
		if i == 0 {
			sb.WriteString(fmt.Sprintf("L%.1f,%.1f ", x, y))
		} else {
			sb.WriteString(fmt.Sprintf("L%.1f,%.1f ", x, y))
		}
	}
	sb.WriteString(fmt.Sprintf("L%d,%d Z", w, h))
	return sb.String()
}

func sparklineFill(color string) string {
	switch color {
	case "emerald":
		return "rgba(16,185,129,0.1)"
	case "violet":
		return "rgba(139,92,246,0.1)"
	case "cyan":
		return "rgba(6,182,212,0.1)"
	case "amber":
		return "rgba(245,158,11,0.1)"
	default:
		return "rgba(107,114,128,0.1)"
	}
}

func sparklineStroke(color string) string {
	switch color {
	case "emerald":
		return "#10B981"
	case "violet":
		return "#8B5CF6"
	case "cyan":
		return "#06B6D4"
	case "amber":
		return "#F59E0B"
	default:
		return "#6B7280"
	}
}

// SectionHeader renders a section title.
templ SectionHeader(title string) {
	<h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-gray-400">{ title }</h3>
}

// EmptyState renders a centered placeholder for zero-result views.
// icon: "search", "list", "contract", "event", "tx"
// ctaLabel/ctaHref: optional call-to-action button (pass "" to omit).
templ EmptyState(icon string, title string, description string, ctaLabel string, ctaHref string) {
	<div class="flex flex-col items-center justify-center py-16 px-6 text-center">
		<div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-gray-100">
			@emptyStateIcon(icon)
		</div>
		<h3 class="text-sm font-semibold text-gray-900 mb-1">{ title }</h3>
		<p class="text-xs text-gray-500 max-w-xs mb-5">{ description }</p>
		if ctaLabel != "" {
			<a href={ templ.SafeURL(ctaHref) } class="rounded-lg bg-gray-900 px-4 py-2 text-xs font-semibold text-white shadow-sm hover:bg-gray-800 transition-colors">
				{ ctaLabel }
			</a>
		}
	</div>
}

templ emptyStateIcon(icon string) {
	switch icon {
		case "search":
			<svg class="h-6 w-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
		case "list":
			<svg class="h-6 w-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
		case "contract":
			<svg class="h-6 w-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
		case "event":
			<svg class="h-6 w-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
		case "tx":
			<svg class="h-6 w-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
		default:
			<svg class="h-6 w-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path></svg>
	}
}
