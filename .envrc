use flake

# Jev is optional. Developers with the central SOPS repository get the API key
# automatically; everyone else can use Prism without Jev.
prism_secrets_dir="${SECRETS_DIR:-$HOME/Documents/secrets}"
if declare -F use_secrets >/dev/null && [[ -f "$prism_secrets_dir/prism/dev.enc.yaml" ]]; then
  use_secrets prism dev
  export PRISM_JEV_API_KEY="${TYPESAFE_API_KEY:?TYPESAFE_API_KEY is missing}"
fi
unset prism_secrets_dir
